;=================================================
; 営業時間システム
;  各施設の営業時間を一元管理する純関数群（状態は持たない）
;  ARG=地区(0住宅街/1大学/2繁華街) / ARG:1=部屋番号
;
;  @営業開始/@営業終了 … 分単位(TIME準拠)。
;    -1        = 営業時間の対象外（道・住居・大学の校舎など常時開放）
;    0〜1440   = 24時間営業（開始0かつ終了1440）
;    終了>1440 = 深夜跨ぎ（例:キャバクラ 1140〜1500 = 19時〜翌1時）
;  @定休日    … 1=本日定休（ジム=月曜 / 家電屋=水曜）
;  @営業中    … 1=営業中 / 0=閉店（店内コマンド＝買い物/遊ぶ/注文/勤務 等のゲートに使う）
;  @入店可    … 1=入れる（移動・入店・マップ表示のゲートはこちらを使う）
;               自分の勤務先（バイト先＋身分の職場）だけは開店前の準備時間も入れる
;  @開店準備中 … 1=勤務先の開店準備時間帯（＝入店はできるが営業前）
;  @営業時間表示 … 「営業時間 9時〜21時（水曜定休）」等の表示用文字列
;  ※病院は救急外来があるため場所としては24時間開放。
;    受付時間（9時〜17時・毎日）は @病院受付中 が別管理し、時間外はCOMF1049が救急外来に切り替える
;=================================================

;-------------------------------------------------
; 開店時刻（分）
;-------------------------------------------------
@営業開始(ARG, ARG:1)
#FUNCTION
SELECTCASE ARG
	CASE 0
		SELECTCASE ARG:1
			;コンビニ・病院・警察署（24時間。病院の受付時間は@病院受付中が別管理）
			CASE 5, 12, 13
				RETURNF 0
			;スーパー・薬屋（9時開店）
			CASE 6, 8
				RETURNF 540
			;銭湯（15時開店。木曜定休）
			CASE 10
				RETURNF 900
			;定食屋（11時開店）
			CASE 14
				RETURNF 660
			;本屋（10時開店）
			CASE 16
				RETURNF 600
			CASEELSE
				RETURNF -1
		ENDSELECT
	;大学は建物として常時開放（-1）だが、学内の店だけは営業時間を持つ(2026-08-31)
	CASE 1
		SELECTCASE ARG:1
			;学生食堂（11時開店）
			CASE 25
				RETURNF 660
			;生協（9時開店）
			CASE 26
				RETURNF 540
			CASEELSE
				RETURNF -1
		ENDSELECT
	CASE 2
		SELECTCASE ARG:1
			;コンビニ・ハンバーガー屋・警察署・ファミレス・病院・ラブホテル（24時間。病院の受付時間は@病院受付中が別管理）
			CASE 5, 6, 11, 12, 13, 22
				RETURNF 0
			;薬屋（9時開店）
			CASE 10
				RETURNF 540
			;カラオケ・ゲーセン・服屋・本屋・ジム・家電屋（10時開店）
			CASE 7, 8, 9, 15, 16, 24
				RETURNF 600
			;喫茶店（7時開店）
			CASE 14
				RETURNF 420
			;キャバクラ（19時開店）
			CASE 19
				RETURNF 1140
			;アダルトショップ（13時開店）
			CASE 20
				RETURNF 780
			;アクセサリーショップ（11時開店）
			CASE 21
				RETURNF 660
			;ソープランド（9時開店）
			CASE 51
				RETURNF 540
			;劇場（18時開演）
			CASE 52
				RETURNF 1080
			;ホストクラブ（20時開店）
			CASE 53
				RETURNF 1200
			;居酒屋（17時開店）
			CASE 54
				RETURNF 1020
			;バー（20時開店）
			CASE 55
				RETURNF 1200
			;質屋（10時開店）
			CASE 56
				RETURNF 600
			;映画館（10時開映）
			CASE 57
				RETURNF 600
			;オフィスビル（9時始業。会社員本人は@開店準備中の猶予で8時から入館できる）
			CASE 29
				RETURNF 540
			CASEELSE
				RETURNF -1
		ENDSELECT
	CASEELSE
		RETURNF -1
ENDSELECT

;-------------------------------------------------
; 閉店時刻（分）。>1440 は深夜跨ぎ（翌日 終了-1440 まで営業）
;-------------------------------------------------
@営業終了(ARG, ARG:1)
#FUNCTION
SELECTCASE ARG
	CASE 0
		SELECTCASE ARG:1
			;コンビニ・病院・警察署（24時間）
			CASE 5, 12, 13
				RETURNF 1440
			;スーパー（21時閉店）
			CASE 6
				RETURNF 1260
			;定食屋（22時閉店）
			CASE 14
				RETURNF 1320
			;薬屋・本屋（20時閉店）
			CASE 8, 16
				RETURNF 1200
			;銭湯（24時閉店）
			CASE 10
				RETURNF 1440
			CASEELSE
				RETURNF -1
		ENDSELECT
	CASE 1
		SELECTCASE ARG:1
			;学生食堂（14時閉店）
			CASE 25
				RETURNF 840
			;生協（18時閉店）
			CASE 26
				RETURNF 1080
			CASEELSE
				RETURNF -1
		ENDSELECT
	CASE 2
		SELECTCASE ARG:1
			;コンビニ・ハンバーガー屋・警察署・ファミレス・病院・ラブホテル（24時間）
			CASE 5, 6, 11, 12, 13, 22
				RETURNF 1440
			;カラオケ（翌5時閉店）
			CASE 7
				RETURNF 1740
			;ゲーセン・喫茶店・本屋・ジム（22時閉店）
			CASE 8, 14, 15, 16
				RETURNF 1320
			;服屋・薬屋・アクセサリーショップ（20時閉店）
			CASE 9, 10, 21
				RETURNF 1200
			;キャバクラ（翌1時閉店）
			CASE 19
				RETURNF 1500
			;アダルトショップ（24時閉店）
			CASE 20
				RETURNF 1440
			;家電屋（21時閉店）
			CASE 24
				RETURNF 1260
			;ソープランド（24時閉店）
			CASE 51
				RETURNF 1440
			;劇場（翌1時閉店＝深夜跨ぎ）
			CASE 52
				RETURNF 1500
			;ホストクラブ（翌2時閉店＝深夜跨ぎ）
			CASE 53
				RETURNF 1560
			;居酒屋（翌1時閉店＝深夜跨ぎ）
			CASE 54
				RETURNF 1500
			;バー（翌3時閉店＝深夜跨ぎ）
			CASE 55
				RETURNF 1620
			;質屋（20時閉店）
			CASE 56
				RETURNF 1200
			;映画館（24時閉館＝成人映画の最終回は22時から）
			CASE 57
				RETURNF 1440
			;オフィスビル（18時終業）
			CASE 29
				RETURNF 1080
			CASEELSE
				RETURNF -1
		ENDSELECT
	CASEELSE
		RETURNF -1
ENDSELECT

;-------------------------------------------------
; 定休日判定（1=本日定休）
;  D:101 = HOLIDAY() のキャッシュ（INFO.ERB @NEXT_DAY で毎日更新）
;-------------------------------------------------
@定休日(ARG, ARG:1)
#FUNCTION
;スポーツジム(2:16)：月曜定休
SIF ARG == 2 && ARG:1 == 16
	RETURNF DAY % 7 == 1
;家電屋(2:24)：水曜定休
SIF ARG == 2 && ARG:1 == 24
	RETURNF DAY % 7 == 3
;銭湯(0:10)：木曜定休
SIF ARG == 0 && ARG:1 == 10
	RETURNF DAY % 7 == 4
RETURNF 0

;-------------------------------------------------
; 営業中判定（1=営業中 / 0=閉店）
;-------------------------------------------------
@営業中(ARG, ARG:1)
#FUNCTION
#DIM 開始
#DIM 終了
開始 = 営業開始(ARG, ARG:1)
;対象外（道・住居・大学の校舎など）は常に営業中扱い
SIF 開始 < 0
	RETURNF 1
終了 = 営業終了(ARG, ARG:1)
;24時間営業
SIF 開始 == 0 && 終了 >= 1440
	RETURNF 1
SIF 定休日(ARG, ARG:1)
	RETURNF 0
;深夜跨ぎ（開店以降 または 翌日側の閉店前）
SIF 終了 > 1440
	RETURNF (TIME >= 開始 || TIME < 終了 - 1440)
RETURNF (TIME >= 開始 && TIME < 終了)

;-------------------------------------------------
; 表示用文字列（閉店メッセージ・マップのバルーンに使用）
;  対象外は空文字を返す
;-------------------------------------------------
@営業時間表示(ARG, ARG:1)
#FUNCTIONS
#DIM 開始
#DIM 終了
#DIMS 定休
開始 = 営業開始(ARG, ARG:1)
SIF 開始 < 0
	RETURNF ""
終了 = 営業終了(ARG, ARG:1)
;定休日の注記
IF ARG == 2 && ARG:1 == 16
	定休 = （月曜定休）
ELSEIF ARG == 2 && ARG:1 == 24
	定休 = （水曜定休）
ELSEIF ARG == 0 && ARG:1 == 10
	定休 = （木曜定休）
ENDIF
SIF 開始 == 0 && 終了 >= 1440
	RETURNF @"24時間営業%定休%"
SIF 終了 > 1440
	RETURNF @"営業時間 {開始 / 60}時〜翌{(終了 - 1440) / 60}時%定休%"
RETURNF @"営業時間 {開始 / 60}時〜{終了 / 60}時%定休%"

;-------------------------------------------------
; 病院の受付時間内か（COMF1049用）
;  受付は毎日9時〜17時。時間外はCOMF1049が救急外来（時間外料金）に切り替える。
;  病院は場所としては24時間開放（@営業開始/終了で24hに設定）
;-------------------------------------------------
@病院受付中
#FUNCTION
RETURNF (TIME >= 540 && TIME < 1020)

;-------------------------------------------------
; 開店準備の猶予（分）。勤務先はこの分数だけ開店前から入れる
;-------------------------------------------------
@開店準備猶予
#FUNCTION
RETURNF 60

;-------------------------------------------------
; 指定の地区・部屋が「あなたの勤務先」か（1=勤務先）
;  ・バイト先  … CFLAG:MASTER:職業 → JOB_AREA/JOB_PLACE（JOB.ERB）
;  ・身分の職場 … 勤務先地区()/勤務先位置()（COM_PROFILE.ERB。専用職場なしは-1）
;-------------------------------------------------
@勤務先か(ARG, ARG:1)
#FUNCTION
;バイト先
SIF CFLAG:MASTER:職業 && ARG == JOB_AREA(CFLAG:MASTER:職業) && ARG:1 == JOB_PLACE(CFLAG:MASTER:職業)
	RETURNF 1
;身分の職場（キャバクラ/ソープランド/劇場/オフィス/教室）
SIF 勤務先地区() >= 0 && ARG == 勤務先地区() && ARG:1 == 勤務先位置()
	RETURNF 1
RETURNF 0

;-------------------------------------------------
; 勤務先の開店準備時間帯か（1=準備中）
;  開店@開店準備猶予分前〜開店時刻の直前。定休日は不可。
;  深夜跨ぎの店（キャバクラ19時/劇場18時）も開店時刻基準でそのまま扱える。
;-------------------------------------------------
@開店準備中(ARG, ARG:1)
#FUNCTION
#DIM 開始
SIF !勤務先か(ARG, ARG:1)
	RETURNF 0
SIF 定休日(ARG, ARG:1)
	RETURNF 0
開始 = 営業開始(ARG, ARG:1)
;対象外（常時開放）・24時間営業は準備時間の概念なし（そもそも営業中）
SIF 開始 <= 0
	RETURNF 0
RETURNF (TIME >= 開始 - 開店準備猶予() && TIME < 開始)

;-------------------------------------------------
; 入店可否（1=入れる）。移動・入店・マップ表示のゲートはこれを使う。
;  店内でできること（買い物・勤務など）は従来どおり @営業中 で判定する。
;-------------------------------------------------
@入店可(ARG, ARG:1)
#FUNCTION
SIF 営業中(ARG, ARG:1)
	RETURNF 1
RETURNF 開店準備中(ARG, ARG:1)
