;-------------------------------------------------
;好感度ボーナス
;-------------------------------------------------
@MASTER_FAVOR_CHECK(ARG,ARG:1)
#FUNCTION
SIF !TCVAR:ARG:行為対象
	RETURNF 100
SELECTCASE ARG:1
	CASE 0 TO 3
		RETURNF GET_REVISION(TA:ARG:(TCVAR:ARG:行為対象):0, 200 , 20000) + 100
	CASE 10,16,20
		RETURNF GET_REVISION((TA:ARG:(TCVAR:ARG:行為対象):1 * 2 + TA:ARG:(TCVAR:ARG:行為対象):3) , 200 , 15000) + 100
	CASE 30 TO 33
		RETURNF MAX(50,100 - (TA:ARG:(TCVAR:ARG:行為対象):1 * 2 + TA:ARG:(TCVAR:ARG:行為対象):3) / 200)
	CASEELSE
		RETURNF 100
ENDSELECT
;-------------------------------------------------
;技巧のチェック
;-------------------------------------------------
@TECHNIQUE_CHECK(ARG,ARG:1)
#FUNCTION
SIF !TCVAR:ARG:行為対象
	RETURNF 100
SELECTCASE ARG:1
	CASE 0 TO 3
		RETURNF GET_REVISION(ABL:(TCVAR:ARG:行為対象):技巧 + 2, 500, 10)
	CASEELSE
		RETURNF 100
ENDSELECT
;-------------------------------------------------
;興奮度
;-------------------------------------------------
@EXCITE_CHECK(ARG,ARG:1)
#FUNCTION
SELECTCASE ARG:1
	CASE 10,12,15,16,18,20,21,22
		RETURNF GET_REVISION(BASE:ARG:興奮度, 50 , 500) + 100
	CASE 30 TO 33
		RETURNF 200 - BASE:ARG:興奮度 / 100
	CASEELSE
		RETURNF 100
ENDSELECT
;-------------------------------------------------
;理性
;-------------------------------------------------
@REASON_CHECK(ARG,ARG:1)
#FUNCTION
SELECTCASE ARG:1
	CASE 0,1,2,3,10,12,15,16,18
		RETURNF GET_REVISION(1000 - BASE:ARG:理性, 50 , 500) + 100
	CASE 30 TO 33
		RETURNF 50 + BASE:ARG:理性 / 100
	CASEELSE
		RETURNF 100
ENDSELECT
;-------------------------------------------------
;処女喪失時の処理
;-------------------------------------------------
@LOST_VIRGIN(ARG)

IF TALENT:ARG:処女 == 1 && EXP_UP(1,ARG)
	PRINTFORML %CALLNAME:ARG%の秘唇から、処女の証である赤い血が垂れ落ちていった……
	PRINTFORMW %CALLNAME:(TCVAR:ARG:行為対象)%は%CALLNAME:ARG%の処女を奪った
	TALENT:ARG:処女 = 0
	SIF J:115
		EXP:ARG:異常経験 += 2
	SIF J:116
		EXP:ARG:異常経験 += 1
	;処女喪失フラグ(今回のコマンド)
	PRINTFORML [0] - 確認
$INPUT_LOOP1
	INPUT
	;TCVAR:ARG:破瓜 = 1
[SKIPSTART]
	;ビデオ撮影
	IF TEQUIP:ARG:28
		;性交
		IF TEQUIP:ARG:50
			LOCALS = LV1/
		ELSEIF TEQUIP:13
			LOCALS = LV3/
		;その他
		ELSE
			LOCALS = LV4/
		ENDIF
		TSTR:1 += LOCALS
	ENDIF
[SKIPEND]
	;貞操観念
	IF TALENT:ARG:貞操 > 0
		IF TCVAR:ARG:行為対象 && !LOVE_CHECK(ARG,TCVAR:ARG:行為対象)
			TIMES SOURCE:ARG:情愛 , 0.60
			TIMES SOURCE:ARG:反感 , 10.00
		;ELSEIF !ASSIPLAY
		;	TIMES SOURCE:ARG:情愛 , 1.20
		;	TIMES SOURCE:ARG:反感 , 0.50
		ENDIF
	;貞操無頓着
	ELSEIF TALENT:ARG:貞操 < 0
		TIMES SOURCE:ARG:情愛 , 0.60
		TIMES SOURCE:ARG:反感 , 0.50
	ENDIF
[SKIPSTART]
	;CSTR:ARG:処女喪失相手 = %CALLNAME:(TCVAR:ARG:V相手)%の
	;陥落素質による処理
	;4はＣ（ペニス）
	IF TCVAR:ARG:Ｖ占拠部位 == 4
		;最愛
		IF TCVAR:ARG:Ｖ相手 == CFLAG:ARG:最愛
			PRINTFORMW %CALLNAME:ARG%は%CALLNAME:MASTER%が初めての相手である事にこの上ない幸せを感じているようだ……
			TFLAG:150 = 2
			TIMES SOURCE:ARG:情愛 , 2.00
			TIMES SOURCE:ARG:反感 , 0.10
		;愛情度１００以上
		ELSEIF TA:ARG:(TCVAR:ARG:Ｖ相手):1 > 100
			PRINTFORMW %CALLNAME:ARG%は%CALLNAME:MASTER%に処女を捧げられた事に幸福を感じているようだ……
			TFLAG:150 = 2
			TIMES SOURCE:ARG:情愛 , 2.00
			TIMES SOURCE:ARG:反感 , 0.30
		ENDIF
	ENDIF
[SKIPEND]
;愛情度＋１
	TA:ARG:(TCVAR:ARG:行為対象):1 += 1

ENDIF

IF TCVAR:ARG:挿入
	IF !TALENT:ARG:童貞 && GETBIT(TALENT:ARG:2,1)
		PRINTFORML 童貞喪失(%CALLNAME:ARG%)
		PRINTFORMW %CALLNAME:ARG%は%CALLNAME:(TCVAR:ARG:行為対象)%に童貞を捧げた
		SIF J:115
			EXP:ARG:異常経験 += 2
		SIF J:116
			EXP:ARG:異常経験 += 1
	ENDIF
	SETBIT TALENT:ARG:童貞 , TCVAR:ARG:挿入 - 1

;愛情度＋１
	TA:ARG:(TCVAR:ARG:行為対象):1 += 1
ENDIF
