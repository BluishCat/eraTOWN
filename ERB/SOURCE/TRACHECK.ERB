		ELSEIF LOCAL:10 > 0
			LOCAL:10 = 1
		ENDIF
		SIF ABL:ARG:サドっ気 >= 4
			LOCAL:10 += 1
	ENDIF

	;何もしないを使用した場合は上限を0にする
	;SIF LOCAL:10 > 0 && SELECTCOM == 21
	;	LOCAL:10 = 0
	;助手調教中
	;SIF ASSIPLAY == 1
	;	LOCAL:10 = 0
	SIF LOCAL == 0
		LOCAL:11 = 0
	SIF LOCAL:2 == 0
		LOCAL:10 = 0
	TCVAR:ARG:好意 += LOCAL:10
	TCVAR:ARG:好意 = LIMIT(TCVAR:ARG:好意, 0, 999999)
	TCVAR:ARG:肉欲 += LOCAL:11
	TCVAR:ARG:肉欲 = LIMIT(TCVAR:ARG:肉欲, 0, 999999)
;好意度＋１	SOURCS.ERBの397でやってるっぽい
;;;	SIF LOCAL:10 >= 1
;;;		TA:ARG:(TCVAR:ARG:行為対象):3 += 1
;肉欲度＋１	SOURCS.ERBの397でやってるっぽい
;;;	SIF LOCAL:11 >= 1
;;;		TA:ARG:(TCVAR:ARG:行為対象):0 += 1
ENDIF
