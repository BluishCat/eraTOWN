@SOURCE_EXP(ARG)
VARSET LOCAL
SIF SOURCE:ARG:快Ｃ
	EXP:ARG:0 ++
SIF SOURCE:ARG:快Ｖ && (!TCVAR:ARG:破瓜抑制 || !TALENT:ARG:処女)
	EXP:ARG:1 ++
SIF SOURCE:ARG:快Ａ
	EXP:ARG:2 ++
SIF SOURCE:ARG:快Ｂ
	EXP:ARG:3 ++
SIF TCVAR:ARG:イベント == 1 && !(SELECTCOM >= 900 && SELECTCOM < 1000)
	EXP:ARG:痴漢経験++
@SOURCE_快Ｃ(ARG)
VARSET LOCAL
;Ｃ敏感とＣ鈍感はここで処理
SOURCE:ARG:快Ｃ = SOURCE:ARG:快Ｃ * (2 + TALENT:ARG:Ｃ感度) / 2

;C感覚
SOURCE:ARG:快Ｃ = SOURCE:ARG:快Ｃ * SOURCE_REVISION1(ABL:ARG:Ｃ感覚) / 10

LOCAL = SOURCE:ARG:快Ｃ
;PALAM:欲情をみる
IF PALAM:ARG:欲情 < PALAMLV:1
	TIMES LOCAL , 0.80
ELSEIF PALAM:ARG:欲情 < PALAMLV:2
	TIMES LOCAL , 1.00
ELSEIF PALAM:ARG:欲情 < PALAMLV:3
	TIMES LOCAL , 1.20
ELSEIF PALAM:ARG:欲情 < PALAMLV:4
	TIMES LOCAL , 1.40
ELSEIF PALAM:ARG:欲情 >= PALAMLV:4
	TIMES LOCAL , 1.60
ENDIF
CUP:ARG:快Ｃ += LOCAL

LOCAL = SOURCE:ARG:快Ｃ
;ABL:欲望をみる
LOCAL = LOCAL * SOURCE_REVISION2(ABL:ARG:欲望) / 100

CUP:ARG:欲情 += LOCAL


@SOURCE_快Ｖ(ARG)
VARSET LOCAL
;Ｖ敏感とＶ鈍感はここで処理
SOURCE:ARG:快Ｖ = SOURCE:ARG:快Ｖ * (2 + TALENT:ARG:Ｖ感度) / 2

