		PRINTFORML ＜媚薬＞
	DOWNBASE:ARG:体力 += 10
	DOWNBASE:ARG:気力 += 80

	SOURCE:ARG:欲情 += 300 * LOCAL:2 / 10
	TEQUIP:ARG:媚薬 = MAX(0,TEQUIP:ARG:媚薬 - LOCAL:2)
ENDIF

;利尿剤服用中

IF TEQUIP:ARG:利尿剤
	SIF ARG == 1 || TCVAR:ARG:行為対象 == 1
		PRINTFORML ＜利尿剤＞
	DOWNBASE:ARG:体力 += 10
	DOWNBASE:ARG:気力 += 80

	DOWNBASE:ARG:尿意 -= 100

	SOURCE:ARG:恐怖 += 10 * LOCAL:2 / 10
	SOURCE:ARG:逸脱 += 30 * LOCAL:2 / 10
	SOURCE:ARG:苦痛 += 30 * LOCAL:2 / 10
	TEQUIP:ARG:利尿剤 = MAX(0,TEQUIP:ARG:利尿剤 - LOCAL:2)
ENDIF

;下剤服用中
IF TEQUIP:ARG:下剤
	SIF ARG == 1 || TCVAR:ARG:行為対象 == 1
		PRINTFORML ＜下剤＞
	DOWNBASE:ARG:体力 += 30
	DOWNBASE:ARG:気力 += 80

;便意は対応するパラメータが存在しない
;現状では脱糞するＪＫなど夢のまた夢
;下剤＜なぜ生んだ
;	DOWNBASE:ARG:便意 -= 100

	SOURCE:ARG:恐怖 += 50 * LOCAL:2 / 10
	SOURCE:ARG:逸脱 += 50 * LOCAL:2 / 10
	SOURCE:ARG:苦痛 += 60 * LOCAL:2 / 10
	TEQUIP:ARG:下剤 = MAX(0,TEQUIP:ARG:下剤 - LOCAL:2)
ENDIF


IF TEQUIP:ARG:アロマスプレー
	BASE:ARG:ストレス = LIMIT(BASE:ARG:ストレス - 10 * LOCAL:2,0,MAXBASE:ARG:ストレス)
	TEQUIP:ARG:アロマスプレー = MAX(0,TEQUIP:ARG:アロマスプレー - LOCAL:2)
ENDIF

IF TEQUIP:ARG:睡眠薬
	BASE:ARG:眠気 = LIMIT(BASE:ARG:眠気 + 10 * LOCAL:2,0,MAXBASE:ARG:眠気)
	TEQUIP:ARG:睡眠薬 = MAX(0,TEQUIP:ARG:睡眠薬 - LOCAL:2)
ENDIF

IF TEQUIP:ARG:眠気覚まし
	BASE:ARG:疲労 = LIMIT(BASE:ARG:疲労 + 10 * LOCAL:2,0,MAXBASE:ARG:疲労)
	TEQUIP:ARG:眠気覚まし = MAX(0,TEQUIP:ARG:眠気覚まし - LOCAL:2)
ENDIF

IF TEQUIP:ARG:栄養ドリンク
	TEQUIP:ARG:栄養ドリンク = MAX(0,TEQUIP:ARG:栄養ドリンク - LOCAL:2)
ENDIF

;追加特殊調教
;縄
IF (TFLAG:行為者 == ARG) && (TEQUIP:ARG:縄)
	;-------------------------------------------------
	;縄で緊縛中
	;-------------------------------------------------
	SIF ARG == 1 || TCVAR:ARG:行為対象 == 1
		PRINTFORML ＜緊縛中＞（%CALLNAME:ARG%）
	;-------------------------------------------------
	;ソースの計算
	;-------------------------------------------------
	;緊縛経験が高いと消費減少
	IF EXP:ARG:56 < EXPLV:3 / 2
		DOWNBASE:ARG:体力 += 5
		DOWNBASE:ARG:気力 += 10
	ELSEIF EXP:ARG:56 < EXPLV:4 / 2
		DOWNBASE:ARG:体力 += 4
		DOWNBASE:ARG:気力 += 8
	ELSE
		DOWNBASE:ARG:体力 += 3
		DOWNBASE:ARG:気力 += 6
	ENDIF
	;ABL:マゾっ気をみる
	IF ABL:15 == 0
		A = 60
	ELSEIF ABL:ARG:15 == 1
		A = 180
	ELSEIF ABL:ARG:15 == 2
		A = 300
	ELSEIF ABL:ARG:15 == 3
		A = 480
	ELSEIF ABL:ARG:15 == 4
		A = 700
	ELSE
		A = 850
	ENDIF
	;倒錯的
	SIF TALENT:ARG:80
		TIMES A , 2.00
	;PALAM:欲情をみる
	IF PALAM:ARG:11 < PALAMLV:1
		TIMES A , 0.80
	ELSEIF PALAM:ARG:11 < PALAMLV:2
		TIMES A , 0.90
	ELSEIF PALAM:ARG:11 < PALAMLV:3
		TIMES A , 1.00
	ELSEIF PALAM:ARG:11 < PALAMLV:4
		TIMES A , 1.10
	ELSEIF PALAM:ARG:11 >= PALAMLV:4
		TIMES A , 1.20
	ENDIF
	SOURCE:ARG:苦痛 += A
	SOURCE:ARG:露出 += A
	SOURCE:ARG:屈従 += A
	SOURCE:ARG:逸脱 += A
	;-------------------------------------------------
	;経験上昇
	;-------------------------------------------------
	EXP:ARG:緊縛経験 += 2
ENDIF

