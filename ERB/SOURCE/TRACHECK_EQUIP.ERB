@EQUIP_CHECK(ARG)

;あなたでないキャラクタはチェックしない
;SIF ARG != MASTER
;	RETURN 0
VARSET LOCAL

IF TFLAG:行為者 == ARG
	LOCAL:2 = CFLAG:ARG:待機時間
ELSE
	LOCAL:2 = CFLAG:(TCVAR:ARG:行為対象):待機時間
ENDIF
;他のキャラがまだ服を着ていないので暫定処理
IF ARG == MASTER
;--------------------------------------------------
;服装の刺激度によるソース
;--------------------------------------------------
LOCAL:1 = 10
SIF IS_MASTER_HOME()
	LOCAL:1 = 100
IF BASE:ARG:刺激度 > 600
	SOURCE:ARG:露出 += (BASE:ARG:刺激度 - 600) * LOCAL:2 / LOCAL:1
	SIF !IS_MASTER_HOME()
		BASE:ARG:評判 = LIMIT(BASE:ARG:評判 - ((BASE:ARG:刺激度 - 600) * LOCAL:2 / 50),0,1000)
ENDIF
SIF BASE:ARG:刺激度 > 700
	SOURCE:ARG:逸脱 += (BASE:ARG:刺激度 - 700) * LOCAL:2 * 2 / LOCAL:1
SIF BASE:ARG:内部刺激度 > 600
	SOURCE:ARG:欲情 += (BASE:ARG:内部刺激度 - 600) * LOCAL:2 * ABL:ARG:露出癖 / LOCAL:1
ENDIF
;---------------------------------------------------
;各種器具装着（TEQUIPによって管理されるもので、服でないもの）によるソース
;媚薬や利尿剤などもここ
;---------------------------------------------------

;クリキャップとローター装着中
;性能の差はない
IF (TFLAG:行為者 == ARG) && (TEQUIP:ARG:クリトリス == 40 || TEQUIP:ARG:クリトリス == 41)
	SIF ARG == 1 || TCVAR:ARG:行為対象 == 1
		PRINTFORML ＜%ITEMNAME:(TEQUIP:ARG:クリトリス)%着用中＞（%CALLNAME:ARG%）
	;消費体力、気力
	DOWNBASE:ARG:体力 += 5
	DOWNBASE:ARG:気力 += 10

	SOURCE:ARG:快Ｃ += 100 * LOCAL:2 / 10
	SOURCE:ARG:露出 += 20 * LOCAL:2 / 10
	SOURCE:ARG:逸脱 += 30 * LOCAL:2 / 10
	SOURCE:ARG:反感 += 30 * LOCAL:2 / 10
	
	EXP:ARG:道具使用経験++

ENDIF

;オナホール装着中
IF (TFLAG:行為者 == ARG) && (TEQUIP:ARG:クリトリス == 80)
	SIF ARG == 1 || TCVAR:ARG:行為対象 == 1
		PRINTFORML ＜オナホール着用中＞（%CALLNAME:ARG%）
	;消費体力、気力
	DOWNBASE:ARG:体力 += 5
	DOWNBASE:ARG:気力 += 20

	SOURCE:ARG:快Ｃ += 100 * LOCAL:2 / 10
	SOURCE:ARG:露出 += 10 * LOCAL:2 / 10
	SOURCE:ARG:逸脱 += 15 * LOCAL:2 / 10
	SOURCE:ARG:反感 += 15 * LOCAL:2 / 10
	
	EXP:ARG:道具使用経験++
ENDIF

;バイブ装着中
IF (TFLAG:行為者 == ARG) && (TEQUIP:ARG:膣 == 1)
	SIF ARG == 1 || TCVAR:ARG:行為対象 == 1
		PRINTFORML ＜バイブ着用中＞（%CALLNAME:ARG%）
	DOWNBASE:ARG:体力 += 5
	DOWNBASE:ARG:気力 += 20

	SOURCE:ARG:快Ｖ += 125 * LOCAL:2 / 10
	SOURCE:ARG:逸脱 += 30 * LOCAL:2 / 10
	SOURCE:ARG:露出 += 25 * LOCAL:2 / 10
	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:ARG:自己愛 == -1 || TALENT:ARG:抵抗
		SOURCE:ARG:鬱屈 += 20
	;Vへの苦痛は先に処理しておく
	;EXP:Ｖ経験をみる（処女はありえない）
	A = 25
	B = 20
	IF EXP:ARG:0 < EXPLV:2
		TIMES A , 0.80
		TIMES B , 1.20
	ELSEIF EXP:ARG:0 < EXPLV:3
		TIMES A , 0.40
	ELSEIF EXP:ARG:0 < EXPLV:4
		TIMES A , 0.10
	ELSEIF EXP:ARG:0 < EXPLV:5
		TIMES A , 0.00
	ELSEIF EXP:ARG:0 >= EXPLV:5
		TIMES A , 0.00
	ENDIF
	
	;PALAM:潤滑をみる
	IF PALAM:ARG:4 < PALAMLV:1
		TIMES A , 1.20
		TIMES B , 1.50
	ELSEIF PALAM:ARG:4 < PALAMLV:2
		TIMES A , 0.70
		TIMES B , 1.20
	ELSEIF PALAM:ARG:4 < PALAMLV:3
		TIMES A , 0.40
	ELSEIF PALAM:ARG:4 < PALAMLV:4
		TIMES A , 0.10
	ELSEIF PALAM:ARG:4 >= PALAMLV:4
		TIMES A , 0.10
	ENDIF
	SOURCE:ARG:苦痛 += A
	SOURCE:ARG:反感 += B

	EXP:ARG:道具使用経験++

ENDIF

;アナルバイブ装着中
IF (TFLAG:行為者 == ARG) && (TEQUIP:ARG:アナル == 60 || TEQUIP:ARG:アナル == 62)
	SIF ARG == 1 || TCVAR:ARG:行為対象 == 1
		PRINTFORML ＜%ITEMNAME:(TEQUIP:ARG:アナル)%着用中＞（%CALLNAME:ARG%）
	DOWNBASE:ARG:体力 += 5
	DOWNBASE:ARG:気力 += 20

	SOURCE:ARG:快Ａ += 200 * LOCAL:2 / 10
	SOURCE:ARG:苦痛 += 100 * LOCAL:2 / 10
	SOURCE:ARG:露出 += 25 * LOCAL:2 / 10
	SOURCE:ARG:逸脱 += 25 * LOCAL:2 / 10
	SOURCE:ARG:反感 += 25 * LOCAL:2 / 10

	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:ARG:自己愛 == -1 || TALENT:ARG:抵抗
		SOURCE:ARG:鬱屈 += 35
	;Aへの苦痛は先に処理しておく
	;EXP:Ａ経験をみる
	A = 100
	B = 40
	IF EXP:ARG:1 < EXPLV:1
		TIMES A , 3.00
		TIMES B , 3.00
	ELSEIF EXP:ARG:1 < EXPLV:2
		TIMES A , 1.20
		TIMES B , 2.00
	ELSEIF EXP:ARG:1 < EXPLV:3
		TIMES A , 0.80
		TIMES B , 1.50
	ELSEIF EXP:ARG:1 < EXPLV:4
		TIMES A , 0.60
		TIMES B , 1.20
	ELSEIF EXP:ARG:1 < EXPLV:5
		TIMES A , 0.40
	ELSEIF EXP:ARG:1 >= EXPLV:5
		TIMES A , 0.20
	ENDIF

	;PALAM:潤滑をみる
	IF PALAM:ARG:4 < PALAMLV:1
		TIMES A , 1.20
		TIMES B , 2.00
	ELSEIF PALAM:ARG:4 < PALAMLV:2
		TIMES A , 1.00
		TIMES B , 1.50
	ELSEIF PALAM:ARG:4 < PALAMLV:3
		TIMES A , 0.60
	ELSEIF PALAM:ARG:4 < PALAMLV:4
		TIMES A , 0.30
	ELSEIF PALAM:ARG:4 >= PALAMLV:4
		TIMES A , 0.20
	ENDIF
	SOURCE:ARG:苦痛 += A
	SOURCE:ARG:反感 += B

	EXP:ARG:道具使用経験++

ENDIF
;アナルビーズ使用中

IF (TFLAG:行為者 == ARG) && (TEQUIP:ARG:アナル == 61)
	SIF ARG == 1 || TCVAR:ARG:行為対象 == 1
		PRINTFORML ＜アナルビーズ着用中＞（%CALLNAME:ARG%）
	DOWNBASE:ARG:体力 += 5
	DOWNBASE:ARG:気力 += 40

	SOURCE:ARG:快Ａ += 75 * LOCAL:2 / 10
	SOURCE:ARG:露出 += 25 * LOCAL:2 / 10
	SOURCE:ARG:屈従 += 25 * LOCAL:2 / 10
	SOURCE:ARG:逸脱 += 25 * LOCAL:2 / 10
	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:ARG:自己愛 == -1 || TALENT:ARG:抵抗
		SOURCE:ARG:鬱屈 = 30
	;Aへの苦痛は先に処理しておく
	;EXP:Ａ経験をみる
	A = 100
	B = 25
	IF EXP:ARG:1 < EXPLV:1
		TIMES A , 3.00
		TIMES B , 3.00
	ELSEIF EXP:ARG:1 < EXPLV:2
		TIMES A , 1.20
		TIMES B , 2.00
	ELSEIF EXP:ARG:1 < EXPLV:3
		TIMES A , 0.80
		TIMES B , 1.50
	ELSEIF EXP:ARG:1 < EXPLV:4
		TIMES A , 0.60
		TIMES B , 1.20
	ELSEIF EXP:ARG:1 < EXPLV:5
		TIMES A , 0.40
	ELSEIF EXP:ARG:1 >= EXPLV:5
		TIMES A , 0.20
	ENDIF

	;PALAM:潤滑をみる
	IF PALAM:ARG:4 < PALAMLV:1
		TIMES A , 1.20
		TIMES B , 2.00
	ELSEIF PALAM:ARG:4 < PALAMLV:2
		TIMES A , 1.00
		TIMES B , 1.50
	ELSEIF PALAM:ARG:4 < PALAMLV:3
		TIMES A , 0.60
	ELSEIF PALAM:ARG:4 < PALAMLV:4
		TIMES A , 0.30
	ELSEIF PALAM:ARG:4 >= PALAMLV:4
		TIMES A , 0.20
	ENDIF
	SOURCE:ARG:苦痛 += A
	SOURCE:ARG:反感 += B

	
	EXP:ARG:道具使用経験++
ENDIF

;二プルキャップ装着中

IF (TFLAG:行為者 == ARG) && (TEQUIP:ARG:胸)
	SIF ARG == 1 || TCVAR:ARG:行為対象 == 1
