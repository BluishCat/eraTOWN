@EVENTTRAIN
IF DAY:3 == 1 && !CFLAG:MASTER:お小遣い
	;身分システム：月初の収入を身分別に分岐（お小遣いフラグ64は「今月受給済み」として共用）
	SELECTCASE CFLAG:MASTER:仕事
		CASE 1
			;教師：月初に基本給が振り込まれる（実働分の日当は「授業をする」で別途取得済み）
			PRINTFORMW 今月の給料が振り込まれた(+%金額(150000 + BASE:MASTER:評判 * 30)%円)
			MONEY:MASTER += 150000 + BASE:MASTER:評判 * 30
		CASE 5
			;会社員：月初に基本給が振り込まれる（実働分の日当は「会社で働く」で別途取得済み）
			PRINTFORMW 今月の給料が振り込まれた(+%金額(180000 + BASE:MASTER:評判 * 30)%円)
			MONEY:MASTER += 180000 + BASE:MASTER:評判 * 30
		CASE 7
			;専業主婦・家事手伝い：家族から生活費を受け取る
			PRINTFORMW 今月の生活費を受け取った(+%金額(50000 + BASE:MASTER:評判 * 10)%円)
			MONEY:MASTER += 50000 + BASE:MASTER:評判 * 10
		CASE 6, 8, 9, 10
			;フリーター・キャバ嬢・ソープ嬢・ダンサー：固定収入なし（働いた分だけ。日当はバイト/店に出る/ステージで取得）
		CASEELSE
			;学生：親からのお小遣い
			PRINTFORMW お小遣いを貰いました(+%金額(BASE:MASTER:評判 * 20)%円)
			MONEY:MASTER += BASE:MASTER:評判 * 20
	ENDSELECT
	CFLAG:MASTER:お小遣い = 1
	CFLAG:MASTER:欠席日数 = 0
	FOR J:101,2,CHARANUM
		IF TALENT:(J:101):学生
			J:102 = EXP:(J:101):20 + EXP:(J:101):21 - EXP:(J:101):41
			MONEY:(J:101) += (22000 - J:102 * 5)
		ELSE
			J:102 = EXP:(J:101):12 + EXP:(J:101):13 + EXP:(J:101):53 + EXP:(J:101):54 + EXP:(J:101):55 - EXP:(J:101):57
			MONEY:(J:101) += (30000 + J:102 * 10)
		ENDIF
	NEXT
ENDIF
;賃貸住居の家賃（月初徴収。物件別金額はマンション.ERB @物件家賃）
IF FLAG:引越し && DAY:3 == 1
	LOCAL:9 = 物件家賃(CFLAG:MASTER:開始地区, CFLAG:MASTER:開始位置)
	IF LOCAL:9 > 0
		IF MONEY:MASTER >= LOCAL:9
			PRINTFORMW 家賃を払いました(-%金額(LOCAL:9)%円)
			MONEY:MASTER -= LOCAL:9
		ELSE
			PRINTFORMW お金がない為家賃を払えません
		ENDIF
	ENDIF
ENDIF
;ホストクラブの売掛（月初徴収＋利息、担当の好意の減衰。ホストクラブ.ERB）
CALL ホストクラブ日次
;質屋の借金（月初徴収＋利息、払えなければ質流れ。質屋.ERB）
CALL 質屋日次

;TIME = CFLAG:MASTER:起床時間
;BASE:MASTER:体力 = LIMIT(BASE:MASTER:体力 + (TIME / 60) * 100 ,0,MAXBASE:MASTER:体力)
;BASE:MASTER:気力 = LIMIT(BASE:MASTER:気力 + (TIME / 20) * 200 ,0,MAXBASE:MASTER:気力)
BASE:MASTER:気力 = LIMIT(BASE:MASTER:気力 + MAXBASE:MASTER:気力 / 10 ,0,MAXBASE:MASTER:気力)

FOR LOCAL,1,CHARANUM
	CALL SET_CLOTHES(LOCAL)
	FOR LOCAL:1,0,100
		TCVAR:LOCAL:(400 + LOCAL:1) = EXP:LOCAL:(LOCAL:1)
	NEXT
	TCVAR:LOCAL:お金 = MONEY:LOCAL
	;BASE:LOCAL:性欲 = LIMIT(BASE:LOCAL:性欲 + ABL:LOCAL:欲望 * 1000,0,MAXBASE:LOCAL:性欲)
	;IF LOCAL == MASTER
	;	BASE:LOCAL:興奮度 = 0
	;ELSE
	;	BASE:LOCAL:興奮度 = MIN(RAND((ABL:LOCAL:欲望 +1)* 250),1000)
		;BASE:LOCAL:興奮度 = MIN((ABL:LOCAL:欲望 +1)* 250,1000)
	;ENDIF
	BASE:LOCAL:理性 = MAXBASE:LOCAL:理性
	CFLAG:LOCAL:現在位置 = CFLAG:LOCAL:開始位置
	CFLAG:LOCAL:現在地区 = CFLAG:LOCAL:開始地区
	;二日酔いの体調ペナルティ（酔い.ERB。上の回復処理より後に置くこと）
	CALL 二日酔い_朝(LOCAL)
	;昨夜の醜態を思い出す（酔い.ERB。二日酔いとは独立＝軽く飲んだ日でも発生する）
	CALL 醜態_翌朝(LOCAL)
	;CALL SLEEP_CHECK(LOCAL)
NEXT
;外泊判定は就寝位置がセンチネル（位置0は不存在。地区0は正当な値のため判定に使えない）
IF FLAG:就寝位置
	CFLAG:1:現在地区 = FLAG:就寝地区
	CFLAG:1:現在位置 = FLAG:就寝位置
ENDIF
FLAG:就寝地区 = 0
FLAG:就寝位置 = 0

CALL SLEEP_CHECK
TARGET = 0

;泥酔してお持ち帰りされた翌朝の発覚（EVENT_酔い持ち帰り.ERB）
CALL 酔い持ち帰り_翌朝

;流産で搬送された翌朝、病院で目覚める
IF FLAG:流産後入院
	PRINTL ――目を覚ますと、消毒液の匂いのする白い部屋の中だった。
	PRINTL 倒れていたあなたは通りがかりの人に救急車を呼ばれ、病院へ運ばれたらしい。
	PRINTW 医師によれば流産の処置は終わり、幸い母体に大事はないとのことだった。
	FLAG:流産後入院 = 0
ENDIF

;警察の後始末（警察署.ERB）。容疑の減衰と拘留日数の消化。
;上のFORループが全員を開始位置へ戻した後で呼ぶこと＝拘留中の者を署へ置き直すため
CALL 警察_日次

;逮捕された翌朝、留置場で目覚める（流産後入院と同型。位置はFLAG:就寝位置で復元済み）
IF FLAG:留置中
	PRINTL ――目を覚ますと、そこは畳敷きの狭い部屋だった。
	PRINTL 廊下の向こうから、朝の点呼らしい声が聞こえてくる。
	PRINTW 手続きが済むまで、あなたはただ座って待つほかなかった。
	FLAG:留置中 = 0
ENDIF

NEXTCOM = 990
