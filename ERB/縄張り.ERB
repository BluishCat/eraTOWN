;=================================================
; 縄張り（場所ごとの顔役）の判定（2026-09-01追加）
; ・判定基準は SHIHAI_SYUUKEI.ERB の月次集計と同じ＝支配度 × 評判 / 1000 の最大値。
;   INFO.ERBの現在地表示は素の支配度で最大を取っており月末の発表と食い違っていたため、
;   判定をこの関数に一本化する。
; ・プレイヤーに見せる文言では「支配」ではなく「縄張り」「顔役」と呼ぶ。
; ・支配度TBは移動・会話・バイト・部活など、ほぼ全てのコマンドが現在地に加算している。
;=================================================

;-------------------------------------------------
; 支配度の換算値（支配度 × 評判 / 1000）。SHIHAI_SYUUKEIと同じ式
; ARG=地区 / ARG:1=位置 / ARG:2=キャラ
;-------------------------------------------------
@支配換算(ARG, ARG:1, ARG:2)
#FUNCTION
RETURNF TB:ARG:(ARG:1):(ARG:2) * BASE:(ARG:2):評判 / 1000

;-------------------------------------------------
; その場所の顔役。0=まだ誰のものでもない
; ARG=地区 / ARG:1=位置
;-------------------------------------------------
@場所支配者(ARG, ARG:1)
#FUNCTION
#DIM 人
#DIM 主
#DIM 最高
主 = 0
最高 = 0
FOR 人,1,CHARANUM
	SIF TB:ARG:(ARG:1):人 <= 0
		CONTINUE
	SIF 支配換算(ARG, ARG:1, 人) <= 最高
		CONTINUE
	最高 = 支配換算(ARG, ARG:1, 人)
	主 = 人
NEXT
RETURNF 主

;-------------------------------------------------
; 自分が顔役になるまで必要な支配度。0=すでに自分が顔役 / -1=評判が無く取れない
; ARG=地区 / ARG:1=位置
;-------------------------------------------------
@縄張り差(ARG, ARG:1)
#FUNCTION
#DIM 主
#DIM 必要
主 = 場所支配者(ARG, ARG:1)
SIF 主 == MASTER
	RETURNF 0
;評判が0だと何点稼いでも換算値が0のままなので取れない
SIF BASE:MASTER:評判 <= 0
	RETURNF -1
;相手の換算値を自分の評判で割り戻す＝必要な支配度
必要 = 支配換算(ARG, ARG:1, 主) * 1000 / BASE:MASTER:評判 + 1 - TB:ARG:(ARG:1):MASTER
SIF 必要 < 1
	必要 = 1
RETURNF 必要

;-------------------------------------------------
; 縄張りの対象になる場所の総数（賃貸の号室は数えない）
;-------------------------------------------------
@全エリア数()
#FUNCTION
#DIM 地区
#DIM 位置
#DIM 数
数 = 0
FOR 地区,0,MAX_MAP()
	FOR 位置,1,MAX_ROOM() + 1
		SIF PLACE_NAME(地区, 位置) == "" || 所属物件(地区, 位置)
			CONTINUE
		数 ++
	NEXT
NEXT
RETURNF 数

;-------------------------------------------------
; 自分が顔役になっている場所の数
; 全場所×全キャラの走査になるので1日1回だけ計算して持つ
; （FLAG:縄張り集計日 / FLAG:縄張り数 / FLAG:全エリア数）
;-------------------------------------------------
@自分の縄張り数()
#FUNCTION
#DIM 地区
#DIM 位置
#DIM 数
SIF FLAG:縄張り集計日 == DAY && DAY > 0
	RETURNF FLAG:縄張り数
数 = 0
FOR 地区,0,MAX_MAP()
	FOR 位置,1,MAX_ROOM() + 1
		SIF PLACE_NAME(地区, 位置) == "" || 所属物件(地区, 位置)
			CONTINUE
		SIF 場所支配者(地区, 位置) == MASTER
			数 ++
	NEXT
NEXT
FLAG:縄張り集計日 = DAY
FLAG:縄張り数 = 数
FLAG:全エリア数 = 全エリア数()
RETURNF 数

;-------------------------------------------------
; 現在地の支配度を増減し、プレイヤーには節目だけ知らせる
; ARG=キャラ / ARG:1=増減値
; 全ての行動で出すと画面がログで埋まるので、表示は
; 「顔役になった瞬間」と「あと少しで取れるとき（残り20以下）」だけに絞る。
;-------------------------------------------------
@支配度加算(ARG, ARG:1)
#DIM 前の主
#DIM 残り
SIF !ARG:1
	RETURN 0
;NPCの分と減少分は黙って加算するだけ（表示用の判定も省いて軽くする）
IF ARG != MASTER || ARG:1 < 0
	TB:(CFLAG:ARG:現在地区):(CFLAG:ARG:現在位置):ARG += ARG:1
	RETURN 0
ENDIF
前の主 = 場所支配者(CFLAG:ARG:現在地区, CFLAG:ARG:現在位置)
TB:(CFLAG:ARG:現在地区):(CFLAG:ARG:現在位置):ARG += ARG:1
;顔役が自分に変わった瞬間だけ手を止めて知らせる
IF 前の主 != MASTER && 場所支配者(CFLAG:ARG:現在地区, CFLAG:ARG:現在位置) == MASTER
	SETCOLOR 0xFFCC00
	PRINTFORMW %場所表示名(CFLAG:ARG:現在地区, CFLAG:ARG:現在位置)%の顔役になった！
	RESETCOLOR
	RETURN 1
ENDIF
;あと少しで取れるときだけ残りを知らせる（それ以外は無言）
残り = 縄張り差(CFLAG:ARG:現在地区, CFLAG:ARG:現在位置)
SIF 残り <= 0 || 残り > 20
	RETURN 0
PRINTFORML 　（顔役まであと{残り}）
RETURN 1
