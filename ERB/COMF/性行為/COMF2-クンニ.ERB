@XCOM_ABLE2(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !TCVAR:LOCAL:行為対象
	RETURN 0
;対象者が女性器がないと不可
SIF !GETBIT(TALENT:(TCVAR:LOCAL:行為対象):2,0)
	RETURN 0
SIF TEQUIP:(TCVAR:LOCAL:行為対象):下半身下着 == 373
	RETURN 0
;ボールギャグ装着時は不可
SIF TEQUIP:LOCAL:ボールギャグ
	RETURN 0

;キス中は口を使えない
SIF TCVAR:LOCAL:キス中
	RETURN 0

;生身結合中（自分または相手）は口が股間に届かず不可
SIF TCVAR:LOCAL:挿入 || TCVAR:LOCAL:被挿入 || TCVAR:(TCVAR:LOCAL:行為対象):挿入
	RETURN 0

RETURN GLOBAL_COMABLE(2)

;-------------------------------------------------
;クンニ
;-------------------------------------------------
@XCOM2(ARG)
VARSET LOCAL
PRINTL 
PRINTFORML %"=" * 107%
PRINTFORML クンニ(%CALLNAME:ARG%)
SIF ARG == MASTER || TCVAR:ARG:行為対象 == MASTER
	CALL 汎用口上(2, TCVAR:ARG:行為対象, ARG)

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:(TCVAR:ARG:行為対象):体力 += 5
DOWNBASE:(TCVAR:ARG:行為対象):気力 += 50

SOURCE:ARG:性行動 = 30
SOURCE:(TCVAR:ARG:行為対象):快Ｃ = 100
SOURCE:(TCVAR:ARG:行為対象):液体 = 60
SOURCE:(TCVAR:ARG:行為対象):露出 = 10
SOURCE:(TCVAR:ARG:行為対象):逸脱 = 15
SOURCE:(TCVAR:ARG:行為対象):反感 = 15

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:(TCVAR:ARG:行為対象):自己愛 < 0 || TALENT:(TCVAR:ARG:行為対象):抵抗
	SOURCE:(TCVAR:ARG:行為対象):鬱屈 += 20

;舌を使う調教では、調教者の舌使いによって、快感のソース増加
SIF TALENT:ARG:舌使い
	TIMES SOURCE:(TCVAR:ARG:行為対象):快Ｃ , 1.50


;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＶ⇔調教者の口の汚れが移動
STAIN:(TCVAR:ARG:行為対象):3 |= STAIN:ARG:0
STAIN:ARG:0 |= STAIN:(TCVAR:ARG:行為対象):3

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL HETEROSEX_EXP(ARG,TCVAR:ARG:行為対象,3)


;口淫経験
EXP:ARG:口淫経験 ++
CFLAG:ARG:待機時間 += 2

VARSET ARG
RETURN 1

