;アナルバイブ
@XCOM_ABLE45(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !TCVAR:LOCAL:行為対象
	RETURN 0
SIF !EQUIP:LOCAL:アナルバイブ
	RETURN 0
;NPCは道具を常時携帯しない → 低確率でのみ使用
SIF LOCAL != MASTER && RAND(100) >= 15
	RETURN 0
;道具男性器抵抗時は取り敢えずスルー
SIF TEQUIP:(TCVAR:LOCAL:行為対象):アナル == 79
	RETURN 0
;道具抵抗時は取り敢えずスルー
SIF TEQUIP:(TCVAR:LOCAL:行為対象):アナル == 77
	RETURN 0
;道具のみ抵抗時CFLAGは取り敢えずスルー
SIF CFLAG:(TCVAR:LOCAL:行為対象):ＡオンリーＰ == 1
	RETURN 0
;行為者が縄装着時は不可
SIF TEQUIP:LOCAL:縄
	RETURN 0

;アナルに生身挿入中／既に器具挿入中なら不可
SIF TCVAR:LOCAL:挿入 == 2
	RETURN 0
SIF TEQUIP:(TCVAR:LOCAL:行為対象):アナル >= 60 && TEQUIP:(TCVAR:LOCAL:行為対象):アナル <= 62
	RETURN 0

RETURN GLOBAL_COMABLE(45)

;-------------------------------------------------
;アナルバイブ
;-------------------------------------------------
@XCOM45(ARG)
VARSET LOCAL
PRINTL 
PRINTFORML %"=" * 107%
PRINTFORML アナルバイブ(%CALLNAME:ARG%)
SIF ARG == MASTER || TCVAR:ARG:行為対象 == MASTER
	CALL 汎用口上(4, TCVAR:ARG:行為対象, ARG)

;男性器のみ抵抗時はCFLAG立て
IF TEQUIP:(TCVAR:ARG:行為対象):アナル == 78
	CFLAG:(TCVAR:ARG:行為対象):ＡオンリーＴ = 1
ENDIF

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF TEQUIP:(TCVAR:ARG:行為対象):アナル != 60 && TEQUIP:(TCVAR:ARG:行為対象):アナル != 61 && TEQUIP:(TCVAR:ARG:行為対象):アナル != 62
	DOWNBASE:(TCVAR:ARG:行為対象):体力 += 60
	DOWNBASE:(TCVAR:ARG:行為対象):気力 += 150
	
	SOURCE:(TCVAR:ARG:行為対象):快Ａ = 250
	SOURCE:(TCVAR:ARG:行為対象):苦痛 = 250
	SOURCE:(TCVAR:ARG:行為対象):露出 = 50
	SOURCE:(TCVAR:ARG:行為対象):屈従 = 50
	SOURCE:(TCVAR:ARG:行為対象):逸脱 = 50
	SOURCE:(TCVAR:ARG:行為対象):反感 = 200
ELSE
	DOWNBASE:(TCVAR:ARG:行為対象):体力 += 30
	DOWNBASE:(TCVAR:ARG:行為対象):気力 += 40
	
	SOURCE:(TCVAR:ARG:行為対象):快Ａ = 40
	SOURCE:(TCVAR:ARG:行為対象):苦痛 = 40
	SOURCE:(TCVAR:ARG:行為対象):露出 = 20
	SOURCE:(TCVAR:ARG:行為対象):屈従 = 10
	SOURCE:(TCVAR:ARG:行為対象):逸脱 = 10
	SOURCE:(TCVAR:ARG:行為対象):反感 = 50
ENDIF

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
IF TEQUIP:(TCVAR:ARG:行為対象):アナル != 60 && TEQUIP:(TCVAR:ARG:行為対象):アナル != 61 && TEQUIP:(TCVAR:ARG:行為対象):アナル != 62
	SIF TALENT:(TCVAR:ARG:行為対象):自己愛 < 0 || TALENT:(TCVAR:ARG:行為対象):抵抗
		SOURCE:(TCVAR:ARG:行為対象):鬱屈 += 70

	;Aへの苦痛は先に処理しておく
	CALL PAIN_CHECK_A(TCVAR:ARG:行為対象)
ENDIF
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
STAIN:(TCVAR:ARG:行為対象):7 |= STAIN:(TCVAR:ARG:行為対象):4
STAIN:(TCVAR:ARG:行為対象):4 |= STAIN:(TCVAR:ARG:行為対象):7
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;Ａ経験
;EXP:(TCVAR:ARG:行為対象):Ａ経験 ++

CALL HETEROSEX_EXP(ARG,TCVAR:ARG:行為対象,1)
CFLAG:ARG:待機時間 += 2
IF TEQUIP:(TCVAR:ARG:行為対象):アナル == 60 || TEQUIP:(TCVAR:ARG:行為対象):アナル == 61 || TEQUIP:(TCVAR:ARG:行為対象):アナル == 62
	TEQUIP:(TCVAR:ARG:行為対象):アナル = 0
ELSE
	TEQUIP:(TCVAR:ARG:行為対象):アナル = 60
ENDIF
EXP:ARG:道具使用経験 ++
VARSET ARG
RETURN 1
