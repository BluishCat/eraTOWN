;================================================
; 奥を突く（子宮口・膣結合中のみ）
;  膣で生身結合しているときだけ選べる、最奥を狙う抽送。
;  快Ｖが大きく、わずかに苦痛も伴う。
;================================================
@XCOM_ABLE17(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !TCVAR:LOCAL:行為対象
	RETURN 0
;膣で生身結合中のみ（攻め＝膣挿入 / 受け＝膣被挿入）
SIF TCVAR:LOCAL:挿入 != 1 && 生身被挿入部位(LOCAL) != 1
	RETURN 0
RETURN GLOBAL_COMABLE(17)

;-------------------------------------------------
;奥を突く
;-------------------------------------------------
@XCOM17(ARG)
#DIM 相手
#DIM 攻
VARSET LOCAL
相手 = TCVAR:ARG:行為対象
攻 = TCVAR:ARG:挿入 == 1
PRINTL
PRINTFORML %"=" * 107%
PRINTFORML 奥を突く(%CALLNAME:ARG%)
IF ARG == MASTER || 相手 == MASTER
	IF 攻
		PRINTFORML %CALLNAME:ARG%は%CALLNAME:相手%の最奥、子宮口をこじ開けるように深く突き上げた。
	ELSE
		PRINTFORML %CALLNAME:ARG%は自ら深く腰を沈め、最奥で先端を受け止めた。
	ENDIF
	CALL 汎用口上(3, 相手, ARG)
ENDIF
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
IF 攻
	;ARGが攻め：相手(受け)の膣奥に強い快感＋苦痛
	DOWNBASE:ARG:体力 += 25
	DOWNBASE:ARG:気力 += 40
	SOURCE:ARG:性行動 = 70
	SOURCE:ARG:快Ｃ = 180
	SOURCE:ARG:欲情 = 40
	SOURCE:相手:快Ｖ = 400
	SOURCE:相手:苦痛 = 100
	SOURCE:相手:欲情 = 50
	SOURCE:相手:性行動 = 30
	;受け(相手)が抑圧・抵抗持ちなら抑鬱ソース
	SIF TALENT:相手:自己愛 < 0 || TALENT:相手:抵抗
		SOURCE:相手:鬱屈 += 30
ELSE
	;ARGが受け：ARG自身の膣奥に強い快感＋苦痛
	DOWNBASE:ARG:体力 += 20
	DOWNBASE:ARG:気力 += 40
	SOURCE:ARG:性行動 = 40
	SOURCE:ARG:快Ｖ = 400
	SOURCE:ARG:苦痛 = 100
	SOURCE:ARG:欲情 = 50
	SOURCE:相手:快Ｃ = 150
	SOURCE:相手:性行動 = 30
	;受け(ARG)が抑圧・抵抗持ちなら抑鬱ソース
	SIF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
		SOURCE:ARG:鬱屈 += 30
ENDIF
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL HETEROSEX_EXP(ARG, 相手, 3)
CFLAG:ARG:待機時間 += 3
VARSET ARG
RETURN 1
