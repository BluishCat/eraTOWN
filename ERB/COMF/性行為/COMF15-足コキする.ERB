;足コキする
@XCOM_ABLE15(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !TCVAR:LOCAL:行為対象
	RETURN 0
;対象者が男性器のみ
SIF !GETBIT(TALENT:(TCVAR:LOCAL:行為対象):2,1)
	RETURN 0
;対象者が貞操帯装着時は不可
SIF TEQUIP:(TCVAR:LOCAL:行為対象):下半身下着 == 373
	RETURN 0
;行為者が縄装着時は不可
SIF TEQUIP:LOCAL:縄
	RETURN 0

SIF !CAN_COM15(LOCAL,TCVAR:LOCAL:行為対象)
	RETURN 0

;生身挿入中は口/胸/足での奉仕は不自然
SIF TCVAR:LOCAL:挿入 || TCVAR:LOCAL:被挿入 || TCVAR:(TCVAR:LOCAL:行為対象):挿入
	RETURN 0

RETURN GLOBAL_COMABLE(15)

;-------------------------------------------------
;足コキする
;-------------------------------------------------
@XCOM15(ARG)
VARSET LOCAL
PRINTL 
PRINTFORML %"=" * 107%
PRINTFORML 足コキする(%CALLNAME:ARG%)
SIF ARG == MASTER || TCVAR:ARG:行為対象 == MASTER
	CALL 汎用口上(2, TCVAR:ARG:行為対象, ARG)
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:ARG:体力 += 10
DOWNBASE:ARG:気力 += 50
DOWNBASE:(TCVAR:ARG:行為対象):体力 += 10
DOWNBASE:(TCVAR:ARG:行為対象):気力 += 50

SOURCE:ARG:屈従 = 5
SOURCE:ARG:逸脱 = 1
SOURCE:ARG:不潔 = 1

;ABL:奉仕精神をみる（性行動、達成、不潔）
IF ABL:ARG:13 == 0
	SOURCE:ARG:性行動 = 3
	SOURCE:ARG:達成   = 0
	TIMES SOURCE:ARG:30 , 4.00
ELSEIF ABL:ARG:13 == 1
	SOURCE:ARG:性行動 = 3
	SOURCE:ARG:達成   = 1
	TIMES SOURCE:ARG:30 , 2.50
ELSEIF ABL:ARG:13 == 2
	SOURCE:ARG:性行動 = 4
	SOURCE:ARG:達成   = 1
	TIMES SOURCE:ARG:30 , 1.50
ELSEIF ABL:ARG:13 == 3
	SOURCE:ARG:性行動 = 4
	SOURCE:ARG:達成   = 2
	TIMES SOURCE:ARG:30 , 1.00
ELSEIF ABL:ARG:13 == 4
	SOURCE:ARG:性行動 = 5
	SOURCE:ARG:達成   = 2
	TIMES SOURCE:ARG:30 , 0.50
ELSE
	SOURCE:ARG:性行動 = 5
	SOURCE:ARG:達成   = 3
	TIMES SOURCE:ARG:30 , 0.10
ENDIF

;ABL:技巧をみる（性行動、達成）
IF ABL:ARG:12 == 0
	TIMES SOURCE:ARG:11 , 0.50
	TIMES SOURCE:ARG:12 , 0.50
ELSEIF ABL:ARG:12 == 1
	TIMES SOURCE:ARG:11 , 0.80
	TIMES SOURCE:ARG:12 , 0.80
ELSEIF ABL:ARG:12 == 2
	TIMES SOURCE:ARG:11 , 1.00
	TIMES SOURCE:ARG:12 , 1.00
ELSEIF ABL:ARG:12 == 3
	TIMES SOURCE:ARG:11 , 1.20
	TIMES SOURCE:ARG:12 , 1.20
ELSEIF ABL:ARG:12 == 4
	TIMES SOURCE:ARG:11 , 1.50
	TIMES SOURCE:ARG:12 , 1.50
ELSE
	TIMES SOURCE:ARG:11 , 2.00
	TIMES SOURCE:ARG:12 , 2.00
ENDIF

;ABL:サドっ気をみる（性行動、達成）
IF ABL:ARG:16 == 0
	TIMES SOURCE:ARG:11 , 1.00
	TIMES SOURCE:ARG:12 , 1.00
ELSEIF ABL:ARG:16 == 1
	TIMES SOURCE:ARG:11 , 1.20
	TIMES SOURCE:ARG:12 , 1.20
ELSEIF ABL:ARG:16 == 2
	TIMES SOURCE:ARG:11 , 1.40
	TIMES SOURCE:ARG:12 , 1.40
ELSEIF ABL:ARG:16 == 3
	TIMES SOURCE:ARG:11 , 1.60
	TIMES SOURCE:ARG:12 , 1.60
ELSEIF ABL:ARG:16 == 4
	TIMES SOURCE:ARG:11 , 1.80
	TIMES SOURCE:ARG:12 , 1.80
ELSE
	TIMES SOURCE:ARG:11 , 2.00
	TIMES SOURCE:ARG:12 , 2.00
ENDIF

;TALENT:サドの場合は２倍（性行動、達成）
IF TALENT:ARG:82
	TIMES SOURCE:ARG:11 , 2.00
	TIMES SOURCE:ARG:12 , 2.00
ENDIF

;-------------------------------------------------
;相手の快感上昇
;-------------------------------------------------

;ABL:Ｃ感覚をみる
IF ABL:(TCVAR:ARG:行為対象):0 == 0
	SOURCE:(TCVAR:ARG:行為対象):快Ｃ = 20
ELSEIF ABL:(TCVAR:ARG:行為対象):0 == 1
	SOURCE:(TCVAR:ARG:行為対象):快Ｃ = 22
ELSEIF ABL:(TCVAR:ARG:行為対象):0 == 2
	SOURCE:(TCVAR:ARG:行為対象):快Ｃ = 25
ELSEIF ABL:(TCVAR:ARG:行為対象):0 == 3
	SOURCE:(TCVAR:ARG:行為対象):快Ｃ = 28
ELSEIF ABL:(TCVAR:ARG:行為対象):0 == 4
	SOURCE:(TCVAR:ARG:行為対象):快Ｃ = 33
ELSE
	SOURCE:(TCVAR:ARG:行為対象):快Ｃ = 38
ENDIF

;ABL:マゾっ気をみる（快Ｃ）
IF ABL:(TCVAR:ARG:行為対象):15 == 0
	TIMES SOURCE:(TCVAR:ARG:行為対象):0 , 1.00
ELSEIF ABL:(TCVAR:ARG:行為対象):15 == 1
	TIMES SOURCE:(TCVAR:ARG:行為対象):0 , 1.20
ELSEIF ABL:(TCVAR:ARG:行為対象):15 == 2
	TIMES SOURCE:(TCVAR:ARG:行為対象):0 , 1.40
ELSEIF ABL:(TCVAR:ARG:行為対象):15 == 3
	TIMES SOURCE:(TCVAR:ARG:行為対象):0 , 1.60
ELSEIF ABL:(TCVAR:ARG:行為対象):15 == 4
	TIMES SOURCE:(TCVAR:ARG:行為対象):0 , 1.80
ELSE
	TIMES SOURCE:(TCVAR:ARG:行為対象):0 , 2.00
ENDIF

;TALENT:マゾの場合は２倍（快Ｃ）
IF TALENT:(TCVAR:ARG:行為対象):83
	TIMES SOURCE:(TCVAR:ARG:行為対象):0 , 2.00
ENDIF

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
	SOURCE:ARG:鬱屈 += 20


;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＰ⇔調教者の手の汚れが移動
STAIN:(TCVAR:ARG:行為対象):2 |= STAIN:ARG:1
STAIN:ARG:1 |= STAIN:(TCVAR:ARG:行為対象):2

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL HETEROSEX_EXP(ARG,TCVAR:ARG:行為対象,2)




;嗜虐快楽経験
;サド又は欲望又はサドっ気
IF TALENT:ARG:82 == 1 || (ABL:ARG:11 >= 3 && ABL:ARG:16 >= 3)
	EXP:ARG:嗜虐快楽経験 += 3
ELSEIF ABL:ARG:11 >= 3 && ABL:ARG:16 >= 1
	EXP:ARG:嗜虐快楽経験 += 2
ELSE
	EXP:ARG:嗜虐快楽経験 += 1
ENDIF
CFLAG:ARG:待機時間 += 2

VARSET ARG
RETURN 1


