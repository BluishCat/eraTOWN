;;;	STAIN:(TCVAR:ARG:行為対象):2 = 2
;;;	STAIN:(TCVAR:ARG:行為対象):3 = 1
;;;	STAIN:(TCVAR:ARG:行為対象):4 = 8
;;;	PALAM:(TCVAR:ARG:行為対象):4 /= 2
;;;ENDIF
;;;[SKIPEND]
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;ビデオ撮影時は経験にプラス
;IF TEQUIP:(TCVAR:ARG:行為対象):ビデオ撮影
;	EXP:(TCVAR:ARG:行為対象):自慰経験 += 2
;	EXP:(TCVAR:ARG:行為対象):調教自慰経験 += 2
;ELSE
	EXP:(TCVAR:ARG:行為対象):自慰経験 += 1
	EXP:(TCVAR:ARG:行為対象):調教自慰経験 += 1
;ENDIF
;公開オナニー時は異常経験付加
;IF TEQUIP:(TCVAR:ARG:行為対象):ビデオ撮影 && !GETBIT(CFLAG:3,0)
;	EXP:(TCVAR:ARG:行為対象):異常経験 ++
;	SETBIT CFLAG:3,0
;ENDIF
CALL HETEROSEX_EXP(ARG,TCVAR:ARG:行為対象,4)

CFLAG:ARG:待機時間 += 2

VARSET ARG

RETURN 1


@CAN_COM10(ARG,ARG:1)
#FUNCTION
;;;VARSET LOCAL
;-------------------------------------------------
;実行できるかの判定
;-------------------------------------------------
;すべての命令に共通の要素を考慮
;(従順が高いと命令に従いやすいなど)
A = 0
A = COM_ORDER(ARG,ARG:1)
;ABL:欲望
IF ABL:(ARG:1):欲望
	A += ABL:(ARG:1):欲望 * 3
ENDIF
;ABL:露出癖
IF ABL:(ARG:1):露出癖
	A += ABL:(ARG:1):露出癖 * 4
ENDIF
;ABL:自慰中毒
IF ABL:(ARG:1):自慰中毒
	A += ABL:(ARG:1):自慰中毒 * 3
ENDIF
IF MARK:(ARG:1):快楽刻印
	A += MARK:(ARG:1):快楽刻印 * 3
ENDIF
;自制心
IF TALENT:(ARG:1):自制心
	A -= 5
ENDIF
;恥じらい
IF TALENT:(ARG:1):羞恥心 > 0
	A -= 5
ENDIF
;恥薄い
IF TALENT:(ARG:1):羞恥心 < 0
	A += 2
ENDIF
;自慰しやすい
IF TALENT:(ARG:1):自慰しやすい
	A += 5
ENDIF
;快感に素直
IF TALENT:(ARG:1):快感応答 > 0
	A += 5
ENDIF
;快感の否定（淫乱、娼婦で無効）
IF TALENT:(ARG:1):快感応答 < 0 && !TALENT:(ARG:1):淫乱
	A -= 5
ENDIF
;媚薬
IF TEQUIP:(ARG:1):媚薬
	A += 8
ENDIF
[SKIPSTART]
;難易度上昇
;公開で10、バイブで5、アナルバイブで5、シャワーで3
;;;SIF TEQUIP:(ARG:1):ビデオ撮影
;;;	A -= 10
;;;SIF TEQUIP:(ARG:1):シャワー
;;;	A -= 3
SIF TEQUIP:(ARG:1):膣 == 1
	A -= 5
SIF TEQUIP:(ARG:1):アナル == (60 | 61 | 62)
	A -= 5
[SKIPEND]
;実行できない
SIF A < 33
	RETURNF 0
RETURNF 1
