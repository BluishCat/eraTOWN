;================================================
; ディープキス（キス中のみ）
;  既にキスしているときだけ選べる、舌を絡める濃厚なキス。
;  情愛・快Ｂが大きく、舌使いで補正される。
;================================================
@XCOM_ABLE21(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !TCVAR:LOCAL:行為対象
	RETURN 0
;キス中のときのみ
SIF !口キス中(LOCAL)
	RETURN 0
;ボールギャグ装着時は不可
SIF TEQUIP:LOCAL:ボールギャグ
	RETURN 0
RETURN GLOBAL_COMABLE(21)

;-------------------------------------------------
;ディープキス
;-------------------------------------------------
@XCOM21(ARG)
#DIM 相手
VARSET LOCAL
相手 = TCVAR:ARG:行為対象
PRINTL
PRINTFORML %"=" * 107%
PRINTFORML ディープキス(%CALLNAME:ARG%)
IF ARG == MASTER || 相手 == MASTER
	PRINTFORML %CALLNAME:ARG%は%CALLNAME:相手%の唇をこじ開け、舌を絡ませて深く貪り合った。
	CALL 汎用口上(2, 相手, ARG)
ENDIF
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
DOWNBASE:相手:体力 += 0
DOWNBASE:相手:気力 += 30
SOURCE:ARG:性行動 = 20
SOURCE:相手:情愛 = 100
SOURCE:相手:快Ｂ = 60
SOURCE:相手:性行動 = 20
SOURCE:相手:屈従 = 20
SOURCE:相手:逸脱 = 20
SOURCE:相手:反感 = 10
SOURCE:相手:不潔 = STATIN_POINT(ARG,0) * (2 - TALENT:相手:汚臭耐性) * 5 + 10
;抑圧・抵抗持ちには抑鬱ソース
SIF TALENT:相手:自己愛 < 0 || TALENT:相手:抵抗
	SOURCE:相手:鬱屈 += 20
;舌使いによる快感補正
SIF TALENT:ARG:舌使い
	TIMES SOURCE:相手:情愛 , 1.50
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷の口⇔調教者の口の汚れが移動
STAIN:相手:0 |= STAIN:ARG:0
STAIN:ARG:0 |= STAIN:相手:0
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL HETEROSEX_EXP(ARG, 相手, 3)
EXP:相手:キス経験 ++
EXP:ARG:キス経験 ++
CFLAG:ARG:待機時間 += 2
VARSET ARG
RETURN 1
