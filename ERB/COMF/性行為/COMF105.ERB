@XCOM_ABLE105(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !TCVAR:LOCAL:行為対象
	RETURN 0
;挿入器具と衝突する体位は不可
SIF 体位器具衝突(105, LOCAL, TCVAR:LOCAL:行為対象)
	RETURN 0
SIF !GETBIT(TALENT:(TCVAR:LOCAL:行為対象):2,1)
	RETURN 0
SIF !GETBIT(TALENT:LOCAL:2,0)
	RETURN 0
SIF J:115
	RETURN 1
SIF !CAN_COM105(TCVAR:LOCAL:行為対象,LOCAL)
	RETURN 0
SIF TEQUIP:LOCAL:下半身下着 == 373
	RETURN 0
SIF TEQUIP:(TCVAR:LOCAL:行為対象):下半身下着 == 373
	RETURN 0
;道具男性器抵抗時は取り敢えずスルー
SIF TEQUIP:LOCAL:膣 == 19
	RETURN 0
;男性器抵抗時は取り敢えずスルー
SIF TEQUIP:LOCAL:膣 == 18
	RETURN 0
;男性器のみ抵抗時CFLAGは取り敢えずスルー
SIF CFLAG:LOCAL:ＶオンリーＴ == 1
	RETURN 0
;対象者が男性器でオナホール装着時は不可
SIF (GETBIT(TALENT:(TCVAR:LOCAL:行為対象):2,1)) && (TEQUIP:(TCVAR:LOCAL:行為対象):クリトリス == 80)
	RETURN 0
;行為者＆対象者が縄装着時は不可（３Ｐを考え付けておく）
SIF (TEQUIP:LOCAL:縄) && (TEQUIP:(TCVAR:LOCAL:行為対象):縄)
	RETURN 0
;対象者が男性器なし
SIF !GETBIT(TALENT:(TCVAR:LOCAL:行為対象):2,1)
	RETURN 0

RETURN GLOBAL_COMABLE(105)
;-------------------------------------------------
;騎乗位させる
;-------------------------------------------------
@XCOM105(ARG)
VARSET LOCAL
PRINTL 
PRINTFORML %"=" * 107%
PRINTFORML 騎乗位させる(%CALLNAME:ARG%)
SIF ARG == MASTER || TCVAR:ARG:行為対象 == MASTER
	CALL 汎用口上(3, TCVAR:ARG:行為対象, ARG)

;道具のみ抵抗時はCFLAG立て
IF TEQUIP:ARG:膣 == 17
	CFLAG:ARG:ＶオンリーＰ = 1
ENDIF

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:ARG:体力 += 150
DOWNBASE:ARG:気力 += 60
DOWNBASE:(TCVAR:ARG:行為対象):体力 += 30
DOWNBASE:(TCVAR:ARG:行為対象):気力 += 80

SOURCE:(TCVAR:ARG:行為対象):性行動 = 120
SOURCE:(TCVAR:ARG:行為対象):快Ｃ = 400

SOURCE:ARG:快Ｖ = 500
SOURCE:ARG:情愛 = 250
SOURCE:ARG:性行動 = 250
SOURCE:ARG:達成 = 250
SOURCE:ARG:苦痛 = 500
SOURCE:ARG:露出 = 120
SOURCE:ARG:逸脱 = 600

SOURCE:(TCVAR:ARG:行為対象):反感 = 800

SOURCE:(TCVAR:ARG:行為対象):不潔 = STATIN_POINT(ARG,1) * (2 - TALENT:(TCVAR:ARG:行為対象):汚臭耐性) * 5 + 60

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
	SOURCE:ARG:鬱屈 += 800

;貞操観念持ちで恋慕、親愛持ち以外には常に反発のソースを追加する（セックス系のみ）
SIF TALENT:ARG:貞操 > 0 && !LOVE_CHECK(TCVAR:ARG:行為対象,ARG)
	SOURCE:ARG:反感 += 1000

;処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:ARG:処女 == 1
	SOURCE:ARG:苦痛 += 2000
	SOURCE:ARG:反感 += 3000
ENDIF

;再生処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:ARG:処女 == 2
	SOURCE:ARG:苦痛 += 500
	SOURCE:ARG:反感 += 1000
ENDIF

;Vへの苦痛は先に処理しておく
CALL PAIN_CHECK_V(ARG)

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;膣内に破瓜の血の汚れを付加
SIF TALENT:ARG:処女
	STAIN:ARG:6 |= 64
;奴隷の膣内⇔調教者のＰの汚れが移動
STAIN:(TCVAR:ARG:行為対象):2 |= STAIN:ARG:3
STAIN:(TCVAR:ARG:行為対象):2 |= STAIN:ARG:6
STAIN:ARG:3 |= STAIN:(TCVAR:ARG:行為対象):2
STAIN:ARG:6 |= STAIN:(TCVAR:ARG:行為対象):2

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;性交経験
EXP:ARG:Ｖ性交経験 ++
;騎乗位の時は相手腰使い経験無し
;;;EXP:(TCVAR:ARG:行為対象):Ｃ挿入経験 ++

;異常経験
IF TALENT:ARG:処女
	EXP:ARG:異常経験 += 2
ENDIF
SIF TALENT:ARG:処女 && !GETBIT(CFLAG:ARG:異常経験,1)
	SETBIT CFLAG:ARG:異常経験,1
TCVAR:(TCVAR:ARG:行為対象):挿入 = 1

TCVAR:ARG:被挿入 = 1

CALL HETEROSEX_EXP(TCVAR:ARG:行為対象,ARG,7)

CFLAG:ARG:待機時間 += 2

VARSET ARG
RETURN 1

@CAN_COM105(ARG,ARG:1)
#FUNCTION
;;;VARSET LOCAL
SIF TEQUIP:(ARG:1):縄 == 1
	RETURNF 0

A = 0
;すべての命令に共通の要素を考慮
;(従順が高いと命令に従いやすいなど)
A = COM_ORDER(ARG,ARG:1)

;ABL:欲望
IF ABL:(ARG:1):欲望
	A += ABL:(ARG:1):欲望 * 3
ENDIF
;ABL:Ｖ感覚
IF ABL:(ARG:1):Ｖ感覚
	A += ABL:(ARG:1):Ｖ感覚 * 2
ENDIF
;ABL:奉仕精神
IF ABL:(ARG:1):奉仕精神
	A += ABL:(ARG:1):奉仕精神 * 4
ENDIF
;快楽刻印
IF MARK:(ARG:1):快楽刻印
	A += MARK:(ARG:1):快楽刻印 * 3
ENDIF
;PALAM:潤滑（の不足）
IF PALAM:(ARG:1):潤滑 < PALAMLV:3
	A -= 5
ENDIF
;PALAM:欲情
IF GETPALAMLV(PALAM:(ARG:1):欲情,5)
	A += GETPALAMLV(PALAM:(ARG:1):欲情,5) * 3
ENDIF
;恥じらい
IF TALENT:(ARG:1):羞恥心 > 0
	A -= 2
ENDIF
;快感の否定
IF TALENT:(ARG:1):快感応答 < 0 && !LOVE_CHECK(ARG:1,ARG)
	A -= 5
ENDIF
;男嫌い（恋慕、親愛で無効）
IF TALENT:(ARG:1):性別嗜好 & 1 && !(TALENT:ARG:2 & 1) && !LOVE_CHECK(ARG:1,ARG)
	A -= 12
ENDIF


;処女
IF TALENT:(ARG:1):処女
	A -= MAX(10,40 - EXP:(ARG:1):Ｖ経験)
;V経験
ELSEIF EXP:(ARG:1):Ｖ経験 < EXPLV:2
	A -= 15
ENDIF

;調教者がふたなり
IF (TALENT:ARG:2 & 3) == 3
	A += 4
ENDIF

;媚薬
IF TEQUIP:(ARG:1):媚薬
	A += 6
ENDIF
;汚れあり
IF STATIN_POINT(ARG,2)
	A -= STATIN_POINT(ARG,2) * (2 - TALENT:(ARG:1):汚臭耐性) / 2
ENDIF

;実行できない
SIF A < 35
	RETURNF 0
RETURNF 1
