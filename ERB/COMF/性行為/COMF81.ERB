@XCOM_ABLE81(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !TCVAR:LOCAL:行為対象
	RETURN 0

SIF !GETBIT(TALENT:LOCAL:2,1)
	RETURN 0
SIF TEQUIP:LOCAL:下半身下着 == 373
	RETURN 0
;行為者がオナホール装着時は不可
SIF TEQUIP:LOCAL:クリトリス == 80
	RETURN 0
;相手がボールギャグ装着時は不可
SIF TEQUIP:(TCVAR:LOCAL:行為対象):ボールギャグ
	RETURN 0

;キス中は口を使えない
SIF TCVAR:LOCAL:キス中
	RETURN 0

;生身挿入中（自分または相手が結合中）は解かないと不可
SIF TCVAR:LOCAL:挿入 || TCVAR:LOCAL:被挿入 || TCVAR:(TCVAR:LOCAL:行為対象):挿入
	RETURN 0

RETURN GLOBAL_COMABLE(81)
;-------------------------------------------------
;フェラチオさせる
;-------------------------------------------------
@XCOM81(ARG)
VARSET LOCAL
PRINTL 
PRINTFORML %"=" * 107%
PRINTFORML フェラチオさせる(%CALLNAME:ARG%)
SIF ARG == MASTER || TCVAR:ARG:行為対象 == MASTER
	CALL 汎用口上(6, TCVAR:ARG:行為対象, ARG)
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:ARG:体力 += 10
DOWNBASE:ARG:気力 += 50
DOWNBASE:(TCVAR:ARG:行為対象):体力 += 5
DOWNBASE:(TCVAR:ARG:行為対象):気力 += 50

SOURCE:(TCVAR:ARG:行為対象):性行動 = 30
SOURCE:ARG:快Ｃ = 110
SOURCE:ARG:露出 = 20
SOURCE:ARG:逸脱 = 20

SOURCE:(TCVAR:ARG:行為対象):反感 = 20

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:(TCVAR:ARG:行為対象):自己愛 < 0 || TALENT:(TCVAR:ARG:行為対象):抵抗
	SOURCE:(TCVAR:ARG:行為対象):鬱屈 += 20

;調教者のTALENT:舌使いをみる
SIF TALENT:(TCVAR:ARG:行為対象):舌使い
	TIMES SOURCE:ARG:快Ｃ , 1.50

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＰ⇔調教者の口の汚れが移動
STAIN:ARG:2 |= STAIN:(TCVAR:ARG:行為対象):0
STAIN:(TCVAR:ARG:行為対象):0 |= STAIN:ARG:2

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL HETEROSEX_EXP(TCVAR:ARG:行為対象,ARG,3)



;口淫経験
EXP:(TCVAR:ARG:行為対象):口淫経験 ++
;フェラ経験
EXP:(TCVAR:ARG:行為対象):フェラ経験 ++
CFLAG:ARG:待機時間 += 2

VARSET ARG
RETURN 1
