@XCOM_ABLE71(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !TCVAR:LOCAL:行為対象
	RETURN 0
;挿入器具と衝突する体位は不可
SIF 体位器具衝突(71, LOCAL, TCVAR:LOCAL:行為対象)
	RETURN 0
SIF GETBIT(TALENT:LOCAL:2,1)
	RETURN 0
SIF GETBIT(TALENT:(TCVAR:LOCAL:行為対象):2,1)
	RETURN 0
SIF J:115
	RETURN 1
SIF TEQUIP:(TCVAR:LOCAL:行為対象):下半身下着 == 373
	RETURN 0
SIF TEQUIP:LOCAL:下半身下着 == 373
	RETURN 0
;行為者が縄装着時は不可
SIF TEQUIP:LOCAL:縄
	RETURN 0

;生身挿入中（自分または相手が結合中）は解かないと不可
SIF TCVAR:LOCAL:挿入 || TCVAR:LOCAL:被挿入 || TCVAR:(TCVAR:LOCAL:行為対象):挿入
	RETURN 0

RETURN GLOBAL_COMABLE(71)

;-------------------------------------------------
;貝あわせ
;-------------------------------------------------
@XCOM71(ARG)
VARSET LOCAL
PRINTL 
PRINTFORML %"=" * 107%
PRINTFORML 貝あわせ(%CALLNAME:ARG%)
SIF ARG == MASTER || TCVAR:ARG:行為対象 == MASTER
	CALL 汎用口上(3, TCVAR:ARG:行為対象, ARG)
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:(TCVAR:ARG:行為対象):体力 += 30
DOWNBASE:(TCVAR:ARG:行為対象):気力 += 90

SOURCE:ARG:性行動 = 200
SOURCE:ARG:快Ｃ = 200

SOURCE:(TCVAR:ARG:行為対象):快Ｃ = 200
SOURCE:(TCVAR:ARG:行為対象):性行動 = 200
SOURCE:(TCVAR:ARG:行為対象):達成 = 100
SOURCE:(TCVAR:ARG:行為対象):露出 = 50
SOURCE:(TCVAR:ARG:行為対象):屈従 = 400
SOURCE:(TCVAR:ARG:行為対象):逸脱 = 400
SOURCE:(TCVAR:ARG:行為対象):反感 = 400


;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:(TCVAR:ARG:行為対象):自己愛 < 0 || TALENT:(TCVAR:ARG:行為対象):抵抗
	SOURCE:(TCVAR:ARG:行為対象):鬱屈 += 400

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＶ⇔調教者のＶの汚れが移動
STAIN:(TCVAR:ARG:行為対象):3 |= STAIN:ARG:3
STAIN:ARG:3 |= STAIN:(TCVAR:ARG:行為対象):3

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL HETEROSEX_EXP(ARG,TCVAR:ARG:行為対象,8)
CFLAG:ARG:待機時間 += 2

VARSET ARG
RETURN 1

