@XCOM_ABLE1001(ARG)
;学生専用の宣言は中央テーブル（COM_PROFILE.ERB @COM_JOB_MASK）へ移管済み
;講義室(2)に加えて大講義室(9)でも受けられる(2026-09-01)。
;それまで大講義室は名前だけの場所だった。教室ごとの差は @XCOM1001 の 学び/消耗 が持つ
SIF !(CFLAG:MASTER:現在地区 == 1 && (CFLAG:MASTER:現在位置 == 2 || CFLAG:MASTER:現在位置 == 9)) || D:101 || TIME < 360 || TIME >= 960
	RETURN 0
RETURN GLOBAL_COMABLE(1001)


@XCOM1001(ARG)
#DIM 学び
#DIM 消耗
PRINTL 
PRINTFORML %"=" * 107%
;授業を受ける
;教室ごとの差（％）。大講義室(9)は後ろの席まで声が届かず集中が切れやすい＝
;学びは薄いが、そのぶん気力もストレスも溜まりにくい。講義室(2)は従来どおり等倍。
学び = 100
消耗 = 100
IF CFLAG:MASTER:現在位置 == 9
	学び = 65
	消耗 = 70
ENDIF

IF TIME < 750
	CFLAG:MASTER:待機時間 = 750 - TIME
	IF RAND(3) != 0 || TALENT:ARG:妊娠
		TFLAG:COM用変数 = 0
		EXP:ARG:学習経験 += CFLAG:ARG:待機時間 * 4 * 学び / 100 / 60 / 5
		BASE:ARG:学力 = MIN(BASE:ARG:学力 + CFLAG:ARG:待機時間 * 学び / 100 / 6,MAXBASE:ARG:学力)
		DOWNBASE:ARG:体力 -= CFLAG:ARG:待機時間 * 20 / 60
		DOWNBASE:ARG:気力 += CFLAG:ARG:待機時間 * 40 * 消耗 / 100 / 60
		DOWNBASE:ARG:ストレス -= CFLAG:ARG:待機時間 * 40 * 消耗 / 100 / 60
		MAXBASE:ARG:気力 += CFLAG:ARG:待機時間 * 3 * 学び / 100 / 60

	ELSE
		TFLAG:COM用変数 = 1
		EXP:ARG:運動経験 += CFLAG:ARG:待機時間 * 2 / 60
		DOWNBASE:ARG:体力 += CFLAG:ARG:待機時間 * 40 / 60
		DOWNBASE:ARG:気力 -= CFLAG:ARG:待機時間 * 20 / 60
		DOWNBASE:ARG:疲労 -= CFLAG:ARG:待機時間 * 50 / 60
		MAXBASE:ARG:体力 += CFLAG:ARG:待機時間 * 3 / 60

	ENDIF
	SETBIT CFLAG:MASTER:出席,0
ELSE
	CFLAG:MASTER:待機時間 = 960 - TIME
	IF RAND(3) != 0 || TALENT:ARG:妊娠
		TFLAG:COM用変数 = 0
		EXP:ARG:学習経験 += CFLAG:ARG:待機時間 * 4 * 学び / 100 / 60 / 5
		BASE:ARG:学力 = MIN(BASE:ARG:学力 + CFLAG:ARG:待機時間 * 学び / 100 / 6,MAXBASE:ARG:学力)
		DOWNBASE:ARG:体力 -= CFLAG:ARG:待機時間 * 20 / 60
		DOWNBASE:ARG:気力 += CFLAG:ARG:待機時間 * 40 * 消耗 / 100 / 60
		DOWNBASE:ARG:ストレス -= CFLAG:ARG:待機時間 * 40 * 消耗 / 100 / 60
		MAXBASE:ARG:気力 += CFLAG:ARG:待機時間 * 3 * 学び / 100 / 60
	ELSE
		TFLAG:COM用変数 = 1
		EXP:ARG:運動経験 += CFLAG:ARG:待機時間 * 2 / 60
		DOWNBASE:ARG:体力 += CFLAG:ARG:待機時間 * 40 / 60
		DOWNBASE:ARG:気力 -= CFLAG:ARG:待機時間 * 20 / 60
		DOWNBASE:ARG:疲労 -= CFLAG:ARG:待機時間 * 50 / 60
		MAXBASE:ARG:体力 += CFLAG:ARG:待機時間 * 3 / 60

	ENDIF

	SETBIT CFLAG:MASTER:出席,1
ENDIF
J:151 = 1
M:101 = 0
RETURN 1


@COM_RESULT1001





