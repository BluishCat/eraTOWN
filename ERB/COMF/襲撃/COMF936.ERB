@XCOM_ABLE936(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF TCVAR:LOCAL:イベント != 2 || BASE:(TCVAR:LOCAL:行為対象):抵抗 == 0
	RETURN 0
RETURN 1

@XCOM936(ARG)
VARSET LOCAL
;睨みつける
PRINTL 
PRINTFORML %"=" * 107%
IF BASE:ARG:抵抗 == 0
	CFLAG:ARG:待機時間 += 2
	TFLAG:COM用変数 = -1
	RETURN 1
ENDIF

LOCAL = (MAXBASE:ARG:気力 + 2 * BASE:ARG:気力) / (60 * (1 + TCVAR:(TCVAR:ARG:行為対象):防御))
SIF GETBIT(TALENT:ARG:性別,0)
	TIMES LOCAL,1.20
LOCAL:1 = ABL:ARG:サドっ気 - ABL:(TCVAR:ARG:行為対象):サドっ気 - TALENT:(TCVAR:ARG:行為対象):度胸 * 3 - TALENT:ARG:感情乏しい * 3 - TALENT:(TCVAR:ARG:行為対象):感情乏しい * 3
LOCAL:1 += GETBIT(TALENT:ARG:性別,1) - GETBIT(TALENT:(TCVAR:ARG:行為対象):性別,1)
IF TCVAR:(TCVAR:ARG:行為対象):無抵抗
	TFLAG:COM用変数 = 3
	LOCAL *= 2
ELSE
	LOCAL = ATTACK_SUCCESS(LOCAL,LOCAL:1)
ENDIF

DOWNBASE:(TCVAR:ARG:行為対象):気力 += LOCAL
BASE:(TCVAR:ARG:行為対象):抵抗 = MAX(BASE:(TCVAR:ARG:行為対象):抵抗 - LOCAL,0)
BASE:(TCVAR:ARG:行為対象):興奮度 = MAX(BASE:(TCVAR:ARG:行為対象):興奮度 - LOCAL,0)


CFLAG:ARG:待機時間 += 2
VARSET ARG

RETURN 1
