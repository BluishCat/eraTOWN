@XCOM_ABLE1011(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG

SIF CFLAG:LOCAL:現在位置 != CFLAG:LOCAL:開始位置 || CFLAG:LOCAL:現在地区 != CFLAG:LOCAL:開始地区
	RETURN 0
RETURN GLOBAL_COMABLE(1011)
@XCOM1011(ARG)
VARSET LOCAL
PRINTL 
PRINTFORML %"=" * 107%
;お弁当を作る
DOWNBASE:ARG:体力 += 10
DOWNBASE:ARG:気力 += 50

IF RAND(10) - ABL:ARG:料理技能 * 3 < 1
	IF RAND(10) - (ABL:ARG:料理技能 - 2) * 2 < 1
	CFLAG:ARG:待機時間 += 5
	ELSE
	CFLAG:ARG:待機時間 += 10
	ENDIF
ELSE
	CFLAG:ARG:待機時間 += 15
ENDIF
SIF FLAG:お弁当 == 2
	LOCAL:2 = 2
IF RAND(10 + LOCAL:2) - ABL:ARG:料理技能 * 3 < 1
	IF RAND(10 + LOCAL:2) - (ABL:ARG:料理技能 - 2) * 2 < 1
		PRINTL 美味しそうなお弁当が出来ました
		EQUIP:ARG:美味しそうなお弁当++
		EXP:ARG:料理経験 += 3
		LOCAL:2 = 3
	ELSE
		PRINTL お弁当が出来ました
		EQUIP:ARG:普通のお弁当++
		EXP:ARG:料理経験 += 2
		LOCAL:2 = 2
	ENDIF
ELSE
	PRINTL やばそうなお弁当が出来ました･･････
	EQUIP:ARG:やばそうなお弁当++
	EXP:ARG:料理経験 += 1
	LOCAL:2 = 1
ENDIF
IF FLAG:お弁当 == 2
	FOR LOCAL,2,CHARANUM
		SIF !TCVAR:LOCAL:同室 || CFLAG:LOCAL:睡眠 || CFLAG:LOCAL:衰弱
			CONTINUE
		IF TALENT:LOCAL:家族
			TA:LOCAL:1:3 += LOCAL:2
			SIF LOCAL:1 >=1
				PRINT と
			LOCAL:1 += 1
			PRINTFORM %CALLNAME:LOCAL%
			EXP:ARG:料理経験 += 1
		ENDIF
	NEXT
	PRINTL にも用意してあげた
	IF LOCAL:2 == 3
		PRINTW うれしそうな表情を見せている
	ELSEIF LOCAL:2 == 2
		PRINTW お礼を言われた
	ELSEIF LOCAL:2 == 1
		PRINTW 顔が引きつっている…嫌な事でもあったのだろうか
	ENDIF
ELSE
	PRINTW 　
ENDIF
BASE:ARG:評判 += 10
CALL 支配度加算(ARG, 2)
VARSET ARG
M:101 = 0
RETURN 1
