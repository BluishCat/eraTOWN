;=================================================
; 転職コマンド「面接を受ける」（身分システム・案2：職場で面接を受けて転職。2026-07-20追加）
; 現在地の職場に応じて応募先の身分が決まる:
;   教室(地区1・位置2、平日8〜16時)      → 教師(cflag:仕事==1)   合格条件: 学力500以上
;   オフィスビル(地区2・位置29、平日9〜18時) → 会社員(仕事==5)      合格条件: 学力400以上
;   キャバクラ(地区2・位置19、営業中)     → キャバ嬢(仕事==8)     合格条件: 容姿400以上（バイト応募と同基準）
;   ソープランド(地区2・位置51、営業中)   → ソープ嬢(仕事==9)     合格条件: 容姿500以上かつ非処女
; 合格すると前職は自動的に辞めて新しい身分になる（年齢はそのまま＝リセットしない）。
; 学生は合格後に「大学を辞めるか」の確認を挟む（承諾で退学して就職）。
; ※複数の場所に対応するため、場所・時間条件はCOM_PROFILEの単一場所テーブルではなく
;   本ファイルの@転職_対象身分で自前判定する。
; 自宅で無職・フリーター・主婦に戻るのはCOMF1056「仕事を辞める」。
;=================================================

;現在地・現在時刻で応募できる身分を返す（-1=ここでは面接不可）
@転職_対象身分
#FUNCTION
IF CFLAG:MASTER:現在地区 == 1 && CFLAG:MASTER:現在位置 == 2
	;教室：平日の日中のみ採用面接を受け付けている
	SIF !D:101 && TIME >= 480 && TIME < 960
		RETURNF 1
ELSEIF CFLAG:MASTER:現在地区 == 2 && CFLAG:MASTER:現在位置 == 29
	;オフィスビル：平日の就業時間内
	SIF !D:101 && TIME >= 540 && TIME < 1080
		RETURNF 5
ELSEIF CFLAG:MASTER:現在地区 == 2 && CFLAG:MASTER:現在位置 == 19
	;キャバクラ：営業中のみ
	SIF 営業中(2, 19)
		RETURNF 8
ELSEIF CFLAG:MASTER:現在地区 == 2 && CFLAG:MASTER:現在位置 == 51
	;ソープランド：営業中のみ
	SIF 営業中(2, 51)
		RETURNF 9
ELSEIF CFLAG:MASTER:現在地区 == 2 && CFLAG:MASTER:現在位置 == 52
	;劇場：営業中のみ
	SIF 営業中(2, 52)
		RETURNF 10
ENDIF
RETURNF -1

@XCOM_ABLE1055(ARG)
#DIM 対象
対象 = 転職_対象身分()
SIF 対象 < 0
	RETURN 0
;現職と同じ職場では面接不要
SIF 対象 == CFLAG:MASTER:仕事
	RETURN 0
RETURN GLOBAL_COMABLE(1055)

@XCOM1055(ARG)
#DIM 対象
#DIM 合格
対象 = 転職_対象身分()
SIF 対象 < 0
	RETURN 0
;面接30分
CFLAG:MASTER:待機時間 = 30
PRINTL
PRINTFORML %"=" * 107%
;----------------------------------------------------------------
;面接と合否判定
;----------------------------------------------------------------
合格 = 0
SELECTCASE 対象
	CASE 1
		PRINTL 職員室に通され、教員採用の面接を受けた。
		PRINTL 経歴や教育方針について、校長からじっくりと質問される。
		合格 = BASE:MASTER:学力 >= 500
		IF !合格
			PRINTW 「うーん……申し訳ないが、学識の面でもう一歩ですな」──不採用のようだ。学をつけて出直そう。
			RETURN 1
		ENDIF
	CASE 5
		PRINTL 受付で来意を告げると、会議室で中途採用の面接が始まった。
		PRINTL 職務経歴と一般常識について、人事担当が淡々と質問してくる。
		合格 = BASE:MASTER:学力 >= 400
		IF !合格
			PRINTW 「今回はご縁がなかったということで……」──不採用のようだ。学をつけて出直そう。
			RETURN 1
		ENDIF
	CASE 8
		PRINTL 開店前の準備で慌ただしい店内で、店長がこちらの全身へ値踏みの視線を送ってくる。
		合格 = BASE:MASTER:容姿 >= 400
		IF !合格
			PRINTW 「悪いけど、うちはお客を取れる子じゃないとね」──不採用のようだ。磨きをかけて出直そう。
			RETURN 1
		ENDIF
	CASE 9
		IF GETCHARA(60) != -1
			PRINTFORML 受付の%CALLNAME:(GETCHARA(60))%が、こちらの体つきを頭のてっぺんからつま先まで眺め回した。
		ELSE
			PRINTL 受付のソープ嬢が、こちらの体つきを頭のてっぺんからつま先まで眺め回した。
		ENDIF
		合格 = BASE:MASTER:容姿 >= 500 && !TALENT:MASTER:0
		IF !合格
			IF TALENT:MASTER:0
				PRINTW 「……あなた、未経験でしょ？　うちの仕事は最初から本番よ。悪いけど、まだ紹介できないわ」──経験を積んでから出直そう。
			ELSE
				PRINTW 「ごめんね。うちは指名で回る店だから、容姿はどうしても厳しく見るの」──不採用のようだ。磨きをかけて出直そう。
			ENDIF
			RETURN 1
		ENDIF
	CASE 10
		IF GETCHARA(61) != -1
			PRINTFORML 支配人の%CALLNAME:(GETCHARA(61))%が、こちらの容姿と身のこなしを値踏みするように眺めた。
		ELSE
			PRINTL 劇場の支配人が、こちらの容姿と身のこなしを値踏みするように眺めた。
		ENDIF
		合格 = BASE:MASTER:容姿 >= 450 && (ABL:MASTER:運動能力 >= 2 || ABL:MASTER:ダンス技能 >= 1)
		IF !合格
			PRINTW 「舞台は素人にゃ荷が重い。……見栄えと身のこなし、もう少し磨いてから出直しな」──不採用のようだ。
			RETURN 1
		ENDIF
ENDSELECT
;----------------------------------------------------------------
;合格。学生は退学確認を挟む
;----------------------------------------------------------------
IF TALENT:MASTER:160
	PRINTL 「採用したいところだけど……うちで働くなら、大学は辞めてもらうことになるよ」
	PRINTL 大学を辞めて働きますか？
	PRINTL [0] - 大学を辞めて働く
	PRINTL [1] - やっぱりやめておく
	$TENSYOKU_INPUT
	INPUT
	SIF RESULT != 0 && RESULT != 1
		GOTO TENSYOKU_INPUT
	IF RESULT == 1
		PRINTW 少し考えて、今回は辞退することにした。
		RETURN 1
	ENDIF
	PRINTW あなたは退学届を出し、新しい道へ進む決意をした。
ENDIF
;転職実行（年齢は据え置き。素質160学生/161学年/162教師を整理し、勤怠をリセット）
TALENT:MASTER:160 = 0
TALENT:MASTER:161 = 0
IF 対象 == 1
	TALENT:MASTER:162 = 1
ELSE
	TALENT:MASTER:162 = 0
ENDIF
CFLAG:MASTER:仕事 = 対象
CFLAG:MASTER:出席 = 0
CFLAG:MASTER:欠席日数 = 0
SELECTCASE 対象
	CASE 1
		PRINTW 「明日からよろしくお願いしますよ、先生」──こうしてあなたは教師になった。
	CASE 5
		PRINTW 「明日から出社してください」──こうしてあなたは会社員になった。
	CASE 8
		PRINTW 「じゃあ今夜から、よろしくね」──こうしてあなたはキャバ嬢になった。
	CASE 9
		PRINTW 「体は大事にしなさいよ。……ようこそ、泡の世界へ」──こうしてあなたはソープ嬢になった。
	CASE 10
		PRINTW 「照明は嘘をつかない。……ようこそ、ステージへ」──こうしてあなたはダンサーになった。
ENDSELECT
RETURN 1
