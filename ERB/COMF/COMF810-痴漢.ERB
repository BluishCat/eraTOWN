T:104 = 0
PRINTL 
PRINTFORML %"=" * 107%
PRINTL バイブを弄る
PRINTFORML %CALLNAME:ARG%が前に廻ると何かごそごそしだした。
PRINTL どうしますか？
PRINTFORML [0] - 諦める
PRINTFORML [1] - 抵抗する
PRINTFORML [2] - 受け入れる
$INPUT_LOOP1
INPUT
SIF RESULT != 0 && RESULT != 1 && RESULT != 2
	GOTO INPUT_LOOP1
IF RESULT == 1
	IF BASE:(TCVAR:ARG:行為対象):気力 < (701 + T:101 * 100)
		PRINTFORML 気力が足りない（{701 + T:101 * 100}以上必要です）
		PRINTFORMW %CALLNAME:(TCVAR:ARG:行為対象)%は抵抗出来ない！
		TA:(TCVAR:ARG:行為対象):ARG:6 += 100
	ELSE
		PRINTFORML %CALLNAME:(TCVAR:ARG:行為対象)%は抵抗した、
		PRINTFORMW %CALLNAME:ARG%は不満そうだ。
		TA:ARG:(TCVAR:ARG:行為対象):6 += 50
		DOWNBASE:(TCVAR:ARG:行為対象):気力 += (700 + T:101 * 100)
		T:101 += 1
		T:102 = 1
		RETURN 1
	ENDIF
ELSEIF RESULT == 2
	PRINTFORML %CALLNAME:(TCVAR:ARG:行為対象)%は抵抗せず、むしろ快楽を得られるように腰を差し出している。
	TA:ARG:(TCVAR:ARG:行為対象):0 += 20
	TA:ARG:(TCVAR:ARG:行為対象):6 -= 30
ENDIF

TEQUIP:(TCVAR:ARG:行為対象):アナル = 0
;男性器のみ抵抗時はCFLAG立て
IF TEQUIP:(TCVAR:ARG:行為対象):膣 == 18
	CFLAG:(TCVAR:ARG:行為対象):ＶオンリーＴ = 1
ENDIF

;消費体力、気力
IF !TEQUIP:(TCVAR:ARG:行為対象):膣 == 1
	DOWNBASE:(TCVAR:ARG:行為対象):体力 += 30
	DOWNBASE:(TCVAR:ARG:行為対象):気力 += 100
	
	SOURCE:(TCVAR:ARG:行為対象):快Ｖ = 250
	SOURCE:(TCVAR:ARG:行為対象):苦痛 = 50
	SOURCE:(TCVAR:ARG:行為対象):露出 = 20
	SOURCE:(TCVAR:ARG:行為対象):逸脱 = 40
	SOURCE:(TCVAR:ARG:行為対象):反感 = 40
ELSE
	DOWNBASE:(TCVAR:ARG:行為対象):体力 += 20
	DOWNBASE:(TCVAR:ARG:行為対象):気力 += 30
	
	SOURCE:(TCVAR:ARG:行為対象):快Ｖ = 40
	SOURCE:(TCVAR:ARG:行為対象):苦痛 = 20
	SOURCE:(TCVAR:ARG:行為対象):露出 = 10
	SOURCE:(TCVAR:ARG:行為対象):逸脱 = 10
	SOURCE:(TCVAR:ARG:行為対象):反感 = 10
ENDIF
IF TCVAR:(TCVAR:ARG:行為対象):601
	SOURCE:(TCVAR:ARG:行為対象):露出 += 10
	SOURCE:(TCVAR:ARG:行為対象):逸脱 += 15
	SOURCE:(TCVAR:ARG:行為対象):快Ｖ += 20
	SOURCE:(TCVAR:ARG:行為対象):反感 += 20
ENDIF
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
IF !TEQUIP:(TCVAR:ARG:行為対象):膣 == 1
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:(TCVAR:ARG:行為対象):自己愛 < 0 || TALENT:(TCVAR:ARG:行為対象):抵抗
		SOURCE:(TCVAR:ARG:行為対象):鬱屈 += 40
ENDIF

;処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:(TCVAR:ARG:行為対象):処女 == 1
	SOURCE:(TCVAR:ARG:行為対象):苦痛 += 2000
	SOURCE:(TCVAR:ARG:行為対象):反感 += 3000
ENDIF

;再生処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:(TCVAR:ARG:行為対象):処女 == 2
	SOURCE:(TCVAR:ARG:行為対象):苦痛 += 500
	SOURCE:(TCVAR:ARG:行為対象):反感 += 1000
ENDIF

;Vへの苦痛は先に処理しておく
