@XCOM_ABLE1048(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
;薬をもっていないと実行不可
SIF !(HAVE_DRUGS(LOCAL))
	RETURN 0
RETURN GLOBAL_COMABLE(1048)


@XCOM1048(ARG)
;薬を飲む
VARSET LOCAL
PRINTL 
PRINTFORML %"=" * 107%

DRAWLINE
PRINTFORML どの薬を飲みますか？
FOR LOCAL,150,175
SIF EQUIP:ARG:LOCAL
	PRINTFORML [{LOCAL,3}] - %ITEMNAME:LOCAL% 残り{EQUIP:ARG:LOCAL}個
NEXT
	PRINTFORML [999] - やめる
$INPUT_LOOP
INPUT

LOCAL:1 = RESULT
IF RESULT == 150 && EQUIP:ARG:(LOCAL:1)
	;媚薬
	TEQUIP:ARG:媚薬 += 120
ELSEIF RESULT == 151 && EQUIP:ARG:(LOCAL:1)
	;利尿剤
	TEQUIP:ARG:利尿剤 += 120
ELSEIF RESULT == 152 && EQUIP:ARG:(LOCAL:1)
	;栄養ドリンク
	DOWNBASE:ARG:体力 -= 800 / (1 + TEQUIP:ARG:栄養ドリンク / 250)
	TEQUIP:ARG:栄養ドリンク += 300
ELSEIF RESULT == 153 && EQUIP:ARG:(LOCAL:1)
	;眠気覚まし
	BASE:ARG:眠気 = LIMIT(BASE:ARG:眠気 - 1000,0,MAXBASE:ARG:眠気)
	TEQUIP:ARG:眠気覚まし += 120
ELSEIF RESULT == 154 && EQUIP:ARG:(LOCAL:1)
	;アロマスプレー
	TEQUIP:ARG:アロマスプレー += 120
ELSEIF RESULT == 174 && EQUIP:ARG:(LOCAL:1)
	;下剤
	TEQUIP:ARG:下剤 += 120
ELSEIF RESULT == 155 && EQUIP:ARG:(LOCAL:1)
	;睡眠薬
	TEQUIP:ARG:睡眠薬 += 120
ELSEIF RESULT == 156 && EQUIP:ARG:(LOCAL:1)
	;低用量ピル（服用中は受精しない・残日数制）
	CFLAG:ARG:避妊 = 24
ELSEIF RESULT == 157 && EQUIP:ARG:(LOCAL:1)
	;アフターピル（緊急避妊薬：新たな受精を防ぎ、着床前の受精卵を消す。着床＝妊娠成立後は無効・現実準拠）
	IF !TALENT:ARG:妊娠
		;着床前の受精卵を消滅させる
		CFLAG:ARG:受精卵日数 = 0
		CFLAG:ARG:着床所要日数 = 0
		CFLAG:ARG:父親 = 0
		CFLAG:ARG:胎児数 = 0
		;3日間、新たな受精をブロック（低用量ピルの残日数が長ければそのまま）
		SIF CFLAG:ARG:避妊 < 3
			CFLAG:ARG:避妊 = 3
	ENDIF
	;効果があったかどうかは本人にも分からない（着床済みでも表示は変えない）
	PRINTW 念のため、アフターピルを服用した。
ELSEIF RESULT == 158 && EQUIP:ARG:(LOCAL:1)
	;排卵誘発剤（生理周期を排卵期へ移し受精しやすくする）
	IF TALENT:ARG:妊娠
		PRINTW すでに妊娠しているため、効果がなかった。
	ELSE
		CFLAG:ARG:生理周期 = 12
		;残効中は多胎率が上がる（3日間）
		CFLAG:ARG:排卵誘発 = 3
		PRINTW 体が火照り、排卵が誘発された。
	ENDIF
ELSEIF RESULT == 159 && EQUIP:ARG:(LOCAL:1)
	;風邪薬（当日の症状を抑え、治りを1日早める）
	IF 風邪中(ARG)
		CFLAG:ARG:風邪薬効 = 1
		PRINTW 薬が効いて、少し楽になった気がする。
	ELSE
		PRINTW 特に効いた気はしなかった。
	ENDIF
ELSEIF RESULT == 999
	;止める
	RETURN 0
ELSE
	CLEARLINE 1
	GOTO INPUT_LOOP
ENDIF
PRINTFORMW %ITEMNAME:(LOCAL:1)%を使いました
EQUIP:ARG:(LOCAL:1)--
CFLAG:ARG:待機時間 = 1
RETURN 1


@HAVE_DRUGS(ARG)
;薬をもっているかどうかを判定する関数
;クスリ……クスリをちょうだい……
#FUNCTION
FOR LOCAL,150,175
SIF EQUIP:ARG:LOCAL
	RETURNF 1
NEXT
RETURNF 0
