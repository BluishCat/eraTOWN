@ITEM_HANDLING_CHECK(ARG)
#FUNCTION
;SETBIT LOCAL 0薬屋取り扱い 1服屋取り扱い 2アクセサリーショップ取り扱い 3アダルトショップ取り扱い 4家電屋取り扱い 5購買部取り扱い 6本屋取り扱い
;             7コンビニ取り扱い 8スーパー取り扱い
;※このSELECTCASEは先に当たったCASEだけが効く＝1品目1店舗。コンビニ・スーパー(2026-08-30)は
;　既存店と品揃えが重なる（弁当も市販薬も薬屋や購買部で売っている）ので、SELECTCASEの後に
;　ビットを重ねて立てる。それに伴い最後の判定を「完全一致」から「ビットの重なり」に変えた。

VARSET LOCAL
SELECTCASE ARG
	CASE 1 TO 149,150,175,320,322,365,370,371,372,373,374,450,524,528,529,530,542,585,722,730,731,732
		SETBIT LOCAL,3
	CASE 150 TO 174
		SETBIT LOCAL,0
	CASE 460 TO 530, 532 TO 579
		SETBIT LOCAL,2
	CASE 176,901,902,903
		SETBIT LOCAL,4
	CASE 182,200,201,219,240,250,284,290,638,639,641
		SETBIT LOCAL,5
	CASE 190 TO 195
		SETBIT LOCAL,6
	CASEELSE
		SETBIT LOCAL,1
ENDSELECT

;--- コンビニ：弁当・ドリンク・市販薬・避妊具・雑誌。処方が要るような薬は置かない
;    152栄養ドリンク 153眠気覚まし 159風邪薬 175コンドーム 182普通のお弁当 183美味しそうなお弁当
;    190上手な謝り方 191広い心の持ち方
SIF ARG == 152 || ARG == 153 || ARG == 159 || ARG == 175 || ARG == 182 || ARG == 183 || ARG == 190 || ARG == 191
	SETBIT LOCAL,7
;--- スーパー：食品と日用品。雑誌と栄養ドリンクの類は置かない
SIF ARG == 159 || ARG == 175 || ARG == 182 || ARG == 183
	SETBIT LOCAL,8

IF LOCAL & SHOP_CATEGORY()
	RETURNF 1
ELSE
	RETURNF 0
ENDIF
