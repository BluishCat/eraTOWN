@COM_MESSAGE_1008
SIF M:101 == 1
	RETURN 0
;入浴
IF (CFLAG:MASTER:現在地区 == 1 && CFLAG:MASTER:現在位置 == 15) || (CFLAG:MASTER:現在地区 == 2 && CFLAG:MASTER:現在位置 == 27)
	PRINTFORML シャワー
	PRINTFORMW %CALLNAME:MASTER%は、%PLACE_NAME(CFLAG:MASTER:現在地区,CFLAG:MASTER:現在位置)%でシャワーを浴びた…
ELSEIF IS_MASTER_HOME() || (CFLAG:MASTER:現在地区 == 2 && CFLAG:MASTER:現在位置 == 22)
	PRINTFORML 入浴
	PRINTFORMW %CALLNAME:MASTER%は、ゆっくりと湯船に浸かった…
ELSE
	PRINTFORML 入浴
	PRINTFORMW %CALLNAME:MASTER%は、湯船を借りた…
ENDIF
;覗きの演出は入浴後に EVENT_覗き.ERB @覗きチェック(1) が担当する（EVENTCOMEND から発火）
M:101 = 1
