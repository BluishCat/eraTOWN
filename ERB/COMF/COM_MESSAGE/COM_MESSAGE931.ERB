@COM_MESSAGE_931
;--------------------------------------------------------------------------
;押さえつける
;--------------------------------------------------------------------------
PRINTFORML ＜押さえつける＞
SELECTCASE TFLAG:COM用変数
	CASE -1
		PRINTW 抵抗不可
	CASE 0
		PRINTFORMW %CALLNAME:(TFLAG:行為者)%は%CALLNAME:(TCVAR:(TFLAG:行為者):行為対象)%を押さえつけようとしたが失敗した
	CASE 1
		PRINTFORMW %CALLNAME:(TFLAG:行為者)%は%CALLNAME:(TCVAR:(TFLAG:行為者):行為対象)%を押さえつけた
ENDSELECT
