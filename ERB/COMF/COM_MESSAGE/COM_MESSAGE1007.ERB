@COM_MESSAGE_1007
;===============================================================================
;自慰とか
;===============================================================================
SIF M:101 == 1
	RETURN 0
;--------------------------------------------------------------------------
;自慰する
;　欲情PALAMが一定以上の場合に使用可能な感じで。
;--------------------------------------------------------------------------
PRINTFORML ＜自慰する＞
;媚薬
IF TEQUIP:MASTER:媚薬
	PRINTFORM 媚薬による
ENDIF
PRINTFORM 体の火照りを鎮めるため、%CALLNAME:MASTER%の手が
;自慰経験＋調教自慰経験が30未満
SIF EXP:MASTER:自慰経験 + EXP:MASTER:調教自慰経験 < 30
	PRINTFORM 無意識に動き、
;下半身下着あり
IF TEQUIP:MASTER:下半身下着
	;PALAM潤滑Lv3以上＋女性器あり
	SIF PALAM:MASTER:潤滑 >= PALAMLV:3 && TALENT:MASTER:性別 & 1
		PRINTFORM 濡れそぼった
	PRINTFORM %ITEMNAME:(TEQUIP:MASTER:下半身下着)%の中に潜り込んで、
ENDIF
;膣に玩具
IF TEQUIP:MASTER:膣 == 1
	;PALAM潤滑Lv3以上
	SIF PALAM:MASTER:潤滑 >= PALAMLV:3
		PRINTFORM 愛液で溢れる
	PRINTFORM 膣を%ITEMNAME:(TEQUIP:MASTER:膣)%で弄び
;男性器あり
ELSEIF TALENT:MASTER:性別 & 2
	;PALAM欲情Lv3以上
	IF PALAM:MASTER:欲情 >= PALAMLV:3
		PRINTFORM 硬く勃起した
	ELSE
		PRINTFORM まだ柔らかい
	ENDIF
	PRINTFORM ペニスをしごき
;アナルに玩具
ELSEIF TEQUIP:MASTER:アナル == (60 | 61 | 62)
	;PALAM潤滑Lv3以上
	SIF PALAM:MASTER:潤滑 >= PALAMLV:3
		PRINTFORM 腸液でぬめる
	PRINTFORM 直腸を刺激する%ITEMNAME:(TEQUIP:MASTER:アナル)%を弄び
;女性器あり
ELSEIF TALENT:MASTER:性別 & 1
	;Ｖ経験1以上
	IF EXP:MASTER:Ｖ経験 >= 1
		;PALAM潤滑Lv3以上
		SIF PALAM:MASTER:潤滑 >= PALAMLV:3
			PRINTFORM 愛液で溢れる
		PRINTFORM 膣内に指を抽送し
	;Ｃ感覚Lv3以上
	ELSEIF ABL:MASTER:Ｃ感覚 >= 3
		;PALAM欲情Lv3以上
		SIF PALAM:MASTER:欲情 >= PALAMLV:3
			PRINTFORM すっかり勃起した
		PRINTFORM 敏感な肉豆を刺激し
	ELSE
		;PALAM潤滑Lv3以上
		SIF PALAM:MASTER:潤滑 >= PALAMLV:3
			PRINTFORM 愛液でぬめる
		;小柄体型以下＋貧乳以下
		IF TALENT:MASTER:体型 <= -1 && TALENT:MASTER:バストサイズ <= -1
			PRINTFORM ワレメ
		ELSE
			PRINTFORM 恥裂
		ENDIF
		PRINTFORM をなぞって刺激し
	ENDIF
ENDIF
PRINTFORML 始める。
PRINTFORM もう一方の手も、
;絶壁 or (オトコ＋並乳)
IF TALENT:MASTER:バストサイズ == -2 || (TALENT:MASTER:性別 == 2 && TALENT:MASTER:バストサイズ == 0)
	PRINTFORM 平坦な胸の先端を摘んで捏ね回
ELSE
	;貧乳
	SIF TALENT:MASTER:バストサイズ == -1
		PRINTFORM なだらかな
	;巨乳
	SIF TALENT:MASTER:バストサイズ == 1
		PRINTFORM 豊かな
	;爆乳
	SIF TALENT:MASTER:バストサイズ == 2
		PRINTFORM 豊か過ぎる
	PRINTFORM 乳房を揉みほぐ
ENDIF
PRINTFORMW して、快楽を送り込んだ。
PRINTFORM 止めなくては、とは思うものの、
;自慰中毒Lv3以上
IF ABL:MASTER:自慰中毒 >= 3
	PRINTFORM 普段から頻繁に自慰行為に耽っている
;自慰中毒Lv1以上
ELSEIF ABL:MASTER:自慰中毒 >= 1
	PRINTFORM 回数こそ少ないものの、自慰行為の気持ちよさを知っている
;自慰しやすい or 中毒しやすい
ELSEIF TALENT:MASTER:自慰しやすい || TALENT:MASTER:中毒しやすい
	PRINTFORM 元から没頭しやすい性格の
ENDIF
PRINTFORML %CALLNAME:MASTER%の指の動きが止まることはない。
;PALAM欲情Lv3以上
IF PALAM:MASTER:欲情 >= PALAMLV:3
	PRINTFORM 高まった欲望に突き動かされるまま、
;媚薬効果
ELSEIF TEQUIP:MASTER:媚薬
	PRINTFORM 媚薬によって高められた欲望に突き動かされるまま、
ELSE
	PRINTFORM 疼く体を鎮めるため、
ENDIF
PRINTFORML 自慰に没頭する。
PRINTFORM ほどなくして、
;女性器あり
IF TALENT:MASTER:性別 & 1
	PRINTFORM 粘っこい液体の音が聞こえ始め、それに
	;臆病 or 大人しい or 恥じらい
	SIF TALENT:MASTER:度胸 == -1 || TALENT:MASTER:応答 == -1 || TALENT:MASTER:羞恥心 == 1
		PRINTFORM 控えめな
	PRINTFORMW 喘ぎ声が重なった…
ELSE
	PRINTFORMW 荒い呼吸音が%CALLNAME:MASTER%の唇から洩れ聞こえ始めた…
ENDIF
M:101 = 1
