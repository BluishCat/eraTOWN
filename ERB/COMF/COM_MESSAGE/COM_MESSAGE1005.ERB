				;男性器あり
				IF TALENT:MASTER:性別 & 2
					;PALAM欲情Lv3以上
					SIF PALAM:MASTER:欲情 >= PALAMLV:3
						PRINTFORM 勃起
					PRINTFORM ペニス
				ELSE
					;PALAM潤滑Lv3以上
					SIF PALAM:MASTER:潤滑 >= PALAMLV:3
						PRINTFORM 濡れそぼった
					PRINTFORM 秘部
				ENDIF
			ENDIF
			PRINTFORMW を晒すと、観客の中から歓声が上がった。
		ELSEIF LOCAL == 3
			;局部にジッパー付きの衣服。…ボンデージくらいしか対応しませんが。
			;巨乳 or 爆乳
			IF TALENT:MASTER:バストサイズ >= 1
				PRINTFORM 肉感的な体の魅力が最大限に生きる
			ELSE
				PRINTFORM 体のラインの浮き出る
			ENDIF
			PRINTFORMW ボンデージ姿だ。
			PRINTFORM 撮影者たちに指示された%CALLNAME:MASTER%が
			;無関心 or 感情乏しい
			IF TALENT:MASTER:無関心 || TALENT:MASTER:感情乏しい
				PRINTFORM 特に抵抗もなく
			;露出癖Lv3以上＋恥薄い or 露出癖Lv6以上
			ELSEIF (ABL:MASTER:露出癖 >= 3 && TALENT:MASTER:羞恥心 == -1) || ABL:MASTER:露出癖 >= 6
				PRINTFORM 焦らすようにゆっくりと
			;露出癖Lv3以上
			ELSEIF ABL:MASTER:露出癖 >= 3
				PRINTFORM 恥ずかしげに
			ELSE
				PRINTFORM 怯えた様子で
			ENDIF
			PRINTFORM 局部についたジッパーを開けて
			;男性器あり
			IF TALENT:MASTER:性別 & 2
				;PALAM欲情Lv3以上
				SIF PALAM:MASTER:欲情 >= PALAMLV:3
					PRINTFORM 勃起
				PRINTFORM ペニス
			ELSE
				;PALAM潤滑Lv3以上
				SIF PALAM:MASTER:潤滑 >= PALAMLV:3
					PRINTFORM 濡れそぼった
				PRINTFORM 秘部
			ENDIF
			PRINTFORMW を晒すと、観客の中から歓声が上がった。
		ENDIF
	ENDIF

ELSEIF CFLAG:MASTER:職業 == 14
	CALL bite14
ELSEIF CFLAG:MASTER:職業 == 18
	CALL bite18
ELSEIF CFLAG:MASTER:職業 == 19 || CFLAG:MASTER:職業 == 20
	CALL bite19
ELSEIF CFLAG:MASTER:職業 == 21
	CALL bite21
ELSE
	;===============================================================================
	;アルバイトをする
	;===============================================================================
	PRINTFORML ＜アルバイトをする＞
	;接客技能による働きぶりの変化
	IF ABL:MASTER:接客技能 >= 4
		PRINTFORML 長いバイト経験に裏打ちされた手際で、%CALLNAME:MASTER%はテキパキと働いていく。
	ELSEIF ABL:MASTER:接客技能 >= 2
		PRINTFORML 仕事にも大分慣れ、%CALLNAME:MASTER%の動きは板についてきた。
	ELSE
		PRINTFORML まだ慣れない仕事に、%CALLNAME:MASTER%はたどたどしく取り組んでいる。
	ENDIF
	;--------------------------------------------------------------------------
	;淫具装着
	;--------------------------------------------------------------------------
	IF TEQUIP:MASTER:胸 || TEQUIP:MASTER:クリトリス || (TEQUIP:MASTER:膣 == 1) || (TEQUIP:MASTER:アナル >= 60 && TEQUIP:MASTER:アナル <= 62)
		;確率が一定じゃないのは故意にやってます
		IF RAND:5 == 0
			PRINTFORM 多くの客でごった返す
		ELSEIF RAND:5 == 1
			PRINTFORM 閑散としている
		ELSE
			PRINTFORM いつもと変わらぬ様子の
		ENDIF
		PRINTFORM 店内で、取り付けられた
		;胸刺激
		IF TEQUIP:MASTER:胸
			PRINTFORM %ITEMNAME:(TEQUIP:MASTER:胸)%が%CALLNAME:MASTER%の
			;絶壁 or (オトコ＋並乳)
			IF TALENT:MASTER:バストサイズ == -2 || (TALENT:MASTER:性別 == 2 && TALENT:MASTER:バストサイズ == 0)
				;女性
				IF TALENT:MASTER:性別 & 1
					;幼児体型
					SIF TALENT:MASTER:100 == -2
						PRINTFORM 見た目相応の
					;長身以上
					SIF TALENT:MASTER:100 >= 1
						PRINTFORM 見た目に反して
				ENDIF
				PRINTFORM 平坦な
			;貧乳
			ELSEIF TALENT:MASTER:105 == -1
				;小柄体型
				SIF TALENT:MASTER:100 == -1
					PRINTFORM 見た目相応の
				;長身以上
				SIF TALENT:MASTER:100 >= 1
					PRINTFORM 見た目に反して
				PRINTFORM なだらかな

			;巨乳
			ELSEIF TALENT:MASTER:105 == 1
				;小柄体型 or 幼児体型
				SIF TALENT:MASTER:100 == -1 || TALENT:MASTER:100 == -2
					PRINTFORM 見た目に反して
				PRINTFORM 豊かな
			;爆乳
			ELSEIF TALENT:MASTER:105 == 2
				PRINTFORM 豊か過ぎる
			ENDIF
			PRINTFORML 胸の先を刺激する。
		;クリ刺激
		ELSEIF TEQUIP:MASTER:クリトリス
			PRINTFORML %ITEMNAME:(TEQUIP:MASTER:クリトリス)%が%CALLNAME:MASTER%のクリトリスを刺激する。
		;膣刺激
		ELSEIF TEQUIP:MASTER:膣
			PRINTFORML %ITEMNAME:(TEQUIP:MASTER:膣)%が%CALLNAME:MASTER%の膣で震える。
		;アナル刺激
		ELSEIF TEQUIP:MASTER:アナル
			PRINTFORML %ITEMNAME:(TEQUIP:MASTER:アナル)%が%CALLNAME:MASTER%の直腸で震える。
		ENDIF
		;PALAM欲情Lv3以上
		IF PALAM:MASTER:欲情 >= PALAMLV:3
			PRINTFORML 仕事に集中しなければ、と思うほど、淫具の刺激は%CALLNAME:MASTER%を苛んだ。
			;女性器あり
			IF TALENT:MASTER:性別 & 1
				;下半身下着
				IF TEQUIP:MASTER:下半身下着
					PRINTFORM 身に付けた下着
				ELSE
					PRINTFORM 下着を着けていない秘処
				ENDIF
				;PALAM潤滑Lv3以上
				IF PALAM:MASTER:潤滑 >= PALAMLV:3
					PRINTFORMW からは愛液が溢れ、幾筋かは太ももに零れ落ちて輝線を描いている。
				ELSE
					PRINTFORMW は、染み出した愛液で濡れ始めている。
				ENDIF
			ELSE
				PRINTFORM 股間では、勃起した肉棒
				;スカート類
				IF TEQUIP:MASTER:下半身上着 <= 274
					PRINTFORMW がスカートを持ち上げて自己主張をしている。
				ELSE
					PRINTFORM の形が%ITEMNAME:(TEQUIP:MASTER:下半身上着)%越しにも
					;下半身下着なし
					SIF TEQUIP:MASTER:下半身下着 == 0
						PRINTFORM はっきりと
					PRINTFORMW わかる。
				ENDIF
			ENDIF
		ELSE
			PRINTFORMW 淫らな玩具の与える苦痛に耐えながら、%CALLNAME:MASTER%はアルバイトに専念した。
		ENDIF
		;淫具を着けたまま働き続けた：道具使用+1 異常+1（快感PALAMはSOURCE_CHECK_1のEQUIP_CHECKが反映）
		CALL バイト経験加算(28, 1)
		CALL バイト経験加算(53, 1)

	;--------------------------------------------------------------------------
	;ノーパン・通常
	;--------------------------------------------------------------------------
	ELSE
		PRINTFORM 今日の店内は
		;確率が一定じゃないのは故意にやってます
		IF RAND:5 == 0
			PRINTFORML 、いつもより盛況のようだ。
			;下半身下着なし
			IF TEQUIP:MASTER:下半身下着 == 0
				;露出癖Lv3以上 or 露出癖Lv5以上＋恥じらい
				IF ABL:MASTER:露出癖 >= 3 || (ABL:MASTER:露出癖 >= 5 && TALENT:MASTER:羞恥心 == 1)
					PRINTFORML 下着を着けていない下半身に、疼くような感覚が走る。
					PRINTFORMW %CALLNAME:MASTER%はどこか楽しげに、客でごった返す店内に向けて歩き出した。
				ELSE
					PRINTFORML 今日は、忙しく動き回ることになりそうだ。
					PRINTFORML それはつまり、下着を穿いていないことがバレる危険性が増す、と言うことでもある。
					PRINTFORMW %CALLNAME:MASTER%はどこか不安げに、客でごった返す店内に一歩を踏み出した…
				ENDIF
			ELSE
				PRINTFORMW …今日は忙しくなりそうだ。
			ENDIF
		ELSEIF RAND:5 == 1
			PRINTFORML 閑散としている。
			;下半身下着なし
			IF TEQUIP:MASTER:下半身下着 == 0
				;露出癖Lv3以上 or 露出癖Lv4以上＋恥じらい
				IF ABL:MASTER:露出癖 >= 3 || (ABL:MASTER:露出癖 >= 4 && TALENT:MASTER:羞恥心 == 1)
					PRINTFORML …折角、下着を穿かずに来たと言うのに。
					PRINTFORMW %CALLNAME:MASTER%はどこか残念そうに、溜息をついた。
				ELSE
					PRINTFORML …これならば、下着を穿いていないこともバレにくいかもしれない。
					PRINTFORMW %CALLNAME:MASTER%は安堵の吐息を洩らし、とりあえず、あまり動かなくて済むような仕事に取り掛かることにした。
				ENDIF
			ELSE
				PRINTFORMW %CALLNAME:MASTER%は溜息をつくと、とりあえず店内の掃除から始めることにした。
			ENDIF
		ELSE
			PRINTFORML 、平常通りの客の入りのようだ。
			;下半身下着なし
			SIF TEQUIP:MASTER:下半身下着 == 0
				PRINTFORML …下着を穿いていないことが、バレてしまわないだろうか。
			PRINTFORM %CALLNAME:MASTER%は入って来た客に対して
			;露出癖Lv3以上 or 露出癖Lv4以上＋恥じらい
			IF ABL:MASTER:露出癖 >= 3 || (ABL:MASTER:露出癖 >= 4 && TALENT:MASTER:羞恥心 == 1)
				PRINTFORM どこか楽しそうに
			;臆病 or 下半身下着なし
			ELSEIF TALENT:MASTER:度胸 == -1 || TEQUIP:MASTER:下半身下着 == 0
				PRINTFORM ぎこちなく
			;気丈 or 陽気 or 目立ちたがり
			ELSEIF TALENT:MASTER:度胸 == 1 || TALENT:MASTER:陽気／陰気 == 1 || TALENT:MASTER:目立ちたがり
				PRINTFORM 元気よく
			;大人しい
			ELSEIF TALENT:MASTER:応答 == -1
				PRINTFORM 柔らかく
			ENDIF
			PRINTFORMW 微笑み、来店を歓迎した。
		ENDIF
	ENDIF
ENDIF
;今日の給料（額はXCOM1005で計算、M:103経由）。経験はここで加算し、獲得表示はSOURCE_CHECK_2の標準表示が行う
PRINTL
PRINTFORML 今日の給料 +%金額(M:103)%円
CALL JOB_EXP_GAIN(CFLAG:MASTER:職業)

;;;援交判定：店ごとの専用店主を相手にする（番号の解決は@JOB_MASTER_CHARA。JOB.ERB）
I = -1
D = JOB_MASTER_CHARA(CFLAG:MASTER:職業)
IF D >= 0 && EXISTCSV(D,0)
	I = GETCHARA(D)
ENDIF
;専用店主が未登録なら従来の汎用モブ(モブ男/モブ子)にフォールバック
IF I < 0
	IF RAND(2)
		I = GETCHARA(37)
	ELSE
		I = GETCHARA(38)
	ENDIF
ENDIF

;M:102==1（この接客で客ホテルが発生）のターンは店主援交をスキップ
IF I >= 0 && BASE:1:評判 >= 600 && M:102 != 1
	CALL NPC_ENKOU(I,1)
ENDIF

M:101 = 1
