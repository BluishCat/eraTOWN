;===============================================================================
;痴漢カウンターコマンド
;===============================================================================
;--------------------------------------------------------------------------
;舐める
;--------------------------------------------------------------------------
@COM_MESSAGE_820(ARG)

PRINTFORML ＜舐める＞
IF T:102 == 0
	IF T:104
		ARG = (TCVAR:1:行為対象)
	ELSE
		ARG = 1
	ENDIF
	PRINTFORM %CALLNAME:MASTER%はまるで挑発する様に
		PRINTFORM %CALLNAME:(TCVAR:MASTER:行為対象)%の顔を
	PRINTL 嘗めた…
ENDIF

;--------------------------------------------------------------------------
;胸を触らせる
;--------------------------------------------------------------------------
@COM_MESSAGE_821

PRINTFORML ＜胸を触らせる＞
PRINTFORM %CALLNAME:MASTER%を弄る痴漢の手を掴み、
PRINTFORM %CALLNAME:MASTER%の
;絶壁 or (オトコ＋並乳)
IF TALENT:MASTER:バストサイズ == -2 || (TALENT:MASTER:性別 == 2 && TALENT:MASTER:バストサイズ == 0)
	PRINTFORML 平坦な胸。
ELSE
	;巨乳 or 爆乳
	IF TALENT:MASTER:バストサイズ >= 1
		PRINTFORM 自慢の豊乳

	ELSEIF TALENT:MASTER:バストサイズ == 1
			PRINTFORM 小振りの乳房
	ELSE
			PRINTFORM 自慢の美乳
	ENDIF
	PRINTFORML へ押し当てた。
ENDIF
PRINTFORM 痴漢の手は一瞬ビクリとしたが%CALLNAME:MASTER%の意図を読んでか、
;上半身上着あり
IF TEQUIP:MASTER:上半身上着
	IF BASE:MASTER:興奮度 >= 500 && BASE:(TCVAR:MASTER:行為対象):興奮度 >= 500
		PRINTFORM 服の中に潜り込み、
	ELSE
		PRINTFORM 、服の上から
	ENDIF
;上半身下着あり
ELSEIF TEQUIP:MASTER:上半身下着
	IF BASE:MASTER:興奮度 >= 500 && BASE:(TCVAR:MASTER:行為対象):興奮度 >= 500
		PRINTFORM 下着の中に潜り込み、
	ELSE
		PRINTFORM 、下着の上から
	ENDIF
ENDIF
PRINTFORM その胸を
;PALAM欲情Lv3以上
IF PALAM:(TCVAR:MASTER:行為対象):欲情 >= PALAMLV:3
	PRINTFORMW 鼻息を乱して揉みしだいている。
;PALAM欲情Lv1以上
ELSEIF PALAM:(TCVAR:MASTER:行為対象):欲情 >= PALAMLV:1
	PRINTFORMW 掌全体で感触を確かめている。
ELSE
	PRINTFORMW うれしそうに擦っている。
ENDIF

;--------------------------------------------------------------------------
;乳首を探る
;--------------------------------------------------------------------------
@COM_MESSAGE_822

PRINTFORML ＜乳首を探る＞
PRINTFORM 痴漢の位置を把握した%CALLNAME:MASTER%は、
;絶壁 or (オトコ＋並乳)
IF TALENT:(TCVAR:MASTER:行為対象):バストサイズ == -2 || (TALENT:(TCVAR:MASTER:行為対象):性別 == 2 && TALENT:(TCVAR:MASTER:行為対象):バストサイズ == 0)
	PRINTFORM 平坦な胸の中心にある
;巨乳 or 爆乳
ELSEIF TALENT:(TCVAR:MASTER:行為対象):バストサイズ >= 1
	PRINTFORM 豊乳の頂にある
ELSE
	SIF TALENT:(TCVAR:MASTER:行為対象):バストサイズ == 1
		PRINTFORM 小振りの
	PRINTFORM 乳房の中心にある
ENDIF
;PALAM欲情Lv4以上
IF PALAM:(TCVAR:MASTER:行為対象):欲情 >= PALAMLV:4
	PRINTFORM 硬く勃起した
;PALAM欲情Lv2以上
ELSEIF PALAM:(TCVAR:MASTER:行為対象):欲情 >= PALAMLV:2
	PRINTFORM 硬くなりつつある
ELSE
	PRINTFORM まだ柔らかい
ENDIF
PRINTFORML 乳首を、
;上半身下着あり
IF TEQUIP:(TCVAR:MASTER:行為対象):上半身上着
	PRINTFORM 上着の上から
;上半身上着あり
ELSEIF TEQUIP:(TCVAR:MASTER:行為対象):上半身下着
	PRINTFORM 下着の上から
ENDIF
PRINTFORML 乳首を探るように捏ねた。
PRINTFORML %CALLNAME:MASTER%の積極的なアプローチに痴漢はより一層興奮を高めていった。

;--------------------------------------------------------------------------
;股間をさする
;--------------------------------------------------------------------------
@COM_MESSAGE_823

PRINTFORML ＜股間をさする＞
PRINTFORM %CALLNAME:MASTER%は痴漢の股間を
SIF TCVAR:(TCVAR:MASTER:行為対象):601
	PRINTFORM 衣服の上から
PRINTFORML 誘うように優しく撫でている。
;男性器あり
IF TALENT:(TCVAR:MASTER:行為対象):性別 & 2
	PRINTFORML 痴漢のペニスは堪らず勃起していく。
ELSE
	PRINTFORML 痴漢のクリトリスは堪らず勃起していく。
ENDIF

;--------------------------------------------------------------------------
;足を踏む
;--------------------------------------------------------------------------
@COM_MESSAGE_825

PRINTFORML ＜足を踏む＞
PRINTFORM %CALLNAME:MASTER%は痴漢と思われる足
IF TALENT:MASTER:サド || ABL:MASTER:サドっ気 >= 3
	PRINTFORM に思い切り踵を落とし、そのままグリグリと踏みにじってやった。
ELSEIF TALENT:MASTER:度胸 == -1
	PRINTFORML へ恐る恐る足を下ろした。
ELSE
	PRINTFORML を踏みつけた。
ENDIF
IF TALENT:(TCVAR:MASTER:行為対象):マゾ || ABL:(TCVAR:MASTER:行為対象):マゾっ気 >= 3
	PRINTFORML が、
	PRINTFORML 
	PRINTFORML 痴漢は苦痛に悶えながらも足を引かない。
	PRINTFORML むしろ%CALLNAME:MASTER%には興奮しているようにさえ見えた。
	SIF TALENT:MASTER:度胸 == -1
		PRINTFORML その様を%CALLNAME:MASTER%は理解できないでいる。
ELSE
	PRINTFORML 痴漢は苦痛に「うぐ」と声を漏らし、その手は勢いを弱めた。
ENDIF
