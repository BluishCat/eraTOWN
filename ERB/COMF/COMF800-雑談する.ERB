@XCOM_ABLE800(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG

SIF TCVAR:LOCAL:イベント != 3
	RETURN 0
RETURN GLOBAL_COMABLE(800)

;=================================================
; 話題（TCVAR:会話話題(644) と同じ番号）
;   0 世間話 / 1 褒める / 2 近況を聞く / 3 噂話 / 4 部活の話
; 出せる話題かどうかを返す。RETURN 1 = 選択肢に出す
;=================================================
@話題可否(ARG,ARG:1)
#FUNCTION
#DIM 本人
#DIM 相手
本人 = ARG
相手 = TCVAR:本人:行為対象
SELECTCASE ARG:1
	CASE 0, 1
		RETURNF 1
	CASE 2
		;近況を聞く：家族には今さら聞くことがない
		RETURNF !TALENT:相手:家族
	CASE 3
		;噂話：本当に敵視している相手が居るときだけ
		RETURNF 噂話対象(本人, 相手) > 0
	CASE 4
		RETURNF 部活一致(本人, 相手)
ENDSELECT
RETURNF 0

;----- 話題のラベル -----
@話題名(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "世間話をする"
	CASE 1
		RETURNF "相手を褒める"
	CASE 2
		RETURNF "近況を聞く"
	CASE 3
		RETURNF "噂話をする"
	CASE 4
		RETURNF "部活の話をする"
ENDSELECT
RETURNF ""

@XCOM800(ARG)
;雑談
;※LOCAL は XCOM801 の VARSET LOCAL で壊れうるので、跨いで持ち越す値は #DIM に置く
#DIM 噂話相手
VARSET LOCAL
PRINTL
PRINTFORML %"=" * 107%

;----- 話題選択 -----
;選んだ話題は TCVAR:会話話題 に置く。地の文(COM_MESSAGE800)は SOURCE.ERB の
;TRYCALLFORM 経由で呼ばれ話題を再計算できないため、必ずここで確定させること
LOCAL:2 = 0
PRINTFORML %CALLNAME:(TCVAR:ARG:行為対象)%に何を話しますか？
FOR LOCAL:3,0,7
	SIF !話題可否(ARG, LOCAL:3)
		CONTINUE
	PRINTFORML [{LOCAL:3}] - %話題名(LOCAL:3)%
NEXT
PRINTL [99] - やめる
$TOPIC_LOOP
INPUT
IF RESULT == 99
	RETURN 0
ELSEIF RESULT >= 0 && RESULT <= 6 && 話題可否(ARG, RESULT)
	LOCAL:2 = RESULT
ELSE
	CLEARLINE 1
	GOTO TOPIC_LOOP
ENDIF
TCVAR:ARG:会話話題 = LOCAL:2
;噂話の対象は判定前に確定させる（効果適用で敵対値が動くため）
噂話相手 = 0
SIF LOCAL:2 == 3
	噂話相手 = 噂話対象(ARG, TCVAR:ARG:行為対象)
PRINTL

IF !(TALENT:(TCVAR:ARG:行為対象):家族)
;相手からの好意3が30以上且つ愛情1が1以上（又は好意が70以上）、又は、服従2が10以上且つ肉欲0が100以上
	IF ((TA:(TCVAR:ARG:行為対象):ARG:0 >= 100) && (TA:(TCVAR:ARG:行為対象):ARG:2 >= 10)) | ((TA:(TCVAR:ARG:行為対象):ARG:3 >= 30) && ((TA:(TCVAR:ARG:行為対象):ARG:1 >= 1) | (TA:(TCVAR:ARG:行為対象):ARG:3 >= 70)))
	ELSE
;但し、確率でOK
		A = RAND(900)
		A = A * TA:ARG:(CFLAG:(TCVAR:ARG:行為対象):タイプ):5 / 100 + (ABL:MASTER:話術技能 * 30)
		IF !(A >400)
			PRINTFORML %CALLNAME:(TCVAR:ARG:行為対象)%に相手にされなかった
			TFLAG:成否用変数 = -2
			CFLAG:ARG:待機時間 += 10
;;;	支配度に−２、相手は無し
			CALL 支配度加算(ARG, -1)
			VARSET ARG
			RETURN 1
		ENDIF
	ENDIF
ENDIF
LOCAL = RAND(100)
LOCAL:1 = 90 + (GET_SUCCESS_RATE(ARG) / 5) - TCVAR:ARG:会話累積値
SIF LOCAL:1 > 99
	LOCAL:1 = 99
SIF LOCAL:1 < 0
	LOCAL:1 = 0

IF LOCAL >= LOCAL:1
	;10〜1％で失敗
	TFLAG:成否用変数 = -1
	CALL 支配度加算(ARG, 1)
ELSE
	IF LOCAL <= 19
		;10％で大成功
		TFLAG:成否用変数 = 2
		EXP:ARG:会話経験 += 2
		EXP:(TCVAR:ARG:行為対象):会話経験 += 2
		CALL 支配度加算(ARG, 2)
		TB:(CFLAG:ARG:現在地区):(CFLAG:ARG:現在位置):(TCVAR:ARG:行為対象) -= 1
	ELSE
	;残りは成功
	TFLAG:成否用変数 = 1
	EXP:ARG:会話経験++
	EXP:(TCVAR:ARG:行為対象):会話経験++
	CALL 支配度加算(ARG, 1)
	TB:(CFLAG:ARG:現在地区):(CFLAG:ARG:現在位置):(TCVAR:ARG:行為対象) -= 1
	ENDIF
ENDIF
;行為者にも同じ値をセット（好意があるので話しかけたと仮定）
CALL XCOM801(ARG)
I = TCVAR:ARG:行為対象
TCVAR:ARG:行為対象 = I
TCVAR:I:行為対象 = ARG
TFLAG:行為者 = I
CALL SOURCE_CHECKS(I)
TFLAG:行為者 = ARG
TCVAR:ARG:行為対象 = I

DOWNBASE:ARG:気力 += 10
DOWNBASE:(TCVAR:ARG:行為対象):気力 += 10
;固定で獲得するソース
SOURCE:(TCVAR:ARG:行為対象):歓楽 = 200


;;;20120211 追加　会話成功時に欲情度＋１、＋５、＋７
IF TFLAG:成否用変数 == -1
	TIMES SOURCE:(TCVAR:ARG:行為対象):歓楽 , 0.10
	TA:ARG:(TCVAR:ARG:行為対象):4 += 1
	TA:(TCVAR:ARG:行為対象):ARG:4 += 1
ELSEIF TFLAG:成否用変数 == 1
	TIMES SOURCE:(TCVAR:ARG:行為対象):歓楽 , 1.00
	TA:ARG:(TCVAR:ARG:行為対象):4 += 5
	TA:(TCVAR:ARG:行為対象):ARG:4 += 5
ELSE
	TIMES SOURCE:(TCVAR:ARG:行為対象):歓楽 , 2.00
	TA:ARG:(TCVAR:ARG:行為対象):4 += 7
	TA:(TCVAR:ARG:行為対象):ARG:4 += 7
ENDIF
SELECTCASE ABL:ARG:話術技能
	CASE 0
		TIMES SOURCE:(TCVAR:ARG:行為対象):歓楽 , 0.20
	CASE 1
		TIMES SOURCE:(TCVAR:ARG:行為対象):歓楽 , 0.40
	CASE 2
		TIMES SOURCE:(TCVAR:ARG:行為対象):歓楽 , 0.70
	CASE 3
		TIMES SOURCE:(TCVAR:ARG:行為対象):歓楽 , 1.00
	CASE 4
		TIMES SOURCE:(TCVAR:ARG:行為対象):歓楽 , 1.50
	CASEELSE
		TIMES SOURCE:(TCVAR:ARG:行為対象):歓楽 , 2.00
ENDSELECT

;;;20120717 追加　会話成功時にMAX気力＋１
MAXBASE:ARG:気力 += 1
MAXBASE:I:気力 += 1
;;; 会話成功時に好意＋１
TA:ARG:(TCVAR:ARG:行為対象):3 += 1
TA:(TCVAR:ARG:行為対象):ARG:3 += 1
;;;20120721 会話成功時に敵対−１
TA:I:ARG:6 -= 1
TA:ARG:I:6 -= 1

;;;20260716 追加　同じ部活だと話が弾む（部活一致補正）
IF TFLAG:成否用変数 >= 1 && 部活一致(ARG, TCVAR:ARG:行為対象)
	TA:ARG:(TCVAR:ARG:行為対象):3 += 1
	TA:(TCVAR:ARG:行為対象):ARG:3 += 1
	;大成功ならさらに欲情＋2、低確率で愛情＋1（愛情はレア資源のため確率付与）
	IF TFLAG:成否用変数 == 2
		TA:ARG:(TCVAR:ARG:行為対象):4 += 2
		TA:(TCVAR:ARG:行為対象):ARG:4 += 2
		IF RAND(3) == 0
			TA:ARG:(TCVAR:ARG:行為対象):1 += 1
			TA:(TCVAR:ARG:行為対象):ARG:1 += 1
		ENDIF
	ENDIF
ENDIF

;;;20260726 追加　話題別の効果（成功時のみ。失敗は従来どおり素の欲情+1だけ）
IF TFLAG:成否用変数 >= 1
	SELECTCASE TCVAR:ARG:会話話題
		CASE 1
			;褒める：相手からの好意が伸びる。大成功ならさらに乗る
			TA:(TCVAR:ARG:行為対象):ARG:3 += 3
			SIF TFLAG:成否用変数 == 2
				TA:(TCVAR:ARG:行為対象):ARG:3 += 2
		CASE 2
			;近況を聞く：聞き役。伸びは小さいが会話累積値も溜まりにくい（@会話累積値加算）
			TA:(TCVAR:ARG:行為対象):ARG:3 += 1
		CASE 3
			;噂話：対象への敵対感を二人で共有する。共犯関係になるぶん好意は伸びる
			IF 噂話相手
				TA:(TCVAR:ARG:行為対象):噂話相手:6 += 10
				TA:ARG:噂話相手:6 += 10
				TA:ARG:(TCVAR:ARG:行為対象):3 += 3
				TA:(TCVAR:ARG:行為対象):ARG:3 += 3
			ENDIF
		CASE 4
			;部活の話：共通の話題で弾む（部活一致補正と重ねがけ）
			TA:ARG:(TCVAR:ARG:行為対象):3 += 3
			TA:(TCVAR:ARG:行為対象):ARG:3 += 3
			TA:ARG:(TCVAR:ARG:行為対象):4 += 2
			TA:(TCVAR:ARG:行為対象):ARG:4 += 2
	ENDSELECT
ENDIF

;会話累積値（話題ごとの「連発の効かなさ」は @会話累積値加算 に集約）
CALL 会話累積値加算(ARG, TCVAR:ARG:会話話題)

CFLAG:ARG:待機時間 += 10


VARSET ARG
RETURN 1

