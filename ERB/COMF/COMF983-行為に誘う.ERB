;[行為に誘う]（2026-07-29追加。恋愛.ERB の共通基盤を使用）
;会話イベント(3)中に、合意の上で性行為(4)へ移る。押し倒す(COMF998)の強引ルートに対する合意ルート。
;解禁条件は「その場に居る同室者が全員、同意しうる関係値であること」＝@周囲全員H合意可能（恋愛.ERB）。
;成立条件は @H合意可能（恋愛.ERB）を参照。合意行為なので評判・支配度は下げない。
;※素質「名無し」(TALENT:200) では弾かない。理由は @XCOM_ABLE983 のコメント参照。
;※コマンド番号は 983。987/988/993/994 は H状態保持.ERB の器具解除に使用済み。

@XCOM_ABLE983(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
;会話イベント中のみ
SIF TCVAR:LOCAL:イベント != 3
	RETURN 0
;※TALENT:200（名無し）では弾かない。あれは「口上が未整備の汎用扱いキャラ」を示すフラグで
;　（NPC_AUTOACTION1/2 が描写の簡略化に使っている）行為対象の可否とは無関係。
;　71キャラ中36キャラに付いており、恋人・セフレになれる相手も多数含まれる。
;　押し倒す(COMF998)・３０分調教(COMF1200)はこれをガードに使っているが踏襲しない。
;同じ相手への誘いは1日1回まで
SIF TCVAR:(TCVAR:LOCAL:行為対象):誘い済
	RETURN 0
;その場に居る全員が同意しうる関係値であること（他人に見られても構わない面子か）
SIF !周囲全員H合意可能()
	RETURN 0
RETURN GLOBAL_COMABLE(983)

@XCOM983(ARG)
#DIM 相手
VARSET LOCAL
PRINTL
PRINTFORML %"=" * 107%

相手 = TCVAR:ARG:行為対象
TFLAG:成否用変数 = 0
;成否を問わず1日1回（セフレ勧誘 COMF984 と同型）
TCVAR:相手:誘い済 = 1
PRINTFORML あなたは%CALLNAME:相手%を求めるように身を寄せた。
IF H合意可能(相手, ARG)
	TFLAG:成否用変数 = 1
	CALL 汎用口上(17, 相手, ARG)
	;合意なので評判・支配度のペナルティは無し（押し倒す COMF998 との差）
	CALL EVENT_JOIN(ARG, 相手, 4)
	CFLAG:ARG:待機時間 += 2
ELSE
	TFLAG:成否用変数 = -1
	TA:相手:ARG:3 -= 5
	CALL 汎用口上(16, 相手, ARG)
	CFLAG:ARG:待機時間 += 10
ENDIF
VARSET ARG
RETURN 1
