;=================================================
; 「始業まで待つ」（身分共通。2026-07-21追加）
; 職場に早く着いた時、始業（開店）時刻ちょうどまで一気に時間を進めるだけのコマンド。
; 勤務コマンド（COMF1001/1050/1051/1053/1054/1057・バイトCOMF1005）は始業・営業時間の
; ゲートを持つため、それまで1018「１０分進める」を連打する手間を省くのが目的。
; 場所・時間の条件は中央テーブル（COM_PROFILE.ERB）で宣言。待ち時間は@始業までの分が返す。
;=================================================
@XCOM_ABLE1058(ARG)
;職場にいる（@勤務先か）＋始業前（@始業までの分 > 0）。身分制限はなし
SIF !COM_PLACE_OK(1058) || !COM_TIME_OK(1058)
	RETURN 0
RETURN GLOBAL_COMABLE(1058)

@XCOM1058(ARG)
PRINTL
PRINTFORML %"=" * 107%
PRINTL 待機
;始業ちょうどまで拘束する
CFLAG:MASTER:待機時間 = 始業までの分()
;待った長さは描写で使うので控える（TIME_COUNTで待機時間が減る前に退避）
M:107 = CFLAG:MASTER:待機時間
;手待ちの休息：疲労は少し抜けるが、手持ち無沙汰でストレスは溜まる
;（DOWNBASEの符号は労働側COMF1051に準拠＝ += が消耗 / -= が回復）
DOWNBASE:ARG:体力 -= CFLAG:ARG:待機時間 * 10 / 60
DOWNBASE:ARG:気力 -= CFLAG:ARG:待機時間 * 10 / 60
DOWNBASE:ARG:疲労 += CFLAG:ARG:待機時間 * 30 / 60
DOWNBASE:ARG:ストレス -= CFLAG:ARG:待機時間 * 15 / 60
M:101 = 0
RETURN 1

;待機の地の文（職場ごとに文言を変える。待った長さはM:107）
@COM_MESSAGE_1058
#DIMS 待ち
SIF M:101 == 1
	RETURN 0
;待った時間の整形はPLAYER_USERCOMの経過表示と同じ流儀
IF M:107 >= 60 && M:107 % 60 == 0
	待ち '= @"{M:107 / 60}時間"
ELSEIF M:107 >= 60
	待ち '= @"{M:107 / 60}時間{M:107 % 60}分"
ELSE
	待ち '= @"{M:107}分"
ENDIF
PRINTL
IF CFLAG:MASTER:現在地区 == 1 && CFLAG:MASTER:現在位置 == 2
	PRINTL あなたは自分の席に着き、教科書を開いたり友達とだべったりしながらチャイムを待った。
ELSEIF CFLAG:MASTER:現在地区 == 2 && CFLAG:MASTER:現在位置 == 29
	;昼休み（12:30〜13:30）に待つ場合は始業待ちではなく休憩の手持ち無沙汰
	IF TIME >= 750 && TIME < 810
		PRINTL あなたは休憩スペースの椅子に浅く腰かけ、窓の外を眺めて昼休みをやり過ごした。
	ELSE
		PRINTL あなたはデスクでメールに目を通しながら、始業の時間を待った。
	ENDIF
ELSE
	PRINTL あなたは控え室で身支度を整えながら、開店の時間を待った。
ENDIF
PRINTFORML %待ち%待って、そろそろ仕事の時間だ。
M:101 = 1
