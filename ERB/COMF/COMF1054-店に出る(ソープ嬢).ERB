;=================================================
; ソープ嬢の勤務コマンド「店に出る」（身分システム：cflag:仕事==9。2026-07-20追加）
; 勤務地はソープランド（地区2・位置51、9時〜24時営業）。営業中のみ勤務可。
; 客一人（Chara059「お客さん」流用）にフルコースの接客をする＝これが勤務の1単位（90分）。
; 時間制ではないので、一人終えたら通常のコマンド選択に戻る（続けるならもう一度実行する）。
; Hシーン本体は@ソープH_おまかせ（ソープランド.ERB、XCOM2820＋SOURCE_CHECKS）を
; COM_MESSAGE側から呼ぶ（店主援交がCOM_MESSAGE1005末尾から呼ばれるのと同パターン）。
; 歩合制のため月給・勤怠評価はなし。キャバ嬢(COMF1053)より実入りは大きいが消耗も大きい。
;=================================================
@XCOM_ABLE1054(ARG)
SIF !COM_PLACE_OK(1054) || !COM_TIME_OK(1054)
	RETURN 0
;客（Chara059）が未登録なら勤務不可
SIF GETCHARA(59) == -1
	RETURN 0
RETURN GLOBAL_COMABLE(1054)

@XCOM1054(ARG)
VARSET LOCAL
PRINTL
PRINTFORML %"=" * 107%
PRINTL 接客
;勤務の単位は「客一人」。基本コース90分で終わり、その後は通常のコマンド選択に戻る
;（客として受ける側の@ソープ接客_受ける＝90分と同じ単位。時間制ではなく1人単位）
CFLAG:MASTER:待機時間 = 90
DOWNBASE:ARG:体力 += CFLAG:ARG:待機時間 * 30 / 60
DOWNBASE:ARG:気力 += CFLAG:ARG:待機時間 * 50 / 60
DOWNBASE:ARG:疲労 -= CFLAG:ARG:待機時間 * 40 / 60
DOWNBASE:ARG:ストレス -= CFLAG:ARG:待機時間 * 40 / 60
;接客の経験を積む（獲得表示はSOURCE_CHECK_2が行う。性的な経験はH側のXCOM2820で入る）
EXP:ARG:接客経験 += 3
;報酬：技巧+10%/LV・接客技能+5%/LVで補正した客単価30000円の歩合5割。M:103に控え描写側で表示
LOCAL:1 = 100 + ABL:ARG:技巧 * 10 + ABL:ARG:接客技能 * 5
LOCAL = 15000 * LOCAL:1 / 100
MONEY:ARG += LOCAL
M:103 = LOCAL
M:101 = 0
RETURN 1

;接客の地の文（Hシーン込み。獲得経験はSOURCE_CHECK_2が自動表示する）
@COM_MESSAGE_1054
#DIM 客
SIF M:101 == 1
	RETURN 0
客 = GETCHARA(59)
PRINTL
PRINTL あなたは出勤簿に名前を入れ、薄いスリップに着替えて泡の間へ客を迎え入れた。
IF 客 != -1
	;客を店へ（乗車・睡眠は解除）
	CFLAG:客:現在地区 = 2
	CFLAG:客:現在位置 = 51
	CFLAG:客:乗車 = 0
	CFLAG:客:睡眠 = 0
	PRINTFORMW 泡を立てて客の体を丁寧に洗い上げ、ローションマットへと導いていく……。
	CALL ソープH_おまかせ(客, MASTER)
ENDIF
PRINTFORML 今日の稼ぎ +%金額(M:103)%円
M:101 = 1
