@XCOM_ABLE1012(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG

SIF CFLAG:LOCAL:現在位置 != 4 || CFLAG:LOCAL:現在地区 != 1
	RETURN 0
RETURN GLOBAL_COMABLE(1012)
@XCOM1012(ARG)
VARSET LOCAL
PRINTL 
PRINTFORML %"=" * 107%
PRINTL 入部届けを出す
;入部届けを出す
PRINTL 何部に入部しますか？

FOR LOCAL,1,MAX_CLUB() + 1
	SIF CLUB_NAME(LOCAL) == "" || LOCAL == CFLAG:ARG:部活
		CONTINUE
	LOCAL:1++
	PRINTFORMC [{LOCAL,2}] - %CLUB_NAME(LOCAL),20,LEFT%
	SIF LOCAL:1 % 2 == 0
		PRINTL 
NEXT
PRINTL 
PRINTL [99] - 戻る
PRINTL 
$INPUT_LOOP
INPUT
IF RESULT == 99
	RETURN 0
ELSEIF RESULT > 0 && RESULT <= MAX_CLUB() && CLUB_NAME(RESULT) != "" && RESULT != CFLAG:ARG:部活
	PRINTFORML %CLUB_NAME(RESULT)%に入部しました
	CFLAG:ARG:部活 = RESULT
	PRINT 部活は
	PRINTFORMW %PLACE_NAME_1(CLUB_PLACE(CFLAG:ARG:部活))%で行われます
ELSE
	CLEARLINE 1
	GOTO INPUT_LOOP
ENDIF
CALL 支配度加算(ARG, 1)
CFLAG:ARG:待機時間 += 10

VARSET ARG
RETURN 1
