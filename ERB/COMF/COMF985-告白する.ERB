;[告白する]（2026-07-16追加。恋愛.ERB の共通基盤を使用）
;会話イベント(3)中に相手へ告白する。成立条件は @告白可否（恋愛.ERB）を参照。
;屋上・公園では成立条件が緩和される。

@XCOM_ABLE985(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF TCVAR:LOCAL:イベント != 3
	RETURN 0
;既に恋人がいる（排他）／相手が家族／相手が既に恋人／今日すでに告白済みなら不可
SIF CFLAG:LOCAL:恋人相手 || TALENT:(TCVAR:LOCAL:行為対象):恋人 || TALENT:(TCVAR:LOCAL:行為対象):家族 || TCVAR:(TCVAR:LOCAL:行為対象):告白済
	RETURN 0
RETURN GLOBAL_COMABLE(985)

@XCOM985(ARG)
VARSET LOCAL
PRINTL
PRINTFORML %"=" * 107%

TFLAG:成否用変数 = 0
;同じ相手への連続告白は1日1回まで
TCVAR:(TCVAR:ARG:行為対象):告白済 = 1
PRINTFORML あなたは%CALLNAME:(TCVAR:ARG:行為対象)%に想いを告げた。
IF 告白可否(TCVAR:ARG:行為対象)
	TFLAG:成否用変数 = 1
	CALL 恋人成立(ARG, TCVAR:ARG:行為対象)
ELSE
	TFLAG:成否用変数 = -1
	TA:(TCVAR:ARG:行為対象):ARG:3 -= 10
	CALL 汎用口上(13, TCVAR:ARG:行為対象, ARG)
	CFLAG:ARG:待機時間 += 10
ENDIF
VARSET ARG
RETURN 1
