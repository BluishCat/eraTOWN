@XCOM_ABLE2103(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !TCVAR:LOCAL:行為対象
	RETURN 0
SIF !GETBIT(TALENT:(TCVAR:LOCAL:行為対象):2,1)
	RETURN 0
SIF !CAN_COM2103(TCVAR:LOCAL:行為対象,LOCAL)
	RETURN 0
SIF TEQUIP:(TCVAR:LOCAL:行為対象):下半身下着 == 373
	RETURN 0
;道具男性器抵抗時は取り敢えずスルー
SIF TEQUIP:LOCAL:アナル == 79
	RETURN 0
;男性器抵抗時は取り敢えずスルー
SIF TEQUIP:LOCAL:アナル == 78
	RETURN 0
;男性器のみ抵抗時CFLAGは取り敢えずスルー
SIF CFLAG:LOCAL:ＡオンリーＴ == 1
	RETURN 0
;対象者が男性器でオナホール装着時は不可
SIF (GETBIT(TALENT:(TCVAR:LOCAL:行為対象):2,1)) && (TEQUIP:(TCVAR:LOCAL:行為対象):クリトリス == 80)
	RETURN 0
;対象者が縄装着時は不可
SIF TEQUIP:(TCVAR:LOCAL:行為対象):縄
	RETURN 0
;;;2012/02/07 対象の　従順3以上　または　従順2かつ屈服刻印2以上　以外は無理にした
SIF !(ABL:(TCVAR:LOCAL:行為対象):従順 >= 3) && !((ABL:(TCVAR:LOCAL:行為対象):従順 == 2) && (MARK:(TCVAR:LOCAL:行為対象):屈服刻印 >= 2))
	RETURN 0
;対象者が男性器なし且つ両者共がペニスバンドなし
SIF !GETBIT(TALENT:(TCVAR:LOCAL:行為対象):2,1) && EQUIP:LOCAL:ペニスバンド == 0 && EQUIP:(TCVAR:LOCAL:行為対象):ペニスバンド == 0
	RETURN 0

RETURN GLOBAL_COMABLE(2103)
;-------------------------------------------------
;後背位Ａさせる
;-------------------------------------------------
@XCOM2103(ARG)
VARSET LOCAL

PRINTL 
PRINTFORML %"=" * 107%
PRINTFORML 後背位Ａさせる(%CALLNAME:ARG%,%CALLNAME:(TCVAR:ARG:行為対象)%)
SIF ARG == MASTER || TCVAR:ARG:行為対象 == MASTER
	CALL 汎用口上(4, TCVAR:ARG:行為対象, ARG)

;道具のみ抵抗時はCFLAG立て
IF TEQUIP:ARG:アナル == 77
	CFLAG:ARG:ＡオンリーＰ = 1
ENDIF

TEQUIP:ARG:アナル = 0
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:ARG:体力 += 40
DOWNBASE:ARG:気力 += 80
DOWNBASE:(TCVAR:ARG:行為対象):体力 += 80
DOWNBASE:(TCVAR:ARG:行為対象):気力 += 120

SOURCE:(TCVAR:ARG:行為対象):性行動 = 120
SOURCE:(TCVAR:ARG:行為対象):快Ｃ = 300

SOURCE:ARG:快Ａ = 400
SOURCE:ARG:情愛 = 100
SOURCE:ARG:苦痛 = 900
SOURCE:ARG:露出 = 80
;SIF CFLAG:193
;	SOURCE:露出 = 300
SOURCE:ARG:逸脱 = 200
SOURCE:(TCVAR:ARG:行為対象):反感 = 500

SOURCE:(TCVAR:ARG:行為対象):不潔 = STATIN_POINT(ARG,1) * (2 - TALENT:(TCVAR:ARG:行為対象):汚臭耐性) * 5 + 60
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
	SOURCE:ARG:鬱屈 += 500

;Aへの苦痛は先に処理しておく
CALL PAIN_CHECK_A(ARG)

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;奴隷のＡ⇔調教者のＰの汚れが移動
STAIN:(TCVAR:ARG:行為対象):2 |= STAIN:ARG:4
STAIN:(TCVAR:ARG:行為対象):2 |= STAIN:ARG:7
STAIN:ARG:4 |= STAIN:(TCVAR:ARG:行為対象):2
STAIN:ARG:7 |= STAIN:(TCVAR:ARG:行為対象):2

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;;;EXP:ARG:Ａ経験 ++
EXP:ARG:Ａ性交経験 ++
EXP:(TCVAR:ARG:行為対象):Ｃ挿入経験 ++

CALL HETEROSEX_EXP(TCVAR:ARG:行為対象,ARG,4)
TCVAR:(TCVAR:ARG:行為対象):挿入 = 2
CFLAG:ARG:待機時間 += 2


VARSET ARG
RETURN 1

@CAN_COM2103(ARG,ARG:1)
#FUNCTION
;;;VARSET LOCAL

;縄で縛られている場合は無視（縄が無い時のみ実行判定を行う）
SIF TEQUIP:(ARG:1):縄 == 1
	RETURNF 1

A = 0
;すべての命令に共通の要素を考慮
;(従順が高いと命令に従いやすいなど)
A = COM_ORDER(ARG,ARG:1)

;ABL:欲望
IF ABL:(ARG:1):欲望
	A += ABL:(ARG:1):欲望 * 3
ENDIF
;ABL:Ａ感覚
IF ABL:(ARG:1):Ａ感覚
	A += ABL:(ARG:1):Ａ感覚 * 2
ENDIF
;快楽刻印
IF MARK:(ARG:1):快楽刻印
	A += MARK:(ARG:1):快楽刻印 * 3
ENDIF
;PALAM:潤滑（の不足）
IF PALAM:(ARG:1):潤滑 < PALAMLV:3
	A -= 5
ENDIF
;PALAM:欲情
IF GETPALAMLV(PALAM:(ARG:1):欲情,5)
	A += GETPALAMLV(PALAM:(ARG:1):欲情,5) * 3
ENDIF
;恥じらい
IF TALENT:(ARG:1):羞恥心 > 0
	A -= 2
ENDIF
;快感の否定
IF TALENT:(ARG:1):快感応答 < 0 && !TALENT:(ARG:1):淫乱
	A -= 5
ENDIF
;男嫌い（恋慕、親愛で無効）
IF TALENT:(ARG:1):性別嗜好 & 1 && !(TALENT:ARG:2 & 1) && !LOVE_CHECK(ARG:1,ARG)
	A -= 12
ENDIF
;淫乱
IF TALENT:(ARG:1):淫乱
	A += 15
ENDIF
;A経験
IF EXP:(ARG:1):Ａ経験 < EXPLV:2
	A -= 30
ENDIF
;調教者がふたなり
IF (TALENT:ARG:2 & 3) == 3
	A += 4
ENDIF

;媚薬
IF TEQUIP:(ARG:1):媚薬
	A += 6
ENDIF

;汚れあり
IF STATIN_POINT(ARG,2)
	A -= STATIN_POINT(ARG,2) * (2 - TALENT:(ARG:1):汚臭耐性) / 2
ENDIF


;実行できない
SIF A < 32
	RETURNF 0
RETURNF 1
