@XCOM_ABLE2020(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !TCVAR:LOCAL:行為対象
	RETURN 0
SIF !CAN_COM2020(LOCAL,TCVAR:LOCAL:行為対象)
	RETURN 0
;ボールギャグ装着時は不可
SIF TEQUIP:LOCAL:ボールギャグ
	RETURN 0
;相手がボールギャグ装着時は可（不可にしたければコメント外す）
;;;SIF TEQUIP:(TCVAR:LOCAL:行為対象):ボールギャグ
;;;	RETURN 0

;MASTER関与時、既にキス中なら再選択不可（解除は[✕]992）
SIF (LOCAL == MASTER || TCVAR:LOCAL:行為対象 == MASTER) && TCVAR:MASTER:キス中
	RETURN 0

;背面系体位（後背位/背面座位/貝合わせ）で結合中は顔が届かずキス不可
SIF (TCVAR:LOCAL:挿入 || 生身被挿入部位(LOCAL)) && 背面体位中(LOCAL)
	RETURN 0

RETURN GLOBAL_COMABLE(2020)
;-------------------------------------------------
;キス
;-------------------------------------------------
@XCOM2020(ARG)
VARSET LOCAL

PRINTL 
PRINTFORML %"=" * 107%
PRINTFORML キス(%CALLNAME:ARG%,%CALLNAME:(TCVAR:ARG:行為対象)%)
SIF ARG == MASTER || TCVAR:ARG:行為対象 == MASTER
	CALL 汎用口上(2, TCVAR:ARG:行為対象, ARG)
;;;口上呼び出し（どっちかが1の場合のみ）
SIF ARG == 1 || (TCVAR:ARG:行為対象) == 1
	PRINTL
	CALL NMESSAGE_2020(ARG,TCVAR:ARG:行為対象)
;キス中フラグ（MASTERが関与する場合に立てる。「キスをやめる」で解除可能。COM20と同仕様）
SIF ARG == MASTER || TCVAR:ARG:行為対象 == MASTER
	TCVAR:MASTER:キス中 = 1
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:(TCVAR:ARG:行為対象):体力 += 0
DOWNBASE:(TCVAR:ARG:行為対象):気力 += 20

SOURCE:ARG:性行動 = 10
SOURCE:(TCVAR:ARG:行為対象):情愛 = 50
SOURCE:(TCVAR:ARG:行為対象):性行動 = 10
SOURCE:(TCVAR:ARG:行為対象):屈従 = 10
SOURCE:(TCVAR:ARG:行為対象):逸脱 = 10
SOURCE:(TCVAR:ARG:行為対象):反感 = 10

SOURCE:(TCVAR:ARG:行為対象):不潔 = STATIN_POINT(ARG,0) * (2 - TALENT:(TCVAR:ARG:行為対象):汚臭耐性) * 5 + 10


;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:(TCVAR:ARG:行為対象):自己愛 < 0 || TALENT:(TCVAR:ARG:行為対象):抵抗
	SOURCE:(TCVAR:ARG:行為対象):鬱屈 += 10

;舌を使う調教では、調教者の舌使いによって、快感のソース増加
SIF TALENT:ARG:舌使い
	TIMES SOURCE:(TCVAR:ARG:行為対象):情愛 , 1.50


;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷の口⇔調教者の口の汚れが移動
STAIN:(TCVAR:ARG:行為対象):0 |= STAIN:ARG:0
STAIN:ARG:0 |= STAIN:(TCVAR:ARG:行為対象):0

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL HETEROSEX_EXP(ARG,TCVAR:ARG:行為対象,3)



EXP:(TCVAR:ARG:行為対象):キス経験 ++
EXP:ARG:キス経験 ++
CFLAG:ARG:待機時間 += 2

;;;従順4以上で愛情に+1
SIF ABL:(TCVAR:ARG:行為対象):10 >= 4
	TA:(TCVAR:ARG:行為対象):ARG:2 += 1


VARSET ARG

RETURN 1

@CAN_COM2020(ARG,ARG:1)
#FUNCTION
;;;VARSET LOCAL
;-------------------------------------------------
;実行できるかの判定
;-------------------------------------------------

A = 0
;すべての命令に共通の要素を考慮
;(従順が高いと命令に従いやすいなど)
A = COM_ORDER(ARG,ARG:1)

;ABL:欲望
IF ABL:(TCVAR:ARG:行為対象):欲望
	A += ABL:(ARG:1):欲望 * 1
ENDIF
;ABL:奉仕精神
IF ABL:(ARG:1):奉仕精神
	A += ABL:(ARG:1):奉仕精神 * 4
ENDIF

IF MARK:(ARG:1):快楽刻印
	A += MARK:(ARG:1):快楽刻印 * 2
ENDIF

;PALAM:欲情
IF GETPALAMLV(PALAM:(ARG:1):欲情,5)
	A += GETPALAMLV(PALAM:(ARG:1):欲情,5) * 1
ENDIF

;恥じらい
IF TALENT:(ARG:1):羞恥心 > 0
	A -= 1
ENDIF
;汚臭鈍感
IF TALENT:(ARG:1):汚臭耐性 > 0
	A += 1
ENDIF
;汚臭敏感
IF TALENT:(ARG:1):汚臭耐性 < 0
	A -= 1
ENDIF
;献身的
IF TALENT:(ARG:1):献身的
	A += 6
ENDIF
;快感の否定（淫乱、娼婦で無効）
IF TALENT:(ARG:1):快感応答 < 0 && !TALENT:(ARG:1):淫乱
	A -= 1
ENDIF

;キスでは汚れがそれほど影響しない

;汚れあり
IF STATIN_POINT(ARG,0)
	A -= STATIN_POINT(ARG,0) * (2 - TALENT:(ARG:1):汚臭耐性) / 4
ENDIF


;実行できない
SIF A < 15
	RETURNF 0
RETURNF 1

