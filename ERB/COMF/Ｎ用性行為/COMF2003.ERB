@XCOM_ABLE2003(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !TCVAR:LOCAL:行為対象
	RETURN 0

SIF !GETBIT(TALENT:(TCVAR:LOCAL:行為対象):2,1)
	RETURN 0
SIF TEQUIP:(TCVAR:LOCAL:行為対象):下半身下着 == 373
	RETURN 0
;対象者がオナホール装着時は不可
SIF TEQUIP:(TCVAR:LOCAL:行為対象):クリトリス == 80
	RETURN 0
;ボールギャグ装着時は不可
SIF TEQUIP:LOCAL:ボールギャグ
	RETURN 0

;生身挿入中（自分または相手が結合中）は解かないと不可
SIF TCVAR:LOCAL:挿入 || TCVAR:LOCAL:被挿入 || TCVAR:(TCVAR:LOCAL:行為対象):挿入
	RETURN 0
;キス中（口が塞がっている）は不可
SIF 口キス中(LOCAL)
	RETURN 0

RETURN GLOBAL_COMABLE(2003)
;-------------------------------------------------
;フェラする
;-------------------------------------------------
@XCOM2003(ARG)
VARSET LOCAL

PRINTL 
PRINTFORML %"=" * 107%
PRINTFORML フェラする(%CALLNAME:ARG%,%CALLNAME:(TCVAR:ARG:行為対象)%)
SIF ARG == MASTER || TCVAR:ARG:行為対象 == MASTER
	CALL 汎用口上(6, TCVAR:ARG:行為対象, ARG)
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:(TCVAR:ARG:行為対象):体力 += 5
DOWNBASE:(TCVAR:ARG:行為対象):気力 += 50

SOURCE:ARG:性行動 = 30
SOURCE:(TCVAR:ARG:行為対象):快Ｃ = 110
SOURCE:(TCVAR:ARG:行為対象):露出 = 20
SOURCE:(TCVAR:ARG:行為対象):逸脱 = 20
SOURCE:(TCVAR:ARG:行為対象):反感 = 20

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:(TCVAR:ARG:行為対象):自己愛 < 0 || TALENT:(TCVAR:ARG:行為対象):抵抗
	SOURCE:(TCVAR:ARG:行為対象):鬱屈 += 20

;調教者のTALENT:舌使いをみる
SIF TALENT:ARG:舌使い
	TIMES SOURCE:(TCVAR:ARG:行為対象):快Ｃ , 1.50

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＰ⇔調教者の口の汚れが移動
STAIN:(TCVAR:ARG:行為対象):2 |= STAIN:ARG:0
STAIN:ARG:0 |= STAIN:(TCVAR:ARG:行為対象):2

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
CALL HETEROSEX_EXP(ARG,TCVAR:ARG:行為対象,3)



;口淫経験
EXP:ARG:口淫経験 ++
;フェラ経験
EXP:ARG:フェラ経験 ++
CFLAG:ARG:待機時間 += 2

VARSET ARG
RETURN 1
