@XCOM2199(ARG)
VARSET LOCAL
IF (ARG == 1) || ((TCVAR:ARG:行為対象) == 1)
	PRINTL 
	PRINTFORML %"=" * 107%
	PRINTFORML 何もしない(%CALLNAME:ARG%,%CALLNAME:(TCVAR:ARG:行為対象)%)
ENDIF
