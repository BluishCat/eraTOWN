;バイブ
@XCOM_ABLE2044(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !TCVAR:LOCAL:行為対象
	RETURN 0
SIF !GETBIT(TALENT:(TCVAR:LOCAL:行為対象):2,0)
	RETURN 0
SIF !EQUIP:LOCAL:バイブ
	RETURN 0
;NPCは道具を常時携帯しない → 低確率でのみ使用
SIF LOCAL != MASTER && RAND(100) >= 15
	RETURN 0
SIF TEQUIP:(TCVAR:LOCAL:行為対象):下半身下着 == 373
	RETURN 0
;道具男性器抵抗時は取り敢えずスルー
SIF TEQUIP:(TCVAR:LOCAL:行為対象):膣 == 19
	RETURN 0
;道具抵抗時は取り敢えずスルー
SIF TEQUIP:(TCVAR:LOCAL:行為対象):膣 == 17
	RETURN 0
;道具のみ抵抗時CFLAGは取り敢えずスルー
SIF CFLAG:(TCVAR:LOCAL:行為対象):ＶオンリーＰ == 1
	RETURN 0
;行為者が縄装着時は不可
SIF TEQUIP:LOCAL:縄
	RETURN 0
;;;2012/02/07 従順3以上　または　従順2かつ屈服刻印2以上　以外は無理にした
SIF !(ABL:(TCVAR:LOCAL:行為対象):従順 >= 3) && !((ABL:(TCVAR:LOCAL:行為対象):従順 == 2) && (MARK:(TCVAR:LOCAL:行為対象):屈服刻印 >= 2))
	RETURN 0

;膣に生身挿入中／既に器具挿入中なら不可
SIF TCVAR:LOCAL:挿入 == 1
	RETURN 0
SIF TEQUIP:(TCVAR:LOCAL:行為対象):膣 == 1
	RETURN 0

RETURN GLOBAL_COMABLE(2044)

;-------------------------------------------------
;バイブ
;-------------------------------------------------
@XCOM2044(ARG)
VARSET LOCAL

PRINTL 
PRINTFORML %"=" * 107%
PRINTFORML バイブ(%CALLNAME:ARG%,%CALLNAME:(TCVAR:ARG:行為対象)%)
SIF ARG == MASTER || TCVAR:ARG:行為対象 == MASTER
	CALL 汎用口上(3, TCVAR:ARG:行為対象, ARG)

;男性器のみ抵抗時はCFLAG立て
IF TEQUIP:(TCVAR:ARG:行為対象):膣 == 18
	CFLAG:(TCVAR:ARG:行為対象):ＶオンリーＴ = 1
ENDIF

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF !TEQUIP:(TCVAR:ARG:行為対象):膣 == 1
	DOWNBASE:(TCVAR:ARG:行為対象):体力 += 30
	DOWNBASE:(TCVAR:ARG:行為対象):気力 += 100
	
	SOURCE:(TCVAR:ARG:行為対象):快Ｖ = 250
	SOURCE:(TCVAR:ARG:行為対象):苦痛 = 50
	SOURCE:(TCVAR:ARG:行為対象):露出 = 20
	SOURCE:(TCVAR:ARG:行為対象):逸脱 = 40
	SOURCE:(TCVAR:ARG:行為対象):反感 = 40
ELSE
	DOWNBASE:(TCVAR:ARG:行為対象):体力 += 20
	DOWNBASE:(TCVAR:ARG:行為対象):気力 += 30
	
	SOURCE:(TCVAR:ARG:行為対象):快Ｖ = 40
	SOURCE:(TCVAR:ARG:行為対象):苦痛 = 20
	SOURCE:(TCVAR:ARG:行為対象):露出 = 10
	SOURCE:(TCVAR:ARG:行為対象):逸脱 = 10
	SOURCE:(TCVAR:ARG:行為対象):反感 = 10
ENDIF

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
IF !TEQUIP:(TCVAR:ARG:行為対象):膣 == 1
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:(TCVAR:ARG:行為対象):自己愛 < 0 || TALENT:(TCVAR:ARG:行為対象):抵抗
		SOURCE:(TCVAR:ARG:行為対象):鬱屈 += 40
ENDIF

;処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:(TCVAR:ARG:行為対象):処女 == 1
	SOURCE:(TCVAR:ARG:行為対象):苦痛 += 2000
	SOURCE:(TCVAR:ARG:行為対象):反感 += 3000
ENDIF

;再生処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:(TCVAR:ARG:行為対象):処女 == 2
	SOURCE:(TCVAR:ARG:行為対象):苦痛 += 500
	SOURCE:(TCVAR:ARG:行為対象):反感 += 1000
ENDIF

;Vへの苦痛は先に処理しておく
CALL PAIN_CHECK_V(TCVAR:ARG:行為対象)

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;挿入時はＶ経験+
;EXP:(TCVAR:ARG:行為対象):Ｖ経験 ++

;異常経験
IF TALENT:(TCVAR:ARG:行為対象):処女 == 1 && !GETBIT(CFLAG:(TCVAR:ARG:行為対象):異常経験,3)
	EXP:異常経験 ++
	SETBIT CFLAG:(TCVAR:ARG:行為対象):異常経験,3
ENDIF

CALL HETEROSEX_EXP(ARG,TCVAR:ARG:行為対象,1)
CFLAG:ARG:待機時間 += 2

IF TEQUIP:(TCVAR:ARG:行為対象):膣 == 1
	TEQUIP:(TCVAR:ARG:行為対象):膣 = 0
ELSE
	TEQUIP:(TCVAR:ARG:行為対象):膣 = 1
ENDIF

TCVAR:(TCVAR:ARG:行為対象):被挿入 = 1

EXP:ARG:道具使用経験 ++
VARSET ARG
RETURN 1

