@XCOM_ABLE2060(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !TCVAR:LOCAL:行為対象
	RETURN 0
;挿入器具と衝突する体位は不可
SIF 体位器具衝突(2060, LOCAL, TCVAR:LOCAL:行為対象)
	RETURN 0
SIF !GETBIT(TALENT:LOCAL:2,1)
	RETURN 0
SIF !GETBIT(TALENT:(TCVAR:LOCAL:行為対象):2,0)
	RETURN 0
SIF !CAN_COM2060(LOCAL,TCVAR:LOCAL:行為対象)
	RETURN 0
SIF TEQUIP:(TCVAR:LOCAL:行為対象):下半身下着 == 373
	RETURN 0
SIF TEQUIP:LOCAL:下半身下着 == 373
	RETURN 0
;道具男性器抵抗時は取り敢えずスルー
SIF TEQUIP:(TCVAR:LOCAL:行為対象):膣 == 19
	RETURN 0
;男性器抵抗時は取り敢えずスルー
SIF TEQUIP:(TCVAR:LOCAL:行為対象):膣 == 18
	RETURN 0
;男性器のみ抵抗時CFLAGは取り敢えずスルー
SIF CFLAG:(TCVAR:LOCAL:行為対象):ＶオンリーＴ == 1
	RETURN 0
;行為者が男性器でオナホール装着時は不可
SIF (GETBIT(TALENT:LOCAL:2,1)) && (TEQUIP:LOCAL:クリトリス == 80)
	RETURN 0
;行為者が縄装着時は不可
SIF TEQUIP:LOCAL:縄
	RETURN 0
;;;2012/02/07 従順3以上　または　従順2かつ屈服刻印2以上　以外は無理にした
SIF !(ABL:(TCVAR:LOCAL:行為対象):従順 >= 3) && !((ABL:(TCVAR:LOCAL:行為対象):従順 == 2) && (MARK:(TCVAR:LOCAL:行為対象):屈服刻印 >= 2))
	RETURN 0
;行為者が男性器なし且つペニスバンドなし
SIF !GETBIT(TALENT:LOCAL:2,1) && EQUIP:LOCAL:ペニスバンド == 0
	RETURN 0

RETURN GLOBAL_COMABLE(2060)

;-------------------------------------------------
;正常位
;-------------------------------------------------
@XCOM2060(ARG)
VARSET LOCAL

PRINTL 
PRINTFORML %"=" * 107%
PRINTFORML 正常位(%CALLNAME:ARG%,%CALLNAME:(TCVAR:ARG:行為対象)%)
SIF ARG == MASTER || TCVAR:ARG:行為対象 == MASTER
	CALL 汎用口上(3, TCVAR:ARG:行為対象, ARG)

;道具のみ抵抗時はCFLAG立て
IF TEQUIP:(TCVAR:ARG:行為対象):膣 == 17
	CFLAG:(TCVAR:ARG:行為対象):ＶオンリーＰ = 1
ENDIF

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:(TCVAR:ARG:行為対象):体力 += 20
DOWNBASE:(TCVAR:ARG:行為対象):気力 += 80
DOWNBASE:ARG:体力 += 50
DOWNBASE:ARG:気力 += 100

SOURCE:ARG:性行動 = 100
SOURCE:ARG:快Ｃ = 300
SOURCE:(TCVAR:ARG:行為対象):快Ｖ = 400
SOURCE:(TCVAR:ARG:行為対象):情愛 = 150
SOURCE:(TCVAR:ARG:行為対象):苦痛 = 500
SOURCE:(TCVAR:ARG:行為対象):露出 = 50
;SIF CFLAG:193
;	SOURCE:露出 = 300
SOURCE:(TCVAR:ARG:行為対象):反感 = 300

SOURCE:(TCVAR:ARG:行為対象):不潔 = STATIN_POINT(ARG,1) * (2 - TALENT:(TCVAR:ARG:行為対象):汚臭耐性) * 5 + 60

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:(TCVAR:ARG:行為対象):自己愛 < 0 || TALENT:(TCVAR:ARG:行為対象):抵抗
	SOURCE:(TCVAR:ARG:行為対象):鬱屈 += 300

;貞操観念持ちで恋慕、親愛持ち以外には常に反発のソースを追加する（セックス系のみ）
SIF TALENT:(TCVAR:ARG:行為対象):貞操 > 0 && !LOVE_CHECK(TCVAR:ARG:行為対象,ARG)
	SOURCE:(TCVAR:ARG:行為対象):反感 += 1000

;処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:(TCVAR:ARG:行為対象):処女 == 1
	SOURCE:(TCVAR:ARG:行為対象):苦痛 += 2000
	SOURCE:(TCVAR:ARG:行為対象):反感 += 3000
ENDIF

;再生処女だった場合は、苦痛のソースと反発のソースを追加する
IF TALENT:(TCVAR:ARG:行為対象):処女 == 2
	SOURCE:(TCVAR:ARG:行為対象):苦痛 += 500
	SOURCE:(TCVAR:ARG:行為対象):反感 += 1000
ENDIF

;Vへの苦痛は先に処理しておく
CALL PAIN_CHECK_V(TCVAR:ARG:行為対象)

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;膣内に破瓜の血の汚れを付加
SIF TALENT:(TCVAR:ARG:行為対象):処女
	STAIN:(TCVAR:ARG:行為対象):6 |= 64
;奴隷の膣内⇔調教者のＰの汚れが移動
STAIN:ARG:2 |= STAIN:(TCVAR:ARG:行為対象):3
STAIN:ARG:2 |= STAIN:(TCVAR:ARG:行為対象):6
STAIN:(TCVAR:ARG:行為対象):3 |= STAIN:ARG:2
STAIN:(TCVAR:ARG:行為対象):6 |= STAIN:ARG:2

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
EXP:(TCVAR:ARG:行為対象):Ｖ性交経験 ++
EXP:ARG:Ｃ挿入経験 ++

CALL HETEROSEX_EXP(ARG,TCVAR:ARG:行為対象,4)
TCVAR:ARG:挿入 = 1

TCVAR:(TCVAR:ARG:行為対象):被挿入 = 1

CFLAG:ARG:待機時間 += 2

VARSET ARG
RETURN 1

@CAN_COM2060(ARG,ARG:1)
#FUNCTION
;;;VARSET LOCAL
;縄で縛られている場合は無視（縄が無い時のみ実行判定を行う）
SIF TEQUIP:(ARG:1):縄 == 1
	RETURNF 1

A = 0
;すべての命令に共通の要素を考慮
;(従順が高いと命令に従いやすいなど)
A = COM_ORDER(ARG,ARG:1)

;ABL:欲望
IF ABL:(ARG:1):欲望
	A += ABL:(ARG:1):欲望 * 3
ENDIF
;ABL:Ｖ感覚
IF ABL:(ARG:1):Ｖ感覚
	A += ABL:(ARG:1):Ｖ感覚 * 2
ENDIF
;快楽刻印
IF MARK:(ARG:1):快楽刻印
	A += MARK:(ARG:1):快楽刻印 * 3
ENDIF
;PALAM:潤滑（の不足）
IF PALAM:(ARG:1):潤滑 < PALAMLV:3
	A -= 5
ENDIF
;PALAM:欲情
IF GETPALAMLV(PALAM:(ARG:1):欲情,5)
	A += GETPALAMLV(PALAM:(ARG:1):欲情,5) * 3
ENDIF
;恥じらい
IF TALENT:(ARG:1):羞恥心 > 0
	A -= 2
ENDIF
;快感の否定
IF TALENT:(ARG:1):快感応答 < 0 && !LOVE_CHECK(ARG:1,ARG)
	A -= 5
ENDIF
;男嫌い（恋慕、親愛で無効）
IF TALENT:(ARG:1):性別嗜好 & 1 && !(TALENT:ARG:2 & 1) && !LOVE_CHECK(ARG:1,ARG)
	A -= 12
ENDIF
;処女
IF TALENT:(ARG:1):処女
	A -= MAX(10,40 - EXP:(ARG:1):Ｖ経験)
;V経験
ELSEIF EXP:(ARG:1):Ｖ経験 < EXPLV:2
	A -= 15
ENDIF

;調教者がふたなり
IF (TALENT:ARG:2 & 3) == 3
	A += 4
ENDIF

;媚薬
IF TEQUIP:(ARG:1):媚薬
	A += 6
ENDIF
;汚れあり
IF STATIN_POINT(ARG,2)
	A -= STATIN_POINT(ARG,2) * (2 - TALENT:(ARG:1):汚臭耐性) / 2
ENDIF

;実行できない
SIF A < 20
	RETURNF 0
RETURNF 1

