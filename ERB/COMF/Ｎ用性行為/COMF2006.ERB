@XCOM_ABLE2006(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !TCVAR:LOCAL:行為対象
	RETURN 0
;縄装着時は不可
SIF TEQUIP:LOCAL:縄
	RETURN 0

;;;2012/02/07 従順1以上　以外は無理にした
SIF !(ABL:(TCVAR:LOCAL:行為対象):従順 >= 1)
	RETURN 0

;アナルに生身挿入中／既に器具挿入中なら不可
SIF TCVAR:LOCAL:挿入 == 2
	RETURN 0
SIF TEQUIP:(TCVAR:LOCAL:行為対象):アナル >= 60 && TEQUIP:(TCVAR:LOCAL:行為対象):アナル <= 62
	RETURN 0

RETURN GLOBAL_COMABLE(2006)
;-------------------------------------------------
;アナル愛撫
;-------------------------------------------------
@XCOM2006(ARG)
VARSET LOCAL

PRINTL 
PRINTFORML %"=" * 107%
PRINTFORML アナル愛撫(%CALLNAME:ARG%,%CALLNAME:(TCVAR:ARG:行為対象)%)
SIF ARG == MASTER || TCVAR:ARG:行為対象 == MASTER
	CALL 汎用口上(2, TCVAR:ARG:行為対象, ARG)
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
DOWNBASE:(TCVAR:ARG:行為対象):体力 += 40
DOWNBASE:(TCVAR:ARG:行為対象):気力 += 100

SOURCE:ARG:性行動 = 50
SOURCE:(TCVAR:ARG:行為対象):快Ａ = 100
SOURCE:(TCVAR:ARG:行為対象):苦痛 = 100
SOURCE:(TCVAR:ARG:行為対象):屈従 = 100
SOURCE:(TCVAR:ARG:行為対象):逸脱 = 80
SOURCE:(TCVAR:ARG:行為対象):反感 = 60
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:(TCVAR:ARG:行為対象):自己愛 < 0 || TALENT:(TCVAR:ARG:行為対象):抵抗
	SOURCE:(TCVAR:ARG:行為対象):鬱屈 += 100

;Aへの苦痛は先に処理しておく
CALL PAIN_CHECK_A(TCVAR:ARG:行為対象)
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＡ⇔調教者の指の汚れが移動
STAIN:ARG:1 |= STAIN:(TCVAR:ARG:行為対象):4
STAIN:ARG:1 |= STAIN:(TCVAR:ARG:行為対象):7
STAIN:(TCVAR:ARG:行為対象):4 |= STAIN:ARG:1
STAIN:(TCVAR:ARG:行為対象):7 |= STAIN:ARG:1
;-------------------------------------------------
;経験の処理
CALL HETEROSEX_EXP(ARG,TCVAR:ARG:行為対象,2)

;手淫経験
EXP:ARG:手淫経験 ++

CFLAG:ARG:待機時間 += 2

VARSET ARG
RETURN 1
