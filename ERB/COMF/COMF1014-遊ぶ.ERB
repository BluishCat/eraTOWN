@XCOM_ABLE1014(ARG)
VARSET LOCAL
LOCAL = ARG
VARSET ARG
SIF !GETBIT(DA:(CFLAG:LOCAL:現在地区):(CFLAG:LOCAL:現在位置),4)
	RETURN 0
;営業時間外は遊べない
SIF !営業中(CFLAG:LOCAL:現在地区, CFLAG:LOCAL:現在位置)
	RETURN 0
RETURN GLOBAL_COMABLE(1014)
@XCOM1014(ARG)
VARSET LOCAL
PRINTL 
PRINTFORML %"=" * 107%
;遊ぶ
;--- 遊技場ごとの単価・所要時間・満足度(2026-08-30)
;それまで場所に関係なく一律1000円/60分で、カラオケ屋とゲームセンターに差がなかった。
;LOCAL:1 料金 / LOCAL:2 所要分 / LOCAL:3 体力消費 / LOCAL:4 気力消費 / LOCAL:5 疲労増加
;LOCAL:6 ストレス解消 / LOCAL:7 歓楽 / LOCAL:8 同席時の会話経験
;遊技場あり(bit4)を増やした時はここにCASEを足す（漏れても既定値で動く）
LOCAL:1 = 1000
LOCAL:2 = 60
LOCAL:3 = 100
LOCAL:4 = 120
LOCAL:5 = 100
LOCAL:6 = 300
LOCAL:7 = 1000
LOCAL:8 = 2
IF CFLAG:ARG:現在地区 == 2
	SELECTCASE CFLAG:ARG:現在位置
		;カラオケ屋：高くて長いが、一緒に歌う分いちばん打ち解ける
		CASE 7
			LOCAL:1 = 1000
			LOCAL:2 = 60
			LOCAL:3 = 120
			LOCAL:4 = 100
			LOCAL:5 = 120
			LOCAL:6 = 400
			LOCAL:7 = 1200
			LOCAL:8 = 3
		;ゲームセンター：安く短く済む。そのぶん気晴らしも小さい
		CASE 8
			LOCAL:1 = 500
			LOCAL:2 = 30
			LOCAL:3 = 60
			LOCAL:4 = 60
			LOCAL:5 = 50
			LOCAL:6 = 200
			LOCAL:7 = 800
			LOCAL:8 = 1
	ENDSELECT
ENDIF

IF MONEY:ARG < LOCAL:1
	PRINTW お金が足りません
	RETURN 0
ENDIF

DOWNBASE:ARG:体力 += LOCAL:3
DOWNBASE:ARG:気力 += LOCAL:4
CFLAG:ARG:待機時間 = LOCAL:2
DOWNBASE:ARG:疲労 -= LOCAL:5
DOWNBASE:ARG:ストレス += LOCAL:6
MONEY:ARG -= LOCAL:1

;;;	支配度に＋２、相手に＋２
CALL 支配度加算(ARG, 2)
IF TCVAR:ARG:行為対象
	TB:(CFLAG:ARG:現在地区):(CFLAG:ARG:現在位置):(TCVAR:ARG:行為対象) += 2
	DOWNBASE:(TCVAR:ARG:行為対象):体力 += LOCAL:3
	DOWNBASE:(TCVAR:ARG:行為対象):気力 += LOCAL:4

	CFLAG:(TCVAR:ARG:行為対象):待機時間 = LOCAL:2
	SOURCE:(TCVAR:ARG:行為対象):歓楽 = LOCAL:7
	EXP:ARG:会話経験 += LOCAL:8
	EXP:(TCVAR:ARG:行為対象):会話経験 += LOCAL:8
ENDIF
;一人で遊んだ時も歓楽は入る。
;従来はここが SOURCE:(TCVAR:ARG:行為対象):歓楽 の読み込みで、相手がいない時は
;キャラ0の歓楽（＝常に0）を代入していたため、ソロだと何も入っていなかった(2026-08-30)
SOURCE:ARG:歓楽 = LOCAL:7

VARSET ARG
RETURN 1


