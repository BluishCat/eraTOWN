;=================================================
; 会社員の勤務コマンド「会社で働く」（身分システム：会社員 cflag:仕事==5）
; 教師版COMF1050と同型。場所・時間・身分の条件は中央テーブル（COM_PROFILE.ERB）で宣言。
; 勤務地はオフィスビル（地区2・位置29）、平日9:00-18:00の午前/午後2コマ制。
; 12:30-13:30は昼休み（@COM_TIME_OKが弾く）。この間はCOMF1010「お昼を食べる」等に回る。
;=================================================
@XCOM_ABLE1051(ARG)
SIF !COM_PLACE_OK(1051) || !COM_TIME_OK(1051)
	RETURN 0
RETURN GLOBAL_COMABLE(1051)

@XCOM1051(ARG)
VARSET LOCAL
PRINTL
PRINTFORML %"=" * 107%
PRINTL 仕事
;午前は12:30まで、昼休みを挟んで午後（13:30〜）は18:00まで拘束し、出勤(出席)ビットを立てる
IF TIME < 750
	CFLAG:MASTER:待機時間 = 750 - TIME
	SETBIT CFLAG:MASTER:出席,0
ELSE
	CFLAG:MASTER:待機時間 = 1080 - TIME
	SETBIT CFLAG:MASTER:出席,1
ENDIF
;デスクワーク：気力を中心に消耗する
DOWNBASE:ARG:体力 += CFLAG:ARG:待機時間 * 15 / 60
DOWNBASE:ARG:気力 += CFLAG:ARG:待機時間 * 35 / 60
DOWNBASE:ARG:疲労 -= CFLAG:ARG:待機時間 * 25 / 60
DOWNBASE:ARG:ストレス -= CFLAG:ARG:待機時間 * 30 / 60
;仕事をこなすほど社内の信頼(評判)が上がり、事務能力が磨かれる
BASE:ARG:評判 += CFLAG:ARG:待機時間 / 10
EXP:ARG:学習経験 += CFLAG:ARG:待機時間 * 2 / 60
EXP:ARG:接客経験 += CFLAG:ARG:待機時間 / 60
;給料：教養+10%/LV・話術技能+5%/LVで補正した時給1800円相当。M:103に控え描写側で表示
LOCAL:1 = 100 + ABL:ARG:教養 * 10 + ABL:ARG:話術技能 * 5
LOCAL = CFLAG:ARG:待機時間 * 1800 / 60 * LOCAL:1 / 100
MONEY:ARG += LOCAL
M:103 = LOCAL
M:101 = 0
RETURN 1

;勤務結果の地の文（給料表示。獲得経験はSOURCE_CHECK_2が自動表示する）
@COM_MESSAGE_1051
SIF M:101 == 1
	RETURN 0
PRINTL
PRINTL あなたはオフィスで書類仕事や電話応対をこなした。
;同室にいる社員(仕事==5)を1人拾って職場の一言を添える。誰もいなければ地の文のみ
LOCAL = 0
LOCAL:1 = 0
FOR LOCAL:2,1,CHARANUM
	IF LOCAL:2 != MASTER && CFLAG:(LOCAL:2):仕事 == 5 && CFLAG:(LOCAL:2):現在地区 == CFLAG:MASTER:現在地区 && CFLAG:(LOCAL:2):現在位置 == CFLAG:MASTER:現在位置 && !CFLAG:(LOCAL:2):睡眠 && !TCVAR:(LOCAL:2):衰弱
		LOCAL:3 = RAND(100)
		IF LOCAL:1 <= LOCAL:3
			LOCAL:1 = LOCAL:3
			LOCAL = LOCAL:2
		ENDIF
	ENDIF
NEXT
IF LOCAL
	SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 書類の受け渡しで、%CALLNAME:LOCAL%と何度か言葉を交わした。
		CASE 1
			PRINTFORML 手が空いた時間に、%CALLNAME:LOCAL%と少しだけ雑談をした。
		CASEELSE
			PRINTFORML %CALLNAME:LOCAL%に頼まれた分の仕事も引き受けた。
	ENDSELECT
ENDIF
PRINTFORML 今日の給料 +%金額(M:103)%円
M:101 = 1
