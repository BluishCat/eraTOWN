;装備に必要なV経験
@EQUIP_LIMIT_V(ARG)
#FUNCTION
;ARG アイテム番号
;RETURNF 必要経験

SELECTCASE ARG
	CASE 1
		RETURNF 10
ENDSELECT
RETURNF 0
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------

;装備に必要なアナル経験
@EQUIP_LIMIT_A(ARG)
#FUNCTION
;ARG アイテム番号
;RETURNF 必要経験

SELECTCASE ARG
	CASE 60
		RETURNF 50
	CASE 61
		RETURNF 30
	CASE 62
		RETURNF 60
ENDSELECT
RETURNF 0
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------

;アイテムが装備できるか返す
@CAN_EQUIP(ARG)
#FUNCTION
;ARG アイテム番号
;RETURNF 0装着できない 1できる

SELECTCASE ARG
	CASE 1 TO 19
		IF EXP:MASTER:Ｖ経験 >= EQUIP_LIMIT_V(ARG)
			RETURNF 1
		ELSE
			RETURNF 0
		ENDIF
	CASE 60 TO 79
		IF EXP:MASTER:Ａ経験 >= EQUIP_LIMIT_A(ARG)
			RETURNF 1
		ELSE
			RETURNF 0
		ENDIF
ENDSELECT
RETURNF 1
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------


@CLOTHES_COVERED(ARG)
#FUNCTION
;服が体の何処を隠してるか返す
;1下着上見えない2下着下が見えない4胸が見えない8股間が見えない

SELECTCASE ARG
	CASE 200 TO 241,580
		RETURNF 1
	CASE 250 TO 299
		RETURNF 2
	CASE 300 TO 349
		RETURNF 4
	CASE 350 TO 373 , 375 TO 399
		RETURNF 8
	CASE 620 TO 719 ,581
		RETURNF 3
	CASE 720 TO 731 , 733 TO 819
		RETURNF 12
ENDSELECT
RETURNF 0
