;---------------------------------------------------------------------------


;所持服を最大限着込んだ場合に達成できる最低の基礎刺激度を返す
@MIN_SUGGESTIVE_BASE(ARG)
#FUNCTION
;ARG キャラ登録番号
;LOCAL 達成可能な隠蔽ビット(CLOTHES_COVERED準拠)
VARSET LOCAL

;所持していて装備可能な服
FOR LOCAL:1, 200, 820
	SIF EQUIP:ARG:(LOCAL:1) && CAN_EQUIP(LOCAL:1)
		LOCAL |= CLOTHES_COVERED(LOCAL:1)
NEXT
;現在着用中の服
FOR LOCAL:1, 200, 218
	LOCAL |= CLOTHES_COVERED(TEQUIP:ARG:(LOCAL:1))
NEXT

;SUGGESTIVE_CHECKと同じ判定で基礎刺激度を算出
IF GETBIT(LOCAL,0)
	IF GETBIT(LOCAL,1)
		LOCAL:2 = 200
	ELSEIF GETBIT(LOCAL,3)
		LOCAL:2 = 600
	ELSE
		LOCAL:2 = 800
	ENDIF
ELSEIF GETBIT(LOCAL,1)
	IF GETBIT(LOCAL,2)
		LOCAL:2 = 600
	ELSE
		LOCAL:2 = 800
	ENDIF
ELSEIF GETBIT(LOCAL,2)
	IF GETBIT(LOCAL,3)
		LOCAL:2 = 700
	ELSE
		LOCAL:2 = 850
	ENDIF
ELSEIF GETBIT(LOCAL,3)
	LOCAL:2 = 850
ELSE
	LOCAL:2 = 900
ENDIF
SIF TALENT:ARG:魅惑
	LOCAL:2 += 100
RETURNF LOCAL:2
