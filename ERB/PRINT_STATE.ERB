		;多胎で1人産んだ後（次の児を待つ小休止）は残り人数を出す
		IF 分娩中(ARG)
			PRINTFORML 　状態:【分娩中・あと{CFLAG:ARG:分娩残}人】
		ELSEIF CFLAG:ARG:破水済
			PRINTL 　状態:【陣痛中・破水済】
		ELSE
			PRINTL 　状態:【陣痛中】
		ENDIF
		RESETCOLOR
	ELSEIF CFLAG:ARG:切迫流産度 > 0
		SETCOLOR 255,102,102
		PRINTFORML 　状態:%切迫流産タグ(ARG)%
		RESETCOLOR
	ENDIF
ENDIF
;出産・育児の履歴
SIF CFLAG:ARG:出産回数
	PRINTFORML 　経産:{CFLAG:ARG:出産回数}回（これまでに{CFLAG:ARG:子供数}人を出産）
SIF CFLAG:ARG:流産回数
	PRINTFORML 　流産:{CFLAG:ARG:流産回数}回
SIF TALENT:ARG:育児中
	PRINTFORML 　育児中（あと{CFLAG:ARG:育児日数}日）
SIF TALENT:ARG:母乳体質
	PRINTL 　母乳体質
PRINTL

@PRINT_STATE_SEMEN(ARG)
;体内に精液が残っている、または直近の相手が記録されている時のみ表示
SIF !CFLAG:ARG:膣内精液 && !CFLAG:ARG:子宮内精液 && !CFLAG:ARG:肛内精液 && !CFLAG:ARG:(3400)
	RETURN
PRINTL
PRINTL □ 体内精液 □-------------------------------------------------------------
;膣内（合計＋相手別内訳）
IF CFLAG:ARG:膣内精液 > 0
	PRINTFORM 　膣内:%精液量_名(CFLAG:ARG:膣内精液)%（{CFLAG:ARG:膣内精液}）
	CALL 精液内訳表示(ARG, 3000)
	PRINTL
ENDIF
;子宮内（合計＋相手別内訳）
IF CFLAG:ARG:子宮内精液 > 0
	PRINTFORM 　子宮内:%精液量_名(CFLAG:ARG:子宮内精液)%（{CFLAG:ARG:子宮内精液}）
	CALL 精液内訳表示(ARG, 3600)
	PRINTL
ENDIF
;肛内（合計＋相手別内訳）
IF CFLAG:ARG:肛内精液 > 0
	PRINTFORM 　肛内:%精液量_名(CFLAG:ARG:肛内精液)%（{CFLAG:ARG:肛内精液}）
	CALL 精液内訳表示(ARG, 3100)
	PRINTL
ENDIF
;直近の中出し相手（新しい順・最大10人）
IF CFLAG:ARG:(3400) > 0
	PRINTFORM 　直近の相手:
	CALL 直近相手表示(ARG)
	PRINTL
ENDIF
PRINTL


