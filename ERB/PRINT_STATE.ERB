LOCAL:1 = 0
FOR LOCAL,50,60
	SIF !STRLENS(ABLNAME:LOCAL)
		CONTINUE
	SIF !(TALENT:ARG:2 & 1) && (LOCAL == 52 || LOCAL == 54)
		CONTINUE
	PRINTFORM %ABLNAME:LOCAL,12%:{ABL:ARG:LOCAL,5,LEFT} 
	LOCAL:1 ++
	SIF LOCAL:1 % 4 == 0
		PRINTL 
