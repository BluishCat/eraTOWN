VARSET LOCAL
FOR LOCAL,200,204
	IF TEQUIP:ARG:LOCAL
		PRINTFORML %TEQUIPNAME:LOCAL%:%ITEMNAME:(TEQUIP:ARG:LOCAL)%
		LOCAL:1++
	ENDIF
NEXT
