;次の月になるときの処理
;;;悪いけど-29や-30や-12は1を代入に直させていただきます。
SELECTCASE DAY:2
	CASE 2
		IF DAY:1 % 4 == 0 && DAY:3 > 29
;;;			DAY:3 -= 29
			DAY:3 = 1
			DAY:2++
			CFLAG:MASTER:お小遣い = 0
		ELSEIF DAY:3 > 28
;;;			DAY:3 -= 28
			DAY:3 = 1
