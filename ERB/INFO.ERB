			CFLAG:MASTER:お小遣い = 0
		ENDIF
	CASE 4,6,9,11
		IF DAY:3 > 30
;;;			DAY:3 -= 30
			DAY:3 = 1
			DAY:2++
			CFLAG:MASTER:お小遣い = 0
