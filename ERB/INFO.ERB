	PRINTFORM 【%生理状態_名(MASTER)%】
	SIF CFLAG:MASTER:避妊 > 0
		PRINTFORM 【避妊中(あと{CFLAG:MASTER:避妊}日)】
ELSEIF (TALENT:MASTER:妊娠 && CFLAG:MASTER:妊娠自覚 >= 1) || CFLAG:MASTER:出産回数 || (TALENT:MASTER:妊娠 && CFLAG:MASTER:切迫流産度 > 0) || (TALENT:MASTER:妊娠 && CFLAG:MASTER:陣痛 > 0) || CFLAG:MASTER:流産回数
	SIF TALENT:MASTER:妊娠 && CFLAG:MASTER:妊娠自覚 >= 1
		PRINTFORM 【妊娠中】
	SIF TALENT:MASTER:妊娠 && 腹段階(MASTER) >= 1
		PRINTFORM 【お腹：%腹段階_名(MASTER)%】
	;切迫流産の警告（出血・腹痛・切迫）※朱色で強調
	IF CFLAG:MASTER:切迫流産度 > 0
		SETCOLOR 255,102,102
		PRINTFORM %切迫流産タグ(MASTER)%
		RESETCOLOR
	ENDIF
	SIF TALENT:MASTER:妊娠 && CFLAG:MASTER:陣痛 == 0 && 臨月(MASTER)
		PRINTFORM 【臨月】
	;陣痛/破水は赤で強調
	IF TALENT:MASTER:妊娠 && CFLAG:MASTER:陣痛 > 0
		SETCOLOR 255,51,51
