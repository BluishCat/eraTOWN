@PRINT_WEEK_COLORED
;曜日を色付きで表示（日曜=赤 / 土曜=青 / 祝日=赤）。末尾で RESETCOLOR まで行う
IF (DAY % 7 == 0) || (HOLIDAY() >= 2)
	SETCOLOR 0xFF6060
ELSEIF DAY % 7 == 6
	SETCOLOR 0x6699FF
ENDIF
PRINTFORM % WEEK(DAY)%曜日
RESETCOLOR

@WEEK(ARG)
#FUNCTIONS
SELECTCASE ARG % 7
	CASE 0
		RETURNF "日"
	CASE 1
		RETURNF "月"
	CASE 2
		RETURNF "火"
	CASE 3
		RETURNF "水"
	CASE 4
		RETURNF "木"
	CASE 5
		RETURNF "金"
	CASE 6
		RETURNF "土"
ENDSELECT

@TIME_NAME(ARG)
#FUNCTIONS
SELECTCASE TIME
	CASE 0
		RETURNF "朝"
	CASE 1
		RETURNF "放課後"
	CASE 2
		RETURNF "夜"
ENDSELECT

@NEXT_DAY
VARSET LOCAL
;次の日に進むときの処理
IF !HOLIDAY()
	;身分システム：勤怠評価を身分別に分岐（出席ビット cflag:63 は学生・教師・会社員で共通運用。
	;フリーター・主婦・キャバ嬢・ソープ嬢は自由業/歩合制のため勤怠評価なし）
	IF CFLAG:MASTER:仕事 == 1
		;教師の勤怠評価（皆勤で信頼が上がり、欠勤で信頼が下がる）
		SELECTCASE CFLAG:MASTER:出席
			CASE 0
				PRINTL 無断で授業を休んでしまった。教師としての信頼が下がった･･････
				BASE:MASTER:評判 -= 100
				CFLAG:MASTER:欠席日数++
			CASE 1
				PRINTL 午後の授業を休んでしまった･･････
				BASE:MASTER:評判 -= 30
			CASE 2
				PRINTL 午前の授業を休んでしまった･･････
				BASE:MASTER:評判 -= 30
			CASE 3
				PRINTL しっかりと授業をこなした。教師としての信頼が上がった。
				BASE:MASTER:評判 += 10
		ENDSELECT
	ELSEIF CFLAG:MASTER:仕事 == 5
		;会社員の勤怠評価
		SELECTCASE CFLAG:MASTER:出席
			CASE 0
				PRINTL 無断欠勤してしまった。会社での信用が下がった･･････
				BASE:MASTER:評判 -= 100
				CFLAG:MASTER:欠席日数++
			CASE 1
				PRINTL 午後の仕事をさぼってしまった･･････
				BASE:MASTER:評判 -= 30
			CASE 2
				PRINTL 午前の仕事をさぼってしまった･･････
				BASE:MASTER:評判 -= 30
			CASE 3
				PRINTL 一日しっかり働いた。会社での信用が上がった。
				BASE:MASTER:評判 += 10
		ENDSELECT
	ELSEIF TALENT:MASTER:160
		;学生の勤怠評価（従来）
		SELECTCASE CFLAG:MASTER:出席
			CASE 0
				PRINTL 大学をさぼった為評判が悪くなった･･････
				BASE:MASTER:評判 -= 100
				CFLAG:MASTER:欠席日数++
			CASE 1
				PRINTL 午後の授業をさぼった為評判が悪くなった･･････
				BASE:MASTER:評判 -= 30
			CASE 2
				PRINTL 午前の授業をさぼった為評判が悪くなった･･････
				BASE:MASTER:評判 -= 30
			CASE 3
				BASE:MASTER:評判 += 5
		ENDSELECT
	ENDIF
ENDIF
FOR D,2,CHARANUM
	BASE:D:評判 += 1
NEXT

PRINTW 日付が変わりました
;CFLAG:MASTER:現在位置 = 1
