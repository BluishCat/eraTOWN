	SETCOLOR 0xFFAA00
	PRINTL 宿泊費：3,000円
	RESETCOLOR
ENDIF

DRAWLINE
;同室者（同じ部屋に居るNPC。会話中/衰弱/睡眠中は従来どおり非表示）
;名前はクリックできる。押すとコマンド「声をかける」(XCOM1020)と同じ処理が走る
;（受け口は USERCOM.ERB @PLAYER_USERCOM の $INPUT_LOOP。値は "声かけ_登録番号"）
PRINT 同室者：
FOR LOCAL,1,CHARANUM
	SIF LOCAL == MASTER
		CONTINUE
	SIF CFLAG:LOCAL:会話 || CFLAG:LOCAL:現在地区 != CFLAG:MASTER:現在地区 || CFLAG:LOCAL:現在位置 != CFLAG:MASTER:現在位置 || CFLAG:LOCAL:衰弱 || CFLAG:LOCAL:睡眠
		CONTINUE
	;イベント中は声かけコマンド自体が出ないので、その場合は従来どおり素のテキストで並べる
	IF !TCVAR:MASTER:イベント && 声かけ可能(LOCAL)
		PRINTBUTTON @"[%CALLNAME:LOCAL%]", @"声かけ_{LOCAL}"
	ELSE
		PRINTFORM [%CALLNAME:LOCAL%]
	ENDIF
NEXT
PRINTL
;同室者行とステータスの間はデザイン上の空行1行（メイン画面イメージ.txt）
PRINTL

