@SHOW_STATUS
VARSET LOCAL
;直前の行動結果とステータス（日付）表示の間に空行を2行入れて見やすくする
PRINTL
PRINTL
DRAWLINE
IF TCVAR:MASTER:イベント == 1 || TCVAR:MASTER:イベント == 2
	IF TFLAG:騒ぎ
		PRINTFORML 　　　　騒ぎ：{TFLAG:騒ぎ}
	ELSE
		PRINTL
	ENDIF
	IF CFLAG:MASTER:乗車 == 1
		PRINT 電車到着地:
		PRINTFORM %PLACE_NAME(CFLAG:MASTER:到着地区,CFLAG:MASTER:到着位置)%
		PRINTFORML （到着時間:{CFLAG:MASTER:到着時間 / 60}時{CFLAG:MASTER:到着時間 % 60}分）
	ENDIF
ENDIF
PRINTFORM {DAY:1}年目{DAY:2}月{DAY:3}日
CALL PRINT_WEEK_COLORED
SETCOLOR 0xFFAA00
PRINTFORM  %TSTR:11%
RESETCOLOR
PRINTFORM  {TIME / 60}時{TIME % 60}分
;身分別の勤務時間タグ（授業中／勤務中／営業中など）。中身はCOM_PROFILE.ERB @勤務時間タグ
PRINTFORM %勤務時間タグ()%
PRINTFORM   所持金:%金額(MONEY:MASTER)%円
;容疑を抱えている間だけ警告を出す（警察署.ERB）。
;水準に達していると人前に出た時点で職務質問が飛ぶので、色を変えて分かるようにする
IF FLAG:容疑 > 0
	IF FLAG:容疑 >= 容疑水準()
		SETCOLOR 0xFF4040
		PRINTFORM   容疑:{FLAG:容疑}（手配中）
	ELSE
		SETCOLOR 0xFFAA00
		PRINTFORM   容疑:{FLAG:容疑}
	ENDIF
	RESETCOLOR
ENDIF

PRINTL

;現在位置＋エリア情報（NPC人数・支配者）を続けて表示（メイン画面イメージ.txt の並び）
PRINTFORM 現在位置:
SETCOLOR 0xFFAA00
IF CFLAG:MASTER:乗車 == 1
	PRINT 電車内(乗車中)
ELSE
	PRINTFORM %PLACE_NAME(CFLAG:MASTER:現在地区,CFLAG:MASTER:現在位置)%
ENDIF
RESETCOLOR
SIF GETBIT(DA:(CFLAG:MASTER:現在地区):(CFLAG:MASTER:現在位置),3)
	PRINT (室内)
;現在位置直後の部活表示は非表示（▼情報欄に移動）
;SIF CFLAG:MASTER:部活
;	PRINTFORM   部活:%CLUB_NAME(CFLAG:MASTER:部活)%
;現在位置直後のバイト先表示は非表示（▼情報欄のアルバイト表示は残す）
;SIF CFLAG:MASTER:職業
;	PRINTFORM   バイト先:%JOB_NAME(CFLAG:MASTER:職業)%
SIF CFLAG:MASTER:所属
	PRINTFORM   所属:%DANTAI_NAME(CFLAG:MASTER:所属)%

;この場所の顔役（縄張り.ERB）。月末の発表と同じ基準＝支配度×評判で判定する
;（以前は素の支配度で最大を取っており、月末に発表される支配者と食い違うことがあった）
J:102 = 場所支配者(CFLAG:MASTER:現在地区, CFLAG:MASTER:現在位置)
PRINTFORM 　　NPCの人数:{N:101}
J:103 = 縄張り差(CFLAG:MASTER:現在地区, CFLAG:MASTER:現在位置)
IF !J:102
	PRINTFORM 　顔役:まだ誰もいない
ELSEIF J:102 == MASTER
	SETCOLOR 0xFFCC00
	PRINTFORM 　顔役:あなた
	RESETCOLOR
ELSEIF J:103 < 0
	;評判が0だと支配度をいくら稼いでも換算値が0のままで顔役になれない
	PRINTFORM 　顔役:%CALLNAME:(J:102)%（評判が要る）
ELSE
	PRINTFORM 　顔役:%CALLNAME:(J:102)%（あと{J:103}）
ENDIF
;先に集計を走らせる（この中で FLAG:全エリア数 も更新されるため、同じ式の中で読むと順序に依存する）
J:104 = 自分の縄張り数()
PRINTFORM 　縄張り:{J:104}/{FLAG:全エリア数}
PRINTL

