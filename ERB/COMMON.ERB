	RETURNF 1
RETURNF 0

;*************************************************
;@浴場か(ARG,ARG:1) 湯船・シャワーのある場所か
;ARG 地区 / ARG:1 位置
;RETURN 1 入浴できる場所
;自宅（実家・賃貸）は場所が可変なので @IS_MASTER_HOME で別途判定すること。
;※プレイヤー入浴(COMF1008 @XCOM_ABLE1008)とNPC入浴(NPC_AUTOACTION1 CASE 701-750)で
;　同じリストをコピペしていたのを、銭湯の追加(2026-07-22)に合わせてここへ一元化した。
;　ラブホテル(2,22)の当日料金・銭湯(0,10)の入浴料といった「利用権」の判定は
;　各呼び出し側が行う（NPCは料金の概念を持たないため）。
;*************************************************
@浴場か(ARG,ARG:1)
#FUNCTION
SELECTCASE ARG
	CASE 0
		;銭湯（銭湯.ERB） / ＮＰＣの家
		SIF ARG:1 == 10 || ARG:1 == 30
			RETURNF 1
	CASE 1
		;部室棟
		SIF ARG:1 == 15
			RETURNF 1
	CASE 2
		;ラブホテル / 寮 / プロレス事務所
		SIF ARG:1 == 22 || ARG:1 == 26 || ARG:1 == 27
			RETURNF 1
ENDSELECT
RETURNF 0

;*************************************************
;@噂話対象(ARG,ARG:1) 噂話（悪口）の種になる相手を1人返す
;ARG 話し手（敵対感の持ち主） / ARG:1 聞き手（＝会話相手。候補から除外する）
;RETURN 話し手が最も敵視している相手の登録番号。該当なしは0
;※「本当に敵視している相手がいる時だけ噂話になる」ため敵対100以上に限る。
;　NMKAIWA（NPC→プレイヤー）と COMF800（プレイヤー→NPC）で同じ選定を使うため
;　ここへ一元化した。話し手自身と聞き手は候補にしない。
;*************************************************
@噂話対象(ARG,ARG:1)
#FUNCTION
;※ループ変数に I は使えない（Emueraの組み込み変数名と衝突してロードに失敗する）
#DIM 話し手
#DIM 聞き手
#DIM 候補
#DIM 走査
話し手 = ARG
聞き手 = ARG:1
候補 = 0
FOR 走査,1,CHARANUM
	SIF 走査 == 話し手 || 走査 == 聞き手
		CONTINUE
	SIF TA:話し手:走査:6 >= 100 && TA:話し手:走査:6 > TA:話し手:候補:6
		候補 = 走査
NEXT
RETURNF 候補

;*************************************************
;@会話累積値加算(ARG,ARG:1) 雑談後の会話累積値を進める
;ARG 会話した本人 / ARG:1 話題（TCVAR:会話話題 と同じ番号）
;会話累積値は COMF800 の成功率式から引かれる＝同じ相手に話しかけ続けると
;話が続かなくなるための疲れ値。話題ごとの「連発の効かなさ」をここへ集約する
;（従来 COMF800 に直書きされていた 90 / (3 + 話術技能) が話題0の基準値）。
;*************************************************
@会話累積値加算(ARG,ARG:1)
#DIM 基準
基準 = 90 / (3 + ABL:ARG:話術技能)
SELECTCASE ARG:1
	CASE 1
		;褒める：効果は大きいが同じ手は続かない
		基準 = 基準 * 150 / 100
	CASE 2
		;近況を聞く：聞き役に回るので疲れにくい＝繋ぎに使える
		基準 = 基準 * 50 / 100
	CASE 4
		;部活の話：共通の話題なので弾む（COMF1020の部活補正と同じ思想）
		基準 = 基準 * 50 / 100
ENDSELECT
TCVAR:ARG:会話累積値 += 基準
RETURN

;*************************************************
;@昼食場所か(ARG,ARG:1) 昼休みに昼食をとれる場所か
;ARG 地区 / ARG:1 位置
;RETURN 1 昼食をとれる場所
;※大学は学生食堂(25)・生協(26)限定(2026-08-31)。それ以前は学内どこでも食べられたため、
;　食堂も購買部も名前だけの場所だった。昼休みに食堂まで歩かせるのが狙い。
;　オフィスビルの社員食堂は会社員の昼休み(2026-07-25)に合わせて追加した。
;　身分は見ない＝学食が誰でも使えるのと同じ扱い。時間帯（12:30〜13:30）・休日・
;　二重昼食(cflag:食事 bit1)の判定は呼び出し側(COMF1010)の責任。
;*************************************************
@昼食場所か(ARG,ARG:1)
#FUNCTION
SELECTCASE ARG
	CASE 1
		;学生食堂 / 生協
		SIF ARG:1 == 25 || ARG:1 == 26
			RETURNF 1
	CASE 2
		;オフィスビルの社員食堂
		SIF ARG:1 == 29
			RETURNF 1
ENDSELECT
RETURNF 0

;*************************************************
;@昼食場所名(ARG) 昼食の選択肢・地の文で使う場所の呼び名
;ARG 0=食事処の名前（学生食堂／購買部／社員食堂） / 1=同席して食べる場所（食堂の席／中庭／休憩スペース）
;プレイヤーの現在地で切り替える。場所判定を呼び出し側にコピペしないための一枚。
;対応する場所は @昼食場所か と対で増やすこと。
;呼び出し元: COMF1010-お昼を食べる / COM_MESSAGE1010
;*************************************************
@昼食場所名(ARG)
#FUNCTIONS
;オフィスビル
IF CFLAG:MASTER:現在地区 == 2 && CFLAG:MASTER:現在位置 == 29
	SIF ARG == 1
		RETURNF "休憩スペース"
	RETURNF "社員食堂"
ENDIF
;大学の生協（購買部。買ったものは中庭で食べる）
IF CFLAG:MASTER:現在地区 == 1 && CFLAG:MASTER:現在位置 == 26
	SIF ARG == 1
		RETURNF "中庭"
	RETURNF "購買部"
ENDIF
;大学の学生食堂
SIF ARG == 1
	RETURNF "食堂の席"
RETURNF "学生食堂"

;*************************************************
;@昼食代 昼休みに食事処で食べる時の代金
;学生食堂は「注文する」(COMF1015)の定食と同額にしてある。
;店を増やしたら @昼食場所か / @昼食場所名 と対で足すこと。
;呼び出し元: COMF1010-お昼を食べる
;*************************************************
@昼食代
#FUNCTION
;大学の生協（パンと牛乳）
SIF CFLAG:MASTER:現在地区 == 1 && CFLAG:MASTER:現在位置 == 26
	RETURNF 200
;大学の学生食堂
SIF CFLAG:MASTER:現在地区 == 1 && CFLAG:MASTER:現在位置 == 25
	RETURNF 300
;オフィスビルの社員食堂
RETURNF 500

;*************************************************
;@勉強場所か(ARG,ARG:1) 腰を据えて勉強できる場所か
;ARG 地区 / ARG:1 位置
;RETURN 1 「勉強をする」を選べる場所
;自宅（実家・賃貸）は場所が可変なので @IS_MASTER_HOME で別途判定すること（@浴場かと同じ）。
;大学の図書館・ゼミ室を追加(2026-08-30)。それまで勉強は自宅限定で、
;図書館は名前だけの場所だった。捗り方の差は @勉強効率 が持つ。
;講義室・大講義室は授業(COMF1001)の場所なので自習には開けていない。
;*************************************************
@勉強場所か(ARG,ARG:1)
#FUNCTION
SELECTCASE ARG
	CASE 1
		;図書館 / ゼミ室
		SIF ARG:1 == 11 || ARG:1 == 8
			RETURNF 1
ENDSELECT
RETURNF 0

;*************************************************
;@勉強効率(ARG,ARG:1) 勉強一回あたりの捗り方
;ARG 地区 / ARG:1 位置
;RETURN 自宅を100とした百分率。学力の伸びに掛ける（COMF1002）
;わざわざ足を運ぶ以上は自宅より捗らないと意味がないので図書館を厚くしてある。
;*************************************************
@勉強効率(ARG,ARG:1)
#FUNCTION
SELECTCASE ARG
	CASE 1
		;図書館：資料が揃っていて静か
		SIF ARG:1 == 11
			RETURNF 150
		;ゼミ室：机を広く使えるが人の出入りがある
		SIF ARG:1 == 8
			RETURNF 120
ENDSELECT
;自宅そのほか
RETURNF 100

;*************************************************
;@入浴効果(ARG) 湯に浸かったときの状態変化
;ARG 入浴するキャラの登録番号
;体力を10%／気力を20%回復し、疲労・ストレスを落とし、汚れと精液を洗い流す。
;待機時間・地の文は呼び出し側の責任（場所ごとに長さも描写も違うため）。
;呼び出し元: COMF1008-入浴 / NPC_AUTOACTION1(CASE 701-750) / 銭湯.ERB
;*************************************************
@入浴効果(ARG)
DOWNBASE:ARG:体力 -= (MAXBASE:ARG:体力 / 10)
DOWNBASE:ARG:気力 -= (MAXBASE:ARG:気力 / 5)
DOWNBASE:ARG:疲労 += 200
DOWNBASE:ARG:ストレス += 200
;PALAM[抑鬱][不快][反感]を10%減少
PALAM:ARG:30 -= (PALAM:ARG:30 / 10)
PALAM:ARG:31 -= (PALAM:ARG:31 / 10)
PALAM:ARG:32 -= (PALAM:ARG:32 / 10)
;汚れを取り除く
VARSET STAIN:ARG:0
;精液を洗い流す（腟内=全部／肛内=奥に残るため1/4に減衰。既に子宮内へ移行した分は影響を受けない）
CALL 精液_入浴洗浄(ARG)
RETURN

