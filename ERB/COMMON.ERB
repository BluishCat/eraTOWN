@WAKE_UP_CHECK
VARSET LOCAL
FOR LOCAL,1,CHARANUM
	SIF !CFLAG:LOCAL:睡眠 || CFLAG:LOCAL:待機時間
		CONTINUE
	IF (((CFLAG:LOCAL:主睡眠 || CFLAG:LOCAL:衰弱 || LOCAL != MASTER) && TIME >= CFLAG:LOCAL:起床時間 && TIME <= CFLAG:LOCAL:起床時間 + 180) || (BASE:LOCAL:眠気 == 0 && !CFLAG:LOCAL:主睡眠 )) && BASE:LOCAL:眠気 < 1000 && (!CFLAG:LOCAL:衰弱 || BASE:LOCAL:体力 >= MAXBASE:LOCAL:体力 * 8 / 10)
			CFLAG:LOCAL:睡眠 = 0
			CFLAG:LOCAL:衰弱 = 0
			CFLAG:LOCAL:主睡眠 = 0
	ENDIF
NEXT

