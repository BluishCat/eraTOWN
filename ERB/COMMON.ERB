;*************************************************
;@場所表示名(ARG,ARG:1) 一覧・マップ共通の場所表示名
;ARG 地区 \ ARG:1 位置
;賃貸の号室（アパート/マンション/高級マンション）は、その建物の中に立っているときだけ
;建物名の接頭辞を落として「101号室」に短縮する（マンション101号室 → 101号室）。
;号室番号の算出式は PLACE_NAME 側にしか無いので、ここでは接頭辞を削るだけにして二重管理を避ける。
;*************************************************
@場所表示名(ARG,ARG:1)
#FUNCTIONS
#DIM 建物
#DIMS 名前
#DIMS 建物名
名前 '= @"%PLACE_NAME(ARG,ARG:1)%"
建物 = 所属物件(ARG, ARG:1)
;号室でない／その建物に居ない場合はフルネームのまま
SIF !建物
	RETURNF 名前
SIF CFLAG:MASTER:現在地区 != ARG || CFLAG:MASTER:現在位置 != 建物
	RETURNF 名前
建物名 '= @"%PLACE_NAME(ARG,建物)%"
;先頭が建物名で始まっているときだけ削る（名前を変えられても壊れないように）
SIF STRLENSU(建物名) == 0 || STRLENSU(名前) <= STRLENSU(建物名)
	RETURNF 名前
SIF SUBSTRINGU(名前, 0, STRLENSU(建物名)) != 建物名
	RETURNF 名前
RETURNF SUBSTRINGU(名前, STRLENSU(建物名), STRLENSU(名前) - STRLENSU(建物名))

;*************************************************
;@場所名_整形(ARGS,ARG) 半角換算 ARG 桁ちょうどに揃える（長ければ切り、短ければ半角空白で埋める）
;Emuera の %式,幅,LEFT% は短い側を詰めるだけで長い側は切らないため、
;固定幅の列に流し込む前に必ずこれを通す（幅を変数で渡せるようパディングも自前で行う）。
;*************************************************
@場所名_整形(ARGS,ARG)
#FUNCTIONS
#DIMS 文字列
#DIMS 埋め
文字列 '= ARGS
WHILE STRLENS(文字列) > ARG && STRLENSU(文字列) > 0
	文字列 '= SUBSTRINGU(文字列, 0, STRLENSU(文字列) - 1)
WEND
埋め '= " " * (ARG - STRLENS(文字列))
RETURNF @"%文字列%%埋め%"

;*************************************************
;@金額(ARG) 金額を3桁カンマ区切りの文字列にする
;所持金・価格・料金・給料・借金残高など、画面に出るお金は必ずこれを通す
;（{MONEY:MASTER}円 → %金額(MONEY:MASTER)%円）
;TOSTR(値,"#,##0") でも書けるが、書式付きTOSTRに依存せず既存の文字列関数だけで組む
;*************************************************
@金額(ARG)
#FUNCTIONS
#DIM 値
#DIMS 符号
#DIMS 残り
#DIMS 結果
値 = ARG
符号 '= ""
IF 値 < 0
	符号 '= "-"
	値 = -値
ENDIF
残り '= TOSTR(値)
結果 '= ""
;末尾から3桁ずつ切り出して先頭にカンマで繋ぐ
WHILE STRLENSU(残り) > 3
	結果 '= @",%SUBSTRINGU(残り, STRLENSU(残り) - 3, 3)%%結果%"
	残り '= SUBSTRINGU(残り, 0, STRLENSU(残り) - 3)
WEND
RETURNF @"%符号%%残り%%結果%"

;*************************************************
;@一覧表示対象(ARG,ARG:1) その部屋を場所一覧（マップ凡例・移動画面）に出すか
;ARG 地区 \ ARG:1 位置
;賃貸の号室は数が多く（地区0で28件・地区2で20件）常時出すと一覧が埋まるので、
;その建物の中に居るとき／その号室に居るとき／自室のときだけ出す。
;*************************************************
@一覧表示対象(ARG,ARG:1)
#FUNCTION
#DIM 建物
SIF PLACE_NAME(ARG, ARG:1) == ""
	RETURNF 0
建物 = 所属物件(ARG, ARG:1)
SIF !建物
	RETURNF 1
;建物のエントランスに居る（＝そこからしか号室へ行けない）
SIF CFLAG:MASTER:現在地区 == ARG && CFLAG:MASTER:現在位置 == 建物
	RETURNF 1
;その号室に居る
SIF CFLAG:MASTER:現在地区 == ARG && CFLAG:MASTER:現在位置 == ARG:1
	RETURNF 1
;自室（開始地区/開始位置＝実家または契約中の賃貸）
SIF CFLAG:MASTER:開始地区 == ARG && CFLAG:MASTER:開始位置 == ARG:1
	RETURNF 1
RETURNF 0

;*************************************************
;@MAP_NAME_BUTTON(ARG,ARG:1,ARG:2) マップ／一覧の1行分の表示文字列
;ARG 地区 \ ARG:1 位置 \ ARG:2 名前の表示幅（半角換算。0なら従来の16）
;「マーカー(2桁) + 番号(2桁) + ：(2桁) + 名前(ARG:2桁)」の固定幅なので、
;呼び出し側は 6 + ARG:2 桁で列を組める。
;*************************************************
@MAP_NAME_BUTTON(ARG,ARG:1,ARG:2)
#FUNCTIONS
#DIMS マーカー
#DIMS 表示名
#DIM 幅
#DIM 主
幅 = ARG:2
SIF 幅 <= 0
	幅 = 16
;先頭に現在地マーカー（★）／閉店マーカー（×）／勤務先の開店準備中（△）／全角空白を付ける。いずれも全角1文字ぶんで整列を保つ
IF ARG == CFLAG:MASTER:現在地区 && ARG:1 == CFLAG:MASTER:現在位置
	マーカー '= "★"
ELSEIF !入店可(ARG, ARG:1)
	マーカー '= "×"
ELSEIF 開店準備中(ARG, ARG:1)
	マーカー '= "△"
ELSE
	;縄張りマーカー：■＝あなたが顔役 / □＝他の誰かが顔役 / 空白＝まだ誰のものでもない（縄張り.ERB）
	主 = 場所支配者(ARG, ARG:1)
	IF 主 == MASTER
		マーカー '= "■"
	ELSEIF 主
		マーカー '= "□"
	ELSE
		マーカー '= "　"
	ENDIF
ENDIF
;区切りは全角「：」で2桁ぶん（旧実装の半角 \: は桁数が読めず列揃えの計算に乗らないため変更）
表示名 '= 場所名_整形(場所表示名(ARG,ARG:1), 幅)
RETURNF @"%マーカー%\@ARG:1 > 9 ? %TOSTR(ARG:1)% # %TOFULL(TOSTR(ARG:1))%\@：%表示名%"

