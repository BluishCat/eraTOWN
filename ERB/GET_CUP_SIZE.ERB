
@GET_CUP_SIZE(ARG)
;引数として指定されたキャラクターのカップサイズを、「1がAAA,2がAA,3がA,4がB…」となるよう返す。
;男であるか、バストとウェストのサイズのどちらか又は両方が指定されていない場合は-3を返し、AAA未満なら-1を返す。Z超は特に制限しない。
;
;
;
;
;引数ARGはゲーム内のキャラクターの番号を指定

;性別判定
SIF GETBIT(TALENT:ARG:性別,0) == 0
	RETURN -2

;バストとウェストの判定
SIF BASE:ARG:胸囲 <= 0 && BASE:ARG:胴囲 <= 0
	RETURN -2

;CFLAG:ARG:36（カップサイズ）の値については特に参照しない。
;カップ数＝トップバスト(胸囲)とアンダーバストの差から算出する。
LOCAL = 0
;LOCAL:5＝アンダーバスト(MAXBASE:36)。未設定(旧セーブ等)なら身長から推定してフォールバック。
LOCAL:5 = MAXBASE:ARG:アンダーバスト
SIF LOCAL:5 <= 0
	LOCAL:5 = UNDER_BUST_STD(ARG)
;トップ−アンダー差(0.1cm)を1000倍。妊娠中の胴囲(お腹)は参照しないので影響しない。
LOCAL:4 = (MAXBASE:ARG:胸囲 - LOCAL:5) * 100

;AAAになるためにはトップアンダー差3.75cm以上、そこから2.5cm大きくなるたびに一つずつ増えていく
WHILE (LOCAL:4 >= 3750)
	LOCAL += 1
	LOCAL:4 -= 2500
WEND

IF LOCAL <= 0
	RETURN -1
;ちなみにZ超は26(AtoZ)+2=28以上
ELSE
	RETURN LOCAL
ENDIF

;----------------------------------------------------------------
;標準アンダーバスト（身長=フレームから算出）。ARG=対象、0.1cm単位を返す
; 身長×約42.4% − 0.2cm。旧カップ式(胴囲＝身長37%時)と同じカップ数になるよう較正した式。
; アンダーは妊娠では変化しないので、妊娠中もこの値が使われカップは胴囲(お腹)に影響されない。
;----------------------------------------------------------------
@UNDER_BUST_STD(ARG)
#FUNCTION
RETURNF MAXBASE:ARG:身長 * 424 / 1000 - 2

;----------------------------------------------------------------
;体格指数(BMI×10)を体型素質から返す。SHOP_CUSTOM の @UPDATE_BUILD_FROM_TALENT と同一の表。
; 体重算出（@体重_更新）と体型再計算（@UPDATE_BUILD_FROM_TALENT）で値を共有し、齟齬を防ぐ。
;----------------------------------------------------------------
@体格指数(ARG)
#FUNCTION
SELECTCASE TALENT:ARG:体型
	CASE -3
		;小人
		RETURNF 175
	CASE -2
		;幼児体型
		RETURNF 175
	CASE -1
		;小柄体型
		RETURNF 185
	CASE 1
		;長身
		RETURNF 195
	CASE 2
		;巨躯
		RETURNF 240
	CASE 3
		;巨人
		RETURNF 280
	CASEELSE
		;0=標準
		RETURNF 195
ENDSELECT

;----------------------------------------------------------------
;体重を身長・体型・胴囲(お腹)から自動算出して BASE:体重(kg×10) に格納する。
; 基礎体重＝BMI×身長²（SHOP_CUSTOM の体型再計算と同式）。
; そこに「標準胴囲(身長×37%)からのお腹の増減」を加算するため、
; 妊娠でお腹が膨らむ／太る／体型が変わると体重もそれに連動して変化する。
; 体重は0.1kg単位で格納（例：500＝50.0kg）。標準体型・標準胴囲では基礎体重と一致する。
;----------------------------------------------------------------
@体重_更新(ARG)
;身長が未設定なら算出しない
SIF BASE:ARG:身長 <= 0
	RETURN
;基礎体重(×10)＝体格指数(BMI×10) × 身長(×10)² / 1000000
LOCAL = 体格指数(ARG) * BASE:ARG:身長 * BASE:ARG:身長 / 1000000
;標準胴囲(身長の37%)からのお腹の増減で補正：お腹が出れば重くなる（妊娠・肥満）
SIF BASE:ARG:胴囲 > 0
	LOCAL += (BASE:ARG:胴囲 - BASE:ARG:身長 * 37 / 100) * 4 / 10
;30〜300kgの安全域に収める
BASE:ARG:体重 = LIMIT(LOCAL, 300, 3000)
	




