;================================================================
;  きょうだい削除の旧セーブ救済（2026-07-26）
;
;  兄(CSV014)・姉(CSV015)・弟(CSV012)・妹(CSV013)をゲームから削除したため、
;  既に登録済みの旧セーブからも DELCHARA で取り除く。
;  新規ゲームは @CUSTOM_FAMILY が最初から登録しないので、ここは通らない。
;
;  【注意】DELCHARA が詰めてくれるのは CFLAG などキャラ変数の「行」だけ。
;    ・TA:自分:相手:種類 と TB:地区:位置:キャラ はグローバル多次元配列であり、
;      キャラ登録番号を添字にした次元をエンジンは動かしてくれない。
;    ・CFLAG にも「値として相手の登録番号を持つ枠」が多数ある。
;  よって DELCHARA の前に、消す登録番号より大きい参照を手で1つずつ詰める。
;================================================================

;----------------------------------------------------------------
;きょうだい4人をセーブから削除する（一度きり）
;----------------------------------------------------------------
@兄弟姉妹_削除移行
#DIM 対象
#DIM 番号
SIF FLAG:兄弟姉妹削除済
	RETURN
;12=弟 13=妹 14=兄 15=姉。DELCHARA で登録番号が詰まるので毎回引き直す
FOR 対象, 12, 16
	番号 = GETCHARA(対象)
	SIF 番号 == -1
		CONTINUE
	CALL キャラ参照_詰め(番号)
	DELCHARA 番号
NEXT
FLAG:兄弟姉妹削除済 = 1
RETURN

;----------------------------------------------------------------
;ARG = これから DELCHARA する登録番号
;  ARG より大きい参照を1つ減らし、ARG 自身を指していた参照は 0（なし）にする。
;  ※必ず DELCHARA の「前」に呼ぶこと（削除前の CHARANUM を基準にするため）
;----------------------------------------------------------------
@キャラ参照_詰め(ARG)
#DIM 削除
#DIM 人数
#DIM 本人
#DIM 相手
#DIM 種類
#DIM 地区
#DIM 位置
#DIM 枠
#DIM 基底
削除 = ARG
人数 = CHARANUM

;--- TA 第1添字（自分＝所有者）。ブロックごと1つ手前へ寄せる ---
;    種類5（相性）も所有者に紐づく値なので一緒に動かす
FOR 本人, 削除, 人数 - 1
	FOR 相手, 0, 人数
		FOR 種類, 0, 9
			TA:本人:相手:種類 = TA:(本人 + 1):相手:種類
		NEXT
	NEXT
NEXT
FOR 相手, 0, 人数
	FOR 種類, 0, 9
		TA:(人数 - 1):相手:種類 = 0
	NEXT
NEXT

;--- TA 第2添字（相手）---
;    種類5だけは第2添字が「相手のタイプ番号(0-9)」なので絶対に詰めない（変数覚書.TXT）
FOR 本人, 0, 人数 - 1
	FOR 相手, 削除, 人数 - 1
		FOR 種類, 0, 9
			SIF 種類 == 5
				CONTINUE
			TA:本人:相手:種類 = TA:本人:(相手 + 1):種類
		NEXT
	NEXT
	FOR 種類, 0, 9
		SIF 種類 == 5
			CONTINUE
		TA:本人:(人数 - 1):種類 = 0
	NEXT
NEXT

;--- TB:地区:位置:キャラ（支配度）の第3添字 ---
FOR 地区, 0, MAX_MAP()
	FOR 位置, 0, MAX_ROOM() + 1
		FOR 本人, 削除, 人数 - 1
			TB:地区:位置:本人 = TB:地区:位置:(本人 + 1)
		NEXT
		TB:地区:位置:(人数 - 1) = 0
	NEXT
NEXT

;--- CFLAG：値として登録番号を持つ枠 ---
FOR 本人, 0, 人数
	;11=最愛 / 16=妊娠時の父親 / 220=恋人相手
	CALL 番号参照_補正(本人, 11, 削除)
	CALL 番号参照_補正(本人, 16, 削除)
	CALL 番号参照_補正(本人, 220, 削除)
NEXT

;--- CFLAG：相手の登録番号を「添字」にしている予約枠 ---
;    3000 膣内精液源 / 3100 肛内精液源 / 3200 膣内射精日
;    3300 妊娠を知っている / 3600 子宮内精液源 / 3700 子宮内到達日
FOR 枠, 0, 6
	SELECTCASE 枠
		CASE 0
			基底 = 3000
		CASE 1
			基底 = 3100
		CASE 2
			基底 = 3200
		CASE 3
			基底 = 3300
		CASE 4
			基底 = 3600
		CASEELSE
			基底 = 3700
	ENDSELECT
	FOR 本人, 0, 人数
		FOR 相手, 削除, 人数 - 1
			CFLAG:本人:(基底 + 相手) = CFLAG:本人:(基底 + 相手 + 1)
		NEXT
		CFLAG:本人:(基底 + 人数 - 1) = 0
	NEXT
NEXT

;--- CFLAG:3400〜3409（直近の中出し相手の履歴。値＝相手番号+1、0=空スロット）---
FOR 本人, 0, 人数
	FOR 枠, 0, 10
		SIF !CFLAG:本人:(3400 + 枠)
			CONTINUE
		IF CFLAG:本人:(3400 + 枠) - 1 == 削除
			CFLAG:本人:(3400 + 枠) = 0
		ELSEIF CFLAG:本人:(3400 + 枠) - 1 > 削除
			CFLAG:本人:(3400 + 枠) -= 1
		ENDIF
	NEXT
NEXT

;--- TCVAR（揮発だが、ロード直後に残っていると番号がズレるので落とす）---
FOR 本人, 0, 人数
	TCVAR:本人:デート中 = 0
	TCVAR:本人:セフレ提案予約 = 0
NEXT
RETURN

;----------------------------------------------------------------
;ARG=キャラ登録番号 / ARG:1=CFLAG番号 / ARG:2=削除される登録番号
;----------------------------------------------------------------
@番号参照_補正(ARG, ARG:1, ARG:2)
IF CFLAG:(ARG):(ARG:1) == ARG:2
	CFLAG:(ARG):(ARG:1) = 0
ELSEIF CFLAG:(ARG):(ARG:1) > ARG:2
	CFLAG:(ARG):(ARG:1) -= 1
ENDIF
RETURN
