@CUSTOM_CHARAMAKE(ARG)

CALL NAME_CUSTOM(ARG)

;身分システム：主人公は名前の直後に身分・年齢を決めてから素質・能力選択へ進む
;（NPC編集=CUSTM_OTHER経由では強制しない）
SIF ARG == MASTER
	CALL AGE_JOB_CUSTOM(ARG)

CALL CUSTOM_TERMINAL(ARG)

@CUSTOM_TERMINAL(ARG)
;排他処理
IF TALENT:ARG:2 & 1
	ABL:ARG:ホモっ気 = 0
	ABL:ARG:ゲイ中毒 = 0
	EXP:ARG:ゲイ経験 = 0
	SIF !(TALENT:ARG:2 & 2)
		EXP:ARG:射精経験 = 0
ELSE
	ABL:ARG:Ｖ感覚 = 0
	ABL:ARG:レズっ気 = 0
	ABL:ARG:レズ中毒 = 0
	EXP:ARG:レズ経験 = 0
	EXP:ARG:噴乳経験 = 0
	EXP:ARG:Ｖ経験 = 0
	EXP:ARG:パイズリ経験 = 0
	EXP:ARG:Ｖ性交経験 = 0
	EXP:ARG:Ｖ拡張経験 = 0
	TALENT:ARG:Ｖ感度 = 0
	TALENT:ARG:処女 = 0
	TALENT:ARG:母乳体質 = 0
	TALENT:ARG:バストサイズ = 0
ENDIF
IF TALENT:ARG:2 & 2
	;MAXBASE:ARG:精力 = 10000
	;BASE:ARG:精力 = 10000
ELSE
	TALENT:ARG:童貞 = 0
	;MAXBASE:ARG:精力 = 0
	;BASE:ARG:精力 = 0
ENDIF
IF TALENT:ARG:処女 == 1
	ABL:ARG:Ｖ感覚 = 0
	EXP:ARG:Ｖ経験 = 0
	EXP:ARG:Ｖ性交経験 = 0
	EXP:ARG:Ｖ拡張経験 = 0
ELSEIF TALENT:ARG:2 & 1 && EXP:ARG:Ｖ経験 == 0
	EXP:ARG:Ｖ経験 = 1
ENDIF

DRAWLINE
PRINTSL NAME:ARG
PRINT 体力:
CALL PRINT_BASEBAR(ARG, 0)
PRINTFORM ({BASE:ARG:0,4}/{MAXBASE:ARG:0,4}) 
PRINT 気力:
CALL PRINT_BASEBAR(ARG, 1)
PRINTFORM ({BASE:ARG:1,4}/{MAXBASE:ARG:1,4})
PRINTL 
CALL PRINT_STATE_ABL(ARG)
PRINTL 
CALL PRINT_STATE_TALENT(ARG)
PRINTL 
CALL PRINT_STATE_EXP(ARG)
PRINTL
DRAWLINE
;最終決定
IF LOCAL:100 == 1000
	DRAWLINE
	PRINTL これで本当によろしいですか？
;名前の設定
ELSEIF LOCAL:100 == 1001
	CALL NAME_CUSTOM(ARG)
	LOCAL:100 = 0
	RESTART
;ベース設定
ELSEIF LOCAL:100 == 1002
	CALL BASE_CUSTOM(ARG)
;素質設定
ELSEIF LOCAL:100 == 1003
	CALL TALENT_CUSTOM(ARG,LOCAL:101)
;能力設定
ELSEIF LOCAL:100 == 1004
	CALL ABL_CUSTOM(ARG)
;経験設定
ELSEIF LOCAL:100 == 1005
	CALL EXP_CUSTOM(ARG)
;身分・年齢の設定（CALL内で完結して戻る＝NAME_CUSTOMと同型）
ELSEIF LOCAL:100 == 1006
	CALL AGE_JOB_CUSTOM(ARG)
	LOCAL:100 = 0
	RESTART
ENDIF

DRAWLINE
PRINTFORML [1000] - \@(LOCAL:100 == 1000) ? はい # 決定\@  [1001] - 名前の変更  [1002] - 体力、気力の設定
PRINTL [1003] - 素質の設定  [1004] - 能力の設定  [1005] - 経験の設定  [1006] - 身分・年齢の設定
INPUT
IF RESULT == 1000 && LOCAL:100 == 1000
	VARSET LOCAL
	RETURN 1
ELSEIF RESULT >= 1000
	LOCAL:100 = RESULT
	RESTART
ENDIF
;ベース設定
IF LOCAL:100 == 1002
	IF RESULT == 0 && MAXBASE:ARG:0 > 1000
		MAXBASE:ARG:0 -= 100
	ELSEIF RESULT == 1 && MAXBASE:ARG:0 < 3000
		MAXBASE:ARG:0 += 100
	ELSEIF RESULT == 2 && MAXBASE:ARG:1 > 1000
		MAXBASE:ARG:1 -= 100
	ELSEIF RESULT == 3 && MAXBASE:ARG:1 < 3000
		MAXBASE:ARG:1 += 100
	ENDIF
	BASE:ARG:0 = MAXBASE:ARG:0
	BASE:ARG:1 = MAXBASE:ARG:1
	RESTART
;素質設定
ELSEIF LOCAL:100 == 1003
	;ページ送り
	SIF RESULT == 998 && LOCAL:101
		LOCAL:101 --
	SIF RESULT == 999
		LOCAL:101 ++
	SIF RESULT < 0 || RESULT > 500 || TALENTNAME:RESULT == ""
		RESTART
	;陥落素質ほか
	SIF (RESULT >= 3 && RESULT <= 5) || RESULT == 9 || RESULT == 34 || (RESULT >= 72 && RESULT <= 76) || RESULT == 84 || RESULT == 85 || (RESULT >= 153 && RESULT <= 155)
		RESTART
	;性別
	IF RESULT == 2
		IF TALENT:ARG:RESULT == 3
			TALENT:ARG:RESULT = 1
		ELSE
			TALENT:ARG:RESULT ++
		ENDIF
	;性別嗜好
	ELSEIF RESULT == 81
		IF TALENT:ARG:RESULT == 3
			TALENT:ARG:RESULT = -1
		ELSE
			TALENT:ARG:RESULT ++
		ENDIF
	;オンオフ型の素質
	ELSEIF TALENTNAME:RESULT == GET_TALENTNAME(RESULT,1) || RESULT == 1
		TALENT:ARG:RESULT = !TALENT:ARG:RESULT
	;量的素質
	ELSE
		;性別
		IF LOCAL == 2
			IF TALENT:ARG:RESULT == 3
				TALENT:ARG:RESULT = 1
			ELSE
				TALENT:ARG:RESULT ++
			ENDIF
		;端まで行くと-1を掛ける
		ELSEIF STRLENS(GET_TALENTNAME(RESULT,TALENT:ARG:RESULT + 1)) || TALENT:ARG:RESULT == -1
			TALENT:ARG:RESULT ++
		ELSE
			TALENT:ARG:RESULT = -1 * TALENT:ARG:RESULT
		ENDIF
	ENDIF
	;バストサイズ素質(素質105)を変更したら胸囲・カップサイズを連動して再計算
	SIF RESULT == 105
		CALL UPDATE_BUST_FROM_TALENT(ARG)
	;体型素質(素質100)を変更したら身長・体重・胴囲・腰囲・胸囲を連動して再計算
	SIF RESULT == 100
		CALL UPDATE_BUILD_FROM_TALENT(ARG)
;能力設定
ELSEIF LOCAL:100 == 1004
	LOCAL = RESULT / 2
	SIF !STRLENS(ABLNAME:LOCAL)
		RESTART
	;同性愛関係
	IF !(TALENT:ARG:2 & 1) && (LOCAL == 17 || LOCAL == 32)
		RESTART
	ELSEIF TALENT:ARG:2 & 1 && (LOCAL == 18 || LOCAL == 33)
		RESTART
	ENDIF
	;中毒関係
	SIF LOCAL >= 30
		RESTART
	;奇数(+)
	IF RESULT % 2
		IF ABL:ARG:LOCAL >= 2
			RESTART
		ELSE
			ABL:ARG:LOCAL ++
		ENDIF
	;偶数(-)
	ELSE
		IF ABL:ARG:LOCAL <= 0
			RESTART
		ELSE
			ABL:ARG:LOCAL --
		ENDIF
	ENDIF
ELSEIF LOCAL:100 == 1005
	LOCAL = RESULT
	SIF !STRLENS(EXPNAME:LOCAL)
		RESTART
	;同性愛関係
	IF !(TALENT:ARG:2 & 1) && LOCAL == 51
		RESTART
	ELSEIF TALENT:ARG:2 & 1 && LOCAL == 52
		RESTART
	ENDIF
	PRINTFORM %EXPNAME:LOCAL%を入力してください      
	PRINTBUTTON "[キャンセル]",-1
	INPUT
	SIF RESULT < 0
		RESTART
	EXP:ARG:LOCAL = MIN(RESULT,5000)
ELSEIF LOCAL:100 == 1006
	
ENDIF
RESTART

;バストサイズ素質(-2絶壁〜2爆乳)に応じて胸囲(BASE:33)を身長基準で再計算し、カップ(CFLAG:36)も更新する
@UPDATE_BUST_FROM_TALENT(ARG)
;身長未設定(MAXBASE:31<=0)のキャラは計算できないため何もしない
SIF MAXBASE:ARG:身長 <= 0
	RETURN
;アンダーバストは身長(フレーム)で決まり妊娠では変化しない（較正式は@UNDER_BUST_STD）
BASE:ARG:アンダーバスト = UNDER_BUST_STD(ARG)
MAXBASE:ARG:アンダーバスト = BASE:ARG:アンダーバスト
;身長の約53%を並乳(0)の基準胸囲とし、素質1段階につき±5.5cm(55)ずつ増減
LOCAL = MAXBASE:ARG:身長 * 53 / 100 + TALENT:ARG:バストサイズ * 55
;下限ガード(30.0cm)
SIF LOCAL < 300
	LOCAL = 300
BASE:ARG:胸囲 = LOCAL
MAXBASE:ARG:胸囲 = LOCAL
;カップサイズを再計算して反映
CALL GET_CUP_SIZE(ARG)
CFLAG:ARG:36 = RESULT

;体型素質(-3小人〜3巨人)に応じて身長・体重・胴囲・腰囲を再計算し、胸囲・カップも連動更新する
@UPDATE_BUILD_FROM_TALENT(ARG)
;LOCAL=標準身長(性別), LOCAL:1=体型による身長増減, LOCAL:2=体格指数(BMI×10)
;標準身長は女1580(158.0cm)・男1720(172.0cm)
IF TALENT:ARG:性別 & 1
	LOCAL = 1580
ELSE
	LOCAL = 1720
ENDIF
;体型による身長増減(LOCAL:1)と体格指数(LOCAL:2)を決める
IF TALENT:ARG:体型 == -3
	;小人
	LOCAL:1 = -380
	LOCAL:2 = 175
ELSEIF TALENT:ARG:体型 == -2
	;幼児体型
	LOCAL:1 = -200
	LOCAL:2 = 175
ELSEIF TALENT:ARG:体型 == -1
	;小柄体型
	LOCAL:1 = -80
	LOCAL:2 = 185
ELSEIF TALENT:ARG:体型 == 1
	;長身
	LOCAL:1 = 80
	LOCAL:2 = 195
ELSEIF TALENT:ARG:体型 == 2
	;巨躯
	LOCAL:1 = 160
	LOCAL:2 = 240
ELSEIF TALENT:ARG:体型 == 3
	;巨人
	LOCAL:1 = 300
	LOCAL:2 = 280
ELSE
	;0=標準
	LOCAL:1 = 0
	LOCAL:2 = 195
ENDIF
;身長
BASE:ARG:身長 = LOCAL + LOCAL:1
MAXBASE:ARG:身長 = BASE:ARG:身長
;体重 = BMI×身長(m)^2 。身長は×10保存なので体重(×10) = BMI10 × 身長 × 身長 / 1000000
BASE:ARG:体重 = LOCAL:2 * BASE:ARG:身長 * BASE:ARG:身長 / 1000000
MAXBASE:ARG:体重 = BASE:ARG:体重
;胴囲(身長の37%)・腰囲(身長の54%)を比率で再計算
BASE:ARG:胴囲 = BASE:ARG:身長 * 37 / 100
MAXBASE:ARG:胴囲 = BASE:ARG:胴囲
BASE:ARG:腰囲 = BASE:ARG:身長 * 54 / 100
MAXBASE:ARG:腰囲 = BASE:ARG:腰囲
;身長が変わったので胸囲・カップをバスト素質から再算出
CALL UPDATE_BUST_FROM_TALENT(ARG)

;名前の設定
@NAME_CUSTOM(ARG)
PRINTL キャラのNAMEを入力してください
IF STRLENS(NAME:ARG)
	PRINTFORM 現在のNAME：%NAME:ARG%      
	PRINTBUTTON "[変更しない]",""
	PRINTL
ENDIF
INPUTS
IF RESULTS == ""
	NAME:ARG = %NAME:ARG%
ELSE
	NAME:ARG = %RESULTS%
ENDIF

;プレイヤー自身の呼び名は入力させない（本編でほぼ未使用のため省略。口上の二人称用に既定値だけ入れる）
IF ARG == MASTER
	SIF !STRLENS(CALLNAME:ARG)
		CALLNAME:ARG = %NAME:ARG%
	RETURN
ENDIF
PRINTL キャラのCALLNAMEを入力してください
IF STRLENS(CALLNAME:ARG)
	PRINTFORM 現在のCALLNAME：%CALLNAME:ARG%
	PRINTBUTTON "[変更しない]",""
	PRINTL
ENDIF
INPUTS
IF RESULTS == ""
	CALLNAME:ARG = %CALLNAME:ARG%
ELSE
	CALLNAME:ARG = %RESULTS%
ENDIF

;ベースの設定
@BASE_CUSTOM(ARG)
PRINT 体力:
CALL PRINT_BASEBAR(ARG, 0)
PRINTFORM ({BASE:ARG:0,4}/{MAXBASE:ARG:0,4})
IF BASE:ARG:0 != 1000
	PRINTBUTTON "[−]", 0
ELSE
	SETCOLOR 0x969696
	PRINT [−]
	RESETCOLOR
ENDIF
IF BASE:ARG:0 != 3000
	PRINTBUTTON "[＋]", 1
ELSE
	SETCOLOR 0x969696
	PRINT [＋]
	RESETCOLOR
ENDIF
PRINTL
PRINT 気力:
CALL PRINT_BASEBAR(ARG, 1)
PRINTFORM ({BASE:ARG:1,4}/{MAXBASE:ARG:1,4})
IF BASE:ARG:1 != 1000
	PRINTBUTTON "[−]", 2
ELSE
	SETCOLOR 0x969696
	PRINT [−]
	RESETCOLOR
ENDIF
IF BASE:ARG:1 != 3000
	PRINTBUTTON "[＋]", 3
ELSE
	SETCOLOR 0x969696
	PRINT [＋]
	RESETCOLOR
ENDIF
PRINTL
;素質の設定
@TALENT_CUSTOM(ARG,ARG:1)
VARSET LOCAL
FOR LOCAL,ARG:1 * 40,40 + ARG:1 * 40
	IF LOCAL % 10 == 0
		PRINTL
		SIF LOCAL:1 % 2
			PRINTL
		LOCAL:1 = 0
	ENDIF
	;陥落素質ほか
	SIF (LOCAL >= 3 && LOCAL <= 5) || LOCAL == 9 || LOCAL == 34 || (LOCAL >= 72 && LOCAL <= 76) || LOCAL == 84 || LOCAL == 85 || (LOCAL >= 153 && LOCAL <= 155)
		CONTINUE
	;TALENT.CSVに登録されていない
	SIF TALENTNAME:LOCAL == ""
		CONTINUE
	;オンオフ型の素質(TALENTNAMEと素質表示が一致)
	IF TALENTNAME:LOCAL == GET_TALENTNAME(LOCAL,1)
		SIF !TALENT:ARG:LOCAL
			SETCOLOR 150,150,150
		LOCALS = [{LOCAL,3}] - %TALENTNAME:LOCAL%
	;童貞
	ELSEIF LOCAL == 1
		SIF TALENT:ARG:LOCAL
			SETCOLOR 150,150,150
		LOCALS = [{LOCAL,3}] - %TALENTNAME:LOCAL%
	;量的素質
	ELSE
		SIF !TALENT:ARG:LOCAL
			SETCOLOR 150,150,150
		LOCALS =  [{LOCAL,3}] - %TALENTNAME:LOCAL%
		IF STRLENS(GET_TALENTNAME(LOCAL,TALENT:ARG:LOCAL))
			LOCALS:1 =  …【%GET_TALENTNAME(LOCAL,TALENT:ARG:LOCAL)%】
		ELSE
			LOCALS:1 = …
		ENDIF
		LOCALS += LOCALS:1
	ENDIF
	PRINTFORM %LOCALS,35,LEFT%
	LOCAL:1 ++
	SIF LOCAL:1 % 2 == 0
		PRINTL
	RESETCOLOR
NEXT
PRINTL

IF ARG:1 != 0
	PRINTBUTTON "[998] - 前のページ                 ",998
ELSE
	SETCOLOR 0x969696
	PRINTFORM %"[---] - 前のページ",35,LEFT%
	RESETCOLOR
ENDIF
IF ARG:1 != 3
	PRINTBUTTON "[999] - 次のページ",999
ELSE
	SETCOLOR 0x969696
	PRINTFORM %"[---] - 次のページ",35,LEFT%
	RESETCOLOR
ENDIF
PRINTL

@ABL_CUSTOM(ARG)
LOCAL:1 = 0
FOR LOCAL,0,50
	SIF !STRLENS(ABLNAME:LOCAL)
		CONTINUE
	;同性愛関係
	IF !(TALENT:ARG:2 & 1) && (LOCAL == 17 || LOCAL == 32)
		CONTINUE
	ELSEIF TALENT:ARG:2 & 1 && (LOCAL == 18 || LOCAL == 33)
		CONTINUE
	ENDIF
	;中毒も無し
	SIF LOCAL >= 30
		CONTINUE
	PRINTFORM %ABLNAME:LOCAL,12%:{ABL:ARG:LOCAL,5,LEFT} 
	IF ABL:ARG:LOCAL != 0
		PRINTBUTTON "[−]", LOCAL * 2
	ELSE
		SETCOLOR 0x969696
		PRINT [−]
		RESETCOLOR
	ENDIF
	IF ABL:ARG:LOCAL != 2
		PRINTBUTTON "[＋]", LOCAL * 2 + 1
	ELSE
		SETCOLOR 0x969696
		PRINT [＋]
		RESETCOLOR
	ENDIF
	LOCAL:1 ++
	SIF LOCAL:1 % 2 == 0
		PRINTL 
NEXT
PRINTL
@EXP_CUSTOM(ARG)
VARSET LOCAL
FOR LOCAL,0,100
	SIF !STRLENS(EXPNAME:LOCAL)
		CONTINUE
	;同性愛関係
	IF !(TALENT:ARG:2 & 1) && LOCAL == 51
		CONTINUE
	ELSEIF TALENT:ARG:2 & 1 && LOCAL == 52
		CONTINUE
	ENDIF
	PRINTFORM [{LOCAL,2}] - %EXPNAME:LOCAL,12%:{EXP:ARG:LOCAL,5,LEFT} 
	LOCAL:1 += 1
	SIF LOCAL:1 % 3 == 0
		PRINTL 
NEXT
PRINTL

;------------------------------------------------------------
;身分・年齢設定（身分システム。2026-07-19追加）
;学生／教師の身分を選び、学生は学年、全身分で数値年齢(cflag:78)を設定する。
;素質は番号で操作：学生160 / 学年161 / 教師162（名前リテラルは識別子エラーを避けるため使わない）
@AGE_JOB_CUSTOM(ARG)
VARSET LOCAL
;初回表示用：年齢未設定なら現在の身分から既定値を補完
SIF !CFLAG:ARG:年齢
	CALL 身分年齢_既定(ARG)
$INPUT_LOOP
DRAWLINE
PRINTL ■ 身分・年齢の設定
PRINTL
PRINT 現在の身分：
IF TALENT:ARG:160
	PRINTFORML 学生（%GET_TALENTNAME(161, TALENT:ARG:161)%）
ELSEIF CFLAG:ARG:仕事 == 1
	PRINTL 教師
ELSEIF CFLAG:ARG:仕事 == 5
	PRINTL 会社員
ELSEIF CFLAG:ARG:仕事 == 6
	PRINTL フリーター
ELSEIF CFLAG:ARG:仕事 == 7
	PRINTL 専業主婦・家事手伝い
ELSEIF CFLAG:ARG:仕事 == 8
	PRINTL キャバ嬢
ELSEIF CFLAG:ARG:仕事 == 9
	PRINTL ソープ嬢
ELSEIF CFLAG:ARG:仕事 == 10
	PRINTL ダンサー
ELSE
	PRINTL 無職
ENDIF
PRINTFORML 年齢：{CFLAG:ARG:年齢}歳
PRINTL
DRAWLINE
PRINTL ◆ 身分を選ぶ
PRINTBUTTON "[1] - 学生",1
PRINTBUTTON "[2] - 教師",2
PRINTBUTTON "[3] - 会社員",3
PRINTBUTTON "[4] - フリーター",4
PRINTL
PRINTBUTTON "[5] - 専業主婦・家事手伝い",5
PRINTBUTTON "[6] - キャバ嬢",6
PRINTBUTTON "[7] - ソープ嬢",7
PRINTBUTTON "[8] - ダンサー",8
PRINTL
IF TALENT:ARG:160
	PRINTL ◆ 学年
	PRINTBUTTON "[11] - 一年生",11
	PRINTBUTTON "[12] - 二年生",12
	PRINTBUTTON "[13] - 三年生",13
	PRINTBUTTON "[14] - 四年生",14
	PRINTL
ENDIF
PRINTL ◆ 年齢の微調整
PRINTBUTTON "[21] - 年齢 −1",21
PRINTBUTTON "[22] - 年齢 ＋1",22
PRINTL
DRAWLINE
PRINTBUTTON "[1000] - 決定",1000
PRINTL
INPUT
SELECTCASE RESULT
	CASE 1
		;学生
		TALENT:ARG:160 = 1
		TALENT:ARG:162 = 0
		CFLAG:ARG:仕事 = 0
		SIF !TALENT:ARG:161
			TALENT:ARG:161 = 2
		CALL 身分年齢_既定(ARG)
	CASE 2
		;教師
		TALENT:ARG:160 = 0
		TALENT:ARG:161 = 0
		TALENT:ARG:162 = 1
		CFLAG:ARG:仕事 = 1
		CALL 身分年齢_既定(ARG)
	CASE 3,4,5,6,7,8
		;会社員(5)/フリーター(6)/専業主婦(7)/キャバ嬢(8)/ソープ嬢(9)/ダンサー(10)：cflag:72仕事に変換して保持
		TALENT:ARG:160 = 0
		TALENT:ARG:161 = 0
		TALENT:ARG:162 = 0
		CFLAG:ARG:仕事 = RESULT + 2
		CALL 身分年齢_既定(ARG)
	CASE 11,12,13,14
		;学年（学生のみ表示。大学なので1〜4年）
		TALENT:ARG:161 = RESULT - 10
		CALL 身分年齢_既定(ARG)
	CASE 21
		;登場人物は全員20歳以上なので、微調整でも20歳を下回らせない
		SIF CFLAG:ARG:年齢 > 20
			CFLAG:ARG:年齢 -= 1
	CASE 22
		CFLAG:ARG:年齢 += 1
	CASE 1000
		RETURN
ENDSELECT
GOTO INPUT_LOOP

;身分・学年から既定年齢をセット（微調整前のベース値）
;登場人物は全員20歳以上。年齢の既定値はここが唯一の定義で、
;SYSTEM.ERBの@EVENTFIRST／@EVENTLOADもこの関数を呼ぶ（式を重複させない）
@身分年齢_既定(ARG)
IF TALENT:ARG:160
	;大学生：1年20歳/2年21歳/3年22歳/4年23歳
	CFLAG:ARG:年齢 = 19 + TALENT:ARG:161
ELSEIF CFLAG:ARG:仕事 == 1
	;教師（大学の教員）：既定28歳
	CFLAG:ARG:年齢 = 28
ELSEIF CFLAG:ARG:仕事 == 5
	;会社員：既定22歳
	CFLAG:ARG:年齢 = 22
ELSEIF CFLAG:ARG:仕事 == 6
	;フリーター：既定20歳
	CFLAG:ARG:年齢 = 20
ELSEIF CFLAG:ARG:仕事 == 7
	;専業主婦・家事手伝い：既定20歳
	CFLAG:ARG:年齢 = 20
ELSEIF CFLAG:ARG:仕事 == 8
	;キャバ嬢：既定20歳
	CFLAG:ARG:年齢 = 20
ELSEIF CFLAG:ARG:仕事 == 9
	;ソープ嬢：既定20歳
	CFLAG:ARG:年齢 = 20
ELSEIF CFLAG:ARG:仕事 == 10
	;ダンサー：既定20歳
	CFLAG:ARG:年齢 = 20
ELSE
	CFLAG:ARG:年齢 = 20
ENDIF

;------------------------------------------------------------
;家族構成設定
@CUSTOM_FAMILY
VARSET LOCAL
LOCAL:0 = 3
	;0:父 1:母
	;※兄(014)・姉(015)・弟(012)・妹(013)は2026-07-26に削除

PRINTL 家族構成を決めてください
$INPUT_LOOP
PRINTL ---------------------------
FOR LOCAL:1, 0,2

	LOCALS = [{(LOCAL:1+1),3}]

	SELECTCASE LOCAL:1
		CASE 0
			LOCALS += "父"
		CASE 1
			LOCALS += "母"
		CASEELSE
			LOCALS += "????"
	ENDSELECT
	
	GETBIT LOCAL:0, LOCAL:1
	SIF RESULT:0 != 1
		SETCOLOR 100,100,100
	
	PRINTFORM %LOCALS,15,LEFT%

	SIF LOCAL:1 % 2 == 1
	PRINTL
	
	RESETCOLOR
NEXT
PRINTL ---------------------------

PRINTBUTTON "[1000] - 決定",1000
	PRINTL
INPUT

PRINTL

IF RESULT == 1000 

	FOR LOCAL:2,2,100
		
		SELECTCASE LOCAL:2
		CASE 10
			GETBIT LOCAL:0, 0
		CASE 11
			GETBIT LOCAL:0, 1
		;兄(14)・姉(15)・弟(12)・妹(13)は削除済み。CSVも無いが明示的に登録しない
		CASE 12 TO 15
			RESULT:0 = 0
		CASEELSE
			RESULT:0 = 1
		ENDSELECT
		SIF RESULT:0 == 1 && EXISTCSV(LOCAL:2,0)
			ADDCHARA LOCAL:2

	NEXT

	RETURN 0
ELSE
	LOCAL:2 = RESULT-1
	;PRINTFORM RESULT
	INVERTBIT LOCAL:0, LOCAL:2
	GOTO INPUT_LOOP
ENDIF


