;=================================================
; 酔いシステム（2026-07-21追加）
;  居酒屋(2,54)・バー(2,55)の飲酒を中心に、酒に酔う状態を全キャラ共通で扱う。
;  状態は BASE:酔い（0〜1000）に集約し、判定・補正はここの純関数に一元化する
;  （営業時間.ERB と同じ「状態を持たない一元管理」方式）。
;
;  ・BASE:27 酔い     … 酔い度。MAXBASE=1000。@酔い_経過が毎ターン減衰させる
;  ・ABL:48 酒耐性    … 高いほど酔いにくく、抜けるのも早い（EXP:80 飲酒経験で昇格）
;  ・EXP:80 飲酒経験  … 一杯ごとに加算
;  ・TALENT:156 酒豪 / 157 下戸 … 酔いやすさの個人差
;  ・CFLAG:3515 二日酔い（1=本日二日酔い。@NEXT_DAYがセット）
;  ・CFLAG:3516 お持ち帰られ回数（累計・永続）
;  ・TCVAR:636 当日飲酒量 / 637 お持ち帰り済（BEGIN TRAINで自動クリア）
;
;  昨夜の醜態（2026-07-22追加。CSV未登録の生番号運用＝3515-3518と同じ規約）
;  ・CFLAG:3519 昨夜の醜態種別（0=なし / 1=本音 / 2=愚痴 / 3=惚気 / 4=泣き上戸 / 5=歌い出す / 6=介抱された）
;  ・CFLAG:3520 昨夜の醜態の相手（キャラ登録番号）
;  ・CFLAG:3521 昨夜の記憶保持度（0=完全に飛んだ / 1=断片的 / 2=覚えている）
;  ・TCVAR:639 当日介抱済（酒場.ERB @酒場_介抱。BEGIN TRAINで自動クリア）
;  記録は@醜態記録、翌朝の回想は@醜態_翌朝（EVENTTRAINの@二日酔い_朝の直後）。
;  日を跨ぐ値なのでTCVARではなくCFLAGに置く（TCVARはBEGIN TRAINで毎朝クリアされるため）。
;
;  段階: 0=素面 / 1=ほろ酔い(200-) / 2=酔い(400-) / 3=泥酔(600-) / 4=意識朦朧(800-)
;=================================================

;-------------------------------------------------
; 酔いの段階（0〜4）
;-------------------------------------------------
@酔い段階(ARG)
#FUNCTION
SELECTCASE BASE:ARG:酔い
	CASE IS >= 800
		RETURNF 4
	CASE IS >= 600
		RETURNF 3
	CASE IS >= 400
		RETURNF 2
	CASE IS >= 200
		RETURNF 1
	CASEELSE
		RETURNF 0
ENDSELECT

;-------------------------------------------------
; 段階名（表示用）
;  ※状態タグ（素面なら何も出さない）は @酔い状態タグ が別に持つ
;-------------------------------------------------
@酔い段階_名(ARG)
#FUNCTIONS
SELECTCASE 酔い段階(ARG)
	CASE 4
		RETURNF "意識朦朧"
	CASE 3
		RETURNF "泥酔"
	CASE 2
		RETURNF "酔っている"
	CASE 1
		RETURNF "ほろ酔い"
	CASEELSE
		RETURNF "素面"
ENDSELECT

;-------------------------------------------------
; 状態タグ（メイン画面の @状態タグ文字列 から呼ぶ。@病気状態タグ と同型）
;  素面は空文字。泥酔以降は「急性の危険側は赤系」という既存の配色規則に従う
;-------------------------------------------------
@酔い状態タグ(ARG)
#FUNCTIONS
#DIMS OUT
OUT =
SELECTCASE 酔い段階(ARG)
	CASE 4
		OUT '= @"<font color='#FF3333'>【意識朦朧】</font>"
	CASE 3
		OUT '= @"<font color='#FF6666'>【泥酔】</font>"
	CASE 2
		OUT '= @"【酔っている】"
	CASE 1
		OUT '= @"【ほろ酔い】"
ENDSELECT
SIF CFLAG:ARG:3515
	OUT '= @"%OUT%【二日酔い】"
RETURNF OUT

;-------------------------------------------------
; 酔いの上限を保証する（MAXBASE未設定の旧セーブ・未初期化キャラ対策）
;  BASE系の表示・演算より先に呼ぶ。刺激度がメイン画面描画で毎回上限を代入しているのと同趣旨
;-------------------------------------------------
@酔い_上限保証(ARG)
SIF !MAXBASE:ARG:酔い
	MAXBASE:ARG:酔い = 1000
RETURN

;-------------------------------------------------
; 酔いの上がりやすさ（％）。100=標準
;  酒耐性が高いほど・体格が大きいほど回りにくい。酒豪/下戸で大きく変わる
;-------------------------------------------------
@酔いやすさ(ARG)
#FUNCTION
#DIM 倍率
倍率 = 100
;酒耐性1LVにつき-12%（LV5で40%まで低下）
倍率 -= MIN(ABL:ARG:酒耐性, 5) * 12
;素質
SIF TALENT:ARG:酒豪
	倍率 = 倍率 * 50 / 100
SIF TALENT:ARG:下戸
	倍率 = 倍率 * 200 / 100
;体格補正（BASE:体重は10倍格納。標準60.0kg基準。未設定時は補正なし）
SIF BASE:ARG:体重 > 0
	倍率 = 倍率 * 600 / BASE:ARG:体重
RETURNF MAX(倍率, 10)

;-------------------------------------------------
; 飲酒（ARG=対象 / ARG:1=酒の強さ。ビール100・サワー80・日本酒180・焼酎250・カクテル150 目安）
;  酔い度を上げ、飲酒経験を加算する。酔いに伴う理性・ストレスの変化もここで行う
;-------------------------------------------------
@飲酒(ARG, ARG:1)
#DIM 本人
#DIM 上昇
;CALLを挟むためARGは先に退避する（既存関数の流儀）
本人 = ARG
上昇 = ARG:1
CALL 酔い_上限保証(本人)
上昇 = 上昇 * 酔いやすさ(本人) / 100
BASE:本人:酔い = LIMIT(BASE:本人:酔い + 上昇, 0, MAXBASE:本人:酔い)
EXP:本人:飲酒経験 += 1
;酒は理性を溶かし、ストレスを流す（DOWNBASE += が軽減方向）
BASE:本人:理性 = LIMIT(BASE:本人:理性 - 上昇 * 2, 0, MAXBASE:本人:理性)
DOWNBASE:本人:ストレス += 上昇 * 2
;ほろ酔い以上では気分が高揚する
SIF 酔い段階(本人) >= 1
	BASE:本人:興奮度 = LIMIT(BASE:本人:興奮度 + 上昇 / 2, 0, MAXBASE:本人:興奮度)
;プレイヤーの当日杯数（店側の心配イベント用）
SIF 本人 == MASTER
	TCVAR:MASTER:当日飲酒量 += 1
RETURN

;-------------------------------------------------
; 時間経過による酔いの減衰（ARG=対象 / ARG:1=経過分）
;  TIME_COUNT.ERB の全キャラループから毎回呼ばれる
;-------------------------------------------------
@酔い_経過(ARG, ARG:1)
#DIM 本人
#DIM 減衰
;CALLを挟むためARGは先に退避する
本人 = ARG
減衰 = ARG:1
CALL 酔い_上限保証(本人)
SIF BASE:本人:酔い <= 0
	RETURN
;1分あたり2.0が基準。酒耐性1LVごとに+0.6、酒豪は1.5倍、下戸は0.7倍
減衰 = 減衰 * (10 + MIN(ABL:本人:酒耐性, 5) * 3) / 5
SIF TALENT:本人:酒豪
	減衰 = 減衰 * 150 / 100
SIF TALENT:本人:下戸
	減衰 = 減衰 * 70 / 100
BASE:本人:酔い = MAX(BASE:本人:酔い - MAX(減衰, 1), 0)
RETURN

;-------------------------------------------------
; 抵抗力の補正（％）。酔うほど抗えなくなる
;  抵抗判定の入口で BASE:抵抗 に乗算して使う
;-------------------------------------------------
@酔い補正_抵抗(ARG)
#FUNCTION
SELECTCASE 酔い段階(ARG)
	CASE 4
		RETURNF 10
	CASE 3
		RETURNF 30
	CASE 2
		RETURNF 60
	CASE 1
		RETURNF 85
	CASEELSE
		RETURNF 100
ENDSELECT

;-------------------------------------------------
; 理性の補正（％）。判断力・拒否の固さに使う
;-------------------------------------------------
@酔い補正_理性(ARG)
#FUNCTION
SELECTCASE 酔い段階(ARG)
	CASE 4
		RETURNF 15
	CASE 3
		RETURNF 40
	CASE 2
		RETURNF 70
	CASE 1
		RETURNF 90
	CASEELSE
		RETURNF 100
ENDSELECT

;-------------------------------------------------
; 二日酔いの発生判定（@NEXT_DAY＝日付が変わる瞬間に呼ぶ）
;  就寝時に酔いが残っていたら翌日は二日酔い。酔い自体は日を跨げばリセットされる。
;  実際の体調ペナルティは翌朝＝@二日酔い_朝（EVENTTRAIN）で適用する
;-------------------------------------------------
@酔い_日跨ぎ(ARG)
#DIM 本人
;CALLを挟むためARGは先に退避する
本人 = ARG
CALL 酔い_上限保証(本人)
IF BASE:本人:酔い >= 400
	CFLAG:本人:3515 = 1
	;酒耐性が高ければ軽く済む
	SIF ABL:本人:酒耐性 >= 3 && BASE:本人:酔い < 700
		CFLAG:本人:3515 = 0
ELSE
	CFLAG:本人:3515 = 0
ENDIF
;昨夜の記憶がどれだけ残っているか（@醜態記録がある場合のみ翌朝に意味を持つ）
;  酒耐性が高いほど、深く酔っていても覚えている＝翌朝きちんと恥ずかしい
;  ※BASE:酔いを0に戻す前に算出すること
SELECTCASE 酔い段階(本人)
	CASE 4
		CFLAG:本人:3521 = 0
	CASE 3
		CFLAG:本人:3521 = 0
		SIF ABL:本人:酒耐性 >= 3
			CFLAG:本人:3521 = 1
	CASE 2
		CFLAG:本人:3521 = 1
		SIF ABL:本人:酒耐性 >= 2
			CFLAG:本人:3521 = 2
	CASEELSE
		CFLAG:本人:3521 = 2
ENDSELECT
BASE:本人:酔い = 0
RETURN

;-------------------------------------------------
; 二日酔いの朝（EVENTTRAINの起床処理から呼ぶ）
;  EVENTTRAINが体力・気力・理性を回復させた「後」に呼ぶこと（回復で上書きされないため）
;-------------------------------------------------
@二日酔い_朝(ARG)
SIF !CFLAG:ARG:3515
	RETURN
BASE:ARG:体力 = LIMIT(BASE:ARG:体力 * 60 / 100, 0, MAXBASE:ARG:体力)
BASE:ARG:気力 = LIMIT(BASE:ARG:気力 * 60 / 100, 0, MAXBASE:ARG:気力)
BASE:ARG:疲労 = LIMIT(BASE:ARG:疲労 + 300, 0, MAXBASE:ARG:疲労)
BASE:ARG:機嫌 = LIMIT(BASE:ARG:機嫌 - 300, 0, MAXBASE:ARG:機嫌)
IF ARG == MASTER
	PRINTL 目を覚ました瞬間、こめかみを万力で締めつけられるような頭痛が襲ってきた。
	PRINTW 口の中がからからに乾いている。……昨夜は、少し飲みすぎたらしい。
ENDIF
RETURN

;-------------------------------------------------
; ※飲酒の年齢判定（@飲酒許可 / @飲酒許可_断り文 / @酔い_成人判定）は撤去した。
;   登場人物が全員20歳以上になり、判定が常に「許可」を返すだけになったため
;   （呼び出し元だった 酒場.ERB の @酒場_注文 / @酒場_乾杯 / @酒場_相手の品 も同時に整理）。
;   未成年の身分を復活させる場合は、この3関数と呼び出し3箇所を戻すこと。
;-------------------------------------------------

;-------------------------------------------------
; 酔いの口調（地の文に挟む修飾。素面は空文字）
;-------------------------------------------------
@酔い_口調(ARG)
#FUNCTIONS
SELECTCASE 酔い段階(ARG)
	CASE 4
		RETURNF "呂律も回らない声で"
	CASE 3
		RETURNF "呂律の怪しい口ぶりで"
	CASE 2
		RETURNF "やけに大きな声で"
	CASE 1
		RETURNF "少し砕けた調子で"
	CASEELSE
		RETURNF ""
ENDSELECT

;-------------------------------------------------
; 昨夜の醜態を記録する（ARG=本人 / ARG:1=種別 / ARG:2=相手）
;  種別: 1=本音 2=愚痴 3=惚気 4=泣き上戸 5=歌い出す 6=介抱された
;  ・素面〜ほろ酔い（段階1以下）では記録しない＝酔っていないなら醜態ではない
;  ・相手は「+1」して格納する（0=相手なし。旧セーブのCFLAG初期値0と区別するため）
;  ・その晩の最後の醜態で上書きする（後勝ち）
;-------------------------------------------------
@醜態記録(ARG, ARG:1, ARG:2)
SIF ARG != MASTER
	RETURN
SIF 酔い段階(ARG) < 2
	RETURN
CFLAG:ARG:3519 = ARG:1
CFLAG:ARG:3520 = ARG:2 + 1
RETURN

;-------------------------------------------------
; 昨夜の醜態を思い出す朝（EVENTTRAINの@二日酔い_朝の直後に呼ぶ）
;  記憶保持度（@酔い_日跨ぎが算出）で見え方が変わる。
;  二日酔いとは独立＝軽く飲んだだけでも、口が滑っていれば翌朝は恥ずかしい
;-------------------------------------------------
@醜態_翌朝(ARG)
#DIM 本人
#DIM 種別
#DIM 相手
#DIM 記憶
本人 = ARG
種別 = CFLAG:本人:3519
SIF !種別
	RETURN
相手 = CFLAG:本人:3520 - 1
記憶 = CFLAG:本人:3521
;記録は毎朝消費する（NPCは表示せずクリアのみ）
CFLAG:本人:3519 = 0
CFLAG:本人:3520 = 0
CFLAG:本人:3521 = 0
SIF 本人 != MASTER
	RETURN
PRINTL
IF 記憶 >= 2
	SELECTCASE 種別
		CASE 1
			PRINTL 顔を洗っていると、昨夜の自分の声がふいに耳の奥で再生された。
			SIF 相手 >= 0
				PRINTFORML ……よりによって%CALLNAME:相手%に、あそこまで本音を並べ立てるとは。
		CASE 2
			PRINTL 昨夜、誰かを相手に延々と愚痴をこぼしていたことを思い出した。
			SIF 相手 >= 0
				PRINTFORML %CALLNAME:相手%は最後まで聞いてくれたが、あれは相当うんざりしていたはずだ。
		CASE 3
			PRINTL 惚気ていた。それも、聞かれてもいないのに何度も。
			SIF 相手 >= 0
				PRINTFORML %CALLNAME:相手%の生ぬるい笑顔まで、はっきりと思い出せてしまう。
		CASE 4
			PRINTL ……泣いた。理由もよく分からないまま、卓に突っ伏して。
			SIF 相手 >= 0
				PRINTFORML %CALLNAME:相手%が背中をさすってくれたことまで、ちゃんと覚えている。
		CASE 5
			PRINTL 歌っていた。手拍子まで求めて、それはもう朗々と。
		CASEELSE
			PRINTL 昨夜、自分が誰かに介抱されていたことを思い出した。
			SIF 相手 >= 0
				PRINTFORML 水を運んでくれたのも、肩を貸してくれたのも%CALLNAME:相手%だった。
	ENDSELECT
	PRINTW 枕に顔を埋めて、あなたはしばらく動けなかった。
ELSEIF 記憶 == 1
	PRINTL 昨夜の記憶が、切れ切れにしか繋がらない。
	SELECTCASE 種別
		CASE 1,2,3
			PRINTL 自分が何かを喋り続けていた、という感触だけが残っている。
		CASE 4
			PRINTL 頬が濡れていた気がする。……泣いたのだろうか。
		CASE 5
			PRINTL やけに喉が痛い。まさか、歌ったのか。
		CASEELSE
			PRINTL 誰かに肩を借りて歩いた気がする。あれは、誰だっただろう。
	ENDSELECT
	PRINTW （……あれ。私、何か言ったっけ）
ELSE
	PRINTL 昨夜の記憶が、どこを探しても出てこない。
	PRINTL 店に入ったところまでは覚えている。その先が、まるごと無い。
	PRINTW （……まあ、大したことはしていないはずだ。たぶん）
ENDIF
RETURN
