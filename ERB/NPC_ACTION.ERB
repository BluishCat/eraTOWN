@NPC_ACTION(ARG)
VARSET LOCAL
;被害届が受理されて拘留中の者は署から出られない（警察署.ERB）。
;イベント中（プレイヤーと絡んでいる最中）は既存の流れを優先する
IF CFLAG:ARG:拘留日数 > 0 && !TCVAR:ARG:イベント
	CALL 拘留位置へ(ARG)
	CFLAG:ARG:待機時間 += 5
	RETURN 1
ENDIF
IF TCVAR:ARG:イベント
	IF TCVAR:ARG:同行
		IF CFLAG:ARG:現在地区 != CFLAG:MASTER:現在地区 || CFLAG:ARG:現在位置 != CFLAG:MASTER:現在位置
			CFLAG:ARG:現在地区 = CFLAG:MASTER:現在地区
			CFLAG:ARG:現在位置 = CFLAG:MASTER:現在位置
			CFLAG:ARG:待機時間 = CFLAG:MASTER:待機時間
			RETURN 1
		ELSEIF CFLAG:ARG:乗車 != CFLAG:MASTER:乗車
			CFLAG:ARG:到着地区 = CFLAG:MASTER:到着地区
			CFLAG:ARG:到着位置 = CFLAG:MASTER:到着位置
			CFLAG:ARG:乗車 = CFLAG:MASTER:乗車
			CFLAG:ARG:待機時間 = CFLAG:MASTER:待機時間
			CFLAG:ARG:到着時間 = CFLAG:MASTER:到着時間
			RETURN 1
		ENDIF
	ENDIF
	TCVAR:MASTER:行為対象 = ARG
	TCVAR:ARG:行為対象 = MASTER
	;TCVAR:ARG:攻め受け = 1
	;TCVAR:(TCVAR:ARG:行為対象):攻め受け = 2
;#;PRINTVL ARG
	CALLFORM NPC_ACTION_{TCVAR:ARG:イベント}(ARG)
	CALLFORM XCOM{SELECTCOM:ARG}(ARG)
	CALL SOURCE_CHECKS(ARG)
ELSE
	IF TIME >= CFLAG:ARG:就寝時間 || TIME <= CFLAG:ARG:起床時間
		CFLAG:ARG:待機時間 += 5
	ELSEIF TCVAR:ARG:目的位置
		CALL NPC_MOVEMENT(ARG)
		CALL SOURCE_CHECKS(ARG)
;;;華澄先生授業前移動処理
	ELSEIF TALENT:ARG:教師 && ((TIME >= 420 && TIME <= 510) || (TIME >= 750 && TIME <= 810) || TIME >= 960) && !(CFLAG:ARG:現在地区 == 1 && CFLAG:ARG:現在位置 == 4) && !D:101
			TCVAR:ARG:目的地区 = 1
			TCVAR:ARG:目的位置 = 4
			CALL NPC_MOVEMENT(ARG)
			CALL SOURCE_CHECKS(ARG)
	ELSEIF TALENT:ARG:教師 && ((TIME >= 510 && TIME <= 750) || (TIME >= 810 && TIME <= 960)) && !(CFLAG:ARG:現在地区 == 1 && CFLAG:ARG:現在位置 == 2) && !D:101
			TCVAR:ARG:目的地区 = 1
			TCVAR:ARG:目的位置 = 2
			CALL NPC_MOVEMENT(ARG)
			CALL SOURCE_CHECKS(ARG)
;;;午前の講義処理
;;;大学は学年ごとの自分の教室を持たないので、学生も教員も講義室(地区1・位置2)へ集まる
	ELSEIF (TALENT:ARG:学生 || CFLAG:ARG:仕事 == 1) && TIME >= 510 && TIME <= 749 && !D:101
		IF !(CFLAG:ARG:現在地区 == 1 && CFLAG:ARG:現在位置 == 2)
			TCVAR:ARG:目的地区 = 1
			TCVAR:ARG:目的位置 = 2
			CALL NPC_MOVEMENT(ARG)
			CALL SOURCE_CHECKS(ARG)
		ELSE
			CFLAG:ARG:待機時間 += 750 - TIME
			IF TFLAG:COM用変数 == 0 || TALENT:ARG:妊娠
				BASE:ARG:学力 = MIN(BASE:ARG:学力 + CFLAG:ARG:待機時間 / 6,MAXBASE:ARG:学力)
				EXP:ARG:学習経験 += CFLAG:ARG:待機時間 * 4 / 60 / 5
				MAXBASE:ARG:気力 += CFLAG:ARG:待機時間 * 3 / 60
				DOWNBASE:ARG:体力 -= CFLAG:ARG:待機時間 * 20 / 60
				DOWNBASE:ARG:気力 += CFLAG:ARG:待機時間 * 40 / 60
				DOWNBASE:ARG:ストレス -= CFLAG:ARG:待機時間 * 40 / 60
			ELSE
				EXP:ARG:運動経験 += CFLAG:ARG:待機時間 * 2 / 60
				MAXBASE:ARG:体力 += CFLAG:ARG:待機時間 * 3 / 60
				DOWNBASE:ARG:体力 += CFLAG:ARG:待機時間 * 40 / 60
				DOWNBASE:ARG:気力 -= CFLAG:ARG:待機時間 * 20 / 60
				DOWNBASE:ARG:疲労 -= CFLAG:ARG:待機時間 * 50 / 60
			ENDIF
		ENDIF
;;;午後の講義処理（午前と同じく講義室へ集約）
	ELSEIF (TALENT:ARG:学生 || CFLAG:ARG:仕事 == 1) && TIME >= 810 && TIME <= 959 && !D:101
		IF !(CFLAG:ARG:現在地区 == 1 && CFLAG:ARG:現在位置 == 2)
			TCVAR:ARG:目的地区 = 1
			TCVAR:ARG:目的位置 = 2
			CALL NPC_MOVEMENT(ARG)
			CALL SOURCE_CHECKS(ARG)
		ELSE
			CFLAG:ARG:待機時間 += 960 - TIME
			IF TFLAG:COM用変数 == 0 || TALENT:ARG:妊娠
				BASE:ARG:学力 = MIN(BASE:ARG:学力 + CFLAG:ARG:待機時間 / 6,MAXBASE:ARG:学力)
				EXP:ARG:学習経験 += CFLAG:ARG:待機時間 * 4 / 60 / 5
				MAXBASE:ARG:気力 += CFLAG:ARG:待機時間 * 3 / 60
				DOWNBASE:ARG:体力 -= CFLAG:ARG:待機時間 * 20 / 60
				DOWNBASE:ARG:気力 += CFLAG:ARG:待機時間 * 40 / 60
				DOWNBASE:ARG:ストレス -= CFLAG:ARG:待機時間 * 40 / 60
			ELSE
				EXP:ARG:運動経験 += CFLAG:ARG:待機時間 * 2 / 60
				MAXBASE:ARG:体力 += CFLAG:ARG:待機時間 * 3 / 60
				DOWNBASE:ARG:体力 += CFLAG:ARG:待機時間 * 40 / 60
				DOWNBASE:ARG:気力 -= CFLAG:ARG:待機時間 * 20 / 60
				DOWNBASE:ARG:疲労 -= CFLAG:ARG:待機時間 * 50 / 60
			ENDIF
		ENDIF
;;;部活処理
	ELSEIF (TALENT:ARG:学生 || CFLAG:ARG:仕事 == 1) && CFLAG:ARG:部活 && TIME >= 960 && TIME <= 1129
		IF CFLAG:ARG:現在位置 == CLUB_PLACE(CFLAG:ARG:部活) && CFLAG:ARG:現在地区 == 1
			CFLAG:ARG:待機時間 += 1130 - TIME
			IF CFLAG:ARG:部活 < 30
				EXP:ARG:運動経験 += CFLAG:ARG:待機時間 * 2 / 60
				MAXBASE:ARG:体力 += CFLAG:ARG:待機時間 * 3 / 60
				DOWNBASE:ARG:体力 += CFLAG:ARG:待機時間 * 40 / 60
				DOWNBASE:ARG:気力 -= CFLAG:ARG:待機時間 * 20 / 60
				DOWNBASE:ARG:疲労 -= CFLAG:ARG:待機時間 * 50 / 60
			ELSE
				BASE:ARG:学力 = MIN(BASE:ARG:学力 + CFLAG:ARG:待機時間 / 6,MAXBASE:ARG:学力)
				EXP:ARG:学習経験 += CFLAG:ARG:待機時間 * 4 / 60 / 5
				MAXBASE:ARG:気力 += CFLAG:ARG:待機時間 * 3 / 60
				DOWNBASE:ARG:体力 -= CFLAG:ARG:待機時間 * 20 / 60
				DOWNBASE:ARG:気力 += CFLAG:ARG:待機時間 * 40 / 60
				DOWNBASE:ARG:疲労 -= CFLAG:ARG:待機時間 * 40 / 60
			ENDIF
			TB:(CFLAG:ARG:現在地区):(CFLAG:ARG:現在位置):ARG += 2
		ELSE
			TCVAR:ARG:目的地区 = 1
			TCVAR:ARG:目的位置 = CLUB_PLACE(CFLAG:ARG:部活)
			CFLAG:ARG:モラル = MAX(CFLAG:ARG:C - FLAG:危険度 * 200,0)
			CALL NPC_MOVEMENT(ARG)
			CALL SOURCE_CHECKS(ARG)
		ENDIF
	ELSE
		IF TIME % 60 >= 55 && TIME % 60 <= 59
			CALL TEIJI_DOUSHITU(ARG)
		ENDIF
;;;まず移動判定
;;;CFLAG:ARG:A:その時間の目的地区	CFLAG:ARG:B:その時間の目的位置	CFLAG:ARG:C:その時間のモラル
		IF TIME == 1440
			A = 123
			B = 153
			C = 183
		ELSE
			A = (TIME / 60) + 100
			B = (TIME / 60) + 130
			C = (TIME / 60) + 160
		ENDIF
;;;マップ0が全てFELSEになるので対応が必要
;;;		IF CFLAG:ARG:A && CFLAG:ARG:B
		IF CFLAG:ARG:B && (!D:101 || CFLAG:ARG:仕事 == 2 || CFLAG:ARG:仕事 == 4) && 営業中(CFLAG:ARG:A, CFLAG:ARG:B)
			TCVAR:ARG:目的地区 = CFLAG:ARG:A
			TCVAR:ARG:目的位置 = CFLAG:ARG:B
			CFLAG:ARG:モラル = MAX(CFLAG:ARG:C - FLAG:危険度 * 200,0)
			IF !(CFLAG:ARG:現在地区 == CFLAG:ARG:A && CFLAG:ARG:現在位置 == CFLAG:ARG:B)
				CALL NPC_MOVEMENT(ARG)
				CALL SOURCE_CHECKS(ARG)
			ENDIF
		ELSE
			IF TIME % 60 >= 0 && TIME % 60 <= 4
;;;CFLAG:ARG:Aを聞くのが間違ってる（0で正の場合あり）
;;;				IF CFLAG:ARG:A
;;;					CFLAG:ARG:目的地区 = CFLAG:ARG:A
;;;				ELSE
					;毎回3地区から等確率で選び直すと、大学に居た者が唐突に住宅街へ飛ぶ。
					;移動時間ばかり食って誰とも居合わせないため、6割は今いる地区の中で行き先を選ばせる
					IF RAND(10) < 6
						CFLAG:ARG:目的地区 = CFLAG:ARG:現在地区
					ELSE
						CFLAG:ARG:目的地区 = RAND(3)
					ENDIF
;;;				ENDIF
				R = 0
				;Sは前のキャラの抽選結果が残る。候補が1つも無いとき他人の行き先をそのまま拾うため必ず初期化する
				S = 0
				FOR P,1,60
					IF PLACE_NAME(CFLAG:ARG:目的地区,P) != ""
						;私的空間は候補外。ただし番号が30以降でも実際は客が入る店（居酒屋など）は通す（徘徊重み.ERB）
						IF IS_PRIVATE_PLACE(CFLAG:ARG:目的地区,P) && !徘徊解禁(CFLAG:ARG:目的地区,P)
							CONTINUE
						ENDIF
						;閉店中の施設は徘徊先の候補から外す
						SIF !営業中(CFLAG:ARG:目的地区,P)
							CONTINUE
						;人が集まる場所ほど出やすくする（徘徊重み.ERB）
						;Rに重みを積み、その時点の累積に対し Q/R の確率で乗り換える＝重みに比例した抽選。
						;元の「候補ごとに乱数を振って最大値を取る」方式のまま重みを掛けると差が乗数的に効き、
						;重みの低い場所（薬屋・キャバクラ等）が一度も選ばれなくなるためこの形にしている
						Q = 徘徊重み(CFLAG:ARG:目的地区,P)
						R += Q
						SIF R > 0 && RAND(R) < Q
							S = P
					ENDIF
				NEXT
				IF S
					CFLAG:ARG:目的位置 = S
				ELSEIF !IS_PRIVATE_PLACE(CFLAG:ARG:目的地区,1)
					CFLAG:ARG:目的位置 = 1
				ENDIF
			ENDIF
			IF CFLAG:ARG:目的位置 && 営業中(CFLAG:ARG:目的地区, CFLAG:ARG:目的位置)
				TCVAR:ARG:目的地区 = CFLAG:ARG:目的地区
				TCVAR:ARG:目的位置 = CFLAG:ARG:目的位置
				CFLAG:ARG:モラル = MAX(CFLAG:ARG:C - FLAG:危険度 * 200,0)
				IF !(CFLAG:ARG:現在地区 == TCVAR:ARG:目的地区 && CFLAG:ARG:現在位置 == TCVAR:ARG:目的位置)
					CALL NPC_MOVEMENT(ARG)
					CALL SOURCE_CHECKS(ARG)
				ENDIF
			ENDIF
		ENDIF
;;;移動以外の処理
;;;襲い掛かるをやめてみる
;;;		CALL XCOM_ABLE1021(ARG)
;;;		IF RESULT && (((BASE:MASTER:刺激度 * 3 + BASE:MASTER:容姿) * SQRT(BASE:ARG:興奮度) / 100) > (300 - FLAG:危険度 * 100 + RAND(400) + (CFLAG:ARG:モラル * 3 / 4))) && !(BASE:LOCAL:体力 < 500)
;;;			;PRINTFORMW {(BASE:MASTER:刺激度 * 3 + BASE:MASTER:容姿) * SQRT(BASE:ARG:興奮度) / 100}
;;;			CALL XCOM1021(ARG)
		IF (CFLAG:ARG:仕事 == 2 && !D:101 && (TIME >= 1080 || TIME <= 1049)) || (CFLAG:ARG:仕事 == 2 && D:101 && TIME >= 1080)
			CFLAG:ARG:待機時間 += 5
		ELSEIF CFLAG:ARG:仕事 == 4 && TIME >= 600 && TIME <= 1140
			CFLAG:ARG:待機時間 += 5
		ELSEIF CFLAG:ARG:仕事 == 1 && TIME <= 960
			CFLAG:ARG:待機時間 += 5
		ELSEIF !D:101 && TALENT:ARG:家族 && TIME <= 660
			CFLAG:ARG:待機時間 += 5
		ELSE
			IF GETBIT(DA:(CFLAG:LOCAL:現在地区):(CFLAG:LOCAL:現在位置),8)
				CALL NPC_AUTOACTION2(ARG)
			ELSE
				CALL NPC_AUTOACTION1(ARG)
			ENDIF
		ENDIF
	ENDIF
ENDIF

@TEIJI_DOUSHITU(ARG)
FOR D,1,CHARANUM
	IF !CFLAG:D:会話 && !TCVAR:D:イベント && !(D == ARG) && CFLAG:D:現在位置 == CFLAG:ARG:現在位置 && CFLAG:D:現在地区 == CFLAG:ARG:現在地区 && !TCVAR:D:衰弱 && !CFLAG:D:睡眠 && (CFLAG:D:現在位置 != 30 || CFLAG:D:現在地区 != 0)
		J:101 = ((BASE:D:刺激度 * 2 + BASE:D:容姿) * SQRT(BASE:ARG:性欲 / 2000) - 1400) / 50
		IF J:101 > 0
			IF CFLAG:ARG:モラル == 0
				TA:ARG:D:4 += J:101 * 10
			ELSE
				TA:ARG:D:4 += J:101 * 1000 / CFLAG:ARG:モラル
			ENDIF
		ENDIF
	ENDIF
NEXT

