;================================================================
; 恋愛システム共通基盤（2026-07-16追加）
;
; TALENT:恋人（Talent.csv 6番）に代入する唯一の経路。
; 恋人は同時に1人（排他）。CFLAG:恋人相手(220)に相手の登録番号を持つ。
; CFLAG:最愛(11)は@Belovedが日次で上書きする揮発値のため、
; 恋人成立の「条件」には使うが「記録」には使わない。
;
; ■セフレ（2026-07-17追加）
; TA:自分:相手:7 = セフレ関係(0/1)。対称＝必ず両方向に書く。同時複数人可。
; TA:自分:相手:8 = ペアの挿入H回数(1日1回まで加算。自然成立カウント用)。
; TA:7への代入は @セフレ成立 / @セフレ解消 のみ（TALENT:恋人と同じ規約）。
; 恋人と併存可（浮気あり）。ただし同一ペアが恋人になったらセフレは解消（昇格）。
; 素質は作らない＝判定は常にペア単位（@セフレ判定）。
;
; 関連: COMF985-告白する / COMF986-デートに誘う / COMF1022-電話で呼び出す
;       COMF984-セフレに誘う / COMF983-行為に誘う / NMKAIWA.ERB（NPC→プレイヤー告白・セフレ勧誘）
;       デート.ERB / SOURCE.ERB（@セフレH記録の呼び出し元）
;================================================================

;----------------------------------------------------------------
;恋人成立処理
; ARG=プレイヤー側(MASTER)、ARG:1=相手
;----------------------------------------------------------------
@恋人成立(ARG, ARG:1)
#DIM 主
#DIM 相手
主 = ARG
相手 = ARG:1
TALENT:相手:恋人 = 1
CFLAG:主:恋人相手 = 相手
CFLAG:相手:恋人相手 = 主
CFLAG:主:交際開始日 = DAY
CFLAG:相手:交際開始日 = DAY
;関係値の相互加算（愛情はレア資源なので+2に抑える）
TA:相手:主:1 += 2
TA:相手:主:3 += 30
TA:相手:主:4 += 30
TA:主:相手:1 += 2
TA:主:相手:3 += 30
TA:主:相手:4 += 30
;セフレ関係だったペアは恋人に昇格＝セフレフラグを解消（他ペアのセフレは維持）
SIF TA:主:相手:7
	CALL セフレ解消(主, 相手)
;告白承諾の台詞（キャラ別があれば優先）
CALL 汎用口上(12, 相手, 主)
RETURN

;----------------------------------------------------------------
;告白の成否判定
; ARG=相手。RETURNF 1=成功
; 条件: 愛情5以上 && 好意200以上 && 相手の最愛が自分
; 屋上(地区1,位置12)・公園(地区2,位置17)では好意条件を150に緩和
; （@Belovedの閾値500に対し 愛情5*100+好意150=650 で整合）
;----------------------------------------------------------------
@告白可否(ARG)
#FUNCTION
#DIM 相手
#DIM 好意条件
相手 = ARG
好意条件 = 200
SIF (CFLAG:MASTER:現在地区 == 1 && CFLAG:MASTER:現在位置 == 12) || (CFLAG:MASTER:現在地区 == 2 && CFLAG:MASTER:現在位置 == 17)
	好意条件 = 150
SIF TA:相手:MASTER:1 >= 5 && TA:相手:MASTER:3 >= 好意条件 && CFLAG:相手:最愛 == MASTER
	RETURNF 1
RETURNF 0

;----------------------------------------------------------------
;恋人解消（スタブ。破局イベントは未実装）
; ARG=相手。関係の記録をリセットするだけ。デート回数(222)は累計として残す
; 拡張点: cflag223(関係悪化度)を蓄積→閾値で本関数を呼ぶ破局イベント
;----------------------------------------------------------------
@恋人解消(ARG)
#DIM 相手
相手 = ARG
TALENT:相手:恋人 = 0
CFLAG:相手:恋人相手 = 0
CFLAG:相手:交際開始日 = 0
CFLAG:MASTER:恋人相手 = 0
CFLAG:MASTER:交際開始日 = 0
RETURN

;----------------------------------------------------------------
;セフレ判定
; ARG=本人、ARG:1=相手。RETURNF 1=セフレ関係（@LOVE_CHECKと同格の判定関数）
;----------------------------------------------------------------
@セフレ判定(ARG, ARG:1)
#FUNCTION
SIF TA:ARG:(ARG:1):7
	RETURNF 1
RETURNF 0

;----------------------------------------------------------------
;セフレ成立処理（TA:7への代入はここと@セフレ解消のみ）
; ARG=プレイヤー側(MASTER)、ARG:1=相手
; 愛情は増やさない（恋愛感情なしの関係なのがセフレらしさ）
;----------------------------------------------------------------
@セフレ成立(ARG, ARG:1)
#DIM 主
#DIM 相手
主 = ARG
相手 = ARG:1
TA:主:相手:7 = 1
TA:相手:主:7 = 1
;関係値の相互加算（肉欲と欲情のみ）
TA:相手:主:0 += 30
TA:相手:主:4 += 30
TA:主:相手:0 += 30
TA:主:相手:4 += 30
;セフレ成立の台詞（キャラ別があれば優先）
CALL 汎用口上(15, 相手, 主)
RETURN

;----------------------------------------------------------------
;セフレ勧誘の成否判定
; ARG=相手。RETURNF 1=成功
; 愛情不要・肉欲/欲情ベース（NMKAIWA.ERBの性的勧誘条件が雛形）
; 相手が他人の恋人なら浮気ハードルとして欲情300が必要
;----------------------------------------------------------------
@セフレ可否(ARG)
#FUNCTION
#DIM 相手
相手 = ARG
;既に3回以上Hしていれば既成事実＝無条件で成立
SIF TA:相手:MASTER:8 >= 3
	RETURNF 1
;敵対が高い相手は不可
SIF TA:相手:MASTER:6 >= 500
	RETURNF 0
;相手が他人の恋人（浮気）: 高い欲情が必要
IF TALENT:相手:恋人 && CFLAG:相手:恋人相手 != MASTER
	SIF TA:相手:MASTER:4 >= 300
		RETURNF 1
	RETURNF 0
ENDIF
SIF TA:相手:MASTER:4 >= 200 || (TA:相手:MASTER:0 >= 100 && TA:相手:MASTER:3 >= 100) || (TA:相手:MASTER:0 >= 150 && TA:相手:MASTER:2 >= 10)
	RETURNF 1
RETURNF 0

;----------------------------------------------------------------
;H合意可能判定（2026-07-29追加。COMF983-行為に誘う から使う）
; ARG=NPC、ARG:1=誘う側(MASTER想定)。RETURNF 1 = 合意しうる関係値
; 恋人・セフレは無条件。それ以外は @セフレ可否 と同じ帯の欲情/肉欲ベース。
; 「その場の全員が同意しうるか」を測る物差しでもあるので、
; 会話相手の可否判定と観客の可否判定で同じ関数を使う。
;----------------------------------------------------------------
@H合意可能(ARG, ARG:1)
#FUNCTION
;敵対している相手・家族は不可
SIF TA:ARG:(ARG:1):6 >= 500 || TALENT:ARG:家族
	RETURNF 0
;恋人（CFLAG:恋人相手は @恋人成立 が双方向に書く）
SIF CFLAG:(ARG:1):恋人相手 == ARG
	RETURNF 1
;セフレ
SIF セフレ判定(ARG, ARG:1)
	RETURNF 1
;それ以外は関係値で判定（欲情200、または肉欲100かつ好意100）
SIF TA:ARG:(ARG:1):4 >= 200 || (TA:ARG:(ARG:1):0 >= 100 && TA:ARG:(ARG:1):3 >= 100)
	RETURNF 1
RETURNF 0

;----------------------------------------------------------------
;同室者全員がH合意可能か（2026-07-29追加）
; RETURNF 1 = 同室のNPC全員（会話相手を含む）が合意しうる関係値
; 同室フラグは @SAME_ROOM_CHECK（COMMON.ERB）が毎ターン更新する値を使う。
; 睡眠中・衰弱中も除外しない＝「見られている」扱いのまま厳しく判定する。
;----------------------------------------------------------------
@周囲全員H合意可能
#FUNCTION
#DIM 対象
FOR 対象, 1, CHARANUM
	SIF 対象 == MASTER || !TCVAR:対象:同室
		CONTINUE
	SIF !H合意可能(対象, MASTER)
		RETURNF 0
NEXT
RETURNF 1

;----------------------------------------------------------------
;セフレ解消
; ARG=本人、ARG:1=相手。恋人昇格時・将来の破局イベント用
; H回数(TA:8)は履歴として残す
;----------------------------------------------------------------
@セフレ解消(ARG, ARG:1)
TA:ARG:(ARG:1):7 = 0
TA:(ARG:1):ARG:7 = 0
RETURN

;----------------------------------------------------------------
;セフレH記録（SOURCE.ERBの膣内/肛内射精処理から呼ばれる）
; ARG=射精者、ARG:1=受け手
; プレイヤーが絡むペアのみ対象（NPC同士はスコープ外）。
; TCVAR:(NPC側):セフレH済 で1日1回まで。TA:8を両方向+1し、
; 非恋人・非セフレで3回目に達したらセフレ提案を予約
; （COM_MESSAGE描写後にSOURCE_CHECKS末尾の@セフレ提案実行が消化）
;----------------------------------------------------------------
@セフレH記録(ARG, ARG:1)
#DIM 相手
;プレイヤーが絡まないペアは対象外
IF ARG == MASTER
	相手 = ARG:1
ELSEIF ARG:1 == MASTER
	相手 = ARG
ELSE
	RETURN
ENDIF
;恋人同士・家族は対象外
SIF CFLAG:MASTER:恋人相手 == 相手 || TALENT:相手:家族
	RETURN
;当日加算済みなら何もしない（1日1回）
SIF TCVAR:相手:セフレH済
	RETURN
TCVAR:相手:セフレH済 = 1
TA:MASTER:相手:8 += 1
TA:相手:MASTER:8 += 1
;非セフレで3回に達したら提案イベントを予約（当日勧誘済みなら翌日以降に持ち越し）
SIF !TA:MASTER:相手:7 && TA:MASTER:相手:8 >= 3 && !TCVAR:相手:セフレ勧誘済
	TCVAR:MASTER:セフレ提案予約 = 相手
RETURN

;----------------------------------------------------------------
;セフレ提案実行（SOURCE_CHECKS末尾＝行動描写の後で消化）
; H回数が閾値に達したNPCから「これからもこういう関係で」と提案される。
; 断るとTA:8がリセットされ、また3回Hすると再提案される
;----------------------------------------------------------------
@セフレ提案実行
#DIM 相手
SIF !TCVAR:MASTER:セフレ提案予約
	RETURN
相手 = TCVAR:MASTER:セフレ提案予約
TCVAR:MASTER:セフレ提案予約 = 0
;予約後に成立済み・恋人化していたら何もしない
SIF TA:MASTER:相手:7 || CFLAG:MASTER:恋人相手 == 相手
	RETURN
TCVAR:相手:セフレ勧誘済 = 1
PRINTL
PRINTFORML 事後、%CALLNAME:相手%が汗ばんだ肌を寄せたまま囁いた。
IF TALENT:相手:性別 & 2 && !(TALENT:相手:性別 & 1)
	;男性器のみ＝男性口調
	PRINTL 「……なあ。俺たち、もう何回もヤってるだろ。これからも、こういう関係でいいよな？」
ELSE
	PRINTL 「……ねえ。私たち、もう何回もシちゃってるし……これからも、セフレってことで、いいよね？」
ENDIF
$INPUT_LOOP_SF
PRINTL どう答えますか？
PRINTFORML [0] - 受ける
PRINTFORML [1] - 断る
INPUT
SIF RESULT != 0 && RESULT != 1
	GOTO INPUT_LOOP_SF
IF RESULT == 0
	CALL セフレ成立(MASTER, 相手)
	PRINTFORML %CALLNAME:相手%とあなたはセフレになった。
ELSE
	PRINTFORML あなたは曖昧に笑って誤魔化した。
	CALL 汎用口上(16, 相手, MASTER)
	;仕切り直し（また3回Hすると再提案）
	TA:MASTER:相手:8 = 0
	TA:相手:MASTER:8 = 0
ENDIF
RETURN

;----------------------------------------------------------------
;部活一致判定
; ARG=本人、ARG:1=相手。RETURNF 1=同じ部活（0=無所属は不一致扱い）
;----------------------------------------------------------------
@部活一致(ARG, ARG:1)
#FUNCTION
SIF CFLAG:ARG:部活 && CFLAG:ARG:部活 == CFLAG:(ARG:1):部活
	RETURNF 1
RETURNF 0

;----------------------------------------------------------------
;連絡先交換（2026-09-01追加）
; TA:自分:相手:9 = 連絡先(0/1)。対称＝必ず両方向に書く。
; 代入経路はこの@連絡先交換のみ（TALENT:恋人・セフレのTA:7と同じ規約）。判定は@連絡先判定。
; 交換済みなら好意200未満でも電話で呼び出せる（COMF1022 @呼び出し可否）。
; 関連: COMF982-連絡先を交換する
;----------------------------------------------------------------
@連絡先交換(ARG, ARG:1)
TA:ARG:(ARG:1):9 = 1
TA:(ARG:1):ARG:9 = 1

;----------------------------------------------------------------
;連絡先を知っているか。ARG=本人、ARG:1=相手
;----------------------------------------------------------------
@連絡先判定(ARG, ARG:1)
#FUNCTION
RETURNF TA:ARG:(ARG:1):9 != 0

;----------------------------------------------------------------
;交換に応じるか。ARG=頼む側、ARG:1=相手
;----------------------------------------------------------------
@連絡先可否(ARG, ARG:1)
#FUNCTION
;敵対している相手とは交換しない
SIF TA:(ARG:1):ARG:6 > 500 || TA:ARG:(ARG:1):6 > 500
	RETURNF 0
;好意30以上なら快く応じる
SIF TA:(ARG:1):ARG:3 >= 30
	RETURNF 1
;それ未満は好意と相性込みの確率。連絡先の交換自体は敷居が低い行為なので甘めに取る
RETURNF ((RAND(100) + TA:(ARG:1):ARG:3) * TA:(ARG:1):(CFLAG:ARG:タイプ):5 / 100) > 55

;----------------------------------------------------------------
;紹介してもらう相手を選ぶ（2026-09-01追加）
; ARG=頼む側(MASTER)、ARG:1=紹介してくれる相手。RETURNF=紹介される相手の登録番号（0=候補なし）
; 紹介者が好意を持つ相手のうち、まだこちらと面識のない者を優先する。
; 関連: COMF981-友達を紹介してもらう
;----------------------------------------------------------------
@紹介候補(ARG, ARG:1)
#FUNCTION
#DIM 候補
#DIM 最善
#DIM 点
#DIM 最高点
最善 = 0
最高点 = 0
FOR 候補,1,CHARANUM
	SIF 候補 == ARG || 候補 == ARG:1
		CONTINUE
	;家族は紹介の対象にしない
	SIF TALENT:候補:家族
		CONTINUE
	;既に連絡先を知っている相手を紹介されても意味がない
	SIF 連絡先判定(ARG, 候補)
		CONTINUE
	;紹介者自身が好意を持っていない相手は紹介できない
	SIF TA:(ARG:1):候補:3 < 50
		CONTINUE
	点 = TA:(ARG:1):候補:3
	;まだ面識のない相手を優先する（好意も肉欲も動いていない＝会ったことがない）
	SIF !TA:候補:ARG:3 && !TA:候補:ARG:0
		点 += 200
	IF 点 > 最高点
		最高点 = 点
		最善 = 候補
	ENDIF
NEXT
RETURNF 最善
