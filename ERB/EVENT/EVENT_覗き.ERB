;================================================================
; 覗き（のぞき）イベント
;  プレイヤー（あなた＝MASTER）が私的行為をしている最中に、
;  NPC に覗かれるイベント。EVENTCOMEND のマスター行動後から
;  @覗きチェック(場面) を呼び出す。
;    場面 1 = 風呂・シャワー (COMF1008)
;    場面 2 = 自慰           (COMF1007)
;    場面 3 = トイレ         (COMF1019)
;    場面 4 = 部活           (COMF1013)
;  発見/未発見 → 反応選択（隠す/逃げる/誘惑/通報/されるがまま）→
;  場合により H へ発展。H は EVENT_路上遭遇.ERB と同じ標準パイプライン
;  （XCOM2820 → SOURCE_CHECKS → 強制中出し → EVENT_ESCAPE_NPC）に接続する。
;================================================================

;----------------------------------------------------------------
; 同じ場所に居て、プレイヤーに欲情・肉欲を持つ NPC を 1 人抽選して返す。
; 居なければ -1。（COMF1008 の I 選定ロジックを踏襲＋リザーバサンプリング）
;----------------------------------------------------------------
@覗き手を探す
#FUNCTION
#DIM 候補
#DIM 数
#DIM 相手
候補 = -1
数 = 0
FOR 相手,2,CHARANUM
	;同じ地区・位置に居ること
	SIF CFLAG:相手:現在地区 != CFLAG:MASTER:現在地区 || CFLAG:相手:現在位置 != CFLAG:MASTER:現在位置
		CONTINUE
	;睡眠・衰弱・乗車中は覗けない
	SIF CFLAG:相手:睡眠 || CFLAG:相手:衰弱 || CFLAG:相手:乗車
		CONTINUE
	;プレイヤー(1)に対する欲情・肉欲がそれなりにあること（COMF1008 準拠のしきい値）
	SIF TA:相手:1:4 <= 100 || TA:相手:1:0 <= 100
		CONTINUE
	数 += 1
	SIF RAND(数) == 0
		候補 = 相手
NEXT
RETURNF 候補

;----------------------------------------------------------------
; 覗きの発生判定。発生したら 1 を返す。
;  ARG = 場面(1..4)
;----------------------------------------------------------------
@覗きチェック(ARG)
#DIM 場面
#DIM 覗き手
#DIM 確率
場面 = ARG
;イベント中・睡眠・衰弱・乗車中は除外
SIF TCVAR:MASTER:イベント || CFLAG:MASTER:睡眠 || CFLAG:MASTER:衰弱 || CFLAG:MASTER:乗車
	RETURN 0
;女性のみ対象（本文が被覗き＝女子前提）
SIF !GETBIT(TALENT:MASTER:性別,0)
	RETURN 0
;1 日 1 回/場面（CFLAG:MASTER:3501〜3504 ＝ 前回発生 DAY。3500 は路上遭遇が使用）
SIF CFLAG:MASTER:(3500 + 場面) == DAY
	RETURN 0
;覗き手の決定
覗き手 = 覗き手を探す()
;トイレ（公衆前提）は同室者が居なければ見知らぬ男(Chara041)にフォールバック
IF 覗き手 < 0 && 場面 == 3
	覗き手 = 見知らぬ男番号()
ENDIF
SIF 覗き手 < 0
	RETURN 0
;発生確率（場面・場所別）
確率 = 5
SELECTCASE 場面
	CASE 1
		;風呂・シャワー
		確率 = 8
		;銭湯(0,10)＝不特定多数が出入りする公衆浴場。仕切り一枚の向こうに男が居る（銭湯.ERB）
		SIF CFLAG:MASTER:現在地区 == 0 && CFLAG:MASTER:現在位置 == 10
			確率 = 25
	CASE 2
		;自慰。自宅以外（公共の場でのオナニー）は覗かれやすい
		確率 = 6
		SIF !IS_MASTER_HOME()
			確率 = 20
	CASE 3
		;トイレ（公衆）
		確率 = 15
	CASE 4
		;部活後の更衣・シャワー
		確率 = 10
ENDSELECT
;危険度が高いほど発生しやすい（上限 +5）
確率 += MIN(FLAG:危険度, 5)
SIF RAND(100) >= 確率
	RETURN 0
CFLAG:MASTER:(3500 + 場面) = DAY
CALL 覗きイベント(MASTER, 覗き手, 場面)
RETURN 1

;----------------------------------------------------------------
; 場面別の導入文。ARG=被害者 ARG:1=覗き手 ARG:2=場面
;----------------------------------------------------------------
@覗き導入文(ARG,ARG:1,ARG:2)
#DIM 被害者
#DIM 覗き手
#DIM 場面
被害者 = ARG
覗き手 = ARG:1
場面 = ARG:2
SELECTCASE 場面
	CASE 1
		PRINTFORML 湯気の立ちこめる浴室で%CALLNAME:被害者%が火照った体を洗っていると、
		PRINTFORMW ふと、扉の隙間からこちらを覗く%CALLNAME:覗き手%の視線に気づいた……気がした。
	CASE 2
		PRINTFORML 快楽に没頭し、%CALLNAME:被害者%が甘い声を漏らしていると、
		PRINTFORMW すぐ近くで息を潜めて見つめる%CALLNAME:覗き手%の気配があった……。
	CASE 3
		PRINTFORML 個室で用を足していた%CALLNAME:被害者%の頭上から、
		PRINTFORMW 隣の個室によじ登った%CALLNAME:覗き手%が、じっとこちらを見下ろしていた……！
	CASE 4
		PRINTFORML 部活を終え、更衣室で汗ばんだ体操服を脱いでいると、
		PRINTFORMW ロッカーの陰から%CALLNAME:覗き手%がこちらを盗み見ているのが目に入った……。
ENDSELECT
RETURN

;----------------------------------------------------------------
; 覗きイベント本体（発見判定→反応選択→H発展）
;  ARG=被害者 ARG:1=覗き手 ARG:2=場面
;----------------------------------------------------------------
@覗きイベント(ARG,ARG:1,ARG:2)
#DIM 被害者
#DIM 覗き手
#DIM 場面
#DIM 気づく
#DIM 判定
被害者 = ARG
覗き手 = ARG:1
場面 = ARG:2

PRINTL
PRINTFORML %"=" * 107%
CALL 覗き導入文(被害者, 覗き手, 場面)

;発見判定：運動能力（反射）＋気力＋度胸/羞恥心。自慰・入浴は油断して気づきにくい
判定 = ABL:被害者:運動能力 * 12 + BASE:被害者:気力 / 50 + 25
SIF TALENT:被害者:度胸 == 1
	判定 += 15
SIF TALENT:被害者:羞恥心 == 1
	判定 += 15
SIF 場面 == 2
	判定 -= 25
SIF 場面 == 1
	判定 -= 10
気づく = 0
SIF RAND(100) < 判定
	気づく = 1

;----------------- 気づかなかった場合 -----------------
IF !気づく
	PRINTFORML %CALLNAME:被害者%はそれに気づかず、無防備な痴態を晒し続けた。
	PRINTFORMW %CALLNAME:覗き手%はニヤニヤしながら、その姿を目に焼き付けて去っていった……。
	;隠しペナルティ：覗き手の肉欲・欲情が上がり、評判が下がり、危険度が上がる
	TA:覗き手:被害者:0 += 30
	TA:覗き手:被害者:4 += 30
	BASE:被害者:評判 = MAX(BASE:被害者:評判 - 10, 0)
	;盗撮された証拠フラグ（CFLAG:3505 のビット＝場面）
	SETBIT CFLAG:被害者:3505, 場面
	CFLAG:被害者:待機時間 += 5
	RETURN
ENDIF

;----------------- 気づいた場合：反応選択 -----------------
PRINTFORML 目が合ってしまった。どうしますか？
PRINTL [0] - 隠して逃げ出す
PRINTL [1] - 通報する
;誘惑：淫乱／目立ちたがり、または相手への好意が高いと選べる
IF TALENT:被害者:淫乱 || TALENT:被害者:目立ちたがり || TA:被害者:覗き手:3 >= 300
	PRINTL [2] - 誘惑してみる
ENDIF
PRINTL [3] - されるがままにする
$覗き_INPUT
INPUT
IF RESULT == 0
	;隠して逃げる：ストレス増・時間消費で終了
	PRINTFORMW %CALLNAME:被害者%は慌てて身を隠し、その場から逃げ出した。
	BASE:被害者:ストレス = MIN(BASE:被害者:ストレス + 400, MAXBASE:被害者:ストレス)
	BASE:被害者:気力 = MAX(BASE:被害者:気力 - 300, 0)
	CFLAG:被害者:待機時間 += 10
	TA:被害者:覗き手:6 += 30
	RETURN
ELSEIF RESULT == 1
	;通報：敵対を上げて撃退（JYUGYOU.ERB 準拠）
	PRINTL 「誰か！　覗きです！」
	PRINTFORMW %CALLNAME:被害者%が声を上げると、%CALLNAME:覗き手%は舌打ちして逃げていった。
	;顔は見えている＝後から警察署へ届け出られる（警察署.ERB @被害を記録）
	CALL 被害を記録(覗き手, 3)
	TA:被害者:覗き手:6 += 50
	TA:覗き手:被害者:6 += 50
	BASE:被害者:ストレス = MIN(BASE:被害者:ストレス + 200, MAXBASE:被害者:ストレス)
	CFLAG:被害者:待機時間 += 10
	RETURN
ELSEIF RESULT == 2 && (TALENT:被害者:淫乱 || TALENT:被害者:目立ちたがり || TA:被害者:覗き手:3 >= 300)
	;誘惑：合意 H へ
	PRINTFORML %CALLNAME:被害者%は隠すどころか、覗く%CALLNAME:覗き手%へ妖しく微笑みかけた。
	PRINTFORMW 「そんなところで見てないで……こっちに来て？」
	TA:被害者:覗き手:0 += 50
	TA:覗き手:被害者:0 += 50
	CALL 覗き_本番(被害者, 覗き手, 場面, 0)
	RETURN
ELSEIF RESULT == 3
	;されるがまま：強制 H へ
	PRINTFORMW 逃げることも声を上げることもできず、%CALLNAME:被害者%はその場で立ちすくんでしまった。
	CALL 覗き_本番(被害者, 覗き手, 場面, 1)
	RETURN
ELSE
	GOTO 覗き_INPUT
ENDIF
RETURN

;----------------------------------------------------------------
; 覗きからの性行為本体（EVENT_路上遭遇.ERB @路上遭遇_本番 を範に）
;  ARG=被害者 ARG:1=覗き手 ARG:2=場面 ARG:3=強制(1)/合意(0)
;  行為・PALAM・EXP・処女喪失・射精・受精・性病は標準パイプライン任せ。
;----------------------------------------------------------------
@覗き_本番(ARG,ARG:1,ARG:2,ARG:3)
#DIM 被害者
#DIM 相手
#DIM 強制
被害者 = ARG
相手 = ARG:1
強制 = ARG:3

IF 強制
	PRINTFORMW %CALLNAME:相手%はにじり寄ると、抵抗する間もなく強引に押し入ってきた。
	;体力・気力・ストレス・興奮・敵対
	BASE:被害者:体力 = MAX(BASE:被害者:体力 - 400, 0)
	BASE:被害者:気力 = MAX(BASE:被害者:気力 - 800, 0)
	BASE:被害者:ストレス = MIN(BASE:被害者:ストレス + 500, MAXBASE:被害者:ストレス)
	BASE:被害者:興奮度 = MIN(BASE:被害者:興奮度 + 200, MAXBASE:被害者:興奮度)
	TA:被害者:相手:6 += 300
	BASE:被害者:評判 = MAX(BASE:被害者:評判 - 20, 0)
ELSE
	PRINTFORMW 誘われるまま%CALLNAME:相手%は身を寄せ、二人はもつれ合った。
	BASE:被害者:興奮度 = MIN(BASE:被害者:興奮度 + 300, MAXBASE:被害者:興奮度)
	TA:被害者:相手:0 += 50
	TA:被害者:相手:3 += 30
ENDIF

;性病リスク：見知らぬ男は感染者のことがある（シード。感染判定は SOURCE 側）
IF FLAG:病気機能 && !性病持ち(相手) && NO:相手 == 41 && RAND(100) < 15
	SETBIT CFLAG:(相手):病気,1
	CFLAG:(相手):性病日数 = 1
ENDIF

;標準の行為ループへ接続
J:115 = 1
TFLAG:Ｎイベント = 8
TFLAG:行為者 = 相手
;相手を現場（被害者の現在地）に合わせる
CFLAG:(相手):現在地区 = CFLAG:被害者:現在地区
CFLAG:(相手):現在位置 = CFLAG:被害者:現在位置
TCVAR:(相手):同室 = 1
TEQUIP:被害者:膣 = 0
TEQUIP:被害者:アナル = 0
SIF !強制
	TCVAR:被害者:防御 = 0
FOR G,0,5
	TCVAR:(相手):行為対象 = 被害者
	TCVAR:被害者:行為対象 = 相手
	CFLAG:(相手):受能動 = 1
	CFLAG:被害者:受能動 = 2
	;H はコマンド実行時の ARG 変数に代入
	H = 相手
	CALL XCOM2820(相手,1)
	TCVAR:(相手):行為対象 = 被害者
	CALL SOURCE_CHECKS(相手)
	TFLAG:行為者 = 相手
	SIF !TFLAG:移動中
		PRINTW
NEXT
;相手は必ず膣内射精する（ループ中に未発生なら強制中出し。量 2〜4 相当）
IF CFLAG:被害者:(3200 + 相手) != DAY && MAXBASE:(相手):射精 > 0
	PRINTFORMW %CALLNAME:相手%は最後に奥まで突き入れると、欲望のすべてを注ぎ込んできた……！
	TCVAR:(相手):行為対象 = 被害者
	TCVAR:被害者:行為対象 = 相手
	TCVAR:(相手):挿入 = 1
	BASE:(相手):射精 = MAXBASE:(相手):射精 * (2 + RAND(3)) + 1
	CALL SOURCE_CHECKS(相手)
ENDIF
;後始末（行為状態リセット・着衣復帰）
CALL EVENT_ESCAPE_NPC(相手, 被害者)
TFLAG:Ｎイベント = 0
J:115 = 0
IF 強制
	PRINTFORMW %CALLNAME:相手%は満足げに去っていった。%CALLNAME:被害者%はその場に座り込んだ。
ELSE
	PRINTFORMW %CALLNAME:相手%は満足げに身なりを整えると、名残惜しげに去っていった。
ENDIF
PRINTL
CFLAG:被害者:待機時間 += 20
RETURN
