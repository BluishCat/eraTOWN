	CASE 6
		RETURNF "ハンバーガー屋"
	CASE 7
		RETURNF "カラオケ屋"
	CASE 8
		RETURNF "ゲームセンター"
	CASE 9
		RETURNF "服屋"
	CASE 10
		RETURNF "薬屋"
	CASE 11
		RETURNF "警察署"
	CASE 12
		RETURNF "ファミレス"
	CASE 13
		RETURNF "病院"
	CASE 14
		RETURNF "喫茶店"
	CASE 15
		RETURNF "本屋"
	CASE 16
		RETURNF "スポーツジム"
	CASE 17
		RETURNF "公園"
	CASE 18
		RETURNF "裏通り"
	CASE 19
		RETURNF "キャバクラ"
	CASE 20
		RETURNF "アダルトショップ"
	CASE 21
		RETURNF "アクセサリーショップ"
	CASE 22
		RETURNF "ラブホテル"
	CASE 23
		RETURNF "裏路地"
	CASE 24
		RETURNF "家電屋"
	CASE 25
		RETURNF "他大学"
	CASE 26
		RETURNF "寮"
	CASE 27
		RETURNF "プロレス事務所"
	CASE 28
		RETURNF "格闘場"
	;身分システム：会社員の職場（2026-07-20追加）
	CASE 29
		RETURNF "オフィスビル"
	CASE 30
		RETURNF "高級マンション"
	;高級マンションは5階建て・各階4室（31-34=101-104 / 35-38=201-204 / … / 47-50=501-504）
	CASE 31 TO 50
		RETURNF @"高級マンション{100 + (ARG - 31) / 4 * 100 + (ARG - 31) % 4 + 1}号室"
	;繁華街の風俗店（裏通り接続。ソープランド.ERB参照）
	CASE 51
		RETURNF "ソープランド"
	;繁華街の劇場（裏通り接続。劇場.ERB参照）
	CASE 52
		RETURNF "劇場"
	;繁華街のホストクラブ（裏通り接続。ホストクラブ.ERB参照）
	CASE 53
		RETURNF "ホストクラブ"
	;繁華街の居酒屋（裏通り接続。居酒屋.ERB参照）
	CASE 54
		RETURNF "居酒屋"
	;繁華街のバー（裏通り接続。バー.ERB参照）
	CASE 55
		RETURNF "バー"

	CASE 56
		RETURNF "質屋"
	;繁華街に面した映画館（映画館.ERB参照）
	CASE 57
		RETURNF "映画館"

ENDSELECT
