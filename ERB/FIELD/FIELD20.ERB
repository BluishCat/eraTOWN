;*************************************************
;@PLACE_SET_2 場所の属性
;SETBIT DA:2:0,0 は内部の存在判定に使ってますので消さないで下さい
;SETBIT DA:2:部屋番号,0 外に出れる場所
;SETBIT DA:2:部屋番号,1 中に入れる場所
;SETBIT DA:2:部屋番号,2 電車に乗れる場所
;SETBIT DA:2:部屋番号,3 屋内
;SETBIT DA:2:部屋番号,4 遊技場あり
;SETBIT DA:2:部屋番号,5 注文可
;SETBIT DA:2:部屋番号,7 買い物可
;SETBIT DA:2:部屋番号,8 アルバイト可
;SETBIT DA:2:部屋番号,9 鍵が掛かってる
;SETBIT DA:0:部屋番号,10 ＮＰＣが自慰出来る場所
;*************************************************
@PLACE_SET_2
SETBIT DA:2:0,0
SETBIT DA:2:1,1
SETBIT DA:2:3,2

SETBIT DA:2:5,3
SETBIT DA:2:6,3
SETBIT DA:2:7,3
SETBIT DA:2:8,3
SETBIT DA:2:9,3
SETBIT DA:2:10,3
SETBIT DA:2:11,3
SETBIT DA:2:12,3
SETBIT DA:2:13,3
SETBIT DA:2:14,3
SETBIT DA:2:15,3
SETBIT DA:2:16,3
SETBIT DA:2:19,3
SETBIT DA:2:20,3
SETBIT DA:2:21,3
SETBIT DA:2:25,3
SETBIT DA:2:26,3
SETBIT DA:2:27,3
SETBIT DA:2:28,3
SETBIT DA:2:29,3
SETBIT DA:2:30,3

SETBIT DA:2:7,4
SETBIT DA:2:8,4

SETBIT DA:2:6,5
SETBIT DA:2:14,5
SETBIT DA:2:12,5


;コンビニ(5)でも買い物できる(2026-08-30)。住宅街のコンビニ(0,5)と品揃えは同じ
SETBIT DA:2:5,7
SETBIT DA:2:9,7
SETBIT DA:2:10,7
SETBIT DA:2:15,7
SETBIT DA:2:20,7
SETBIT DA:2:21,7
SETBIT DA:2:24,7

SETBIT DA:2:5,8
SETBIT DA:2:6,8
SETBIT DA:2:7,8
SETBIT DA:2:8,8
SETBIT DA:2:9,8
SETBIT DA:2:10,8
SETBIT DA:2:12,8
SETBIT DA:2:14,8
SETBIT DA:2:15,8
SETBIT DA:2:16,8
SETBIT DA:2:19,8
SETBIT DA:2:20,8
SETBIT DA:2:21,8

SETBIT DA:2:26,9
SETBIT DA:2:28,9

SETBIT DA:2:7,10
SETBIT DA:2:8,10
SETBIT DA:2:14,10
SETBIT DA:2:17,10
;SETBIT DA:2:22,10
SETBIT DA:2:23,10
SETBIT DA:2:26,10
SETBIT DA:2:30,10
;賃貸の号室（高級マンション=31〜50。マンション.ERB参照）は屋内・NPC自慰可
FOR LOCAL,31,51
	SETBIT DA:2:LOCAL,3
	SETBIT DA:2:LOCAL,10
NEXT
;ソープランド（部屋51、裏通り接続。ソープランド.ERB参照）は屋内
SETBIT DA:2:51,3
;劇場（部屋52、裏通り接続。劇場.ERB参照）は屋内・バイト可（ダンサー職業18）
SETBIT DA:2:52,3
SETBIT DA:2:52,8
;ホストクラブ（部屋53、裏通り接続。ホストクラブ.ERB参照）は屋内のみ（客専門＝バイト不可）
SETBIT DA:2:53,3
;居酒屋（部屋54、裏通り接続。居酒屋.ERB参照）は屋内・注文可・バイト可（職業19）
SETBIT DA:2:54,3
SETBIT DA:2:54,5
SETBIT DA:2:54,8
;バー（部屋55、裏通り接続。バー.ERB参照）は屋内・注文可・バイト可（職業20）
SETBIT DA:2:55,3
SETBIT DA:2:55,5
SETBIT DA:2:55,8
;質屋（屋内。注文・バイトは無い）
SETBIT DA:2:56,3
;映画館（部屋57、繁華街直結。映画館.ERB参照）は屋内・バイト可（もぎり＝職業21）
SETBIT DA:2:57,3
SETBIT DA:2:57,8

