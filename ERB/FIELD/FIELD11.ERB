@PLACE_NINZU_1_1(ARG)
;	1 "正門"
IF D:101
	RETURN 2
ELSE
	SELECTCASE ARG
		CASE 7
			RETURN 2
		CASE 8
			RETURN 100
		CASE 9 TO 11
			RETURN 0
		CASE 12,13
			RETURN 5
		CASE 14,15
			RETURN 0
		CASE 16 TO 18
			RETURN 30
		CASE 19
			RETURN 10
		CASEELSE
			RETURN 0
	ENDSELECT
ENDIF

