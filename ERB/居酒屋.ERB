;================================================================
; 居酒屋（地区2・位置54、裏通り接続。2026-07-21追加）
;  ・営業17時〜翌1時（営業時間.ERB）。閉店中はCOMF1000の移動ガードで入店不可。
;  ・スタッフ＝Chara066「熊谷 剛蔵」（大将・店主兼バイト店主振り替え先）
;              Chara068「田淵 政雄」（常連のオヤジ・相席／絡み役）
;  ・遊び方: 大将に席へ通され、飲む／つまむ／相席する／大将と話す を選び続ける。
;    相席は店内に居る全キャラが対象＝街の誰とでも飲める「出会いの場」として機能する。
;    酔うほど相手との距離が縮まり（TA増加が大きくなる）、同時に抵抗も落ちていく。
;  ・泥酔して店を出るとお持ち帰りイベントの判定が走る（@酔い_お持ち帰りチェック。酔い.ERB系）。
;  ・酒の値段・強さ・注文処理は 酒場.ERB に集約（バーと共通）。酔い度は 酔い.ERB。
;  ・バイト職業19のホール勤務は COMF1005＋@酒場勤務抽選/@酒場勤務描写（酒場.ERB）。
;  ・使用フラグ: TCVAR:636 当日飲酒量（酒場.ERB経由で@飲酒が加算）
;================================================================

;================================================================
;@居酒屋受付
;  居酒屋(2,54)到着時のフック（ROOM_IN_OUT.ERB @到着時処理から呼ばれる）。
;================================================================
@居酒屋受付
#DIM 大将
SIF CFLAG:MASTER:現在地区 != 2 || CFLAG:MASTER:現在位置 != 54
	RETURN
;イベント文脈からの到着では何もしない（通常コマンド文脈のみ）
SIF TCVAR:MASTER:イベント
	RETURN
大将 = GETCHARA(66)
PRINTL
PRINTFORML %"=" * 107%
;従業員（バイト職業19）は客用の受付を出さない（勤務はCOMF1005「アルバイト」から）
IF CFLAG:MASTER:職業 == 19
	IF 大将 >= 0
		PRINTFORMW 暖簾をくぐると、%CALLNAME:大将%が「おう、今日も頼むぞ」と厨房から声を張り上げた。
	ELSE
		PRINTFORMW 暖簾をくぐると、厨房から「おう、今日も頼むぞ」と声が飛んできた。
	ENDIF
	RETURN
ENDIF
IF 大将 >= 0
	PRINTFORML 煙と出汁の匂い。%CALLNAME:大将%が濡れた手を前掛けで拭いながら顔を上げた。
	PRINTL 「らっしゃい。空いてるとこ、どこでも座んな」
ELSE
	PRINTL 煙と出汁の匂いが立ちこめる店内。空いた席を探して腰を下ろした。
ENDIF
CALL 居酒屋メニュー
RETURN

;================================================================
;@居酒屋メニュー
;  帰るまで遊びを選び続ける（ホストクラブ.ERBの@ホストクラブメニューと同型）。
;================================================================
@居酒屋メニュー
#DIM 大将
大将 = GETCHARA(66)
$IZAKAYA_MENU_INPUT
PRINTL
PRINTFORML ＜居酒屋／{TIME / 60}時{TIME % 60}分／所持金%金額(MONEY:MASTER)%円／%酔い段階_名(MASTER)%＞
PRINTL [0] - 一杯頼む
PRINTL [1] - つまみを頼む（６００円）
PRINTL [2] - 相席する
IF 大将 >= 0
	PRINTL [3] - 大将と話す
ELSE
	SETCOLOR 96 , 96, 96
	PRINTL 　　　大将と話す（今夜は姿が見えない）
	RESETCOLOR
ENDIF
PRINTL [4] - 誰かと乾杯する
PRINTL [5] - 誰かに一杯奢る
IF TCVAR:MASTER:当日介抱済
	SETCOLOR 96 , 96, 96
	PRINTL 　　　酔い潰れた人を介抱する（今夜はもう手一杯）
	RESETCOLOR
ELSE
	PRINTL [6] - 酔い潰れた人を介抱する
ENDIF
PRINTL [7] - 店を出る
INPUT
SIF RESULT < 0 || RESULT > 7
	GOTO IZAKAYA_MENU_INPUT
SIF RESULT == 3 && 大将 < 0
	GOTO IZAKAYA_MENU_INPUT
SIF RESULT == 6 && TCVAR:MASTER:当日介抱済
	GOTO IZAKAYA_MENU_INPUT
SELECTCASE RESULT
	CASE 0
		CALL 居酒屋_酒選択
	CASE 1
		CALL 居酒屋_つまみ
	CASE 2
		CALL 居酒屋_相席
	CASE 3
		CALL 居酒屋_大将と話す(大将)
	CASE 4
		CALL 居酒屋_乾杯
	CASE 5
		CALL 居酒屋_奢る
	CASE 6
		CALL 居酒屋_介抱
	CASEELSE
		IF 大将 >= 0
			PRINTFORMW %CALLNAME:大将%の「まいど」という野太い声に送られて、あなたは暖簾をくぐった。
		ELSE
			PRINTFORMW 会計を済ませ、あなたは暖簾をくぐって夜の裏通りへ出た。
		ENDIF
		RETURN
ENDSELECT
GOTO IZAKAYA_MENU_INPUT

;================================================================
;@居酒屋_酒選択
;  居酒屋で扱う酒＝1ビール／2サワー／3日本酒／4焼酎、および8ソフトドリンク。
;================================================================
@居酒屋_酒選択
#DIM 大将
#DIM 選択
大将 = GETCHARA(66)
PRINTL
PRINTL 何を頼みますか？
;[0]〜[3] が酒番号1〜4に対応（@酒場_メニュー表示の採番規則）
CALL 酒場_メニュー表示(1, 4)
PRINTFORML [4] - %酒_名(8)%（%金額(酒_値段(8))%円）
PRINTL [5] - やめておく
$IZAKAYA_SAKE_INPUT
INPUT
SIF RESULT < 0 || RESULT > 5
	GOTO IZAKAYA_SAKE_INPUT
;CALLするとRESULTが戻り値で上書きされるため、選択値を退避しておく
選択 = RESULT
IF 選択 == 5
	PRINTL 品書きを眺めただけで、注文はしなかった。
	RETURN
ENDIF
IF 選択 == 4
	CALL 酒場_注文(MASTER, 8, 大将)
ELSE
	CALL 酒場_注文(MASTER, 選択 + 1, 大将)
ENDIF
;深酒への気遣い（当日5杯以上で大将が水を出す）
IF TCVAR:MASTER:当日飲酒量 >= 5 && 大将 >= 0 && 酔い段階(MASTER) >= 2
	PRINTFORMW %CALLNAME:大将%が黙って冷たい水のコップを置いていった。「……ほどほどにしとけよ」
ENDIF
RETURN

;================================================================
;@居酒屋_つまみ
;  空腹を満たし、ストレスを落とす。酒の回りも少し遅くなる（酔いを軽く戻す）。
;================================================================
@居酒屋_つまみ
IF MONEY:MASTER < 600
	PRINTFORMW 品書きの値段を見て、あなたはそっと目を逸らした。（所持金%金額(MONEY:MASTER)%円）
	RETURN
ENDIF
MONEY:MASTER -= 600
DOWNBASE:MASTER:体力 -= 100
DOWNBASE:MASTER:気力 -= 150
DOWNBASE:MASTER:ストレス += 200
SETBIT CFLAG:MASTER:食事 , 1
;胃に何か入れれば酔いの回りは少し落ち着く
BASE:MASTER:酔い = MAX(BASE:MASTER:酔い - 60, 0)
CFLAG:MASTER:待機時間 += 20
PRINTFORMW 湯気の立つ皿が運ばれてきた。箸を進めるうち、胃の底があたたかくなっていく。
RETURN

;================================================================
;@居酒屋_相席
;  店内に居る他のキャラと同席して飲む。酔うほど距離が縮まる（TAの増分が増える）。
;================================================================
@居酒屋_相席
#DIM 相手
CALL 居酒屋_同席者選択
相手 = RESULT
SIF 相手 < 0
	RETURN
CALL 居酒屋_相席する(相手)
RETURN

;================================================================
;@居酒屋_同席者選択
;  店内に居る他のキャラを一覧して選ばせる（相席／乾杯／奢る／介抱で共用）。
;  RETURN 選んだキャラの登録番号 / -1＝候補なし・やめた
;================================================================
@居酒屋_同席者選択
#DIM 候補, 20
#DIM 件数
#DIM 選択
件数 = 0
FOR LOCAL, 0, CHARANUM
	SIF LOCAL == MASTER
		CONTINUE
	SIF CFLAG:LOCAL:現在地区 != 2 || CFLAG:LOCAL:現在位置 != 54
		CONTINUE
	SIF 件数 >= 20
		BREAK
	候補:件数 = LOCAL
	件数 ++
NEXT
IF !件数
	PRINTFORMW 見渡してみたが、今夜は声をかけられそうな相手はいなかった。
	RETURN -1
ENDIF
PRINTL
PRINTL 誰に声をかけますか？
FOR LOCAL, 0, 件数
	PRINTFORML [{LOCAL}] - %CALLNAME:(候補:LOCAL)%（%酔い段階_名(候補:LOCAL)%）
NEXT
PRINTFORML [{件数}] - やめておく
$IZAKAYA_PICK_INPUT
INPUT
SIF RESULT < 0 || RESULT > 件数
	GOTO IZAKAYA_PICK_INPUT
選択 = RESULT
IF 選択 == 件数
	PRINTL 結局、声はかけなかった。
	RETURN -1
ENDIF
RETURN 候補:選択

;================================================================
;@居酒屋_品目選択
;  乾杯／奢る で出す品を選ぶ。RETURN 酒番号 / -1＝やめた
;================================================================
@居酒屋_品目選択
#DIM 選択
PRINTL
PRINTL 何を頼みますか？
;[0]〜[3] が酒番号1〜4に対応（@酒場_メニュー表示の採番規則）
CALL 酒場_メニュー表示(1, 4)
PRINTFORML [4] - %酒_名(8)%（%金額(酒_値段(8))%円）
PRINTL [5] - やめておく
$IZAKAYA_ITEM_INPUT
INPUT
SIF RESULT < 0 || RESULT > 5
	GOTO IZAKAYA_ITEM_INPUT
選択 = RESULT
SIF 選択 == 5
	RETURN -1
SIF 選択 == 4
	RETURN 8
RETURN 選択 + 1

;================================================================
;@居酒屋_乾杯 / @居酒屋_奢る / @居酒屋_介抱
;  相手（と品）を選んで 酒場.ERB の共通処理へ渡すだけの薄いラッパ。
;================================================================
@居酒屋_乾杯
#DIM 相手
#DIM 品目
CALL 居酒屋_同席者選択
相手 = RESULT
SIF 相手 < 0
	RETURN
CALL 居酒屋_品目選択
品目 = RESULT
SIF 品目 < 0
	RETURN
CALL 酒場_乾杯(相手, 品目, GETCHARA(66))
RETURN

@居酒屋_奢る
#DIM 相手
#DIM 品目
CALL 居酒屋_同席者選択
相手 = RESULT
SIF 相手 < 0
	RETURN
CALL 居酒屋_品目選択
品目 = RESULT
SIF 品目 < 0
	RETURN
CALL 酒場_奢る(相手, 品目, GETCHARA(66))
RETURN

@居酒屋_介抱
#DIM 相手
CALL 居酒屋_同席者選択
相手 = RESULT
SIF 相手 < 0
	RETURN
CALL 酒場_介抱(相手)
RETURN

;================================================================
;@居酒屋_相席する(ARG)
;  ARG = 相席する相手。奢る形で一杯を共にする（600円）。
;  酔いが深いほど打ち解ける＝TAの増分が大きくなる。相手も一緒に酔う。
;================================================================
@居酒屋_相席する(ARG)
#DIM 相手
#DIM 増分
相手 = ARG
IF MONEY:MASTER < 600
	PRINTFORMW 奢ってやれるだけの持ち合わせがなく、あなたは声をかけるのをやめた。
	RETURN
ENDIF
;嫌われていると同席を断られる（COMF1015「注文する」と同じ考え方）
IF TA:相手:MASTER:3 < 5 && TA:相手:MASTER:0 < 5 && RAND(100) < 40
	PRINTFORMW %CALLNAME:相手%は曖昧に笑って、やんわりと断ってきた。
	TA:MASTER:相手:4 += 3
	RETURN
ENDIF
MONEY:MASTER -= 600
CFLAG:MASTER:待機時間 += 30
CFLAG:相手:待機時間 += 30
;先に自分が飲み、相手にも一杯付き合ってもらう
CALL 飲酒(MASTER, 100)
CALL 飲酒(相手, 100)
;酔うほど打ち解ける
増分 = 4 + 酔い段階(MASTER) * 3 + 酔い段階(相手) * 3
TA:MASTER:相手:3 += 増分
TA:相手:MASTER:3 += 増分
TA:MASTER:相手:4 += 酔い段階(MASTER) * 2
TA:相手:MASTER:4 += 酔い段階(相手) * 2
EXP:MASTER:会話経験 += 2
EXP:相手:会話経験 += 2
SOURCE:MASTER:歓楽 = 400
SOURCE:相手:歓楽 = 400
PRINTL
PRINTFORML グラスを合わせ、%CALLNAME:相手%と他愛のない話を始めた。
IF 酔い段階(MASTER) >= 3 || 酔い段階(相手) >= 3
	PRINTL 呂律の回らない言葉と、意味もない笑い。距離感はとうに壊れていた。
	PRINTFORMW 気づけば%CALLNAME:相手%の肩に、自分の肩がぴたりと触れている。
ELSEIF 酔い段階(MASTER) >= 1
	PRINTFORMW 酒が入るほど口は軽くなり、%CALLNAME:相手%の笑い声も大きくなっていった。
ELSE
	PRINTFORMW 最初は当たり障りのない話。それでも、間はまるで悪くなかった。
ENDIF
CALL 居酒屋_相席_話題(相手)
RETURN

;================================================================
;@居酒屋_相席_話題(ARG)
;  ARG = 相席相手。酔いが回ってから何を喋ったか（2026-07-22追加）。
;  酔い段階2以上でのみ発生し、翌朝の回想（@醜態記録→@醜態_翌朝）へ繋がる。
;  加算するのは好意(TA:3)のみ。
;================================================================
@居酒屋_相席_話題(ARG)
#DIM 相手
#DIM 種別
相手 = ARG
;素面〜ほろ酔いでは当たり障りのない話のままで終わる
SIF 酔い段階(MASTER) < 2
	RETURN
種別 = RAND(5) + 1
PRINTL
SELECTCASE 種別
	CASE 1
		PRINTFORML 言うつもりのなかったことが、するりと口から出ていった。
		PRINTFORMW %CALLNAME:相手%は茶化しもせず、ただ「うん」と相槌を打っている。
		DOWNBASE:MASTER:ストレス += 250
	CASE 2
		PRINTL 一度こぼし始めると止まらなかった。仕事のこと、金のこと、うまくいかないこと。
		PRINTFORMW %CALLNAME:相手%は空のグラスを回しながら、辛抱強く聞いてくれた。
		DOWNBASE:MASTER:ストレス += 350
	CASE 3
		PRINTL 気づけば、好きな相手の話ばかりしていた。それも、同じ話を何度も。
		PRINTFORMW %CALLNAME:相手%の相槌が、だんだん生ぬるくなっていく。
	CASE 4
		PRINTL 何がきっかけだったのかは分からない。ただ、急に目の奥が熱くなった。
		PRINTFORMW %CALLNAME:相手%は何も聞かず、黙って新しいおしぼりを差し出してくれた。
		DOWNBASE:MASTER:ストレス += 400
	CASEELSE
		PRINTL 誰に頼まれたわけでもないのに、あなたは朗々と歌い始めた。
		PRINTFORMW 隣の卓から拍手が飛んでくる。%CALLNAME:相手%は顔を覆って笑っていた。
		DOWNBASE:MASTER:ストレス += 300
ENDSELECT
TA:MASTER:相手:3 += 4
TA:相手:MASTER:3 += 4
CALL 醜態記録(MASTER, 種別, 相手)
RETURN

;================================================================
;@居酒屋_大将と話す(ARG)
;  ARG = 大将。愚痴を聞いてもらう＝ストレスが落ちる。常連になるほど親身になる。
;================================================================
@居酒屋_大将と話す(ARG)
#DIM 大将
大将 = ARG
CFLAG:MASTER:待機時間 += 15
EXP:MASTER:会話経験 += 1
TA:MASTER:大将:3 += 2
TA:大将:MASTER:3 += 2
PRINTL
IF TA:大将:MASTER:3 >= 40
	PRINTFORML カウンター越しの%CALLNAME:大将%は、注文もしていない小鉢をすっと差し出してきた。
	PRINTL 「顔色が良くねえな。……まあ、話くらいは聞くぞ」
	PRINTFORMW 湯気ごしの太い声に、張り詰めていたものが少しほどけていく。
	DOWNBASE:MASTER:ストレス += 400
ELSEIF TA:大将:MASTER:3 >= 15
	PRINTFORML %CALLNAME:大将%は手を動かしたまま、あなたの話に短く相槌を返してくれた。
	PRINTFORMW 「そうかい」「そりゃ大変だ」──それだけで、不思議と気が晴れる。
	DOWNBASE:MASTER:ストレス += 250
ELSE
	PRINTFORML 世間話を振ってみると、%CALLNAME:大将%は「そうかい」とだけ返して鍋に向き直った。
	PRINTFORMW 愛想はないが、無視されているわけでもなさそうだ。
	DOWNBASE:MASTER:ストレス += 100
ENDIF
RETURN
