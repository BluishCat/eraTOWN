;================================================
; レスラー♂強（キャラ番号 27）の汎用口上
; 状況：1声かけ 2愛撫 3膣挿入 4アナル挿入 5絶頂 6口内/顔射 7抵抗 8甘え 9日常
;================================================

@汎用口上_1_27(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「おう、なんだ小僧。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「俺に用か。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「どうした。」
ENDSELECT
RETURN
@汎用口上_8_27(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ふん、見どころはあるな。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「気合いは認めてやる。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「たまには揉んでやろう。」
ENDSELECT
RETURN
@汎用口上_9_27(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「鍛錬あるのみ。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「腹が減ったな、大盛りだ。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「今日も己を追い込むぞ。」
ENDSELECT
RETURN

;================================================
; 性的状況の口上（男性・受け手時。2/4/5/7のみ）※KSTR方式
;================================================
;----- 2 愛撫される -----
@汎用口上_2_27(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んっ……お前の手か……ふっ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「よせっ……小僧、舐めるな……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「……好きにしろ」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ぬっ……何をする……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ぐっ……身体が、熱い……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見るな……」
ENDIF
RETURN
;----- 4 アナル挿入される -----
@汎用口上_4_27(ARG,ARG:1)
IF EXP:ARG:Ａ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「なにっ……そこに挿れる気か……！？」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「お前になら……許してやる……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめろっ……ぬぅ……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「……好きにしろ、尻でも」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ぐっ……こわい……ゆっくりやれ……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ぬあっ、尻で感じるとは……この俺が……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……いっぱいで……」
ENDIF
RETURN
;----- 5 絶頂 -----
@汎用口上_5_27(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イく……お前と……っ！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イく……ぐっ……！」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ぬっ、出る……くっ！」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見るな……イく顔など……」
ELSEIF TALENT:ARG:快感応答 < 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「これは……ぐっ、あぁっ！」
ENDIF
RETURN
;----- 7 行為を拒む・抵抗する -----
@汎用口上_7_27(ARG,ARG:1)
IF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「離せっ……！　この俺を、舐めるな……！」
ELSEIF TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめろ……っ、ぬぅ……！」
ELSEIF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ぐっ……無様な……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「よせ……頼む……」
ENDIF
RETURN
