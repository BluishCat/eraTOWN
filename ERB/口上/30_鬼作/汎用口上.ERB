;================================================
; 鬼作（キャラ番号 30）の汎用口上
; 状況：1声かけ 2愛撫 3膣挿入 4アナル挿入 5絶頂 6口内/顔射 7抵抗 8甘え 9日常
;================================================

@汎用口上_1_30(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「あぁ？　なんだ。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「俺に用か、嬢ちゃん。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「チッ。」
ENDSELECT
RETURN
@汎用口上_8_30(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「……ふん、まあいい。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「気に入ったぜ、嬢ちゃん。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「へっ、悪くねぇな。」
ENDSELECT
RETURN
@汎用口上_9_30(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「退屈だな。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「獲物はどこだ……なんてな。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「腹が減った。」
ENDSELECT
RETURN

;================================================
; 性的状況の口上（男性・受け手時。2/4/5/7のみ）※KSTR方式
;================================================
;----- 2 愛撫される -----
@汎用口上_2_30(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んっ……お前の手か……ぐへへ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「よせや……っ、なんの真似だ……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「……好きにしろや」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「おっと……どこ触ってやがる……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「くっ……身体が、熱ぃ……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見んじゃねぇ……」
ENDIF
RETURN
;----- 4 アナル挿入される -----
@汎用口上_4_30(ARG,ARG:1)
IF EXP:ARG:Ａ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「おいっ……そこに挿れる気か……！？」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「お前になら……まぁ、いいぜ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめろっ……ふざけんな……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「……好きにしろ、ケツでも」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「くっ……こえぇ……ゆっくりやれ……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「うぁっ、ケツで感じちまう……この俺が……くそっ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……いっぱいで……くるし……」
ENDIF
RETURN
;----- 5 絶頂 -----
@汎用口上_5_30(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イく……お前と……っ！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イく……くっ……！」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「や、やめろ……出る……くそっ！」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見んな……イく顔なんざ……」
ELSEIF TALENT:ARG:快感応答 < 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「これは……くっ、あぁっ！」
ENDIF
RETURN
;----- 7 行為を拒む・抵抗する -----
@汎用口上_7_30(ARG,ARG:1)
IF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「離せっ……！　舐めやがって……！」
ELSEIF TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめろ……っ、ふざけんな……！」
ELSEIF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「くっ……ざまぁねぇな……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「よせ……頼むから……」
ENDIF
RETURN
