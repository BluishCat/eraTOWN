@妊娠口上_3_1(ARG,ARG:1)
;妊娠発覚
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「生理が来ない……もしかして、本当に……？」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「体がなんだか変……熱っぽくて、だるくて……」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「朝、気持ち悪くて……まさか、わたし……？」
ENDSELECT
RETURN
