		ENDSELECT
	ELSE
		;---【自宅等】過酷な苦悶 ---
		SELECTCASE RAND(4)
			CASE 0
				PRINTFORMW %CALLNAME:ARG%「うぅ……っ！　あぁっ……！　もう、我慢できない……！　骨盤が、壊れるみたいに……っ！」
			CASE 1
				PRINTFORMW %CALLNAME:ARG%「んんんんっ……！！　お腹の奥を、全部押しつぶされる……！　あぁ、もう出ちゃう……っ！」
			CASE 2
