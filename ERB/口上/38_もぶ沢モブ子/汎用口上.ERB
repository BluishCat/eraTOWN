;================================================
; もぶ沢モブ子（キャラ番号 38）の汎用口上
; 状況：1声かけ 2愛撫 3膣挿入 4アナル挿入 5絶頂 6口内/顔射 7抵抗 8甘え 9日常
;================================================

@汎用口上_1_38(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「え、わたし？」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「なあに？」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「どうかしました？」
ENDSELECT
RETURN
@汎用口上_8_38(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「えへへ、ありがとうございます。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「先輩、優しい……。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「また声かけてください！」
ENDSELECT
RETURN
@汎用口上_9_38(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「おなかすいた……。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「はやく帰りたいなあ。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「今日つかれた……。」
ENDSELECT
RETURN

;================================================
; 性的状況の口上（ARG=本人 / ARG:1=相手）※KSTR方式
;================================================
;----- 2 愛撫される -----
@汎用口上_2_38(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んっ……あなたの手、あったかい……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「や、やめて……触らないで……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「はい……どうぞ、好きに……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あ……そんなところ……っ」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「はぁっ……身体、熱くて……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ないで……恥ずかしい……」
ENDIF
RETURN
;----- 3 膣挿入される -----
@汎用口上_3_38(ARG,ARG:1)
IF EXP:ARG:Ｖ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あ……っ、これが……こわい……っ」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あなたと……嬉しい……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「や……っ、やめて……」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「はい……奥まで、どうぞ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「まだ、心が……あぁっ」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あぁっ、とろけちゃう……！」
ELSEIF PALAM:ARG:潤滑 >= PALAMLV:3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んぁ……濡らして……恥ずかしい……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……痛い……ゆっくり……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ないで……つながってる所……」
ELSEIF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「強くされると……なんで、感じちゃうの……」
ENDIF
RETURN
;----- 4 アナル挿入される -----
@汎用口上_4_38(ARG,ARG:1)
IF EXP:ARG:Ａ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ひぁ……そこ、だめ……！」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あなたのため、なら……お尻でも……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やぁ……そこは……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「はい……お尻も……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「こわい……ゆっくり……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あぁっ、お尻なのに……変……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……苦しい……」
ENDIF
RETURN
;----- 5 絶頂 -----
@汎用口上_5_38(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イっちゃう……一緒に……っ！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イかせて……ください……っ！」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「や……イきたくないのに……あぁっ！」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ないで……イく顔……」
ELSEIF TALENT:ARG:快感応答 < 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ちが……イってなんか……あぁあっ！」
ENDIF
RETURN
;----- 6 口内・顔に射精される -----
@汎用口上_6_38(ARG,ARG:1)
IF EXP:ARG:口淫経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んぷっ……口の中、熱い……」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ん……こく……飲んだ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「けほっ……ひどい……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「一滴も……ごちそうさま……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んんっ……顔に……」
ENDIF
RETURN
;----- 7 行為を拒む・抵抗する -----
@汎用口上_7_38(ARG,ARG:1)
IF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめてっ……！　いや……！」
ELSEIF TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いや……っ、こんなの……！」
ELSEIF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「恥ずかしくて……できない……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「う……やめて……」
ENDIF
RETURN
