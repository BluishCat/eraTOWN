;================================================
; よし子先生（キャラ番号 22）の汎用口上
; 状況：1声かけ 2愛撫 3膣挿入 4アナル挿入 5絶頂 6口内/顔射 7抵抗 8甘え 9日常
;================================================

@汎用口上_1_22(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「はいはい、どうしましたか？」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「あら、なにか困りごと？」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「先生でよければ、お話聞きますよ。」
ENDSELECT
RETURN
@汎用口上_8_22(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ふふ、いい子ね。頑張ってるの、ちゃんと見てますよ。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「無理はしないでね。先生はあなたの味方だから。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「そんな顔しないの。ほら、笑って。」
ENDSELECT
RETURN
@汎用口上_9_22(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「今日はいいお天気ねぇ。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「お昼、なにを食べようかしら。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「ふぅ、ひと息つきましょうか。」
ENDSELECT
RETURN

;================================================
; 性的状況の口上（ARG=本人 / ARG:1=相手）※KSTR方式
;================================================
;----- 2 愛撫される -----
@汎用口上_2_22(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んっ……ふふ、いけない子ね……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「こら……やめなさい……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いいわ……先生の身体で、よければ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あら……こんな所で……あっ……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「はぁっ……先生、こんなに感じて……だめね……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ないで……大人の身体なんて……」
ENDIF
RETURN
;----- 3 膣挿入される -----
@汎用口上_3_22(ARG,ARG:1)
IF EXP:ARG:Ｖ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あ……っ、こんな、生徒に……いけないわ……」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あなたと……ああ、先生、幸せよ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「くっ……こんなことで……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いいのよ……奥まで、来なさい……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「だめ……こんなの、いけないのに……あぁ」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あぁっ、だめ……乱れちゃう……！」
ELSEIF PALAM:ARG:潤滑 >= PALAMLV:3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んぁ……こんなに濡らして……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……少し、痛むわ……ゆっくり……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ては、だめよ……」
ELSEIF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「乱暴にされると……どうして……」
ENDIF
RETURN
;----- 4 アナル挿入される -----
@汎用口上_4_22(ARG,ARG:1)
IF EXP:ARG:Ａ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「そこは……だめよ……！」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あなたになら……お尻でも……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめてっ……そこは……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いいわ……お尻も……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「こわいわ……ゆっくりね……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あぁっ、お尻で……いけない先生ね……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……苦しいわ……」
ENDIF
RETURN
;----- 5 絶頂 -----
@汎用口上_5_22(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イく……一緒に……っ！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イかせて……あぁ……！」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「い、いや……あぁっ！」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ないで……」
ELSEIF TALENT:ARG:快感応答 < 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「これは……あぁあっ……！」
ENDIF
RETURN
;----- 6 口内・顔に射精される -----
@汎用口上_6_22(ARG,ARG:1)
IF EXP:ARG:口淫経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んぐっ……口の中に……熱い……」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ん……こく……飲んであげた……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「けほっ……なんてこと……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「一滴も、残さないわ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んんっ……顔に……」
ENDIF
RETURN
;----- 7 行為を拒む・抵抗する -----
@汎用口上_7_22(ARG,ARG:1)
IF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめなさいっ……！　教師として……！」
ELSEIF TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いや……っ、こんなこと……！」
ELSEIF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「恥ずかしくて……できないわ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「お願い……やめて……」
ENDIF
RETURN
