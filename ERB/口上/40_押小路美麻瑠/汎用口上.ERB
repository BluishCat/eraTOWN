;================================================
; 押小路美麻瑠（キャラ番号 40）の汎用口上
; 状況：1声かけ 2愛撫 3膣挿入 4アナル挿入 5絶頂 6口内/顔射 7抵抗 8甘え 9日常
;================================================

@汎用口上_1_40(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「あら、わたくしに御用？」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「なあに、どうかなさって？」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「はい、なんでしょう。」
ENDSELECT
RETURN
@汎用口上_8_40(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ふふ、あなたといると新鮮ですわ。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「あなた、なかなか見どころがありますこと。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「また、お茶でもいたしましょう。」
ENDSELECT
RETURN
@汎用口上_9_40(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「お花の稽古に行かなくては。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「今日は良いお天気ですこと。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「ふぅ、少し休憩いたしますわ。」
ENDSELECT
RETURN

;================================================
; 性的状況の口上（ARG=本人 / ARG:1=相手）※KSTR方式
;================================================
;----- 2 愛撫される -----
@汎用口上_2_40(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んっ……あなたの手、悪くありませんわ……ふふ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「無礼者っ……このわたくしに、なんて真似を……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ふふ……どうぞ、わたくしを味わいなさい……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あら……ずいぶんと、無遠慮ですのね……あっ……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「はぁっ……このわたくしが、こんなに乱れて……っ」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ないでっ……こんな、はしたない姿……」
ENDIF
RETURN
;----- 3 膣挿入される -----
@汎用口上_3_40(ARG,ARG:1)
IF EXP:ARG:Ｖ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あ……っ、これが……こわい、ですわ……っ」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あなたと、ひとつに……ああ、幸せですわ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「くっ……この程度で、わたくしが……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ふふ……奥まで、どうぞ……わたくしのすべてを……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「まっ……あぁ、まだ心が……はしたない……っ」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あぁっ、だめ……わたくし、こんなに乱れて……！」
ELSEIF PALAM:ARG:潤滑 >= PALAMLV:3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んぁ……こんなに濡らして……いけない身体……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……少し、痛みますわ……ゆっくり……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見てはいけませんわ……こんな姿……」
ELSEIF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「乱暴にされると……なぜ、感じてしまうの……あぁ……」
ENDIF
RETURN
;----- 4 アナル挿入される -----
@汎用口上_4_40(ARG,ARG:1)
IF EXP:ARG:Ａ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「まぁっ……そんな場所、はしたない……っ」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あなたのためなら……このお尻も……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「おやめなさいっ……そこだけは……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ふふ……お尻も、どうぞご自由に……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「こわいですわ……ゆっくり、してくださいまし……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あぁっ、お尻で……わたくし、どうかしていますわ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……いっぱいで……苦しい……」
ENDIF
RETURN
;----- 5 絶頂 -----
@汎用口上_5_40(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イってしまいます……あなたと……っ！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イく許しを……あぁ、イってしまいますわ……！」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「い、いやですわ……こんな、無様に……あぁっ！」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ないで……達する顔など……っ」
ELSEIF TALENT:ARG:快感応答 < 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「これは、達してなど……あぁあっ……！」
ENDIF
RETURN
;----- 6 口内・顔に射精される -----
@汎用口上_6_40(ARG,ARG:1)
IF EXP:ARG:口淫経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んぷっ……！　口の中に……熱いですわ……」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ん……こく……ふふ、いただきましたわ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「けほっ……なんて無礼な……吐き出しますわよ……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「一滴も残さず……ごちそうさま、でしたわ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んんっ……お顔に……あら、どうしましょう……」
ENDIF
RETURN
;----- 7 行為を拒む・抵抗する -----
@汎用口上_7_40(ARG,ARG:1)
IF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「無礼者っ……！　このわたくしに、許されると思って……！」
ELSEIF TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いやですわ……っ、おやめになって……！」
ELSEIF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「は、恥ずかしくて……こんなこと……っ」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「お、おやめください……お願いですわ……」
ENDIF
RETURN
