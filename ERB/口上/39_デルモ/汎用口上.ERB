;================================================
; デルモ（キャラ番号 39）の汎用口上
; 状況：1声かけ 2愛撫 3膣挿入 4アナル挿入 5絶頂 6口内/顔射 7抵抗 8甘え 9日常
;================================================

@汎用口上_1_39(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ん？　なに？」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「呼んだ？」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「どうかした？」
ENDSELECT
RETURN
@汎用口上_8_39(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ふふ、あなたって面白いね。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「また一緒に写真撮ろ。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「なんか、あなた好きかも。」
ENDSELECT
RETURN
@汎用口上_9_39(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「今日のコーデ、決まったな。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「写真映えする場所ないかな。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「はー、小腹すいた。」
ENDSELECT
RETURN

;================================================
; 性的状況の口上（ARG=本人 / ARG:1=相手）※KSTR方式
;================================================
;----- 2 愛撫される -----
@汎用口上_2_39(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んっ……ふ、あなたの手つき、悪くないわね……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「触らないで……不愉快だわ……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「……いいわ、好きにして……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「……どこ触ってるの。あっ……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「はぁっ……こんなに乱れるなんて……らしくない……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ないで……こんな姿……」
ENDIF
RETURN
;----- 3 膣挿入される -----
@汎用口上_3_39(ARG,ARG:1)
IF EXP:ARG:Ｖ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あ……っ、これが……緊張、するわね……」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あなたと、つながって……ふ、悪くないわ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「くっ……この程度で、乱すと思わないで……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いいわ……奥まで、来なさい……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「まっ……まだ、心が……あぁっ」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あぁっ、だめ……こんなに、乱れて……！」
ELSEIF PALAM:ARG:潤滑 >= PALAMLV:3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んぁ……こんなに濡らして……最悪ね……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……少し、痛むわ……ゆっくり……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ないで……つながってる所……っ」
ELSEIF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「乱暴にされると……どうして、感じてしまうの……」
ENDIF
RETURN
;----- 4 アナル挿入される -----
@汎用口上_4_39(ARG,ARG:1)
IF EXP:ARG:Ａ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「そこは……っ、だめよ……！」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あなたになら……お尻でも……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめなさいっ……そこは……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いいわ……お尻も、好きにして……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「こわいわ……ゆっくり……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あぁっ、お尻で感じるなんて……どうかしてる……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……いっぱいで……苦しい……」
ENDIF
RETURN
;----- 5 絶頂 -----
@汎用口上_5_39(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イく……あなたと一緒に……っ！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イかせて……っ、あぁ……！」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「い、いや……こんな無様に……あぁっ！」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ないで……イく顔なんて……っ」
ELSEIF TALENT:ARG:快感応答 < 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「これは、達してなど……あぁあっ！」
ENDIF
RETURN
;----- 6 口内・顔に射精される -----
@汎用口上_6_39(ARG,ARG:1)
IF EXP:ARG:口淫経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んぐっ……口の中に……熱い……っ」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ん……こく……ふ、飲んだわ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「けほっ……最低ね……吐き出すわよ……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「一滴も、残さないわ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んんっ……顔に、かかって……最悪……」
ENDIF
RETURN
;----- 7 行為を拒む・抵抗する -----
@汎用口上_7_39(ARG,ARG:1)
IF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「離しなさいっ……！　好きにできると思わないで……！」
ELSEIF TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いや……っ、こんなこと、認めない……！」
ELSEIF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「恥ずかしくて……こんなの、無理よ……っ」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「お願い……やめて……」
ENDIF
RETURN
