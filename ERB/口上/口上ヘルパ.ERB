;================================================================
; 口上ヘルパ（blue_resort の KSTR 方式を参考）
;
; ■可変セリフ収集（KSTR方式）
;   ディスパッチャが 口上_開始 → キャラ口上関数 → 口上_表示 の順で呼ぶ。
;   キャラ口上関数側は、候補を溜めるだけでよい：
;       TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「セリフ」
;   複数書けば、口上_表示 がランダムに1つを PRINTFORMW 相当で表示する。
;   ※従来の SELECTCASE + PRINTFORMW（即時表示）方式とも共存できる
;     （その場合バッファは空なので 口上_表示 は何もしない）。
;
; ■可変呼称
;   セリフ内に %CSTR:ARG:一人称% / %CSTR:ARG:二人称% を埋め込める。
;   既定値は 呼称_初期化（EVENTFIRSTから呼ぶ）で設定。好感度等で書き換え可。
;================================================================

;----------------------------------------------------------------
;候補収集の開始（カウンタリセット）
;----------------------------------------------------------------
@口上_開始
FLAG:口上候補数 = 0
RETURN

;----------------------------------------------------------------
;溜まった候補からランダムに1つ表示（PRINTFORMW相当）
;----------------------------------------------------------------
@口上_表示
SIF FLAG:口上候補数 <= 0
	RETURN
VARSET LOCAL
LOCAL = RAND(FLAG:口上候補数)
PRINTFORMW %TSTR:LOCAL%
FLAG:口上候補数 = 0
RETURN

;----------------------------------------------------------------
;可変呼称の既定値を設定（EVENTFIRST から呼ぶ）
;----------------------------------------------------------------
@呼称_初期化
VARSET LOCAL
FOR LOCAL,0,CHARANUM
	IF TALENT:LOCAL:性別 & 1
		;女性器あり（ふたなり含む）
		SIF CSTR:LOCAL:一人称 == ""
			CSTR:LOCAL:一人称 = わたし
		SIF CSTR:LOCAL:二人称 == ""
			CSTR:LOCAL:二人称 = あなた
	ELSEIF TALENT:LOCAL:性別 & 2
		;男性器のみ
		SIF CSTR:LOCAL:一人称 == ""
			CSTR:LOCAL:一人称 = 俺
		SIF CSTR:LOCAL:二人称 == ""
			CSTR:LOCAL:二人称 = お前
	ENDIF
NEXT
RETURN
