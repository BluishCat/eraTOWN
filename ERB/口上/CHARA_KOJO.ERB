;================================================================
; 妊娠以外の汎用口上（台詞）ディスパッチ
;
; キャラ別口上 @汎用口上_{状況}_{キャラ番号} があればそれを呼ぶ。
; 無ければ何もしない（共通の既定台詞は用意しない＝未記入なら無言）。
; ⇒ キャラごとのフォルダ内 キャラ口上.ERB に台詞を書けば有効になる。
;
; 状況ID：
;   1 = 声かけ・会話
;   2 = 愛撫される
;   3 = 挿入される（膣）
;   4 = 挿入される（アナル）
;   5 = 絶頂
;   6 = 口内・顔に射精される
;   7 = 行為を拒む・抵抗する
;   8 = 甘える・好意を示す
;   9 = 日常のひとこと
;  10 = 相手の妊娠に気づいた瞬間（お腹を見て）
;  11 = 妊娠を知っている相手への会話（お腹を気遣う）
;  12 = 恋人成立時のひとこと（ARG:1=NPC側、ARG:2=相手。どちらから告白でも呼ばれる）
;  13 = 告白を断る（ARG:1=断る側、ARG:2=告白した側）
;  14 = デート中のひとこと（ARG:1=デート相手、ARG:2=MASTER）
;  15 = セフレ成立時のひとこと（ARG:1=NPC側、ARG:2=相手。どちらから誘っても呼ばれる）
;  16 = セフレ勧誘を断る（ARG:1=断る側、ARG:2=誘った側）
;  17 = 行為の誘いを受ける（ARG:1=応じる側、ARG:2=誘った側。COMF983-行為に誘う）
;       ※誘いを断る場合は 16 を流用する
;
; ※セフレ関係は TA:本人:相手:7 (1=セフレ)。H中の台詞（状況2,3,4,5,6）で
; 　「セフレ相手なら砕けた反応」等の分岐を書きたい場合はこれを参照するとよい。
;
; 呼び出し方（フック側）：
;   CALL 汎用口上(状況ID, 本人, 相手)
;   例：CALL 汎用口上(1, RESULT, MASTER)  ← RESULT が声をかけられて喋る
;================================================================

@汎用口上(ARG,ARG:1,ARG:2)
;ARG=状況ID、ARG:1=本人、ARG:2=相手
;キャラ別口上があればそれを優先。無ければ共通口上へ。
CALL 口上_開始
;末尾の番号は CSV番号（NO）。登録番号は家族の増減でズレるので必ず NO で引く
TRYCCALLFORM 汎用口上_{ARG}_{NO:(ARG:1)}(ARG:1, ARG:2)
CATCH
	CALL 汎用口上_共通(ARG, ARG:1, ARG:2)
ENDCATCH
;KSTR方式で溜めた候補があれば表示（即時表示方式なら空振り）
CALL 口上_表示
RETURN

;----------------------------------------------------------------
;汎用口上の共通（キャラ別が無い場合の既定台詞）
; 非性的な状況(1,8,9,10,11,12,13,14,15,16)＋絶頂(5)のみ既定あり。他の性的状況(2,3,4,6,7)は既定なし＝無言。
; ARG:1=喋る側（観測者）、ARG:2=相手（10/11では妊婦）
;----------------------------------------------------------------
@汎用口上_共通(ARG,ARG:1,ARG:2)
SELECTCASE ARG
	CASE 1
		PRINTFORMW %CALLNAME:(ARG:1)%「ん……なあに？」
	CASE 5
		;絶頂（個人口上が無いキャラの既定台詞）。性別で口調を変える
		IF TALENT:(ARG:1):性別 & 2 && !(TALENT:(ARG:1):性別 & 1)
			;男性器のみ＝男性口調
			PRINTFORMW %CALLNAME:(ARG:1)%「くっ……もう、出る……っ！」
		ELSE
			PRINTFORMW %CALLNAME:(ARG:1)%「あっ、ああっ……イく、イっちゃう……！」
		ENDIF
	CASE 8
		IF TALENT:(ARG:1):性別 & 2 && !(TALENT:(ARG:1):性別 & 1)
			;男性器のみ＝男性口調
			PRINTFORMW %CALLNAME:(ARG:1)%「まあ……お前といると、何だか落ち着くんだよな。」
		ELSE
			PRINTFORMW %CALLNAME:(ARG:1)%「ふふ……あなたといると、なんだか落ち着くな。」
		ENDIF
	CASE 9
		PRINTFORMW %CALLNAME:(ARG:1)%「はぁ……なんだか、のんびりしたい気分。」
	CASE 12
		;恋人成立時のひとこと（どちらから告白した場合でも呼ばれる）
		IF TALENT:(ARG:1):性別 & 2 && !(TALENT:(ARG:1):性別 & 1)
			;男性器のみ＝男性口調
			PRINTFORMW %CALLNAME:(ARG:1)%「……ああ。これからよろしくな、%CALLNAME:(ARG:2)%。」
		ELSE
			PRINTFORMW %CALLNAME:(ARG:1)%「えへへ……これからよろしくね、%CALLNAME:(ARG:2)%。」
		ENDIF
	CASE 13
		;告白を断る
		IF TALENT:(ARG:1):性別 & 2 && !(TALENT:(ARG:1):性別 & 1)
			PRINTFORMW %CALLNAME:(ARG:1)%「悪い……その気持ちには、応えられない。」
		ELSE
			PRINTFORMW %CALLNAME:(ARG:1)%「ごめんなさい……そういうふうには、見られないの。」
		ENDIF
	CASE 14
		;デート中のひとこと
		IF TALENT:(ARG:1):性別 & 2 && !(TALENT:(ARG:1):性別 & 1)
			PRINTFORMW %CALLNAME:(ARG:1)%「こうして二人で歩くのも、悪くないな。」
		ELSE
			PRINTFORMW %CALLNAME:(ARG:1)%「えへへ……なんだか、デートみたいだね。」
		ENDIF
	CASE 15
		;セフレ成立時のひとこと（どちらから誘った場合でも呼ばれる）
		IF TALENT:(ARG:1):性別 & 2 && !(TALENT:(ARG:1):性別 & 1)
			PRINTFORMW %CALLNAME:(ARG:1)%「……ああ、それでいい。面倒なのは無しで、な。」
		ELSE
			PRINTFORMW %CALLNAME:(ARG:1)%「ふふっ……いいよ。恋人じゃない、って割り切れるなら、ね。」
		ENDIF
	CASE 16
		;セフレ勧誘を断る
		IF TALENT:(ARG:1):性別 & 2 && !(TALENT:(ARG:1):性別 & 1)
			PRINTFORMW %CALLNAME:(ARG:1)%「……そういう関係になる気は、ないな。悪い。」
		ELSE
			PRINTFORMW %CALLNAME:(ARG:1)%「……そういうの、私は無理。軽く見ないでよね。」
		ENDIF
	CASE 17
		;行為の誘いを受ける
		IF TALENT:(ARG:1):性別 & 2 && !(TALENT:(ARG:1):性別 & 1)
			PRINTFORMW %CALLNAME:(ARG:1)%「……ああ。俺も、そのつもりだった。」
		ELSE
			PRINTFORMW %CALLNAME:(ARG:1)%「……うん。わたしも、そういう気分。」
		ENDIF
	CASE 10
		;相手の妊娠に気づいた瞬間
		PRINTFORMW %CALLNAME:(ARG:1)%「え……%CALLNAME:(ARG:2)%、お腹……もしかして、妊娠してるの……？」
	CASE 11
		;妊娠を知っている相手への会話（お腹の段階で少し変える）
		SELECTCASE 腹段階(ARG:2)
			CASE 4
				PRINTFORMW %CALLNAME:(ARG:1)%「もう臨月でしょ？　いつ生まれてもおかしくないんだから、無理しないでね。」
			CASE 3
				PRINTFORMW %CALLNAME:(ARG:1)%「お腹、すっかり大きくなったね。重いでしょ、気をつけて。」
			CASEELSE
				PRINTFORMW %CALLNAME:(ARG:1)%「お腹、目立ってきたね。無理はしないで。」
		ENDSELECT
ENDSELECT
RETURN
