;================================================
; 桜井千里（キャラ番号 26）の汎用口上
; 状況：1声かけ 2愛撫 3膣挿入 4アナル挿入 5絶頂 6口内/顔射 7抵抗 8甘え 9日常
;================================================

@汎用口上_1_26(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「なんだ、用か？」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「おう、どうした。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「呼んだか？」
ENDSELECT
RETURN
@汎用口上_8_26(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ふっ、悪くないな。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「お前、根性あるじゃないか。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「たまには稽古つけてやる。」
ENDSELECT
RETURN
@汎用口上_9_26(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「体がなまるな。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「今日のトレーニングは何にするか。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「はー、汗かきたい。」
ENDSELECT
RETURN

;================================================
; 性的状況の口上（ARG=本人 / ARG:1=相手）※KSTR方式
;================================================
;----- 2 愛撫される -----
@汎用口上_2_26(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んっ……ちょ、優しくすんなよ……調子狂う……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「触んじゃねぇ……っ、離せよ！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「……好きにしろよ。あたしは知らねぇからな……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ちっ……どこ触ってんだよ……っ」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「はぁっ……くそ、身体が熱ぃ……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「うっせ……見んなっつってんだろ……」
ENDIF
RETURN
;----- 3 膣挿入される -----
@汎用口上_3_26(ARG,ARG:1)
IF EXP:ARG:Ｖ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「うぁ……っ、く、挿入ってくんじゃねぇか……っ」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あんっ……ちくしょ、あんたとだと……悪くねぇな……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「くっ……こんなんで、あたしがヒィヒィ言うか……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「はぁっ……好きなだけ、突けよ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「や、やべ……勝手に、身体が……くそっ」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あぁっ、やべ……気持ちよすぎて、頭とろける……！」
ELSEIF PALAM:ARG:潤滑 >= PALAMLV:3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んぁ……びしょびしょじゃねぇか……くそ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……まだ、きつい……ちょい待て……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見んな……つながってるとこ、見んじゃねぇ……っ」
ELSEIF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「乱暴にすると……なんで、こんな感じちまうんだ……っ」
ENDIF
RETURN
;----- 4 アナル挿入される -----
@汎用口上_4_26(ARG,ARG:1)
IF EXP:ARG:Ａ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ひっ……！　そこ、ケツだろ……マジかよ……っ」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あんたのためなら……ケツでも、いいよ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめろっ……そこだけは勘弁しろ……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「……ケツの穴も、あんたのだろ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「こわいっての……ゆっくりしろ……っ」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あぁっ、ケツなのに……気持ちいっ……あたし、変だろ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……腹ん中、いっぱいで……くるし……」
ENDIF
RETURN
;----- 5 絶頂 -----
@汎用口上_5_26(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イく……あんたと一緒に、イっちまう……っ！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イかせろ……っ、あんたの前で、イくから……！」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「や、やべ……イきたくねぇのに……あぁっ！」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見んなっ……イく顔なんか……っ」
ELSEIF TALENT:ARG:快感応答 < 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ちが……イってなんか、ねぇ……あぁあっ！」
ENDIF
RETURN
;----- 6 口内・顔に射精される -----
@汎用口上_6_26(ARG,ARG:1)
IF EXP:ARG:口淫経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んぷっ……！　口ん中、熱ぃ……っ」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ん……こく……ちっ、飲んだぞ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「けほっ……サイテーだな……吐くぞ……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んっ……残さず、飲んでやるよ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んんっ……顔にかかった……うわ、べたべた……」
ENDIF
RETURN
;----- 7 行為を拒む・抵抗する -----
@汎用口上_7_26(ARG,ARG:1)
IF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「離せ……！　あたしを好きにできると思うなよ……！」
ELSEIF TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いやだっつってんだろ……っ、やめろ……！」
ELSEIF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「うっせ……恥ずいから、無理だっての……っ」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「う……やめろよ……頼むから……」
ENDIF
RETURN
