@妊娠口上_3_26(ARG,ARG:1)
;妊娠発覚
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ふっ……あたしが母親、か……」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「ほう……新しい命、悪くないな。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「そうか……あたしの中に、な。」
ENDSELECT
RETURN
@妊娠口上_4_26(ARG,ARG:1)
;陣痛・破水
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「っ……ふぅ、来たか……根性で乗り切る……！」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「ぐ……っ、これしきの痛み……！」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「はぁ……まだだ、まだいける……っ」
ENDSELECT
RETURN
@妊娠口上_5_26(ARG,ARG:1)
;出産
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「はぁ……よくやった、あたし……」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「ふっ……小さくても、いい面構えだ。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「よく生まれた。強く育てよ。」
ENDSELECT
RETURN
@妊娠口上_6_26(ARG,ARG:1)
;陣痛激化
SELECTCASE RAND(2)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ふっ……効くな、この痛み……っ」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「ぐ……本番だな……っ」
ENDSELECT
RETURN
@妊娠口上_7_26(ARG,ARG:1)
;いきみ
SELECTCASE RAND(2)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「いくぞ……ふんっ……！」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「根性で……そーれっ……！」
ENDSELECT
RETURN
@妊娠口上_8_26(ARG,ARG:1)
;破水
SELECTCASE RAND(2)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ふっ……破水か。始まりだな。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「っ……羊水……いよいよ本番だ。」
ENDSELECT
RETURN

@妊娠口上_9_26(ARG,ARG:1)
;多胎に気づく（驚き）
TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ほう……もう一人か。双子とはな……!」
TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「まだ終わりじゃないのか……面白い……!」
RETURN
