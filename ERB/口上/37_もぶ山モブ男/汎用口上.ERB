;================================================
; もぶ山モブ男（キャラ番号 37）の汎用口上
; 状況：1声かけ 2愛撫 3膣挿入 4アナル挿入 5絶頂 6口内/顔射 7抵抗 8甘え 9日常
;================================================

@汎用口上_1_37(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ん、俺？」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「なんか用？」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「どした？」
ENDSELECT
RETURN
@汎用口上_8_37(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ま、悪くないな。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「お前とは話しやすいわ。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「また今度な。」
ENDSELECT
RETURN
@汎用口上_9_37(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「だりぃなー。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「腹減った。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「早く帰りたい。」
ENDSELECT
RETURN

;================================================
; 性的状況の口上（男性・受け手時。2/4/5/7のみ）※KSTR方式
;================================================
;----- 2 愛撫される -----
@汎用口上_2_37(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んっ……お前の手か……悪くないな……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「よせ……触るな……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「……好きにしろ」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「っ……何すんだ……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「くっ……身体が、熱い……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見るな……」
ENDIF
RETURN
;----- 4 アナル挿入される -----
@汎用口上_4_37(ARG,ARG:1)
IF EXP:ARG:Ａ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「なっ……そこに挿れる気か……！？」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「お前になら……いいよ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめろっ……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「……好きにしろ、尻でも」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「くっ……こわい……ゆっくり……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「うぁっ、尻で感じちまう……くっ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……いっぱいで……」
ENDIF
RETURN
;----- 5 絶頂 -----
@汎用口上_5_37(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イく……お前と……っ！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イく……くっ……！」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「や、やめ……出る……っ！」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見るな……イく顔なんか……」
ELSEIF TALENT:ARG:快感応答 < 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「これは……くっ、あぁっ！」
ENDIF
RETURN
;----- 7 行為を拒む・抵抗する -----
@汎用口上_7_37(ARG,ARG:1)
IF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「離せっ……！　やめろ……！」
ELSEIF TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめろ……っ、こんなの……！」
ELSEIF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「くっ……みっともない……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「よせ……頼む……」
ENDIF
RETURN
