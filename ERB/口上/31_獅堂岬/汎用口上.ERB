;================================================
; 獅堂岬（キャラ番号 31）の汎用口上
; 状況：1声かけ 2愛撫 3膣挿入 4アナル挿入 5絶頂 6口内/顔射 7抵抗 8甘え 9日常
;================================================

@汎用口上_1_31(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ん、どうかした？」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「なに？　部活の話？」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「呼んだ？」
ENDSELECT
RETURN
@汎用口上_8_31(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「へへ、あんたといると調子出る！」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「今度打ち合おうよ！」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「なんだかんだ、あんた好きだよ。」
ENDSELECT
RETURN
@汎用口上_9_31(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「サーブの練習しなきゃ。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「ラケットのガット、張り替えなきゃ。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「あー、体動かしたい！」
ENDSELECT
RETURN

;================================================
; 性的状況の口上（ARG=本人 / ARG:1=相手）※KSTR方式
;================================================
;----- 2 愛撫される -----
@汎用口上_2_31(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んっ……お前の手、あったかいな……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「よせ……その手を、どけろ……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「……いいぞ、好きにしろ。わたしは構わん……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「っ……どこを、触っている……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「はぁっ……こんなに、乱れるとは……不覚だ……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見るな……こんな姿……」
ENDIF
RETURN
;----- 3 膣挿入される -----
@汎用口上_3_31(ARG,ARG:1)
IF EXP:ARG:Ｖ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あ……っ、これが……く、少し、こわいな……」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「お前と、つながって……ふ、悪くないな……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「くっ……この程度で、屈すると思うな……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いいぞ……奥まで、来い……受け止める……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「まっ……まだ、心が……あぁっ」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あぁっ、だめだ……こんなに、乱れて……！」
ELSEIF PALAM:ARG:潤滑 >= PALAMLV:3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んぁ……こんなに濡らして……情けない……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……少し、痛むな……ゆっくり……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見るな……つながっている所を……っ」
ELSEIF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「乱暴にされると……どうして、感じてしまうんだ……」
ENDIF
RETURN
;----- 4 アナル挿入される -----
@汎用口上_4_31(ARG,ARG:1)
IF EXP:ARG:Ａ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「そこは……っ、だめだ、そんな場所……！」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「お前のためなら……尻でも、いいぞ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめろっ……そこだけは……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いいぞ……尻も、好きにしろ……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「こわいな……ゆっくり、してくれ……っ」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あぁっ、尻で感じるとは……どうかしている……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……いっぱいで……苦しい……」
ENDIF
RETURN
;----- 5 絶頂 -----
@汎用口上_5_31(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イく……お前と一緒に……っ！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イかせてくれ……っ、あぁ……！」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「い、いや……こんな無様に……あぁっ！」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見るな……イく顔など……っ」
ELSEIF TALENT:ARG:快感応答 < 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「これは、達してなど……あぁあっ！」
ENDIF
RETURN
;----- 6 口内・顔に射精される -----
@汎用口上_6_31(ARG,ARG:1)
IF EXP:ARG:口淫経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んぐっ……口の中に……熱い……っ」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ん……こく……ふ、飲んだぞ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「けほっ……屈辱だ……吐き出すぞ……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「一滴も、残さん……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んんっ……顔に、かかって……」
ENDIF
RETURN
;----- 7 行為を拒む・抵抗する -----
@汎用口上_7_31(ARG,ARG:1)
IF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「離せっ……！　わたしを好きにできると思うな……！」
ELSEIF TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いやだ……っ、こんなこと、認めん……！」
ELSEIF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「恥ずかしくて……こんなの、無理だ……っ」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「頼む……やめて、くれ……」
ENDIF
RETURN
