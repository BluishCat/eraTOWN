;================================================================
; 妊娠・出産まわりの口上（台詞）ディスパッチ
;
; キャラ別口上 @妊娠口上_{状況}_{キャラ番号} があればそれを呼び、
; 無ければ共通口上にフォールバックする。
; ⇒ キャラごとに口上ファイルを追加するだけで、そのキャラ専用の
;    台詞を喋らせられる（既存の COM_MESSAGE_{番号} と同じ流儀）。
;
; 状況ID：
;   1 = 危険日（排卵期）の膣内射精
;   2 = 妊娠中の膣内射精
;   3 = 妊娠発覚（気づいた時）
;   4 = 陣痛開始
;   5 = 出産（娩出直後）
;   6 = 陣痛激化（活動期）
;   7 = いきみ（娩出）
;   8 = 破水
;   9 = 多胎に気づく（驚き）
;  10 = 移行期（陣痛のピーク・いきみ衝動の芽生え）
;  11 = 娩出期（発露・抗えないいきみ感）
;  12 = 着床（ごく稀に妊娠成立の瞬間をかすかに感じる。本人は正体不明のまま）
;  13 = 流産（切迫流産が限界に達し、お腹の子を失う）
;  14 = 陣痛の波・本格化（規則的な波に耐える。約90分間隔で発火）
;  15 = 陣痛の波・活動期（痛み激化・間隔短縮。約60分間隔）
;  16 = 陣痛の波・移行期（途切れない波・いきみ衝動を逃がす。約30分間隔）
;  17 = 陣痛の波・娩出期（抗えないいきみ・児頭下降。約15分間隔）
;  18 = 中絶手術（手術直前の心情。※@妊娠中断の前＝父親情報が残っている状態で呼ばれる）
;  ※14〜17 は @陣痛_進行 が周期的に呼ぶ「波」の反応。フェーズ境界の 6/10/11 とは別。
;    演出を軽く保つためセリフのみ（PRINTFORMW）とし、地の文や FORCEWAIT は使わないこと。
;
; キャラ別口上の書き方（例：状況1・キャラ5）:
;   @妊娠口上_1_5(ARG,ARG:1)
;   ;ARG=本人(母)、ARG:1=相手
;   PRINTFORMW %CALLNAME:ARG%「…このキャラ専用の台詞…」
;   RETURN
;================================================================

;----------------------------------------------------------------
;口上ディスパッチャ
; ARG=状況ID、ARG:1=本人(母)、ARG:2=相手
;----------------------------------------------------------------
@妊娠口上(ARG,ARG:1,ARG:2)
;キャラ別口上を試し、無ければ共通口上へ
CALL 口上_開始
;末尾の番号は CSV番号（NO）。登録番号は家族の増減でズレるので必ず NO で引く
TRYCCALLFORM 妊娠口上_{ARG}_{NO:(ARG:1)}(ARG:1, ARG:2)
CATCH
	CALL 妊娠口上_共通(ARG, ARG:1, ARG:2)
ENDCATCH
;KSTR方式で溜めた候補があれば表示（即時表示方式なら空振り）
CALL 口上_表示
RETURN

;----------------------------------------------------------------
;共通口上（キャラ別が無い場合の既定台詞）
; ARG=状況ID、ARG:1=本人(母)、ARG:2=相手
;----------------------------------------------------------------
@妊娠口上_共通(ARG,ARG:1,ARG:2)
SELECTCASE ARG
	CASE 1
		PRINTFORMW %CALLNAME:(ARG:1)%「今日は、危ない日なのに……こんなに中に出されたら……っ」
	CASE 2
		PRINTFORMW %CALLNAME:(ARG:1)%「妊娠してるのに……お腹の赤ちゃんのそばまで、いっぱい……っ」
	CASE 3
		PRINTFORMW %CALLNAME:(ARG:1)%「まさか……わたし、妊娠したの……？」
	CASE 4
		PRINTFORMW %CALLNAME:(ARG:1)%「……っ、お腹が……! 来る、来ちゃう……!」
	CASE 5
		PRINTFORMW %CALLNAME:(ARG:1)%「はぁ……はぁ……ちゃんと、産めた……」
	CASE 6
		PRINTFORMW %CALLNAME:(ARG:1)%「っ……痛みが、強く……！　間隔も、短く……！」
	CASE 7
		PRINTFORMW %CALLNAME:(ARG:1)%「う、うぅ……っ、いきむ……！」
	CASE 8
		PRINTFORMW %CALLNAME:(ARG:1)%「あ……っ、破水……！　溢れ、出て……！」
	CASE 9
		PRINTFORMW %CALLNAME:(ARG:1)%「え……っ、まだ、お腹に……!?　もう一人、いるの……!?」
	CASE 10
		PRINTFORMW %CALLNAME:(ARG:1)%「んんっ……! 痛みが、切れ目なく……! お腹が、ひとりでに押し出そうと……っ!」
	CASE 11
		PRINTFORMW %CALLNAME:(ARG:1)%「もう、無理……! 出ちゃう、赤ちゃんが……降りてきて……っ!」
	CASE 12
		PRINTFORMW %CALLNAME:(ARG:1)%「ん……？　お腹の奥が、ちくっとしたような……気のせいかな」
	CASE 13
		PRINTFORMW %CALLNAME:(ARG:1)%「うそ……いや……っ、赤ちゃん……! わたしの、赤ちゃんが……!」
	CASE 14
		;陣痛の波・本格化（規則的な波に耐える）
		SELECTCASE RAND(3)
			CASE 0
				PRINTFORMW %CALLNAME:(ARG:1)%「んっ……また、来た……ふー、ふー……」
			CASE 1
				PRINTFORMW %CALLNAME:(ARG:1)%「……っ、波が引いた……今のうちに、息を整えないと……」
			CASEELSE
				PRINTFORMW %CALLNAME:(ARG:1)%「お腹が、ぎゅうって……規則的に、締めつけてくる……」
		ENDSELECT
	CASE 15
		;陣痛の波・活動期（痛み激化・間隔短縮）
		SELECTCASE RAND(3)
			CASE 0
				PRINTFORMW %CALLNAME:(ARG:1)%「い、痛……っ！　さっきより、ずっと強い……！」
			CASE 1
				PRINTFORMW %CALLNAME:(ARG:1)%「はぁっ、はぁっ……休む間が、なくなってきた……！」
			CASEELSE
				PRINTFORMW %CALLNAME:(ARG:1)%「くぅ……っ！　腰まで、痛みが響いて……！」
		ENDSELECT
	CASE 16
		;陣痛の波・移行期（途切れない波・いきみ衝動を逃がす）
		SELECTCASE RAND(3)
			CASE 0
				PRINTFORMW %CALLNAME:(ARG:1)%「んんー……っ！　いきんじゃ、だめ……まだ、だめ……！」
			CASE 1
				PRINTFORMW %CALLNAME:(ARG:1)%「ひっ、ぐ……うぅ……波が、終わらない……！」
			CASEELSE
				PRINTFORMW %CALLNAME:(ARG:1)%「はっ、はっ、はっ……逃がして……この感じ、逃がさないと……！」
		ENDSELECT
	CASE 17
		;陣痛の波・娩出期（抗えないいきみ・児頭下降）
		SELECTCASE RAND(3)
			CASE 0
				PRINTFORMW %CALLNAME:(ARG:1)%「んんんっ……！　勝手に、力が入っちゃう……！」
			CASE 1
				PRINTFORMW %CALLNAME:(ARG:1)%「うー……っ！　降りてくる……下に、押し広げられて……！」
			CASEELSE
				PRINTFORMW %CALLNAME:(ARG:1)%「ふーっ、ふーっ……うぅっ……！　もう、我慢できない……！」
		ENDSELECT
	CASE 18
		;中絶手術（手術直前の心情）
		PRINTFORMW %CALLNAME:(ARG:1)%「……ごめんね。……ごめんなさい……」
ENDSELECT
RETURN

;----------------------------------------------------------------
;中出し時の口上判定（受精判定の前の状態で呼ぶ）
; ARG=母、ARG:1=相手
;----------------------------------------------------------------
@中出し口上判定(ARG,ARG:1)
;女性器を持たない相手は対象外
SIF !GETBIT(TALENT:ARG:性別,0)
	RETURN
IF TALENT:ARG:妊娠
	;妊娠中の膣内射精（自覚して確信している時のみ言及。未確信時は口上なし）
	SIF CFLAG:ARG:妊娠自覚 >= 2
		CALL 妊娠口上(2, ARG, ARG:1)
ELSEIF CFLAG:ARG:避妊 == 0
	;危険日（排卵期）の膣内射精
	SELECTCASE CFLAG:ARG:生理周期
		CASE 12,13,14,15,16
			CALL 妊娠口上(1, ARG, ARG:1)
	ENDSELECT
ENDIF
RETURN
