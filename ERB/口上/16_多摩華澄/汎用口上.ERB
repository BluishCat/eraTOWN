;================================================
; 多摩華澄（キャラ番号 16）の汎用口上
; 状況：1声かけ 2愛撫 3膣挿入 4アナル挿入 5絶頂 6口内/顔射 7抵抗 8甘え 9日常
;================================================

@汎用口上_1_16(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「どうかしましたか？　相談なら、いつでも聞きますよ。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「はい、何かありました？」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「あら、わたしに用事？」
ENDSELECT
RETURN
@汎用口上_8_16(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ふふ、生徒に頼られるのは嬉しいものね。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「あなたは放っておけない子ね。先生として、心配なの。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「たまには、こうして話すのもいいものね。」
ENDSELECT
RETURN
@汎用口上_9_16(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「はぁ……今日の授業、うまく伝わったかしら。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「テストの採点、まだ残ってるのよね……。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「コーヒーでも淹れようかしら。」
ENDSELECT
RETURN

;================================================
; 性的状況の口上（ARG=本人 / ARG:1=相手）※KSTR方式
;================================================
;----- 2 愛撫される -----
@汎用口上_2_16(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んっ……あなたの手つき、優しいのね……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめなさい……教師に、なんてことを……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ふふ……いいわ、好きに触って……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「こら……どこを触っているの……あっ……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「はぁっ……こんなに感じてしまうなんて……教師失格ね……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ないで……大人の身体なんて……恥ずかしいわ……」
ENDIF
RETURN
;----- 3 膣挿入される -----
@汎用口上_3_16(ARG,ARG:1)
IF EXP:ARG:Ｖ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あ……っ、こんな、生徒に……いけないのに……っ」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あなたと、つながって……ああ、いけない先生ね、わたし……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「くっ……こんなことで、屈する、とでも……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いいわ……奥まで、来なさい……先生が、受け止めてあげる……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「だめ……生徒と、こんな……あぁっ……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あぁっ、だめ……理性が……こんなに乱れて……はしたない……！」
ELSEIF PALAM:ARG:潤滑 >= PALAMLV:3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んぁ……こんなに濡らして……大人なのに、恥ずかしい……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……少し、痛むわ……ゆっくりね……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ては、だめ……つながっている所なんて……っ」
ELSEIF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「乱暴にされると……どうして、こんなに……感じてしまうの……」
ENDIF
RETURN
;----- 4 アナル挿入される -----
@汎用口上_4_16(ARG,ARG:1)
IF EXP:ARG:Ａ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「そこは……っ、だめよ、そんな場所……！」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あなたになら……お尻でも、許してあげる……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめなさいっ……そこだけは……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いいわ……お尻も、好きにして……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「こわいわ……壊れて、しまう……ゆっくり……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あぁっ、お尻で感じるなんて……いけない、先生ね……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……いっぱいで……苦しいわ……」
ENDIF
RETURN
;----- 5 絶頂 -----
@汎用口上_5_16(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イく……あなたと一緒に……っ、いけない、けど……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「イかせて……あぁ、生徒の前で、イってしまう……！」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「い、いや……こんな無様に……あぁっ！」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ないで……イく顔なんて……っ」
ELSEIF TALENT:ARG:快感応答 < 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「これは、達してなど……あぁあっ……！」
ENDIF
RETURN
;----- 6 口内・顔に射精される -----
@汎用口上_6_16(ARG,ARG:1)
IF EXP:ARG:口淫経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んぐっ……！　口の中に、こんな……熱いもの……」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ん……こく……ぜんぶ、飲んであげた……ふふ……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「けほっ……なんてこと……吐き出させて……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「一滴も、残さないわ……ごちそうさま……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んんっ……顔に、かかって……どうしましょう……」
ENDIF
RETURN
;----- 7 行為を拒む・抵抗する -----
@汎用口上_7_16(ARG,ARG:1)
IF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「やめなさいっ……！　教師として、許しません……！」
ELSEIF TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いや……っ、生徒と、こんなこと……だめよ……！」
ELSEIF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「は、恥ずかしくて……こんなこと、できないわ……っ」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「お願い……やめて、ちょうだい……」
ENDIF
RETURN
