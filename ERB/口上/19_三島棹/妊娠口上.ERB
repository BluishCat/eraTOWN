		PRINTFORMW %CALLNAME:ARG%「ふぅ……よく頑張ったわ、わたし……」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「あら、可愛い……ふふ。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「はぁ……無事で、なにより。」
ENDSELECT
RETURN
@妊娠口上_6_19(ARG,ARG:1)
