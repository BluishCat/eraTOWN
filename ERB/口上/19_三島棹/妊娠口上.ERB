@妊娠口上_9_19(ARG,ARG:1)
;多胎に気づく（驚き）
TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あら……もう一人……?　双子だったのね」
TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「まだ、いたの……ふふ、驚いたわ」
