@妊娠口上_3_19(ARG,ARG:1)
;妊娠発覚
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「あら……わたし、赤ちゃんができたのね」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「ふふ、こんなわたしが母親になるなんて。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「そう……宿ったのね、この子。」
ENDSELECT
RETURN
@妊娠口上_4_19(ARG,ARG:1)
;陣痛・破水
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「っ……ふぅ、来たわ……もう少しの辛抱ね」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「ん……っ、痛……。落ち着いて、ね……」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「はぁ……もう少しで、会えるのね……っ」
ENDSELECT
RETURN
@妊娠口上_5_19(ARG,ARG:1)
;出産
SELECTCASE RAND(3)
