;================================================
; 零素都乱（キャラ番号 23）の汎用口上
; 状況：1声かけ 2愛撫 3膣挿入 4アナル挿入 5絶頂 6口内/顔射 7抵抗 8甘え 9日常
;================================================

@汎用口上_1_23(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ご用でしょうか、お客様。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「はい、なんなりと。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「お呼びで？」
ENDSELECT
RETURN
@汎用口上_8_23(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「ふふ、光栄です。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「あなたには特別なサービスを。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「またのご利用をお待ちしております。」
ENDSELECT
RETURN
@汎用口上_9_23(ARG,ARG:1)
SELECTCASE RAND(3)
	CASE 0
		PRINTFORMW %CALLNAME:ARG%「テーブルを片付けねば。」
	CASE 1
		PRINTFORMW %CALLNAME:ARG%「今日は忙しいな。」
	CASEELSE
		PRINTFORMW %CALLNAME:ARG%「制服のシワが気になる。」
ENDSELECT
RETURN

;================================================
; 性的状況の口上（男性・受け手時。2/4/5/7のみ）※KSTR方式
;================================================
;----- 2 愛撫される -----
@汎用口上_2_23(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んっ……あなた様の手……悪くありません……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「おやめください……無礼な……っ」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「はい……どうぞ、ご随意に……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「っ……そのような所を……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「くっ……このように乱れるとは……不覚……」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「ご覧に、ならないで……」
ENDIF
RETURN
;----- 4 アナル挿入される -----
@汎用口上_4_23(ARG,ARG:1)
IF EXP:ARG:Ａ性交経験 <= 1
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「そこに、挿れると……！？」
ENDIF
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「あなた様のためなら……この身も……」
ELSEIF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「おやめくださいっ……！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「はい……どうぞ、ご随意に……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「こわい、です……ゆっくり……」
ENDIF
IF GETPALAMLV(PALAM:ARG:欲情, 5)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「うぁっ、感じて、しまう……お許しを……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「んくっ……いっぱいで……」
ENDIF
RETURN
;----- 5 絶頂 -----
@汎用口上_5_23(ARG,ARG:1)
IF LOVE_CHECK(ARG, ARG:1)
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「達します……あなた様と……っ！」
ELSEIF ABL:ARG:従順 >= 3
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「達する許しを……っ！」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「い、いけません……出て……っ！」
ENDIF
IF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「見ないで……」
ELSEIF TALENT:ARG:快感応答 < 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「これは……くっ、あぁっ！」
ENDIF
RETURN
;----- 7 行為を拒む・抵抗する -----
@汎用口上_7_23(ARG,ARG:1)
IF TA:ARG:(ARG:1):6 > 500
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「おやめくださいっ……！　許しません……！」
ELSEIF TALENT:ARG:抵抗
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「いけません……っ、おやめを……！」
ELSEIF TALENT:ARG:羞恥心 > 0
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「く……お恥ずかしい……」
ELSE
	TSTR:(FLAG:口上候補数++) = %CALLNAME:ARG%「どうか、お許しを……」
ENDIF
RETURN
