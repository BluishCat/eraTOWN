@HOUBI1(ARG)
FOR J:101,1,CHARANUM
	SIF J:101 == ARG
		CONTINUE
	SIF NO:(J:101) == 34
		CONTINUE
	IF MONEY:(J:101) > 0
		TA:(J:101):ARG:6 += MONEY:(J:101)
		MONEY:ARG += MONEY:(J:101)
		MONEY:(J:101) = 1000
	ENDIF
NEXT

@HOUBI2()
