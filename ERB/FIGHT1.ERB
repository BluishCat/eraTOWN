@FIGHT1(ARG,ARG:1)
;ARG		攻撃側のキャラクター登録番号
;ARG:1		防御側のキャラクター登録番号
;F:100		呼び出し元が設定する強姦フラグ（1なら強姦時の戦闘）
;
;戻り値	1 … 攻撃側の勝ち
;		2 … 攻撃側の負け（＝防御側の勝ち）
;		3 … プレイヤーが逃走に成功
;
;2026-09-09 ターン制のHP/MP削り合いを廃止し、一発判定に置き換えた。
;援軍（＝縄張りの支配度）の算出だけは旧実装をそのまま引き継いでいる。
;旧実装は FIGHT1.ERB.bak / FIGHT2.ERB.bak を参照。

VARSET LOCAL
VARSET LOCALS

;LOCAL		戦闘場所のNPC人数
;LOCAL:1	攻撃側支配度
;LOCAL:2	防御側支配度
;LOCAL:3	攻撃側援軍
;LOCAL:4	防御側援軍
;LOCAL:5	攻撃側の挑み方（0:腕力 1:知略）
;LOCAL:6	防御側の挑み方（同上）
;LOCAL:7	攻撃側戦力
;LOCAL:8	防御側戦力
;LOCAL:9	攻撃側の勝率（％）
;LOCAL:10	作業用
;LOCAL:11	プレイヤーの選択
;LOCAL:12	逃走失敗フラグ
;LOCAL:13	勝敗（0:攻撃側の勝ち 1:防御側の勝ち）
;LOCAL:14	レベルアップ判定を行うか（プレイヤーが絡む戦闘のみ）

;------------------------------------------------------------------------
;戦闘場所のNPC人数
;（旧実装は N:101 を見ていたが、あれは EVENTCOMEND のループが最後に触った
;  キャラの現在地の人数であって、戦闘場所とは無関係だった）
LOCAL:10 = TIME / 60
RESULT = 0
TRYCALLFORM PLACE_NINZU_{CFLAG:ARG:現在地区}_{CFLAG:ARG:現在位置}(LOCAL:10)
LOCAL = MAX(RESULT,0)

;------------------------------------------------------------------------
;支配度
LOCAL:1 = TB:(CFLAG:ARG:現在地区):(CFLAG:ARG:現在位置):ARG * BASE:ARG:評判 / 1000
LOCAL:2 = TB:(CFLAG:ARG:現在地区):(CFLAG:ARG:現在位置):(ARG:1) * BASE:(ARG:1):評判 / 1000

;援軍の分配（旧実装どおり）
;どちらも支配度0ならどちらにも援軍は来ない
IF LOCAL:1 < 1 && LOCAL:2 < 1
	LOCAL:3 = 0
	LOCAL:4 = 0
;片方だけ支配度があるなら、支配度の分だけ援軍が来る（最大で戦闘場所のNPCの人数まで）
ELSEIF LOCAL:1 < 1
	LOCAL:3 = 0
	LOCAL:4 = LIMIT(LOCAL:2,0,LOCAL)
ELSEIF LOCAL:2 < 1
	LOCAL:4 = 0
	LOCAL:3 = LIMIT(LOCAL:1,0,LOCAL)
;ともに支配度があるなら、戦闘場所にいるNPCを互いの支配度で分配
ELSE
	IF (LOCAL:1 + LOCAL:2) <= LOCAL
		LOCAL:3 = LOCAL:1
		LOCAL:4 = LOCAL:2
	ELSE
;;;小数が存在しないのでわざわざこんなことしてます
		LOCAL:10 = (LOCAL * 100) / (LOCAL:1 + LOCAL:2)
		LOCAL:3 = LOCAL:1 * LOCAL:10 / 100
		LOCAL:4 = LOCAL:2 * LOCAL:10 / 100
	ENDIF
ENDIF

;戦闘場所が大学(地区1)内で、どちらか一方のみが学生の場合、学生側の援軍が5人増える
SIF !TALENT:ARG:160 && TALENT:(ARG:1):160 && CFLAG:ARG:現在地区 == 1
	LOCAL:4 += 5
SIF TALENT:ARG:160 && !TALENT:(ARG:1):160 && CFLAG:ARG:現在地区 == 1
	LOCAL:3 += 5
;強姦時に戦闘すると攻撃側の援軍が半減、防御側の援軍が倍増する
IF F:100
	LOCAL:3 /= 2
	LOCAL:4 *= 2
ENDIF
;防御側がモブ（TALENT:200持ち）の場合、周囲が総出で守る
IF TALENT:(ARG:1):200
	LOCAL:3 = 0
	LOCAL:4 = LOCAL
ENDIF
;Chara040（押小路美麻瑠）なら援軍が100人増える
SIF NO:ARG == 40
	LOCAL:3 += 100
SIF NO:(ARG:1) == 40
	LOCAL:4 += 100

;------------------------------------------------------------------------
;挑み方の決定
;NPCは運動能力より教養が高ければ知略で挑む
LOCAL:5 = 0
SIF ABL:ARG:運動能力 < ABL:ARG:教養
	LOCAL:5 = 1
LOCAL:6 = 0
SIF ABL:(ARG:1):運動能力 < ABL:(ARG:1):教養
	LOCAL:6 = 1

;プレイヤーが絡むなら選択させる
IF ARG == 1 || ARG:1 == 1
	PRINTL
	PRINTFORML %"-" * 60%
	SIF F:100
		PRINTL 強姦ボーナス！（襲われた側に加勢が集まる）
	SIF TALENT:(ARG:1):200
		PRINTL モブさんボーナス！
	SIF NO:ARG == 40 || NO:(ARG:1) == 40
		PRINTL お嬢様ボーナス！
	CALL FIGHT_STATUS(ARG,LOCAL:3)
	CALL FIGHT_STATUS((ARG:1),LOCAL:4)
	PRINTFORML %"-" * 60%
$INPUT_LOOP
	PRINTL [0] - 正面から挑む（戦闘能力・運動能力）
	PRINTL [1] - 口先で挑む（教養・話術技能）
	PRINTL [2] - 逃げる
	PRINTL どうしますか？
	INPUT
	SIF RESULT != 0 && RESULT != 1 && RESULT != 2
		GOTO INPUT_LOOP
	LOCAL:11 = RESULT

	IF LOCAL:11 == 2
		IF RAND(3) == 0
			PRINTW うまく逃げ切った
			RETURN 3
		ENDIF
		PRINTL 逃げられなかった！
		;逃走に失敗した側は体勢を崩している
		LOCAL:12 = 1
	ELSEIF ARG == 1
		LOCAL:5 = LOCAL:11
	ELSE
		LOCAL:6 = LOCAL:11
	ENDIF
ENDIF

;------------------------------------------------------------------------
;戦力の算出
CALL FIGHT_POWER(ARG,LOCAL:5)
LOCAL:7 = RESULT
CALL FIGHT_POWER((ARG:1),LOCAL:6)
LOCAL:8 = RESULT

;援軍差による補正（援軍1人差につき5％、25％〜400％でクランプ）
LOCAL:7 = LOCAL:7 * LIMIT(100 + (LOCAL:3 - LOCAL:4) * 5,25,400) / 100
LOCAL:8 = LOCAL:8 * LIMIT(100 + (LOCAL:4 - LOCAL:3) * 5,25,400) / 100

;先攻（攻撃側）有利
LOCAL:7 = LOCAL:7 * 110 / 100

;逃げ損ねた側は戦力半減
IF LOCAL:12
	IF ARG == 1
		LOCAL:7 /= 2
	ELSE
		LOCAL:8 /= 2
	ENDIF
ENDIF

LOCAL:7 = MAX(LOCAL:7,1)
LOCAL:8 = MAX(LOCAL:8,1)

;------------------------------------------------------------------------
;勝敗判定（上下5％は必ず残すので、格上相手でもワンチャンある）
LOCAL:9 = LIMIT(LOCAL:7 * 100 / (LOCAL:7 + LOCAL:8),5,95)
LOCAL:13 = 0
SIF RAND(100) >= LOCAL:9
	LOCAL:13 = 1

IF ARG == 1 || ARG:1 == 1
	LOCALS = 力ずくで挑んだ
	SIF LOCAL:5
		LOCALS = 口先で挑んだ
	LOCALS:1 = 力ずくで応じた
	SIF LOCAL:6
		LOCALS:1 = 口先で応じた
	PRINTFORMW %CALLNAME:ARG%は%LOCALS%。%CALLNAME:(ARG:1)%は%LOCALS:1%
ENDIF

;敗者は消耗する（旧実装どおり気力を優先して削る）
IF LOCAL:13 == 0
	IF BASE:(ARG:1):気力 > 300
		DOWNBASE:(ARG:1):気力 += 300
	ELSE
		DOWNBASE:(ARG:1):体力 += 300
	ENDIF
ELSE
	IF BASE:ARG:気力 > 300
		DOWNBASE:ARG:気力 += 300
	ELSE
		DOWNBASE:ARG:体力 += 300
	ENDIF
ENDIF

;戦って強くなる（腕力なら戦闘経験、知略なら会話経験）
;SOURCE_ABLUPはレベルアップをPRINTFORMWで知らせる＝キー待ちが入るので、
;プレイヤーの見ていないNPC同士の戦闘では判定まで行わない。
;経験値自体は貯まるので、そのNPCが次に雑談したときなどにまとめて上がる。
LOCAL:14 = 0
SIF ARG == 1 || ARG:1 == 1
	LOCAL:14 = 1
CALL FIGHT_EXP(ARG,LOCAL:5,(LOCAL:13 == 0),LOCAL:14)
CALL FIGHT_EXP((ARG:1),LOCAL:6,(LOCAL:13 == 1),LOCAL:14)

SIF LOCAL:13
	RETURN 2
RETURN 1


;------------------------------------------------------------------------
@FIGHT_STATUS(ARG,ARG:1)
;ARG		キャラクター登録番号
;ARG:1		援軍の人数
PRINTFORM %CALLNAME:ARG,14%
PRINTFORM  戦闘Lv{ABL:ARG:戦闘能力} 運動Lv{ABL:ARG:運動能力}
PRINTFORM 　教養Lv{ABL:ARG:教養} 話術Lv{ABL:ARG:話術技能}
PRINTFORML 　援軍{ARG:1,4}人
RETURN 1


;------------------------------------------------------------------------
@FIGHT_POWER(ARG,ARG:1)
;ARG		キャラクター登録番号
;ARG:1		挑み方（0:腕力 1:知略）
;戻り値		戦力
VARSET LOCAL
IF ARG:1
	LOCAL = 20 + MAXBASE:ARG:気力 / 100 + ABL:ARG:教養 * 25 + ABL:ARG:話術技能 * 15
ELSE
	LOCAL = 20 + MAXBASE:ARG:体力 / 100 + ABL:ARG:戦闘能力 * 25 + ABL:ARG:運動能力 * 15
ENDIF
;消耗補正（体力満タンで等倍、瀕死で半減）
LOCAL:1 = 100
SIF MAXBASE:ARG:体力 > 0
	LOCAL:1 = 50 + LIMIT(BASE:ARG:体力,0,MAXBASE:ARG:体力) * 50 / MAXBASE:ARG:体力
LOCAL = LOCAL * LOCAL:1 / 100
RETURN MAX(LOCAL,1)


;------------------------------------------------------------------------
@FIGHT_EXP(ARG,ARG:1,ARG:2,ARG:3)
;ARG		キャラクター登録番号
;ARG:1		挑み方（0:腕力 1:知略）
;ARG:2		勝ったなら1
;ARG:3		レベルアップ判定を行うなら1（キー待ちが入るのでプレイヤーが絡む戦闘のみ）
VARSET LOCAL
LOCAL = 1
SIF ARG:2
	LOCAL = 3
IF ARG:1
	EXP:ARG:会話経験 += LOCAL
ELSE
	EXP:ARG:戦闘経験 += LOCAL
ENDIF
SIF ARG:3
	CALL SOURCE_ABLUP(ARG)
RETURN 1
