;================================================================
; 警察署（地区0・位置13 ／ 地区2・位置11。2026-08-30追加）
;  それまで両署は名前だけの場所で、中で何もできなかった。
;  既にあった痴漢(EVENT_1)・襲撃(COMF1021)・強姦(COMF2700)・覗き(EVENT_覗き)の
;  受け皿として、被害者側と加害者側の両方から使えるようにする。
;
;  ・両署とも24時間開いている（営業時間.ERB）。
;  ・窓口の用件は1日1件（TCVAR:MASTER:当日警察利用済。BEGIN TRAINで自動クリア）。
;  ・被害届 … 直近に自分へ痴漢・暴行をした相手を届け出る。受理されると相手は
;              数日拘留され（CFLAG:拘留日数）、その間は街に出てこない。
;  ・出頭   … 溜まった容疑(FLAG:容疑)を自分から清算する。罰金も評判の傷も軽く済む。
;  ・容疑は「人目のある場所」での加害でだけ溜まり（@人目のある場所か）、毎朝少し抜ける。
;    閾値を超えた状態で街を歩くと職務質問(@職務質問チェック)→逮捕。
;  ・逮捕は罰金＋評判低下＋前科＋翌朝まで留置場。留置は「寝る」(COMF1004)と同じ状態を
;    作って一日を畳む＝FLAG:就寝位置で翌朝その場（署）で目覚める。
;    目覚めの地の文は EVENTTRAIN が FLAG:留置中 を見て出す（流産後入院79と同型）。
;
;  使用フラグ:
;    FLAG:容疑 / FLAG:前科 / FLAG:留置中（flag.csv 82-84）
;    CFLAG:拘留日数 / 加害相手 / 加害種別 / 加害日（cflag.csv 224-227）
;    TCVAR:当日警察利用済（TCVAR.csv 646）
;================================================================

;================================================================
;@警察署か(ARG,ARG:1)
;  ARG 地区 / ARG:1 位置。RETURN 1=警察署
;  住宅街(0,13)と繁華街(2,11)の2署。大学(地区1)に署は無い。
;================================================================
@警察署か(ARG,ARG:1)
#FUNCTION
SELECTCASE ARG
	CASE 0
		SIF ARG:1 == 13
			RETURNF 1
	CASE 2
		SIF ARG:1 == 11
			RETURNF 1
ENDSELECT
RETURNF 0

;================================================================
;@人目のある場所か(ARG,ARG:1)
;  ARG 地区 / ARG:1 位置。RETURN 1=誰かに見られうる場所
;  ここが0の場所（密室）での加害は容疑にならない＝表沙汰にならない、という扱い。
;  自宅は場所が可変なので呼び出し側が @IS_MASTER_HOME で別途弾くこと（@浴場かと同じ思想）。
;================================================================
@人目のある場所か(ARG,ARG:1)
#FUNCTION
SELECTCASE ARG
	CASE 0
		;実家 / ＮＰＣの家 / アパートの号室(31-38) / マンションの号室(41-60)
		SIF ARG:1 == 1 || ARG:1 == 30 || (ARG:1 >= 31 && ARG:1 <= 38) || (ARG:1 >= 41 && ARG:1 <= 60)
			RETURNF 0
	CASE 1
		;用具倉庫（人が寄りつかない）
		SIF ARG:1 == 17
			RETURNF 0
	CASE 2
		;ラブホテル / 寮 / 高級マンションの号室(31-50)
		SIF ARG:1 == 22 || ARG:1 == 26 || (ARG:1 >= 31 && ARG:1 <= 50)
			RETURNF 0
ENDSELECT
RETURNF 1

;================================================================
;@容疑水準
;  これ以上溜まると職務質問で捕まりうる、という境目（#FUNCTION）。
;  前科があるほど目を付けられていて、少ない容疑でも引っ張られる。
;================================================================
@容疑水準
#FUNCTION
RETURNF MAX(100 - FLAG:前科 * 20, 40)

;================================================================
;@容疑加算(ARG)
;  ARG = 加算する容疑。人目のある場所での加害でのみ呼ぶこと。
;  自宅・密室は @人目のある場所か が0を返すので何も起きない。
;  呼び出し元: COMF2700-強姦する / EVENT_覗き
;================================================================
@容疑加算(ARG)
SIF IS_MASTER_HOME()
	RETURN
SIF !人目のある場所か(CFLAG:MASTER:現在地区, CFLAG:MASTER:現在位置)
	RETURN
FLAG:容疑 += ARG
RETURN

;================================================================
;@被害を記録(ARG,ARG:1)
;  ARG = 加害者の登録番号 / ARG:1 = 1痴漢 2暴行・強姦 3覗き
;  被害届(@警察_被害届)で出せるように、直近の一件だけを覚えておく。
;  上書き式＝新しい被害があれば古い方は流れる。
;  呼び出し元: EVENT_1(電車痴漢の終了処理) / EVENT_覗き(通報を選んだ時)
;================================================================
@被害を記録(ARG,ARG:1)
SIF ARG <= 0 || ARG == MASTER
	RETURN
CFLAG:MASTER:加害相手 = ARG
CFLAG:MASTER:加害種別 = ARG:1
CFLAG:MASTER:加害日 = DAY
RETURN

;================================================================
;@罰金額(ARG)
;  ARG = 1なら出頭（情状酌量で半額）。#FUNCTION
;  前科を重ねるほど重くなる。
;================================================================
@罰金額(ARG)
#FUNCTION
#DIM 額
額 = 30000 + FLAG:前科 * 20000
SIF ARG
	額 = 額 / 2
RETURNF 額

;================================================================
;@拘留位置へ(ARG)
;  拘留中のNPCを住宅街の署(0,13)へ置き、移動の予約を消す。
;  拘留先を1箇所に固定しているのは、面会に行ける場所を分からなくしないため。
;================================================================
@拘留位置へ(ARG)
CFLAG:ARG:現在地区 = 0
CFLAG:ARG:現在位置 = 13
CFLAG:ARG:乗車 = 0
CFLAG:ARG:到着地区 = 0
CFLAG:ARG:到着位置 = 0
TCVAR:ARG:目的地区 = 0
TCVAR:ARG:目的位置 = 0
TCVAR:ARG:同行 = 0
RETURN

;================================================================
;@逮捕(ARG)
;  ARG = 0職務質問（容疑の累積）／ 1出頭（自分から窓口へ）
;  罰金・評判低下・前科を科し、職務質問の場合は翌朝まで留置場に入れる。
;================================================================
@逮捕(ARG)
#DIM 出頭
#DIM 罰金
#DIM 不足
出頭 = ARG
罰金 = 罰金額(出頭)

PRINTL
IF 出頭
	PRINTL あなたは自分から窓口に立ち、これまでのことを話した。
	PRINTL 「……自分から来たんだな」
	PRINTW 調書を取る警官の口調は、思っていたよりずっと静かだった。
ELSE
	PRINTL 任意同行を求められ、あなたは署へ連れて行かれた。
	PRINTL 取調室の椅子は硬く、蛍光灯はやけに明るかった。
	PRINTW 同じことを何度も聞かれ、答えるたびに調書のページがめくられていく。
ENDIF

;罰金。払いきれない分は分納の約束になり、信用がさらに落ちる
不足 = MAX(罰金 - MONEY:MASTER, 0)
MONEY:MASTER = MAX(MONEY:MASTER - 罰金, 0)
PRINTL
PRINTFORML 罰金は%金額(罰金)%円。
IF 不足 > 0
	PRINTFORMW 手持ちでは%金額(不足)%円が足りず、分納の約束をさせられた。……信用はさらに落ちた。
	BASE:MASTER:評判 = MAX(BASE:MASTER:評判 - 50, 0)
ELSE
	PRINTW 財布から抜けた額を見て、ようやく実感が湧いてきた。
ENDIF

IF 出頭
	BASE:MASTER:評判 = MAX(BASE:MASTER:評判 - 30, 0)
ELSE
	BASE:MASTER:評判 = MAX(BASE:MASTER:評判 - 150, 0)
ENDIF
FLAG:前科 += 1
FLAG:容疑 = 0

;出頭は事情聴取だけで帰される
IF 出頭
	CFLAG:MASTER:待機時間 += 120
	PRINTL
	PRINTW 解放される頃には、二時間が過ぎていた。
	RETURN
ENDIF

;職務質問からの逮捕は翌朝まで留置場。
;「寝る」(COMF1004)と同じ状態を作り、TIMEを1440へ送って EVENTCOMEND に一日を畳ませる。
;翌朝は FLAG:就寝位置 により署で目覚め、地の文は EVENTTRAIN が FLAG:留置中 で出す。
FLAG:留置中 = 1
IF CFLAG:MASTER:現在地区 == 0
	CFLAG:MASTER:現在地区 = 0
	CFLAG:MASTER:現在位置 = 13
ELSE
	CFLAG:MASTER:現在地区 = 2
	CFLAG:MASTER:現在位置 = 11
ENDIF
FLAG:就寝地区 = CFLAG:MASTER:現在地区
FLAG:就寝位置 = CFLAG:MASTER:現在位置
CFLAG:MASTER:乗車 = 0
CFLAG:MASTER:到着地区 = 0
CFLAG:MASTER:到着位置 = 0
CFLAG:MASTER:待機時間 = 0
;連行された時点で、歩きかけていた行き先は消える（EVENTCOMENDに歩き直させない）
TCVAR:MASTER:目的地区 = 0
TCVAR:MASTER:目的位置 = 0
TCVAR:MASTER:直接移動中 = 0
TCVAR:MASTER:直接移動目的地区 = 0
TCVAR:MASTER:直接移動目的位置 = 0
CFLAG:MASTER:睡眠 = 1
CFLAG:MASTER:主睡眠 = 1
PRINTL
PRINTW その日はもう、どこへも行けなかった。
SIF TIME < 1440
	CALL TIME_COUNT(1440 - TIME)
RETURN

;================================================================
;@職務質問チェック
;  容疑が溜まった状態で人目のある場所に出ると呼び止められる。
;  RETURN 1 = 連行された（呼び出し側は以降の到着フックを打ち切ること）
;  呼び出し元: ROOM_IN_OUT.ERB @到着時処理（＝移動して着いた時だけ）
;================================================================
@職務質問チェック
SIF FLAG:留置中 || TCVAR:MASTER:イベント || CFLAG:MASTER:睡眠 || CFLAG:MASTER:衰弱 || CFLAG:MASTER:乗車
	RETURN 0
SIF FLAG:容疑 < 容疑水準()
	RETURN 0
SIF IS_MASTER_HOME() || !人目のある場所か(CFLAG:MASTER:現在地区, CFLAG:MASTER:現在位置)
	RETURN 0
;署そのものに入った時は @警察署受付 が受け持つ
SIF 警察署か(CFLAG:MASTER:現在地区, CFLAG:MASTER:現在位置)
	RETURN 0
;容疑が高いほど声を掛けられやすい（容疑400で必ず）
SIF RAND(400) >= FLAG:容疑
	RETURN 0
PRINTL
PRINTFORML %"=" * 107%
PRINTL 「すみません、少しよろしいですか」
PRINTW 巡回中の警官に呼び止められた。手元の紙と、あなたの顔を見比べている。
CALL 逮捕(0)
RETURN 1

;================================================================
;@警察署受付
;  警察署(0,13 / 2,11)到着時のフック（ROOM_IN_OUT.ERB @到着時処理から呼ばれる）。
;  容疑が溜まりきっていれば、入った時点で見咎められる。
;================================================================
@警察署受付
SIF !警察署か(CFLAG:MASTER:現在地区, CFLAG:MASTER:現在位置)
	RETURN
;イベント文脈からの到着では何もしない（通常コマンド文脈のみ。@質屋受付と同じ）
SIF TCVAR:MASTER:イベント || FLAG:留置中
	RETURN
PRINTL
PRINTFORML %"=" * 107%
PRINTL 自動ドアの向こうは蛍光灯が白く、受付の奥で電話の鳴る音がしていた。
;容疑が溜まりきった状態でのこのこ入ってくれば当然そうなる
IF FLAG:容疑 >= 容疑水準()
	PRINTL 受付の警官があなたの顔を見て、わずかに表情を変えた。
	PRINTW 「……少しお話を伺えますか」
	CALL 逮捕(0)
	RETURN
ENDIF
CALL 警察署メニュー
RETURN

;================================================================
;@警察署メニュー
;  用件が済むか帰るまで選び続ける（@質屋メニューと同型）。
;================================================================
@警察署メニュー
$KEISATSU_MENU_INPUT
PRINTL
PRINTFORML ＜警察署／{TIME / 60}時{TIME % 60}分／所持金%金額(MONEY:MASTER)%円＞
;--- 被害届
IF TCVAR:MASTER:当日警察利用済
	SETCOLOR 96 , 96, 96
	PRINTL 　　　被害届を出す（今日はもう窓口の用は済ませた）
	RESETCOLOR
ELSEIF 被害届を出せるか()
	PRINTFORML [0] - 被害届を出す（%CALLNAME:(CFLAG:MASTER:加害相手)%の件）
ELSE
	SETCOLOR 96 , 96, 96
	PRINTL 　　　被害届を出す（届け出るような目には遭っていない）
	RESETCOLOR
ENDIF
;--- 出頭
IF TCVAR:MASTER:当日警察利用済
	SETCOLOR 96 , 96, 96
	PRINTL 　　　自分のことを話す（今日はもう窓口の用は済ませた）
	RESETCOLOR
ELSEIF FLAG:容疑 > 0
	PRINTFORML [1] - 自分のことを話す（罰金%金額(罰金額(1))%円。黙っているより軽く済む）
ELSE
	SETCOLOR 96 , 96, 96
	PRINTL 　　　自分のことを話す（後ろ暗いことは何もない）
	RESETCOLOR
ENDIF
PRINTL [2] - 署を出る
INPUT
SIF RESULT < 0 || RESULT > 2
	GOTO KEISATSU_MENU_INPUT
SIF RESULT == 0 && (TCVAR:MASTER:当日警察利用済 || !被害届を出せるか())
	GOTO KEISATSU_MENU_INPUT
SIF RESULT == 1 && (TCVAR:MASTER:当日警察利用済 || FLAG:容疑 <= 0)
	GOTO KEISATSU_MENU_INPUT
SELECTCASE RESULT
	CASE 0
		CALL 警察_被害届
	CASE 1
		TCVAR:MASTER:当日警察利用済 = 1
		CALL 逮捕(1)
		RETURN
	CASEELSE
		PRINTFORMW 受付の警官は書きかけの書類に目を戻した。
		RETURN
ENDSELECT
GOTO KEISATSU_MENU_INPUT

;================================================================
;@被害届を出せるか
;  直近の被害が「相手が特定できていて」「3日以内」なら届け出られる（#FUNCTION）。
;  日が経ちすぎた話は取り合ってもらえない。
;================================================================
@被害届を出せるか
#FUNCTION
SIF CFLAG:MASTER:加害相手 <= 0
	RETURNF 0
SIF !CFLAG:MASTER:加害種別
	RETURNF 0
;既に拘留されている相手を重ねて届け出ることはできない
SIF CFLAG:(CFLAG:MASTER:加害相手):拘留日数 > 0
	RETURNF 0
SIF DAY - CFLAG:MASTER:加害日 > 3
	RETURNF 0
RETURNF 1

;================================================================
;@警察_被害届
;  受理されると相手は数日拘留される。証言の通りやすさは評判次第。
;  受理されなかった場合も届けは流れる（同じ件で粘れない）。
;================================================================
@警察_被害届
#DIM 相手
#DIM 種別
#DIM 日数
相手 = CFLAG:MASTER:加害相手
種別 = CFLAG:MASTER:加害種別
TCVAR:MASTER:当日警察利用済 = 1

PRINTL
SELECTCASE 種別
	CASE 2
		PRINTFORML %CALLNAME:相手%にされたことを、順を追って話した。
	CASE 3
		PRINTFORML %CALLNAME:相手%に覗かれたことを、順を追って話した。
	CASEELSE
		PRINTFORML %CALLNAME:相手%に触られたことを、順を追って話した。
ENDSELECT
PRINTW 警官は相槌を打ちながら、細かいところを何度も聞き返してきた。

;届けは一度話した時点で流れる（受理・不受理にかかわらず蒸し返せない）
CFLAG:MASTER:加害相手 = 0
CFLAG:MASTER:加害種別 = 0
CFLAG:MASTER:加害日 = 0

;評判が高いほど証言が通る。評判400以上なら確実
IF BASE:MASTER:評判 / 2 + RAND(300) < 200
	PRINTL
	PRINTL 「……お話は伺いました。ただ、これだけでは動けないんです」
	PRINTW 調書の写しを渡され、あなたは署を出た。何も変わらなかった。
	CFLAG:MASTER:待機時間 += 60
	RETURN
ENDIF

;受理。罪の重さで留め置かれる長さが変わる
SELECTCASE 種別
	CASE 2
		日数 = 7
	CASE 3
		日数 = 2
	CASEELSE
		日数 = 3
ENDSELECT
CFLAG:相手:拘留日数 = 日数
CALL 拘留位置へ(相手)
BASE:相手:評判 = MAX(BASE:相手:評判 - 200, 0)
;届け出られた側は当然あなたを恨む
TA:相手:MASTER:6 += 300
TA:相手:MASTER:3 = MAX(TA:相手:MASTER:3 - 200, 0)
CFLAG:MASTER:待機時間 += 90

PRINTL
PRINTL 「……分かりました。こちらで預からせてもらいます」
PRINTFORMW %CALLNAME:相手%はしばらく戻ってこないだろう、と警官は言った。
RETURN

;================================================================
;@警察_日次
;  毎朝の後始末（EVENTTRAIN から、全員の位置を開始位置へ戻した後で呼ぶこと）。
;   ・容疑は日が経てば薄れる
;   ・拘留の残り日数を減らし、明けていない者は署へ置き直す
;================================================================
@警察_日次
VARSET LOCAL
FLAG:容疑 = MAX(FLAG:容疑 - 10, 0)
FOR LOCAL,1,CHARANUM
	SIF LOCAL == MASTER || CFLAG:LOCAL:拘留日数 <= 0
		CONTINUE
	CFLAG:LOCAL:拘留日数 -= 1
	;まだ明けていない者は開始位置ではなく署にいる
	SIF CFLAG:LOCAL:拘留日数 > 0
		CALL 拘留位置へ(LOCAL)
NEXT
VARSET LOCAL
RETURN
