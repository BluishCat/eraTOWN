;================================================================
; 劇場（地区2・位置52、裏通り接続。2026-07-21追加）
;  ・営業18時〜翌1時（営業時間.ERB）。閉店中はCOMF1000の移動ガードで入店不可。
;  ・スタッフ＝Chara061「剣崎 悟」（支配人・受付兼面接兼バイト店主振り替え先）
;              Chara062「舞園 玲奈」（看板ダンサー・ステージ出演／観客参加Hの相手）
;  ・演目は7種。出演者は@劇場演目選択で自分で選ぶ（2026-07-21 選択制に変更）。
;      1 ダンスショー     (ランク1) 常時
;      2 ポールダンス     (ランク1) 要ダンス技能LV2
;      3 ペアダンス       (ランク1) 要ダンス技能LV3＋共演者が在室
;      4 ストリップショー (ランク2) 要露出癖LV1 or ダンス経験20
;      5 過激ショー       (ランク3) 要露出癖LV2＋欲望LV2（自慰ショー・本番なし）
;      6 観客参加ショー   (ランク3) 要非処女＋過激ショー出演経験＋客(Chara059)登録
;      7 出産ショー       (ランク3) 要臨月。舞台上でそのまま分娩する。
;                                   陣痛の誘発は「陣痛促進剤」か「お迎え棒」を舞台で選ぶ
;    時間帯は「その時刻に上演できる過激度ランクの上限」として残る（@劇場演目）。
;      18〜21時=ランク1まで / 21〜23時=ランク2まで / 23時〜翌1時=ランク3まで
;  ・観覧（客側）: 観覧料先払い→興奮上昇・ストレス減。ステージ上の演目は時間帯ランクのまま
;    （NPCが演じるものなので選択不可）。ランク3は観客参加でH接続。
;  ・出演（演者側）: 身分ダンサー(COMF1057)とバイト職業18の両経路が
;    @劇場ショー抽選（XCOM段階で演目選択＋SOURCE仕込み）＋@劇場ショー実行（COM_MESSAGE段階で描写）を共有する。
;    演目選択の[0]「やめる」は身分ダンサー側だけに出す（バイトは勤務なので取りやめられない）。
;  ・飛び込み体験: 条件を満たすと受付で勧誘。客はChara059「お客さん」を流用。
;    報酬・評判・累計はH前に処理する先払い規約（ソープランド.ERBと同様）。
;  ・使用フラグ: TCVAR:634 劇場体験済（当日1回制限。BEGIN TRAINで自動クリア）
;                CFLAG:3507 過激ショー出演回数（累計・永続。CSV未登録の生番号運用。演目5・6・7と体験段階3で加算）
;                CFLAG:3508 劇場観客参加回数（累計・永続。同上）
;                M:105 ショー成否ランク0〜3 / M:106 演目1〜7（XCOM→COM_MESSAGE受け渡し）
;  ・Hシーン本体は@ソープH_おまかせ（ソープランド.ERB、XCOM2820＋SOURCE_CHECKS）を流用。
;================================================================

;================================================================
;@劇場演目
;  現在時刻(TIME)から、その時刻に上演できる過激度ランクの上限を返す #FUNCTION。
;  1=ダンス帯 / 2=ストリップ帯 / 3=過激帯。観覧側（NPCのステージ）の演目でもある。
;================================================================
@劇場演目
#FUNCTION
;23時〜翌1時（1380以上 or 60未満）は過激ショーまで
SIF TIME >= 1380 || TIME < 60
	RETURNF 3
;21時〜23時はストリップショーまで
SIF TIME >= 1260
	RETURNF 2
;それ以外（開演18時〜21時）はダンス系まで
RETURNF 1

;================================================================
;@劇場演目_名(ARG)
;  演目ID(1〜7)の表示名を返す #FUNCTIONS。
;================================================================
@劇場演目_名(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		RETURNF "ダンスショー"
	CASE 2
		RETURNF "ポールダンス"
	CASE 3
		RETURNF "ペアダンス"
	CASE 4
		RETURNF "ストリップショー"
	CASE 5
		RETURNF "過激ショー"
	CASE 6
		RETURNF "観客参加ショー"
	CASE 7
		RETURNF "出産ショー"
	CASEELSE
		RETURNF ""
ENDSELECT

;================================================================
;@劇場演目_ランク(ARG)
;  演目ID(1〜7)の過激度ランク(1〜3)を返す #FUNCTION。@劇場演目()の戻り値と同じ尺度。
;================================================================
@劇場演目_ランク(ARG)
#FUNCTION
SIF ARG >= 5
	RETURNF 3
SIF ARG == 4
	RETURNF 2
RETURNF 1

;================================================================
;@劇場演目_報酬倍率(ARG)
;  演目ID(1〜7)の報酬倍率(%)を返す #FUNCTION。基本給・チップの双方に掛ける。
;================================================================
@劇場演目_報酬倍率(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 2
		RETURNF 130
	CASE 3, 4
		RETURNF 150
	CASE 5
		RETURNF 200
	CASE 6
		RETURNF 250
	CASE 7
		RETURNF 300
	CASEELSE
		RETURNF 100
ENDSELECT

;================================================================
;@劇場演目_解禁(ARG)
;  演目ID(1〜7)が能力・経験などの条件を満たしているか(1/0)を返す #FUNCTION。
;  時間帯（過激度ランクの上限）はここには含めない＝@劇場演目()と併せて判定する。
;================================================================
@劇場演目_解禁(ARG)
#FUNCTION
SELECTCASE ARG
	;ポールダンス：ダンス技能LV2以上
	CASE 2
		RETURNF (ABL:MASTER:ダンス技能 >= 2)
	;ペアダンス：ダンス技能LV3以上＋共演者（劇場に居るNPCダンサー／看板ダンサー）
	CASE 3
		RETURNF (ABL:MASTER:ダンス技能 >= 3 && 劇場ステージダンサー() != -1)
	;ストリップ：露出癖LV1以上 または ダンス経験20以上
	CASE 4
		RETURNF (ABL:MASTER:露出癖 >= 1 || EXP:MASTER:ダンス経験 >= 20)
	;過激（自慰ショー）：露出癖LV2以上＋欲望LV2以上
	CASE 5
		RETURNF (ABL:MASTER:露出癖 >= 2 && ABL:MASTER:欲望 >= 2)
	;観客参加（本番）：非処女＋過激ショー出演経験＋客(Chara059)登録済
	CASE 6
		RETURNF (!TALENT:MASTER:処女 && CFLAG:MASTER:3507 >= 1 && GETCHARA(59) != -1)
	;出産ショー：臨月（PREGNANCY.ERB）。多胎の小休止中＝分娩の途中は受けられない
	CASE 7
		RETURNF (臨月(MASTER) && !分娩中(MASTER))
ENDSELECT
;ダンスショーは常時
RETURNF 1

;================================================================
;@劇場演目_条件文(ARG)
;  未解禁の演目に添える条件テキストを返す #FUNCTIONS。
;================================================================
@劇場演目_条件文(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 2
		RETURNF "要：ダンス技能ＬＶ２"
	CASE 3
		RETURNF "要：ダンス技能ＬＶ３・共演者"
	CASE 4
		RETURNF "要：露出癖ＬＶ１ もしくは ダンス経験を積む"
	CASE 5
		RETURNF "要：露出癖ＬＶ２・欲望ＬＶ２"
	CASE 6
		SIF TALENT:MASTER:処女
			RETURNF "要：処女を捨てる"
		SIF GETCHARA(59) == -1
			RETURNF "要：飛び入りの客"
		RETURNF "要：過激ショーの出演経験"
	CASE 7
		RETURNF "要：臨月"
	CASEELSE
		RETURNF ""
ENDSELECT

;================================================================
;@劇場演目選択(ARG)
;  出演する演目をプレイヤーに選ばせる（戻り値RESULT＝演目ID 1〜7）。
;  未解禁・時間帯外の演目も灰色で並べて目標を示す（COMMON.ERBの移動不可表示と同配色）。
;  XCOM段階（＝@劇場ショー抽選の冒頭）で呼ぶ。
;  ARG=1 で[0]「やめる」を出し、選ばれたら0を返す（＝出演の取りやめ）。
;  ARG=0（バイト経路）は勤務そのものなのでキャンセル不可（演目1は常時選べる）。
;  ※INPUTを使うため式中関数(#FUNCTION)にはできない。CALLで呼ぶこと。
;================================================================
@劇場演目選択(ARG)
#DIM 上限
#DIM 可否
上限 = 劇場演目()
PRINTL
PRINTL 今夜は何を演りますか？
FOR LOCAL, 1, 8
	;解禁済みかつ時間帯の過激度上限以内なら選択可
	可否 = 劇場演目_解禁(LOCAL) && 劇場演目_ランク(LOCAL) <= 上限
	IF 可否
		PRINTFORML [{LOCAL}] - %劇場演目_名(LOCAL)%
	ELSE
		SETCOLOR 96 , 96, 96
		IF 劇場演目_ランク(LOCAL) > 上限
			PRINTFORML 　　　%劇場演目_名(LOCAL)%（この時間帯では上演できない）
		ELSE
			PRINTFORML 　　　%劇場演目_名(LOCAL)%（%劇場演目_条件文(LOCAL)%）
		ENDIF
		RESETCOLOR
	ENDIF
NEXT
IF ARG
	PRINTL [0] - やめる（今夜は舞台に立たない）
ENDIF
$THEATER_ENMOKU_INPUT
INPUT
;キャンセル可のときだけ[0]を受け付ける（戻り値0＝出演の取りやめ）
SIF ARG && RESULT == 0
	RETURN 0
SIF RESULT < 1 || RESULT > 7
	GOTO THEATER_ENMOKU_INPUT
SIF !劇場演目_解禁(RESULT) || 劇場演目_ランク(RESULT) > 上限
	GOTO THEATER_ENMOKU_INPUT
RETURN RESULT

;================================================================
;@劇場出産誘発選択(ARG, ARG:1)
;  出産ショー（演目7）で陣痛をどう誘発するかを選ばせる。
;  戻り値(RESULT): 1=陣痛促進剤 / 2=お迎え棒
;  ARG = 出演者、ARG:1 = お迎え棒の相手（客Chara059。-1なら選べない）。
;  促進剤は劇場が用意するので所持品は要らない＝キャンセルは無し（1は常時選べる）。
;  ※INPUTを使うため式中関数(#FUNCTION)にはできない。CALLで呼ぶこと。
;================================================================
@劇場出産誘発選択(ARG, ARG:1)
#DIM 相手
相手 = ARG:1
PRINTL
PRINTL 支配人が袖から顔を出した。「……で、どうやって始めます？」
PRINTL [1] - 陣痛促進剤（劇場が用意する。効きは速いが体への負担が大きい）
IF 相手 != -1
	PRINTFORML [2] - お迎え棒（%CALLNAME:相手%を舞台へ招き、性交で陣痛を誘う）
ELSE
	SETCOLOR 96 , 96, 96
	PRINTL 　　　お迎え棒（相手になる客がいない）
	RESETCOLOR
ENDIF
$THEATER_YUUHATSU_INPUT
INPUT
SIF RESULT == 1
	RETURN 1
SIF RESULT == 2 && 相手 != -1
	RETURN 2
GOTO THEATER_YUUHATSU_INPUT

;================================================================
;@劇場ステージダンサー
;  ステージに立つダンサーを返す #FUNCTION。
;  勤務中のNPCダンサー（職業18・(2,52)在室・MASTER以外）を優先、いなければ看板ダンサー(62)、
;  それも未登録なら-1（休演）。
;================================================================
@劇場ステージダンサー
#FUNCTION
LOCAL:1 = -1
FOR LOCAL, 0, CHARANUM
	SIF LOCAL == MASTER
		CONTINUE
	IF CFLAG:LOCAL:職業 == 18 && CFLAG:LOCAL:現在地区 == 2 && CFLAG:LOCAL:現在位置 == 52
		LOCAL:1 = LOCAL
		BREAK
	ENDIF
NEXT
SIF LOCAL:1 != -1
	RETURNF LOCAL:1
RETURNF GETCHARA(62)

;================================================================
;@劇場受付
;  劇場(2,52)到着時の受付フック（ROOM_IN_OUT.ERB @到着時処理から呼ばれる）。
;================================================================
@劇場受付
#DIM 支配人
SIF CFLAG:MASTER:現在地区 != 2 || CFLAG:MASTER:現在位置 != 52
	RETURN
;イベント文脈からの到着では何もしない（通常コマンド文脈のみ）
SIF TCVAR:MASTER:イベント
	RETURN
支配人 = GETCHARA(61)
SIF 支配人 == -1
	RETURN
;従業員（身分ダンサー=仕事10 or バイトダンサー=職業18）は客用受付・体験勧誘を出さない
;（勤務は身分＝COMF1057「ステージに立つ」／バイト＝COMF1005「アルバイト」から）
IF CFLAG:MASTER:仕事 == 10 || CFLAG:MASTER:職業 == 18
	PRINTFORML 楽屋に入ると、支配人の%CALLNAME:支配人%が「今日も客席は埋まってるぞ。……頼んだよ」と声をかけてきた。
	RETURN
ENDIF
;飛び込みステージ体験の勧誘判定（成立したら受付メニューはスキップ）
CALL 劇場体験勧誘
SIF RESULT
	RETURN
;----------------------------------------------------------------
;通常受付（観覧）
;----------------------------------------------------------------
PRINTL
PRINTFORML %"=" * 107%
PRINTFORML 重い緞帳の内側は、紫煙と熱気のこもった薄暗い客席。入口で%CALLNAME:支配人%が出迎えてくれた。
CALL 劇場観覧
RETURN

;================================================================
;@劇場観覧
;  客としてショーを観覧する。演目に応じた観覧料先払い→興奮上昇・ストレス減。
;  ③過激ショーは観覧後に観客参加（H）へ分岐できる。
;================================================================
@劇場観覧
#DIM ダンサー
#DIM 演目
#DIM 料金
ダンサー = 劇場ステージダンサー()
IF ダンサー == -1
	PRINTL ステージには誰も立っておらず、「本日休演」の札が下がっている。
	PRINTW 今日は出直すことにした。
	RETURN
ENDIF
演目 = 劇場演目()
SELECTCASE 演目
	CASE 1
		料金 = 2000
	CASE 2
		料金 = 5000
	CASEELSE
		料金 = 10000
ENDSELECT
IF MONEY:MASTER < 料金
	PRINTFORML 今夜の演目は入場料%金額(料金)%円。あいにく手持ちが足りず、券を買うことができない。
	PRINTW 未練を残しつつ、劇場を後にした。
	RETURN
ENDIF
;観覧料先払い
MONEY:MASTER -= 料金
CFLAG:MASTER:待機時間 += 60
PRINTL
;----------------------------------------------------------------
;演目別の観覧描写
;----------------------------------------------------------------
SELECTCASE 演目
	CASE 1
		;ダンスショー
		PRINTFORML スポットライトを浴びた%CALLNAME:ダンサー%が、跳ねるようなリズムに乗ってステージを舞う。
		PRINTFORML しなやかに反る背中、宙を切る脚。衣装の裾がめくれるたび、客席から溜め息がこぼれた。
		PRINTFORMW 洗練された身のこなしに、あなたの鼓動も知らず知らず速くなっていく……。
		BASE:MASTER:興奮度 = MIN(BASE:MASTER:興奮度 + 100, BASE:MASTER:性欲)
		DOWNBASE:MASTER:ストレス += 200
	CASE 2
		;ストリップショー
		PRINTFORML 照明が艶めいた赤に変わると、%CALLNAME:ダンサー%は音楽に合わせて衣装を一枚ずつ脱ぎ落としていく。
		PRINTL 肩紐が滑り、布がずり下がるたび、客席から堪えきれない歓声とどよめきが上がった。
		PRINTFORML やがてほとんど何も纏わぬ姿を惜しげもなく晒し、挑発するように腰をくねらせる。
		PRINTFORMW 露わになった肌の艶めかしさに、あなたは思わず息を呑み、下腹の奥が疼くのを感じた……。
		BASE:MASTER:興奮度 = MIN(BASE:MASTER:興奮度 + 200, BASE:MASTER:性欲)
		DOWNBASE:MASTER:ストレス += 200
	CASEELSE
		;過激ショー
		PRINTFORML 深夜の劇場は、もう見世物の域を超えていた。全裸の%CALLNAME:ダンサー%がステージ中央で自ら肌をまさぐり、
		PRINTL 淫らな声を上げながら客の視線を一身に浴びている。空気は熱く粘り、誰もが息を荒げていた。
		PRINTFORMW あからさまな痴態に、あなたの体の芯まで火が点いてしまう……。
		BASE:MASTER:興奮度 = MIN(BASE:MASTER:興奮度 + 300, BASE:MASTER:性欲)
		DOWNBASE:MASTER:ストレス += 200
ENDSELECT
;----------------------------------------------------------------
;③過激ショーは観客参加（H）へ分岐
;----------------------------------------------------------------
IF 演目 == 3
	PRINTL
	PRINTFORML ふいに%CALLNAME:ダンサー%と目が合った。彼女は妖しく微笑み、あなたを手招きする。
	PRINTL 「そこのあなた……よかったら、一緒に舞台を盛り上げてくれない？」
	PRINTL 客席からも囃す声が上がる。どうしますか？
	PRINTL [0] - 舞台に上がる（追加料金20,000円）
	PRINTL [1] - 見るだけにしておく
	$THEATER_KANRAN_INPUT
	INPUT
	SIF RESULT != 0 && RESULT != 1
		GOTO THEATER_KANRAN_INPUT
	IF RESULT == 0
		IF MONEY:MASTER < 20000
			PRINTW ……が、追加の料金が足りず、断念するしかなかった。
		ELSE
			CALL 劇場観客参加(ダンサー)
			RETURN
		ENDIF
	ENDIF
ENDIF
PRINTFORMW 火照った体をなだめながら、あなたは満ち足りた気分で劇場を後にした。
RETURN

;================================================================
;@劇場観客参加(ARG)
;  ARG = ステージのダンサー。過激ショーで観客（MASTER）が舞台に上がりHへ。
;  追加料金・評判・累計はH前に処理する先払い規約。
;================================================================
@劇場観客参加(ARG)
;先払い（追加料金・評判・累計回数はH前に処理）
MONEY:MASTER -= 20000
BASE:MASTER:評判 -= 30
CFLAG:MASTER:3508 += 1
PRINTL
PRINTFORML 差し出された手を取って舞台に上がると、%CALLNAME:ARG%が耳元で囁いた。「大丈夫、リードしてあげる」
PRINTFORMW 眩しいライトと無数の視線の中、あなたは%CALLNAME:ARG%に導かれるまま、その体を重ねていった……。
PRINTL ここからどうしますか？
PRINTL [0] - 自分で動く（自分で操作する）
PRINTL [1] - 身を委ねる（おまかせ）
PRINTL [2] - やっぱりやめる
$THEATER_SANKA_INPUT
INPUT
SIF RESULT != 0 && RESULT != 1 && RESULT != 2
	GOTO THEATER_SANKA_INPUT
IF RESULT == 2
	PRINTFORMW 我に返って首を振ると、%CALLNAME:ARG%は「あら残念」と笑い、あなたを舞台の袖へ逃がしてくれた。
	RETURN
ENDIF
IF RESULT == 0
	;イベント4（コマンド選択式）へ合流。終了は997行為を終えるに任せる
	CALL 援交操作モード開始(ARG)
	RETURN
ENDIF
CALL ソープH_おまかせ(ARG, MASTER)
CFLAG:MASTER:待機時間 += 90
PRINTFORML 万雷の拍手の中、%CALLNAME:ARG%はあなたの頬に軽く口づけて舞台の袖へと下がっていった。
PRINTFORMW 生涯忘れられないであろう一夜の見世物は、こうして幕を閉じた。
RETURN

;================================================================
;@劇場ショー抽選(ARG, ARG:1)
;  ARG   = 出演者。XCOM段階の共通判定（COMF1057・XCOM1005の職業18フックの両方から呼ぶ）。
;  ARG:1 = 1なら演目選択でキャンセルできる（身分ダンサー＝COMF1057の経路のみ）。
;  戻り値(RESULT): 1=出演する / 0=キャンセルされた（何も仕込まずに戻る）。
;  M:106=演目(1〜7)、M:105=成否ランク(0〜3)。演目に応じたSOURCE（露出・逸脱）とEXPを仕込む。
;  （SOURCE→PALAM・経験の変換は描写(COM_MESSAGE)より先に走るため、抽選＝XCOM段階で仕込む）
;  ※キャンセルを消耗・報酬の前で拾えるよう、呼び出し側はこれを先に呼ぶこと。
;================================================================
@劇場ショー抽選(ARG, ARG:1)
#DIM 共演者
#DIM 踊り基準
#DIM 色気基準
;演目はプレイヤーが選ぶ。NPCが出演者の場合（NPC_AUTOACTION等）は時間帯まかせ
IF ARG == MASTER
	CALL 劇場演目選択(ARG:1)
	;キャンセル（ARG:1=1のときだけ起こりうる）。EXP・SOURCEを仕込む前に抜ける
	SIF !RESULT
		RETURN 0
	M:106 = RESULT
ELSE
	M:106 = 劇場演目()
ENDIF
;成否：踊り／色気／客あしらいの3判定を積み上げ（bite14方式）
;ダンス系（ランク1）は踊りが、露出系（ランク2以上）は色気が通りやすくなるよう基準値を振る
M:105 = 0
IF 劇場演目_ランク(M:106) == 1
	踊り基準 = 13
	色気基準 = 17
ELSE
	踊り基準 = 17
	色気基準 = 13
ENDIF
;踊り（ダンス技能が主。運動能力・習得速度も効く）
SIF RAND(踊り基準) - ABL:ARG:ダンス技能 * 2 - ABL:ARG:運動能力 - TALENT:ARG:習得速度 < 1
	M:105 += 1
;色気（欲望・露出癖・魅惑）
SIF RAND(色気基準) - ABL:ARG:欲望 - ABL:ARG:露出癖 - TALENT:ARG:魅惑 * 3 < 1
	M:105 += 1
;客あしらい（接客技能・話術技能・目立ちたがり）
SIF RAND(15) - ABL:ARG:接客技能 - ABL:ARG:話術技能 / 2 - TALENT:ARG:目立ちたがり * 3 < 1
	M:105 += 1
;経験（獲得表示はSOURCE_CHECK_2が行う。性的なSOURCEはこの後の変換で入る）
EXP:ARG:ダンス経験 += 3
EXP:ARG:接客経験 += 1
;演目に応じた露出SOURCE（量感はアダルト接客＝露出400/逸脱200、自慰＝露出500/逸脱300を基準）
SELECTCASE M:106
	;ポールダンス（際どい衣装で絡む）
	CASE 2
		SOURCE:ARG:露出 = 150
	;ペアダンス（共演者との息が合えば好意が上がる）
	CASE 3
		共演者 = 劇場ステージダンサー()
		IF 共演者 != -1 && M:105 >= 2
			TA:ARG:共演者:3 += 3
			TA:共演者:ARG:3 += 3
		ENDIF
	CASE 4
		SOURCE:ARG:露出 = 400
		SOURCE:ARG:逸脱 = 200
	CASE 5, 6
		SOURCE:ARG:露出 = 500
		SOURCE:ARG:逸脱 = 300
		EXP:ARG:異常経験 += 1
	;出産ショー（分娩そのものを見世物にする）。露出・逸脱とも最大級
	CASE 7
		SOURCE:ARG:露出 = 600
		SOURCE:ARG:逸脱 = 500
		EXP:ARG:異常経験 += 2
ENDSELECT
RETURN 1

;================================================================
;@劇場ショー実行(ARG, ARG:1, ARG:2)
;  ARG   = 出演者（通常MASTER）
;  ARG:1 = 演目（M:106）
;  ARG:2 = 経路（0=身分ダンサー / 1=バイト）
;  COM_MESSAGE段階の共通描写。M:105を見て成否分岐、チップ・評判を反映。
;  演目6（観客参加ショー）だけは客(Chara059)を舞台へ迎えて本番（@ソープH_おまかせ）。
;  演目7（出産ショー）は報酬・評判を確定させたあと、陣痛の誘発方法を選ばせて分娩へ入る（@出産）。
;================================================================
@劇場ショー実行(ARG, ARG:1, ARG:2)
#DIM 客
#DIM 共演者
PRINTFORML ＜劇場ステージ・%劇場演目_名(ARG:1)%＞
;----------------------------------------------------------------
;演目別・成否別の描写
;----------------------------------------------------------------
SELECTCASE ARG:1
	CASE 1
		;ダンスショー
		PRINTFORML 衣装に袖を通し、%CALLNAME:ARG%はスポットライトの中へ躍り出た。
		IF M:105 >= 3
			PRINTFORMW キレのあるステップと大胆な反りに客席が沸き立ち、指笛と拍手が鳴り止まなかった。
		ELSEIF M:105 == 2
			PRINTFORMW 軽やかな舞に客席から温かい拍手が送られた。まずまずの出来だ。
		ELSEIF M:105 == 1
			PRINTFORMW 振りを一つ二つ間違えたものの、なんとか踊り切った。
		ELSE
			PRINTFORMW リズムに乗り切れず、客席は少し白けた空気になってしまった。
		ENDIF
	CASE 2
		;ポールダンス
		PRINTFORML 舞台中央に立つ銀色のポールへ、%CALLNAME:ARG%は際どい衣装で歩み寄った。
		IF M:105 >= 3
			PRINTL 跳ぶように飛びつき、逆さになって脚を大きく開き、そのまま螺旋を描いて滑り降りる。
			PRINTFORMW 重力を忘れたような妙技と、露わになる肢体の際どさに、客席は割れんばかりの喝采を送った。
		ELSEIF M:105 == 2
			PRINTL ポールに絡めた脚をしならせ、体を反らせて回転する。
			PRINTFORMW 汗に濡れた肌が照明を弾くたび、客席から感嘆の吐息が漏れた。
		ELSEIF M:105 == 1
			PRINTFORMW 腕の力が続かず途中で降りてしまったが、際どい衣装に客席の視線は釘付けだった。
		ELSE
			PRINTFORMW 掌が滑ってポールにしがみつくのが精一杯で、客席からは苦笑がこぼれた。
		ENDIF
	CASE 3
		;ペアダンス（共演者との掛け合い）
		共演者 = 劇場ステージダンサー()
		IF 共演者 == -1
			PRINTFORML 共演者が舞台に現れず、%CALLNAME:ARG%は急遽ひとりで踊るはめになった。
			PRINTFORMW 間の抜けた構成に、客席の拍手はまばらだった。
			M:105 = 0
		ELSE
			PRINTFORML 照明が二本落ちる。%CALLNAME:ARG%と%CALLNAME:共演者%が背中合わせに立ち、音楽が始まった。
			IF M:105 >= 3
				PRINTL 互いの指先が触れ合い、離れ、また引き寄せられる。呼吸まで揃った二人の舞に客席は静まり返った。
				PRINTFORMW 最後の見得で二人が重なると、堰を切ったような歓声と拍手が劇場を揺らした。
			ELSEIF M:105 == 2
				PRINTFORMW %CALLNAME:共演者%のリードに導かれ、二人はしなやかに絡み合ってみせた。客席の反応も上々だ。
			ELSEIF M:105 == 1
				PRINTFORMW 何度か足が合わなかったものの、%CALLNAME:共演者%が上手く隠してくれた。
			ELSE
				PRINTFORMW 呼吸が最後まで噛み合わず、%CALLNAME:共演者%が独りで場をつないでいた。
			ENDIF
		ENDIF
	CASE 4
		;ストリップショー
		PRINTFORML 赤い照明の下、%CALLNAME:ARG%は音楽に合わせて一枚ずつ衣装を脱ぎ落としていく。
		IF M:105 >= 3
			PRINTFORMW 焦らすような所作と艶やかな流し目に客席は総立ちになり、歓声が渦を巻いた。
		ELSEIF M:105 == 2
			PRINTFORMW 露わになった肌に客席がどよめき、口笛が飛んだ。上々の反応だ。
		ELSEIF M:105 == 1
			PRINTFORMW ぎこちなさは残ったが、肌を晒すたびに客席からは歓声が上がった。
		ELSE
			PRINTFORMW 硬い動きに客席の熱は今ひとつ上がらなかった。
		ENDIF
	CASE 5, 6
		;過激ショー（5）／観客参加ショー（6）とも、前半は自ら痴態を晒す構成
		PRINTFORML 深夜の舞台で、%CALLNAME:ARG%は全裸で自らの肌をまさぐり、あられもない痴態を晒していく。
		IF M:105 >= 3
			PRINTFORMW 淫らな絶頂の演技に客席は熱狂の坩堝と化し、割れんばかりの拍手が響いた。
		ELSEIF M:105 == 2
			PRINTFORMW 惜しみない痴態に客席は前のめりになり、生唾を呑む音さえ聞こえた。
		ELSEIF M:105 == 1
			PRINTFORMW 羞じらいながらも肌を晒し切り、客席の視線を集めた。
		ELSE
			PRINTFORMW 大胆になりきれず、過激さを求める客席はやや不満げだった。
		ENDIF
	CASE 7
		;出産ショー（臨月の腹を晒し、分娩そのものを演目にする）
		;ここは幕開け＝客席の掴みまで。誘発の見せ場と娩出の山場は後段（@出産の前後）で作る
		PRINTL 場内が暗転する。緞帳の向こうから、支配人の声だけが客席へ流れ込んだ。
		PRINTFORMW 「――本日の最終演目。生命が生まれ落ちるその瞬間を、皆様の目の前で」
		PRINTL
		PRINTFORML 照明が戻る。舞台の中央に据えられた分娩台へ、%CALLNAME:ARG%は臨月の腹を隠しもせず上がっていった。
		PRINTFORMW 満席の客席がどよめき、無数の視線が張りつめた腹と、開かれた脚のあいだへ吸い寄せられる。
		IF M:105 >= 3
			PRINTL 息を整え、腹を撫で、来るべき波を待つ――その所作の一つ一つに、客席は身じろぎひとつしない。
			PRINTFORMW 見世物にされる恥辱すら演目に変えてみせる度胸に、劇場は早くも張りつめた熱を孕んでいた。
		ELSEIF M:105 == 2
			PRINTFORMW 恥辱に頬を染めながらも腹を突き出してみせる姿に、客席は前のめりになって見入った。
		ELSEIF M:105 == 1
			PRINTFORMW 羞恥に脚を閉じかけては開き直す繰り返し。それでも客席の視線は釘付けのままだった。
		ELSE
			PRINTFORMW 痛みと羞恥に呑まれて演目どころではなく、客席はただ黙って見守るばかりだった。
		ENDIF
ENDSELECT
;----------------------------------------------------------------
;チップ（身分は成否×2000円、バイトは成否×1000円）に演目倍率を掛ける＋評判
;----------------------------------------------------------------
IF ARG:2 == 0
	LOCAL = M:105 * 2000
ELSE
	LOCAL = M:105 * 1000
ENDIF
LOCAL = LOCAL * 劇場演目_報酬倍率(ARG:1) / 100
IF LOCAL > 0
	MONEY:ARG += LOCAL
	PRINTFORML 舞台の縁に投げ込まれたチップ +%金額(LOCAL)%円
ENDIF
SELECTCASE ARG:1
	;ダンス系（ランク1）は健全な舞台なので評判が上がる
	CASE 1, 2, 3
		BASE:ARG:評判 += M:105 * 5
	CASE 4
		BASE:ARG:評判 -= 10
	CASE 5
		BASE:ARG:評判 -= 25
	CASE 6
		BASE:ARG:評判 -= 40
	CASE 7
		BASE:ARG:評判 -= 50
ENDSELECT
;----------------------------------------------------------------
;過激ショー出演回数（演目6の解禁条件）。演目6は客(Chara059)を舞台へ迎えて本番、演目7は分娩へ
;----------------------------------------------------------------
SIF ARG:1 == 5 || ARG:1 == 6 || ARG:1 == 7
	CFLAG:ARG:3507 += 1
IF ARG:1 == 6
	客 = GETCHARA(59)
	IF 客 != -1
		;客を店へ（乗車・睡眠は解除）
		CFLAG:客:現在地区 = 2
		CFLAG:客:現在位置 = 52
		CFLAG:客:乗車 = 0
		CFLAG:客:睡眠 = 0
		PRINTL
		PRINTFORMW 昂ぶった客席から一人が舞台へ招き上げられ、%CALLNAME:ARG%は衆目の中でその体を受け入れていった……。
		;バイト経路の店主援交（COM_MESSAGE1005末尾）と二重にならないようスキップフラグを立てる
		M:102 = 1
		CALL ソープH_おまかせ(客, ARG)
	ENDIF
ENDIF
;----------------------------------------------------------------
;演目7（出産ショー）：舞台の上でそのまま分娩する
;  陣痛がまだなら@劇場出産誘発選択で誘発の方法を選ばせる。
;    1=陣痛促進剤：劇場が用意する（所持品は不要）。速いが母体の消耗が大きい
;    2=お迎え棒　：客(Chara059)を舞台へ招いて性交で誘発（演目6と同じ@ソープH_おまかせ）
;  誘発後は娩出期まで一息に進めて@出産へ渡し、産声のあとにカーテンコールと祝儀で締める。
;  多胎の小休止・後始末（CFLAG:陣痛/破水済のクリア）はPREGNANCY.ERB側が面倒を見る。
;----------------------------------------------------------------
IF ARG:1 == 7
	;すでに陣痛が来ている状態で舞台に上がったなら誘発そのものが要らない
	IF CFLAG:ARG:陣痛 <= 0
		客 = GETCHARA(59)
		CALL 劇場出産誘発選択(ARG, 客)
		IF RESULT == 2
			;お迎え棒：客を舞台へ迎え、性交で陣痛を誘う
			CFLAG:客:現在地区 = 2
			CFLAG:客:現在位置 = 52
			CFLAG:客:乗車 = 0
			CFLAG:客:睡眠 = 0
			PRINTL
			PRINTL 「陣痛を促すには古来より伝わる方法がございます。――どなたか、お手伝いを」
			PRINTFORMW 支配人の口上に客席が沸き返り、我先にと挙がった手の中から一人が舞台へ招き上げられた。
			PRINTFORMW 迫り出した腹を抱えたまま、%CALLNAME:ARG%は衆目の中でその客を受け入れていった……。
			;バイト経路の店主援交（COM_MESSAGE1005末尾）と二重にならないようスキップフラグを立てる
			M:102 = 1
			CALL ソープH_おまかせ(客, ARG)
			PRINTL
			PRINTFORMW 突き上げられるたびに腹が硬く張り、それはやがて周期的な痛みへと変わっていった。
			PRINTFORMW 「――来たようでございます。皆様、お待ちかねのお時間です」
		ELSE
			;陣痛促進剤：劇場が用意する。効きは速いが母体への負担が大きい
			PRINTL
			PRINTL 「お待たせはいたしません。当劇場、薬のご用意もございます」
			PRINTFORML 舞台袖から白衣の医師が現れ、衆目の下で%CALLNAME:ARG%の腕に点滴の針が落とされた。
			PRINTFORMW 客席が息を呑んで見守る中、薬液が落ちきるより早く、抗いようのない波が腹の底から突き上げてくる……！
			BASE:ARG:体力 = MAX(0, BASE:ARG:体力 - MAXBASE:ARG:体力 / 5)
			BASE:ARG:気力 = MAX(0, BASE:ARG:気力 - MAXBASE:ARG:気力 / 5)
		ENDIF
		;お迎え棒のH中にゲーム側の@陣痛誘発チェックが先に発火していることがある
		SIF CFLAG:ARG:陣痛 <= 0
			CALL 陣痛開始(ARG)
	ENDIF
	;娩出期まで一息に進める。@陣痛_進行を経由しないので適時破水もここで済ませる
	CFLAG:ARG:陣痛 = 陣痛_満了(ARG)
	CFLAG:ARG:破水済 = 1
	PRINTL
	PRINTFORMW 「さあ皆様、どうぞお近くで。生まれる瞬間は一度きりでございます」
	PRINTFORMW 客席が一斉に前へ詰め寄る。無数の視線を股のあいだに浴びたまま、%CALLNAME:ARG%はいきみ始めた……。
	CALL 出産(ARG, 0)
	;締め。多胎の小休止中（@分娩_次児待機）はまだ舞台が終わっていないので幕を引かない
	IF !分娩中(ARG)
		PRINTL
		IF M:105 >= 3
			PRINTFORMW 産声が劇場を貫いた瞬間、客席は総立ちになり、万雷の拍手と歓声がいつまでも鳴り止まなかった。
		ELSEIF M:105 >= 1
			PRINTFORMW 産声が上がると、我に返った客席から割れるような拍手が湧き起こった。
		ELSE
			PRINTFORMW 産声が上がっても客席は静まり返ったまま、まばらな拍手がぱらぱらと続くだけだった。
		ENDIF
		;山場に応えて舞台へ投げ込まれる祝儀（チップとは別枠。演目7だけの締め）
		LOCAL = (M:105 + 1) * 5000
		MONEY:ARG += LOCAL
		PRINTFORML 舞台に降り注いだ祝儀 +%金額(LOCAL)%円
	ENDIF
ENDIF
RETURN

;================================================================
;@劇場体験勧誘
;  飛び込み一日ステージ体験。受付フック冒頭から呼ばれる。
;  戻り値(RESULT): 1=体験を引き受けた（受付メニューはスキップ） / 0=発生せず or 断った
;  発生条件: 当日未勧誘(TCVAR:634) / 容姿500以上 / 客(Chara059)登録済 / 抽選
;  報酬・評判・累計(CFLAG:3507)はH呼び出し前に処理（先払い規約）。
;================================================================
@劇場体験勧誘
#DIM 支配人
#DIM 客
#DIM 段階
支配人 = GETCHARA(61)
;当日1回（受けても断っても再勧誘しない）
SIF TCVAR:MASTER:劇場体験済
	RETURN 0
;容姿500以上
SIF BASE:MASTER:容姿 < 500
	RETURN 0
客 = GETCHARA(59)
SIF 客 == -1
	RETURN 0
;抽選: 基本20% + 淫乱素質*20 + 露出癖*5（体験経験者は+10、上限50%）
LOCAL = 20 + TALENT:MASTER:4 * 20 + ABL:MASTER:露出癖 * 5
SIF CFLAG:MASTER:3507
	LOCAL += 10
SIF LOCAL > 50
	LOCAL = 50
SIF RAND(100) >= LOCAL
	RETURN 0
;----------------------------------------------------------------
;勧誘発生
;----------------------------------------------------------------
TCVAR:MASTER:劇場体験済 = 1
PRINTL
PRINTFORML %"=" * 107%
PRINTFORML 客席へ向かおうとしたあなたを、支配人の%CALLNAME:支配人%が呼び止めた。
PRINTL 「お嬢さん、いい身体つきをしてるね。……どうだい、今夜ひと晩だけステージに立ってみないか？」
PRINTFORMW 「日給ははずむよ。あんたの度胸次第で、いくらでもね」
PRINTL 一日体験に勧誘されている。どの演目まで出ますか？
PRINTL [0] - ダンスショーだけ（日給5,000円）
PRINTL [1] - ストリップショーまで（日給10,000円・評判が下がる）
IF !TALENT:MASTER:0
	PRINTL [2] - 過激ショーまで（日給30,000円・評判が大きく下がる）
ENDIF
PRINTL [3] - 断る
$THEATER_TAIKEN_INPUT
INPUT
IF RESULT == 3
	PRINTFORMW あなたが曖昧に首を振ると、%CALLNAME:支配人%は「気が変わったらいつでもおいで」と肩をすくめた。
	RETURN 0
ENDIF
;過激ショー(2)は処女には出させない
IF RESULT == 2
	SIF TALENT:MASTER:0
		GOTO THEATER_TAIKEN_INPUT
	段階 = 3
ELSEIF RESULT == 1
	段階 = 2
ELSEIF RESULT == 0
	段階 = 1
ELSE
	GOTO THEATER_TAIKEN_INPUT
ENDIF
;----------------------------------------------------------------
;着替え・レクチャー
;----------------------------------------------------------------
PRINTFORML 頷くと、%CALLNAME:支配人%は満足げに頷き、あなたを楽屋へ通した。
PRINTL 渡された衣装に着替え、ステップの運びや客の煽り方を手早く教え込まれる。
PRINTFORMW 「照明は正直だ。堂々としてりゃ、客は勝手に沸く。……さあ、幕が上がるよ」
PRINTL
;----------------------------------------------------------------
;報酬（先払い規約: H前に処理）
;----------------------------------------------------------------
SELECTCASE 段階
	CASE 1
		MONEY:MASTER += 5000
		EXP:MASTER:ダンス経験 += 2
	CASE 2
		MONEY:MASTER += 10000
		BASE:MASTER:評判 -= 20
		EXP:MASTER:ダンス経験 += 2
		SOURCE:MASTER:露出 = 400
		SOURCE:MASTER:逸脱 = 200
	CASEELSE
		MONEY:MASTER += 30000
		BASE:MASTER:評判 -= 50
		CFLAG:MASTER:3507 += 1
		EXP:MASTER:ダンス経験 += 2
		SOURCE:MASTER:露出 = 500
		SOURCE:MASTER:逸脱 = 300
ENDSELECT
;----------------------------------------------------------------
;ショー本番
;----------------------------------------------------------------
SELECTCASE 段階
	CASE 1
		PRINTFORML スポットライトの中、あなたは教わったばかりのステップで懸命に踊ってみせた。
		PRINTFORMW 拙いながらも一生懸命な舞に、客席からは温かい拍手が送られた。
	CASE 2
		PRINTFORML 音楽に合わせ、あなたは震える指で衣装を一枚ずつ脱ぎ落としていく。
		PRINTL 肌を晒すたびに客席がどよめき、羞恥と昂揚が綯い交ぜになって全身を火照らせた。
		PRINTFORMW ほとんど何も纏わぬ姿を晒し切ると、客席から惜しみない歓声が上がった。
	CASEELSE
		PRINTFORML 全裸で舞台に立たされたあなたは、衆目の中で自ら肌をまさぐるよう促された。
		PRINTFORML 羞恥に震えながらも痴態を晒すうち、客席の熱気に呑まれて理性が溶けていく。
		客 = GETCHARA(59)
		IF 客 != -1
			CFLAG:客:現在地区 = 2
			CFLAG:客:現在位置 = 52
			CFLAG:客:乗車 = 0
			CFLAG:客:睡眠 = 0
			PRINTFORMW やがて客席から一人が舞台へ上げられ、あなたは衆目の中でその客を受け入れていった……。
			CALL ソープH_おまかせ(客, MASTER)
		ENDIF
ENDSELECT
CFLAG:MASTER:待機時間 += 120
PRINTFORML 舞台を降りると、%CALLNAME:支配人%が労いながら日給の入った封筒を握らせてくれた。
PRINTFORMW 「筋がいいじゃないか。その気になったら、いつでも面接においで」
RETURN 1
