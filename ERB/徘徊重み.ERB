;=================================================
; NPCの徘徊先の重み付け（2026-09-01追加）
; ・NPCが空き時間に行く先の出やすさ。100＝標準
; ・NPC_ACTION.ERB の徘徊抽選（毎時0〜4分）で RAND(100) に掛ける
; ・全候補が等確率だと70箇所以上に散り、特定のNPCと居合わせる確率が数%しかない。
;   人が集まる場所を厚く、用事があるときだけ行く場所と通路を薄くして遭遇率を上げる
; ・地区2の51以降（居酒屋・バー等）は@徘徊解禁を通さないと候補に入らない。下の注記を参照
;=================================================

;-------------------------------------------------
; 徘徊先としての出やすさを返す。100＝標準
; ARG=地区 / ARG:1=位置
;-------------------------------------------------
@徘徊重み(ARG, ARG:1)
#FUNCTION
#DIM 重み
#DIM 時
重み = 100
時 = TIME / 60
SELECTCASE ARG
	CASE 0
		SELECTCASE ARG:1
			;駅前商店街・公園
			CASE 4,11
				重み = 250
			;最寄の駅（通り道）
			CASE 3
				重み = 150
			;薬屋・病院・警察署・本屋（用事があるときだけ行く）
			CASE 8,12,13,16
				重み = 50
		ENDSELECT
	CASE 1
		SELECTCASE ARG:1
			;学生食堂
			CASE 25
				重み = 250
			;生協
			CASE 26
				重み = 200
			;正門・エントランスホール・サークル棟
			CASE 1,3,15
				重み = 150
			;研究室・学長室・学生課・保健センター・ゼミ室・大講義室・プール・アトリエ・音楽練習室・実験室・調理実習室
			CASE 4,5,6,7,8,9,14,21,22,23,24
				重み = 50
			;トイレ・用具倉庫・各廊下
			CASE 10,17,18,19,27,28,29
				重み = 30
		ENDSELECT
	CASE 2
		SELECTCASE ARG:1
			;繁華街・ハンバーガー屋・カラオケ屋・ゲームセンター・ファミレス・公園
			CASE 4,6,7,8,12,17
				重み = 250
			;喫茶店
			CASE 14
				重み = 200
			;大学への道・大学前駅・コンビニ・居酒屋
			CASE 2,3,5,54
				重み = 150
			;バー・映画館
			CASE 55,57
				重み = 100
			;劇場
			CASE 52
				重み = 80
			;薬屋・警察署・病院・キャバクラ
			CASE 10,11,13,19
				重み = 50
			;アダルトショップ
			CASE 20
				重み = 30
		ENDSELECT
ENDSELECT
;昼どきは食事処に、夕方以降は繁華街と酒場に人が寄る
IF 時 >= 11 && 時 <= 14
	SIF (ARG == 1 && (ARG:1 == 25 || ARG:1 == 26)) || (ARG == 2 && (ARG:1 == 6 || ARG:1 == 12)) || (ARG == 0 && ARG:1 == 14)
		重み *= 2
ELSEIF 時 >= 17 && 時 <= 22
	SIF (ARG == 2 && (ARG:1 == 4 || ARG:1 == 7 || ARG:1 == 8 || ARG:1 == 54 || ARG:1 == 55)) || (ARG == 0 && ARG:1 == 4)
		重み *= 2
ENDIF
RETURNF 重み

;-------------------------------------------------
; 私的空間判定を上書きして徘徊先に含める場所。RETURN 1＝解禁
; ARG=地区 / ARG:1=位置
;
; 地区2の店舗は場所番号が51以降に振られているため、@IS_PRIVATE_PLACE（COMMON.ERB）の
; 「地区2は30以上が私的空間」に巻き込まれて徘徊候補から落ちていた。
; ここで通すのは客が普通に入れる4箇所だけ。ソープランド(51)・ホストクラブ(53)・質屋(56)は
; 用事のある者だけが入る場所なので解禁しない。
; @IS_PRIVATE_PLACE 自体は路上遭遇・酔い持ち帰りの発生判定にも使われるため書き換えない。
;-------------------------------------------------
@徘徊解禁(ARG, ARG:1)
#FUNCTION
;劇場・居酒屋・バー・映画館
SIF ARG == 2 && (ARG:1 == 52 || ARG:1 == 54 || ARG:1 == 55 || ARG:1 == 57)
	RETURNF 1
RETURNF 0
