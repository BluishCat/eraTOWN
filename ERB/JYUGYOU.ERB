;身分システム：教師視点の授業中イベント（2026-07-19追加）
;ランダムな生徒を1人選び、3パターンから抽選。TA:(生徒):1:n で生徒→あなたの感情を操作
@JYUGYOU_TEACHER()
J:102 = RAND(CHARANUM - 2) + 2
J:103 = NO:(J:102)
J:104 = RAND:3
SELECTCASE J:104
	CASE 0
		;居眠りしている生徒を起こす
		PRINTFORML 授業中、%CALLNAME:(J:102)%が船を漕いで居眠りしている。
$INPUT_LOOP_TEACHER0
		PRINTL どうしますか？
		PRINTL [0] - 優しく起こす
		PRINTL [1] - チョークを投げる
		INPUT
		IF RESULT == 0
			PRINTFORMW あなたは%CALLNAME:(J:102)%の肩をそっと叩いて起こした。
			PRINTL 「……はっ、すみません先生」
			TA:(J:102):1:3 += 10
			BASE:MASTER:評判 += 5
		ELSEIF RESULT == 1
			PRINTFORMW あなたの投げたチョークが見事に命中し、%CALLNAME:(J:102)%は飛び起きた。
			PRINTL 教室に笑いが起きる。
			TA:(J:102):1:6 += 5
			BASE:MASTER:評判 += 3
		ELSE
			GOTO INPUT_LOOP_TEACHER0
		ENDIF
	CASE 1
		;熱心な生徒からの質問
		PRINTFORML 授業の後、%CALLNAME:(J:102)%が質問にやってきた。
		PRINTL 「先生、ここがどうしても分からなくて……」
$INPUT_LOOP_TEACHER1
		PRINTL どうしますか？
		PRINTL [0] - 丁寧に教える
		PRINTL [1] - 適当にあしらう
		INPUT
		IF RESULT == 0
			PRINTFORMW あなたは%CALLNAME:(J:102)%に丁寧に解説した。理解できた様子で嬉しそうだ。
			TA:(J:102):1:3 += 15
			TA:(J:102):1:1 += 5
			BASE:MASTER:評判 += 8
			EXP:MASTER:接客経験 += 1
		ELSEIF RESULT == 1
			PRINTFORMW あなたが面倒そうに答えると、%CALLNAME:(J:102)%は残念そうに戻っていった。
			TA:(J:102):1:3 -= 10
			BASE:MASTER:評判 -= 5
		ELSE
			GOTO INPUT_LOOP_TEACHER1
		ENDIF
	CASE 2
		;授業がうまくいった（フレーバー）
		PRINTL 今日の授業は生徒たちの反応も良く、滞りなく進んだ。
		PRINTFORMW %CALLNAME:(J:102)%たちが熱心にノートを取っている。
		BASE:MASTER:評判 += 5
ENDSELECT
RETURN 1

