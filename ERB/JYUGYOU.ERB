@JYUGYOU1()
PRINTL
PRINTFORML %"=" * 107%
;身分システム：プレイヤーが教師なら教師視点の授業イベントへ分岐
IF CFLAG:MASTER:仕事 == 1
	CALL JYUGYOU_TEACHER()
	RETURN 1
ENDIF
IF TFLAG:COM用変数
	PRINTL 体育の授業だ。
