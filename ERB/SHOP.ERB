@EVENTSHOP


@SHOW_SHOP
;TFLAG:100 = 0
DRAWLINE
PRINTFORM {DAY}日目
CALL PRINT_WEEK_COLORED
PRINTL
PRINTFORML (所持金:%金額(MONEY:MASTER)%円)
CALL PRINT_BASEBAR簡易行(MASTER)

PRINTL [100] - 起床
PRINTL [101] - 能力表示
PRINTL [104] - 設定
PRINTL [200] - SAVE
PRINTL [300] - LOAD
;PRINTL [400] - OPTION
PRINTL [500] - お着替え
@USERSHOP
IF RESULT == 100
	BEGIN TRAIN
	RETURN 1
ELSEIF RESULT == 101
	CALL SHOW_CHARADATA
ELSEIF RESULT == 104
	CALL SCHEDULE
ELSEIF RESULT == 110
	CALL LIKELOVE
ELSEIF RESULT == 200
	;セーブ一覧のコメントは@SAVEINFO（SYSTEM.ERB）がセーブ時に自動で組み立てる
	SAVEGAME
ELSEIF RESULT == 300
	LOADGAME
;ELSEIF RESULT == 400
;	CALL OPTION
ELSEIF RESULT == 500
	CALL CHANGE_CLOTHES(MASTER)
ENDIF


@SCHEDULE
PRINTL [0] - 起床時間設定
PRINTL [1] - 危険度設定
PRINTL [2] - お弁当設定
PRINTL [4] - 痴漢設定
PRINTL [5] - 妊娠設定
PRINTL [6] - 病気設定
PRINTL [100] - 戻る
INPUT
IF RESULT == 100
	RETURN 0
ELSEIF RESULT == 0
	PRINTL 何時に起床しますか?(0〜23を入力してください)
	$INPUT_LOOP
	INPUT
	SIF RESULT < 0 || RESULT > 23
		GOTO INPUT_LOOP
	CFLAG:MASTER:起床時間 = RESULT * 60
ELSEIF RESULT == 1
	CALL SET_DANGEROUS
ELSEIF RESULT == 2
	CALL SET_BENTO
ELSEIF RESULT == 3
	CALL SET_EQUIP
ELSEIF RESULT == 4
	CALL SET_TIKAN
ELSEIF RESULT == 5
	CALL 妊娠設定画面
ELSEIF RESULT == 6
	CALL 病気設定画面
ELSE
ENDIF
RETURN 1

@LIKELOVE
VARSET LOCAL
FOR LOCAL:1,1,CHARANUM
	FOR LOCAL:2,1,CHARANUM
	IF TA:(LOCAL:1):(LOCAL:2):1 >= 0 && GETCHARA(LOCAL:2) != -1
		LOCAL:3 = TA:(LOCAL:1):(LOCAL:2):1
		LOCAL:6 = TA:(LOCAL:1):(LOCAL:2):3
		IF (LOCAL:3 * 100 + LOCAL:6) >= LOCAL:4
			LOCAL:4 = (LOCAL:3 * 100 + LOCAL:6)
			LOCAL:5 = LOCAL:2
		ENDIF
	ENDIF
	NEXT
	IF LOCAL:4 == 0
		PRINTFORML %CALLNAME:(LOCAL:1)%の好きな人はいない
	ELSEIF LOCAL:5 == LOCAL:1
		PRINTFORML %CALLNAME:(LOCAL:1)%の好きな人は自分で{LOCAL:4}だけ好きだ
	ELSEIF LOCAL:5 == (34 + CHARANUM - 71)
		PRINTFORML %CALLNAME:(LOCAL:1)%の好きな人は自分の父親で{LOCAL:4}だけ好きだ
	ELSE
		PRINTFORML %CALLNAME:(LOCAL:1)%の好きな人は%CALLNAME:(LOCAL:5)%で{LOCAL:4}だけ好きだ
	ENDIF
LOCAL:3 = 0
LOCAL:4 = 0
LOCAL:5 = 0
LOCAL:6 = 0
NEXT
