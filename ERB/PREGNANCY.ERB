;================================================================
; 妊娠・出産システム
;  受精：EVENT_SHOOT（膣内射精）から @受精チェック → 受精卵（着床待ち・まだ妊娠ではない）
;  着床：@妊娠_日次処理 から受精5〜7日後に @着床判定（基礎50%）。成立で TALENT:妊娠
;        ※受精率は着床率50%を織り込んで従来の2倍に補正済み（実効妊娠率はほぼ維持）
;  進行：NEXT_DAY から @妊娠_日次_ALL
;  初期化：EVENTFIRST から @生理周期_INIT
;  避妊：COMF1048（薬の使用）から CFLAG:避妊 / アフターピル（着床前のみ有効・現実準拠）
; 状態は既存 TALENT:妊娠(153)/育児中(154)/母性(155) を流用、
; カウンタは CFLAG:妊娠日数/生理周期/父親/出産回数/避妊/育児日数/受精卵日数/着床所要日数
;================================================================

;----------------------------------------------------------------
;胎児数の決定（多胎判定）
; ARG=母。母体状態で多胎率が変動する
;  ・排卵誘発剤の残効中：大幅増（現実でも排卵誘発＝多胎率上昇）
;  ・過去に多胎歴（子供数>出産回数）：素因ありとみなし加算
;  ・経産婦（出産回数2以上）：微増
;----------------------------------------------------------------
@胎児数決定(ARG)
#FUNCTION
;LOCAL=基礎多胎率(%)、LOCAL:1=三つ子率(%)。基礎値は設定から取得
LOCAL = FLAG:多胎率
;排卵誘発剤の残効中は大幅に多胎しやすい
SIF CFLAG:ARG:排卵誘発 > 0
	LOCAL += 12
;過去に一度の出産で複数産んでいれば多胎素因ありとみなす
SIF CFLAG:ARG:子供数 > CFLAG:ARG:出産回数
	LOCAL += 5
;経産婦は微増
SIF CFLAG:ARG:出産回数 >= 2
	LOCAL += 2
;単胎判定
SIF RAND(100) >= LOCAL
	RETURNF 1
;多胎確定。三つ子率は設定値、誘発剤の残効中はさらに上昇
LOCAL:1 = FLAG:三つ子率
SIF CFLAG:ARG:排卵誘発 > 0
	LOCAL:1 = MAX(LOCAL:1, 25)
SIF RAND(100) < LOCAL:1
	RETURNF 3
RETURNF 2

;----------------------------------------------------------------
;出産予定日数（多胎ほど早まる）
; ARG=母
;----------------------------------------------------------------
@出産予定日数(ARG)
#FUNCTION
;LOCAL=基礎日数（多胎ほど短い）
SELECTCASE CFLAG:ARG:胎児数
	CASE IS >= 3
		LOCAL = 35
	CASE 2
		LOCAL = 37
	CASEELSE
		LOCAL = 40
ENDSELECT
;設定の妊娠期間倍率を適用（最低1日）
RETURNF MAX(1, LOCAL * FLAG:妊娠期間倍率 / 100)

;----------------------------------------------------------------
;産後回復日数の算出
; ARG=母。設定が正なら固定日数、0なら自動（妊娠期間の1/8・切り上げ）
;----------------------------------------------------------------
@産後回復日数算出(ARG)
#FUNCTION
;固定日数の設定があればそれを使う
SIF FLAG:産後回復日数 > 0
	RETURNF FLAG:産後回復日数
;自動：妊娠期間の1/8を切り上げ（(n+7)/8）
RETURNF (出産予定日数(ARG) + 7) / 8

;----------------------------------------------------------------
;腹の大きさ段階（0=目立たない〜4=臨月）
; ARG=対象。妊娠日数と出産予定日数の比率から算出（保存しない）
;----------------------------------------------------------------
@腹段階(ARG)
#FUNCTION
;非妊娠は0
SIF !TALENT:ARG:妊娠 || CFLAG:ARG:妊娠日数 <= 0
	RETURNF 0
VARSET LOCAL
;比率(%)＝妊娠日数 / 出産予定日数
LOCAL = CFLAG:ARG:妊娠日数 * 100 / 出産予定日数(ARG)
SELECTCASE LOCAL
	CASE IS >= 85
		RETURNF 4
	CASE IS >= 60
		RETURNF 3
	CASE IS >= 30
		RETURNF 2
	CASE IS >= 10
		RETURNF 1
	CASEELSE
		RETURNF 0
ENDSELECT

;----------------------------------------------------------------
;腹段階の表示名（INFO用）
;----------------------------------------------------------------
@腹段階_名(ARG)
#FUNCTIONS
SELECTCASE 腹段階(ARG)
	CASE 4
		RETURNF "臨月"
	CASE 3
		RETURNF "大きい"
	CASE 2
		RETURNF "ふっくら"
	CASE 1
		RETURNF "まだ目立たない"
	CASEELSE
		RETURNF
ENDSELECT

;----------------------------------------------------------------
;生理周期の状態名（INFO用）。妊娠しやすさの目安
;----------------------------------------------------------------
@生理状態_名(ARG)
#FUNCTIONS
;産後・中断からの回復期は生理周期に依らず妊娠しない → 最優先で表示
SIF CFLAG:ARG:産後回復 > 0
	RETURNF "回復期（産後）"
SELECTCASE CFLAG:ARG:生理周期
	CASE 0,1,2,3,4
		RETURNF "生理中"
	CASE 12,13,14,15,16
		RETURNF "危険日（排卵期）"
	CASE 10,11,17,18
		RETURNF "やや危険"
	CASEELSE
		RETURNF "安全日"
ENDSELECT

;----------------------------------------------------------------
;切迫流産の警告タグ（ステータス表示用）。切迫流産度に応じた【】文字列を返す
; ARG=対象。非妊娠・切迫流産度0なら空文字
;----------------------------------------------------------------
@切迫流産タグ(ARG)
#FUNCTIONS
SIF !TALENT:ARG:妊娠 || CFLAG:ARG:切迫流産度 <= 0
	RETURNF ""
SELECTCASE CFLAG:ARG:切迫流産度
	CASE IS >= 90
		RETURNF "【切迫流産・要安静/受診】"
	CASE IS >= 60
		RETURNF "【腹痛・出血・要安静】"
	CASEELSE
		RETURNF "【少量出血】"
ENDSELECT

;----------------------------------------------------------------
;臨月かどうか（予定日の5日前以降）。ARG=対象
;----------------------------------------------------------------
@臨月(ARG)
#FUNCTION
SIF !TALENT:ARG:妊娠 || CFLAG:ARG:妊娠日数 <= 0
	RETURNF 0
SIF CFLAG:ARG:妊娠日数 >= 出産予定日数(ARG) - 5
	RETURNF 1
RETURNF 0

;----------------------------------------------------------------
;妊娠の露見チェック（お腹を見て気づく）
; ARG=観測者、ARG:1=対象。新規に気づいたら気づきの口上を出す
;----------------------------------------------------------------
@妊娠露見チェック(ARG,ARG:1)
;対象が女性・妊娠中でなければ対象外
SIF !GETBIT(TALENT:(ARG:1):性別,0) || !TALENT:(ARG:1):妊娠
	RETURN
;自分自身は対象外
SIF ARG == ARG:1
	RETURN
;既に知っている
SIF CFLAG:ARG:(3300 + ARG:1)
	RETURN
VARSET LOCAL
;お腹が段階2以上でないと外見では分からない
LOCAL = 腹段階(ARG:1)
SIF LOCAL < 2
	RETURN
;段階別の気づく確率（2=40% 3=80% 4=100%）
SELECTCASE LOCAL
	CASE 4
		LOCAL:1 = 100
	CASE 3
		LOCAL:1 = 80
	CASEELSE
		LOCAL:1 = 40
ENDSELECT
SIF RAND(100) >= LOCAL:1
	RETURN
;気づいた：フラグを立てて気づきの口上
CFLAG:ARG:(3300 + ARG:1) = 1
CALL 汎用口上(10, ARG, ARG:1)
RETURN

;----------------------------------------------------------------
;受精可否判定
; ARG=母、ARG:1=父
;----------------------------------------------------------------
@FERTILE_CHECK(ARG,ARG:1)
#FUNCTION
;設定で妊娠機能がOFF → 不可（新規受精しない）
SIF FLAG:妊娠機能 == 0
	RETURNF 0
;女性器を持たない → 不可
SIF !GETBIT(TALENT:ARG:性別,0)
	RETURNF 0
;既に妊娠中 → 不可
SIF TALENT:ARG:妊娠
	RETURNF 0
;受精卵が着床待ちの間 → 不可（同時に複数は受精しない）
SIF CFLAG:ARG:受精卵日数 > 0
	RETURNF 0
;避妊薬（ピル）服用中 → 不可
SIF CFLAG:ARG:避妊 > 0
	RETURNF 0
;産後の回復期 → 不可
SIF CFLAG:ARG:産後回復 > 0
	RETURNF 0
RETURNF 1

;----------------------------------------------------------------
;受精チェック（膣内射精時に SOURCE から呼ぶ）
; ARG=母、ARG:1=父
;----------------------------------------------------------------
@受精チェック(ARG,ARG:1)
VARSET LOCAL
SIF !FERTILE_CHECK(ARG,ARG:1)
	RETURN
;排卵周期から基礎確率(%)を決める
;※着床率50%を織り込むため従来の2倍（実効妊娠率はほぼ従来どおり）
SELECTCASE CFLAG:ARG:生理周期
	CASE 12,13,14,15,16
		;排卵期
		LOCAL = 120
	CASE 10,11,17,18
		;排卵期の周辺
		LOCAL = 40
	CASE 7,8,9,19,20
		LOCAL = 12
	CASEELSE
		;安全日
		LOCAL = 4
ENDSELECT
;大量射精で微増
SIF NOWEX:(ARG:1):11 > 1
	LOCAL += 20
;子宮内に精液が多く溜まっているほど微増
SIF CFLAG:ARG:子宮内精液 >= 500
	LOCAL += 20
;設定の妊娠確率倍率を適用
LOCAL = LOCAL * FLAG:妊娠確率倍率 / 100
;「確実に妊娠」設定がONなら確率判定を無視して受精確定
SIF FLAG:確実妊娠
	LOCAL = 100
;判定
IF RAND(100) < LOCAL
	;受精成立。ただちに妊娠にはならず、着床待ちの受精卵となる（本人も気づかない）
	CFLAG:ARG:受精卵日数 = 1
	;着床までの所要日数（5〜7日）
	CFLAG:ARG:着床所要日数 = 5 + RAND(3)
	;父親は先に膣内へ入った精液を優先（後からの射精では上書きしない）
	LOCAL:1 = 父親抽選(ARG)
	SIF LOCAL:1 < 0
		LOCAL:1 = ARG:1
	CFLAG:ARG:父親 = LOCAL:1
	;胎児数（多胎判定）
	CFLAG:ARG:胎児数 = 胎児数決定(ARG)
ENDIF
RETURN

;----------------------------------------------------------------
;受精力（＝子宮内精液量 × 鮮度係数）
; ARG=母、ARG:1=相手。子宮内に届いた精液のみが対象。新しいほど高く、日が経つほど急減
;----------------------------------------------------------------
@受精力(ARG,ARG:1)
#FUNCTION
;LOCAL=精液量、LOCAL:1=経過日数
LOCAL = CFLAG:ARG:(3600 + ARG:1)
SIF LOCAL <= 0
	RETURNF 0
LOCAL:1 = DAY - CFLAG:ARG:(3700 + ARG:1)
SELECTCASE LOCAL:1
	CASE IS <= 0
		RETURNF LOCAL              ;1日目(当日)：100%
	CASE 1
		RETURNF LOCAL * 80 / 100   ;2日目：受精可能な期間を維持
	CASE 2
		RETURNF LOCAL * 20 / 100   ;3日目：ここから急速に低下
	CASE 3
		RETURNF LOCAL * 5 / 100    ;4日目
	CASEELSE
		RETURNF 0                  ;5日目以降：受精能力を喪失
ENDSELECT

;----------------------------------------------------------------
;父親抽選（先に子宮内へ届いた精液を優先。後からの射精では上書きしない）
; ARG=母。父親のキャラ番号を返す。受精力ゼロなら -1
;----------------------------------------------------------------
@父親抽選(ARG)
#FUNCTION
;先に子宮内へ届いた精液を優先（後からの射精では父性を上書きしない）
;受精力が残っている相手のうち、子宮内到達日(3700+相手)が最も古い相手を父親とする
;LOCAL=最古到達日、LOCAL:1=父親候補、LOCAL:2=走査
LOCAL:1 = -1
;登録番号0（ダミー枠）は父親候補から除外（1から走査）
FOR LOCAL:2,1,CHARANUM
	;受精力ゼロ（未到達・鮮度切れ）は候補外
	SIF 受精力(ARG, LOCAL:2) <= 0
		CONTINUE
	;初候補、またはより古い到達日なら更新（同日は登録番号の若い方＝先に走査した方を優先）
	IF LOCAL:1 < 0 || CFLAG:ARG:(3700 + LOCAL:2) < LOCAL
		LOCAL = CFLAG:ARG:(3700 + LOCAL:2)
		LOCAL:1 = LOCAL:2
	ENDIF
NEXT
RETURNF LOCAL:1

;----------------------------------------------------------------
;妊娠の日次処理（全キャラ）NEXT_DAY から呼ぶ
;----------------------------------------------------------------
@妊娠_日次_ALL
VARSET LOCAL
FOR LOCAL,0,CHARANUM
	CALL 精液_漏出(LOCAL)
	CALL 妊娠_日次処理(LOCAL)
NEXT
RETURN

;----------------------------------------------------------------
;精液の漏出（1キャラ）
; 相手別内訳を毎日1/4まで減衰させ、合計(26/27/184)を再計算する
;----------------------------------------------------------------
@精液_漏出(ARG)
VARSET LOCAL
;ダミー枠(登録番号0)は相手ではない。旧セーブ由来の残留値を毎日クリアし合計から除外
CFLAG:ARG:3000 = 0
CFLAG:ARG:3100 = 0
CFLAG:ARG:3200 = 0
CFLAG:ARG:3600 = 0
CFLAG:ARG:3700 = 0
;LOCAL:1=膣合計、LOCAL:2=肛合計、LOCAL:3=子宮内合計（登録番号1から集計）
FOR LOCAL,1,CHARANUM
	;膣内(3000+相手)。尽きたら射精日(3200+相手)もクリア
	IF CFLAG:ARG:(3000 + LOCAL) > 0
		CFLAG:ARG:(3000 + LOCAL) /= 4
		IF CFLAG:ARG:(3000 + LOCAL) < 30
			CFLAG:ARG:(3000 + LOCAL) = 0
			CFLAG:ARG:(3200 + LOCAL) = 0
		ENDIF
		LOCAL:1 += CFLAG:ARG:(3000 + LOCAL)
	ENDIF
	;肛内(3100+相手)
	IF CFLAG:ARG:(3100 + LOCAL) > 0
		CFLAG:ARG:(3100 + LOCAL) /= 4
		SIF CFLAG:ARG:(3100 + LOCAL) < 30
			CFLAG:ARG:(3100 + LOCAL) = 0
		LOCAL:2 += CFLAG:ARG:(3100 + LOCAL)
	ENDIF
	;子宮内(3600+相手)。尽きたら到達日(3700+相手)もクリア
	IF CFLAG:ARG:(3600 + LOCAL) > 0
		CFLAG:ARG:(3600 + LOCAL) /= 4
		IF CFLAG:ARG:(3600 + LOCAL) < 30
			CFLAG:ARG:(3600 + LOCAL) = 0
			CFLAG:ARG:(3700 + LOCAL) = 0
		ENDIF
		LOCAL:3 += CFLAG:ARG:(3600 + LOCAL)
	ENDIF
NEXT
CFLAG:ARG:膣内精液 = LOCAL:1
CFLAG:ARG:肛内精液 = LOCAL:2
CFLAG:ARG:子宮内精液 = LOCAL:3
RETURN

;----------------------------------------------------------------
;精液の腟内→子宮内への移行（TIME_COUNTから経過分ごとに呼ぶ）
; ARG=対象、ARG:1=経過分。精子移行タイマーに加算し、60分ごとに移行処理を実行する
;----------------------------------------------------------------
@精液_子宮移行(ARG,ARG:1)
;女性器を持たない、または腟内に精液が無ければ何もしない
SIF !GETBIT(TALENT:ARG:性別,0) || CFLAG:ARG:膣内精液 <= 0
	RETURN
CFLAG:ARG:精子移行タイマー += ARG:1
WHILE CFLAG:ARG:膣内精液 > 0 && CFLAG:ARG:精子移行タイマー >= 60
	CFLAG:ARG:精子移行タイマー -= 60
	CALL 精液_子宮移行_内部(ARG, 25)
WEND
RETURN

;----------------------------------------------------------------
;膣内絶頂による子宮内への押し込み（TRACHECK_ORGASMの膣内絶頂から呼ぶ）
; ARG=絶頂した対象、ARG:1=絶頂強度(1=絶頂/2=強絶頂)。既に腟内に精液が無ければ何もしない
;----------------------------------------------------------------
@精液_絶頂押込(ARG,ARG:1)
SIF CFLAG:ARG:膣内精液 <= 0
	RETURN
;絶頂時の収縮でまとめて子宮内へ押し込まれる（通常40%、強絶頂は55%。通常の時間経過移行25%より多め）
CALL 精液_子宮移行_内部(ARG, 40 + (ARG:1 >= 2) * 15)
RETURN

;----------------------------------------------------------------
;精液の腟内→子宮内への移行（共通の実処理）
; ARG=対象、ARG:1=移行割合(%)。相手別に腟内残量の当該割合（最低1）を子宮内へ移す
; 移行分は到達日(3700+相手)にDAYを記録し、子宮内へ実際に届いた瞬間として受精判定を行う
;----------------------------------------------------------------
@精液_子宮移行_内部(ARG,ARG:1)
VARSET LOCAL
FOR LOCAL,1,CHARANUM
	SIF CFLAG:ARG:(3000 + LOCAL) <= 0
		CONTINUE
	;LOCAL:1=移行量
	LOCAL:1 = MIN(CFLAG:ARG:(3000 + LOCAL), MAX(1, CFLAG:ARG:(3000 + LOCAL) * ARG:1 / 100))
	CFLAG:ARG:(3000 + LOCAL) -= LOCAL:1
	SIF CFLAG:ARG:(3000 + LOCAL) <= 0
		CFLAG:ARG:(3200 + LOCAL) = 0
	CFLAG:ARG:(3600 + LOCAL) += LOCAL:1
	CFLAG:ARG:(3700 + LOCAL) = DAY
	CFLAG:ARG:膣内精液 -= LOCAL:1
	CFLAG:ARG:子宮内精液 += LOCAL:1
	;子宮内に届いた精液で受精判定
	CALL 受精チェック(ARG, LOCAL)
NEXT
RETURN

;----------------------------------------------------------------
;膣内精液の洗浄（入浴・シャワーで呼ぶ）
; ARG=対象。腟内に残っている分だけを洗い流す。既に子宮内へ移行した分は体の奥にあり影響を受けない
;----------------------------------------------------------------
@膣内精液_洗浄(ARG)
VARSET LOCAL
CFLAG:ARG:膣内精液 = 0
FOR LOCAL, 0, CHARANUM
	CFLAG:ARG:(3000 + LOCAL) = 0
	CFLAG:ARG:(3200 + LOCAL) = 0
NEXT
RETURN

;----------------------------------------------------------------
;肛内精液の洗浄（入浴・シャワーで呼ぶ）
; ARG=対象。奥に残るため全部は流れず、1/4に減衰させる（@精液_漏出と同率）
;----------------------------------------------------------------
@肛内精液_洗浄(ARG)
VARSET LOCAL
;ダミー枠(登録番号0)は相手ではないためクリア
CFLAG:ARG:3100 = 0
;LOCAL:1=肛合計（登録番号1から集計）
FOR LOCAL, 1, CHARANUM
	IF CFLAG:ARG:(3100 + LOCAL) > 0
		CFLAG:ARG:(3100 + LOCAL) /= 4
		SIF CFLAG:ARG:(3100 + LOCAL) < 30
			CFLAG:ARG:(3100 + LOCAL) = 0
		LOCAL:1 += CFLAG:ARG:(3100 + LOCAL)
	ENDIF
NEXT
CFLAG:ARG:肛内精液 = LOCAL:1
RETURN

;----------------------------------------------------------------
;入浴時の精液洗浄（腟内＋肛内をまとめて処理する）
; ARG=対象。腟内=全部洗い流す／肛内=奥に残るため1/4に減衰／子宮内(3600番台)は影響なし
;----------------------------------------------------------------
@精液_入浴洗浄(ARG)
CALL 膣内精液_洗浄(ARG)
CALL 肛内精液_洗浄(ARG)
RETURN

;----------------------------------------------------------------
;膣内精液の全排出（出産・流産・中絶で子宮/膣内が洗い流される）
; ARG=対象。子宮内精液も併せて排出する。肛内精液は対象外
;----------------------------------------------------------------
@膣内精液_全排出(ARG)
VARSET LOCAL
CFLAG:ARG:膣内精液 = 0
CFLAG:ARG:子宮内精液 = 0
CFLAG:ARG:精子移行タイマー = 0
FOR LOCAL, 0, CHARANUM
	CFLAG:ARG:(3000 + LOCAL) = 0
	CFLAG:ARG:(3200 + LOCAL) = 0
	CFLAG:ARG:(3600 + LOCAL) = 0
	CFLAG:ARG:(3700 + LOCAL) = 0
NEXT
RETURN

;----------------------------------------------------------------
;精液の相手別内訳を表示（ステータス用）
; ARG=所有者、ARG:1=部位ベース(3000=膣 / 3100=肛)
;----------------------------------------------------------------
@精液内訳表示(ARG,ARG:1)
VARSET LOCAL
;登録番号0はダミー枠のため相手として表示しない（1から走査）
FOR LOCAL,1,CHARANUM
	SIF CFLAG:ARG:(ARG:1 + LOCAL) > 0
		PRINTFORM 　%CALLNAME:LOCAL%の精液(%精液量_名(CFLAG:ARG:(ARG:1 + LOCAL))%)
NEXT
RETURN

;----------------------------------------------------------------
;精液の相手別内訳を文字列で返す（サイドバーのHTML組み立て用。内容は@精液内訳表示と同一）
; ARG=所有者、ARG:1=部位ベース(3000=膣 / 3100=肛)
;----------------------------------------------------------------
@精液内訳_文字列(ARG,ARG:1)
#FUNCTIONS
#DIMS OUT
OUT =
;登録番号0はダミー枠のため相手として表示しない（1から走査）
FOR LOCAL,1,CHARANUM
	SIF CFLAG:ARG:(ARG:1 + LOCAL) > 0
		OUT '= @"%OUT%　%CALLNAME:LOCAL%の精液(%精液量_名(CFLAG:ARG:(ARG:1 + LOCAL))%)"
NEXT
RETURNF OUT

;----------------------------------------------------------------
;直近の中出し相手を記録（リングバッファ）
; ARG=受け手、ARG:1=射精者。CFLAG:受け手:(3400+n) n=0..9 に相手番号+1を格納
;   最新が先頭。同一相手は先頭へ寄せる（重複させない）。0=空スロット
;----------------------------------------------------------------
@直近相手記録(ARG,ARG:1)
;登録番号0（ダミー枠）や不正な相手は履歴に残さない
SIF ARG:1 <= 0
	RETURN
VARSET LOCAL
;新リストを LOCAL:0..9 に構築（LOCAL:0=最新）。カウンタは LOCAL:10-12 を使用
LOCAL:0 = ARG:1 + 1
LOCAL:10 = 1
;既存リストを走査し、前詰め・重複除去しながら LOCAL:1.. へ退避
FOR LOCAL:11, 0, 10
	LOCAL:12 = CFLAG:ARG:(3400 + LOCAL:11)
	;0が来たらリスト終端
	SIF LOCAL:12 == 0
		BREAK
	;新相手と同一なら捨てる（先頭に寄せるため）
	SIF LOCAL:12 == LOCAL:0
		CONTINUE
	;10件で打ち止め
	SIF LOCAL:10 > 9
		CONTINUE
	LOCAL:(LOCAL:10) = LOCAL:12
	LOCAL:10 ++
NEXT
;CFLAG へ書き戻し（余りは0でクリア）
FOR LOCAL:11, 0, 10
	IF LOCAL:11 < LOCAL:10
		CFLAG:ARG:(3400 + LOCAL:11) = LOCAL:(LOCAL:11)
	ELSE
		CFLAG:ARG:(3400 + LOCAL:11) = 0
	ENDIF
NEXT
RETURN

;----------------------------------------------------------------
;直近の中出し相手を新しい順に表示（ステータス用・改行なし）
; ARG=受け手
;----------------------------------------------------------------
@直近相手表示(ARG)
VARSET LOCAL
;LOCAL:100 = 表示済み件数（区切り「、」の制御用）
FOR LOCAL,0,10
	SIF CFLAG:ARG:(3400 + LOCAL) == 0
		BREAK
	;値1＝登録番号0（ダミー枠）は表示しない（旧セーブ対策）
	SIF CFLAG:ARG:(3400 + LOCAL) == 1
		CONTINUE
	SIF LOCAL:100 > 0
		PRINT 、
	PRINTFORM %CALLNAME:(CFLAG:ARG:(3400 + LOCAL) - 1)%
	LOCAL:100 ++
NEXT
RETURN

;----------------------------------------------------------------
;腹段階の更新（段階アップ時に本人の気づき/確信を描写）
; ARG=対象。地の文はMASTERのみ。CFLAG:腹段階/妊娠自覚 を更新
;----------------------------------------------------------------
@腹段階_更新(ARG)
VARSET LOCAL
;LOCAL=新段階、LOCAL:1=前段階
LOCAL = 腹段階(ARG)
LOCAL:1 = CFLAG:ARG:腹段階
;段階が上がった時だけ処理
IF LOCAL > LOCAL:1
	IF ARG == MASTER
		SELECTCASE LOCAL
			CASE 1
				PRINTW 最近、下腹部がふっくらしてきた気がする……気のせい？
				;まだ自覚が無ければ妊娠発覚の口上
				SIF CFLAG:ARG:妊娠自覚 == 0
					CALL 妊娠口上(3, ARG, CFLAG:ARG:父親)
			CASE 2
				PRINTW お腹のふくらみが、もうはっきり分かる……間違いない、妊娠してるんだ。
			CASE 3
				PRINTW お腹がずいぶん目立つようになってきた……もう、隠せない。
			CASEELSE
				;段階4(臨月)の予兆は妊娠日数側で描写
		ENDSELECT
	ENDIF
	;自覚レベル：段階2以上で確信、段階1で気づき
	IF LOCAL >= 2
		CFLAG:ARG:妊娠自覚 = 2
	ELSEIF CFLAG:ARG:妊娠自覚 < 1
		CFLAG:ARG:妊娠自覚 = 1
	ENDIF
ENDIF
CFLAG:ARG:腹段階 = LOCAL
;お腹の成長に合わせて3サイズ（バスト・ウエスト）を更新
CALL 妊娠_3サイズ_更新(ARG)
RETURN

;----------------------------------------------------------------
;妊娠の日次処理（1キャラ）
;----------------------------------------------------------------
@妊娠_日次処理(ARG)
;女性器を持たないキャラは対象外
SIF !GETBIT(TALENT:ARG:性別,0)
	RETURN
;避妊薬の残日数を減らす
SIF CFLAG:ARG:避妊 > 0
	CFLAG:ARG:避妊 -= 1
;排卵誘発剤の残効日数を減らす（残効中は多胎率が上がる）
SIF CFLAG:ARG:排卵誘発 > 0
	CFLAG:ARG:排卵誘発 -= 1
;産後回復期の残日数を減らす（この間は妊娠しない）
;回復期が明けた日は生理直後（安全日=5日目）から周期を再開する
IF CFLAG:ARG:産後回復 > 0
	CFLAG:ARG:産後回復 -= 1
	SIF CFLAG:ARG:産後回復 == 0
		CFLAG:ARG:生理周期 = 5
ENDIF
;切迫流産度は安静で自然に治まる（毎日-15）。前日に負荷があった場合は治まらない
SIF CFLAG:ARG:切迫流産度 > 0 && CFLAG:ARG:最終母体負荷日 < DAY - 1
	CFLAG:ARG:切迫流産度 = MAX(0, CFLAG:ARG:切迫流産度 - 15)
;育児日数の消化（0になったら育児中を外す。母性は永続）
IF CFLAG:ARG:育児日数 > 0
	CFLAG:ARG:育児日数 -= 1
	SIF CFLAG:ARG:育児日数 == 0
		TALENT:ARG:育児中 = 0
ENDIF
;産後・中断後の体型をゆっくり回復させる（回復目標が残っている間だけ動く）
CALL 産後_3サイズ_回復(ARG)
;妊娠中の進行 / 非妊娠中の生理周期進行
IF TALENT:ARG:妊娠 && CFLAG:ARG:妊娠日数 > 0
	;陣痛が始まっていない間だけ妊娠日数を進める
	IF CFLAG:ARG:陣痛 == 0
		CFLAG:ARG:妊娠日数 += 1
		;お腹の成長段階を更新し、段階アップ時に本人の気づき/確信を描写
		CALL 腹段階_更新(ARG)
		;臨月の予兆（プレイヤーのみ・予定日の2日前）
		SIF ARG == MASTER && CFLAG:ARG:妊娠日数 == 出産予定日数(ARG) - 2
			PRINTW おなかが頻繁に張るようになった。予定日が近いのかもしれない。
		;予定日に達したら陣痛開始（破水は前後どちらもあり得る）
		SIF CFLAG:ARG:妊娠日数 >= 出産予定日数(ARG)
			CALL 陣痛開始(ARG)
	ENDIF
ELSE
	;受精卵があれば着床待ちを進める。なければ残留精液からの受精をチェック
	IF CFLAG:ARG:受精卵日数 > 0
		CFLAG:ARG:受精卵日数 += 1
		;所要日数に達したら着床判定（成立で妊娠、失敗で受精卵は静かに消える）
		SIF CFLAG:ARG:受精卵日数 >= CFLAG:ARG:着床所要日数
			CALL 着床判定(ARG)
	ELSE
		;排卵期の残留精液による受精（新しい精液ほど受精力が高い）
		CALL 残留受精チェック(ARG)
	ENDIF
	;妊娠が成立していなければ生理周期を進める（着床待ちの間も周期は進む）
	;ただし産後・中断の回復期中は月経が止まっているため周期も進めない
	IF !TALENT:ARG:妊娠 && CFLAG:ARG:産後回復 <= 0
		CFLAG:ARG:生理周期 += 1
		SIF CFLAG:ARG:生理周期 > 27
			CFLAG:ARG:生理周期 = 0
	ENDIF
ENDIF
RETURN

;----------------------------------------------------------------
;排卵期の残留精液による受精チェック（NEXT_DAY・非妊娠時）
; ARG=母。溜まった精液の受精力に応じて受精する
;----------------------------------------------------------------
@残留受精チェック(ARG)
VARSET LOCAL
;女性・非妊娠・非避妊のみ
SIF !FERTILE_CHECK(ARG, ARG)
	RETURN
;排卵期のみ
SELECTCASE CFLAG:ARG:生理周期
	CASE 12,13,14,15,16
	CASEELSE
		RETURN
ENDSELECT
;総受精力
LOCAL = 0
FOR LOCAL:1,0,CHARANUM
	LOCAL += 受精力(ARG, LOCAL:1)
NEXT
SIF LOCAL <= 0
	RETURN
;受精力に応じた確率（上限80%）※着床率50%を織り込むため従来の2倍
LOCAL:2 = MIN(80, LOCAL / 75)
;設定の妊娠確率倍率を適用
LOCAL:2 = LOCAL:2 * FLAG:妊娠確率倍率 / 100
;「確実に妊娠」設定がONなら（排卵期・精液残留の条件下で）受精確定
SIF FLAG:確実妊娠
	LOCAL:2 = 100
IF RAND(100) < LOCAL:2
	;受精成立。ただちに妊娠にはならず、着床待ちの受精卵となる
	CFLAG:ARG:受精卵日数 = 1
	CFLAG:ARG:着床所要日数 = 5 + RAND(3)
	CFLAG:ARG:父親 = 父親抽選(ARG)
	SIF CFLAG:ARG:父親 < 0
		CFLAG:ARG:父親 = 0
	CFLAG:ARG:胎児数 = 胎児数決定(ARG)
ENDIF
RETURN

;----------------------------------------------------------------
;着床判定（受精から5〜7日後に一度だけ行う）
; ARG=母。現実では受精卵の約半分しか着床しない。失敗しても本人は気づかず、
; 予定通り生理が来るだけ（表示・描写は一切なし）
;----------------------------------------------------------------
@着床判定(ARG)
VARSET LOCAL
;基礎着床率50%。妊娠しやすさ設定が100%超のときは着床側にも上乗せ（受精側は100%で頭打ちになるため）
LOCAL = 50 * MAX(FLAG:妊娠確率倍率, 100) / 100
;「確実に妊娠」設定がONなら着床確定
SIF FLAG:確実妊娠
	LOCAL = 100
IF RAND(100) < LOCAL
	;着床成立＝妊娠の成立（父親・胎児数は受精時に確定済み）
	TALENT:ARG:妊娠 = 1
	CFLAG:ARG:妊娠日数 = 1
	;ごく稀に（10%）、着床の瞬間をかすかに感じることがある（プレイヤーのみ。妊娠自覚はまだ立てない）
	SIF ARG == MASTER && RAND(100) < 10
		CALL 妊娠口上(12, ARG, CFLAG:ARG:父親)
ELSE
	;着床失敗。受精卵は静かに消える
	CFLAG:ARG:父親 = 0
	CFLAG:ARG:胎児数 = 0
ENDIF
;着床待ち状態を終了
CFLAG:ARG:受精卵日数 = 0
CFLAG:ARG:着床所要日数 = 0
RETURN

;----------------------------------------------------------------
;出産
;----------------------------------------------------------------

;----------------------------------------------------------------
;陣痛・出産の地の文ログ
; 目立つ色で表示し、スキップ中でも FORCEWAIT で必ず入力待ちで止める。
;（PRINTW の WAIT はスキップ中に読み飛ばされるが、FORCEWAIT は必ず停止する）
; 表示文は STR:0 に FORM 展開して格納してから CALL する。ARG=対象（地の文は MASTER のみ）
;----------------------------------------------------------------
@陣痛ログ(ARG)
SIF ARG != MASTER
	RETURN
;表示文が空なら何も出さず停止もしない（移動などで出力が無い時はストップさせない）
SIF STR:0 == ""
	RETURN
SETCOLOR 0xFF66AA
PRINTFORML %STR:0%
RESETCOLOR
FORCEWAIT
;次回に前回の文が残って誤って停止しないよう、表示後はクリアしておく
STR:0 =
RETURN

;----------------------------------------------------------------
;妊娠中リスクの予約（流産等の地の文が行動の描写より先に出るのを防ぐ予約制）
; 行動処理(XCOM/射精処理)からは直接@妊娠中リスクチェックを呼ばず、こちらで強度を予約し、
; SOURCE_CHECKSが行動描写(COM_MESSAGE)の後に@妊娠中リスク保留実行で消化する
; ARG=母、ARG:1=負荷強度(%)。同ターン複数トリガは強い方を採用
;----------------------------------------------------------------
@妊娠中リスク予約(ARG,ARG:1)
;女性・妊娠中・未陣痛のみ（詳細な判定は実行側の@妊娠中リスクチェックが再検証する）
SIF !GETBIT(TALENT:ARG:性別,0)
	RETURN
SIF !TALENT:ARG:妊娠 || CFLAG:ARG:陣痛 > 0
	RETURN
SIF ARG:1 > TCVAR:ARG:妊娠リスク保留
	TCVAR:ARG:妊娠リスク保留 = ARG:1
RETURN

;----------------------------------------------------------------
;予約された妊娠中リスクの実行（SOURCE_CHECKSの行動描写後から呼ばれる）
;----------------------------------------------------------------
@妊娠中リスク保留実行
#DIM 強度
VARSET LOCAL
FOR LOCAL,0,CHARANUM
	SIF TCVAR:LOCAL:妊娠リスク保留 <= 0
		CONTINUE
	;再入防止のため先にクリアしてから実行
	強度 = TCVAR:LOCAL:妊娠リスク保留
	TCVAR:LOCAL:妊娠リスク保留 = 0
	CALL 妊娠中リスクチェック(LOCAL, 強度)
NEXT
RETURN

;----------------------------------------------------------------
;行為の強制終了予約（流産・陣痛開始・出産が行為(H/調教/痴漢)中に起きたとき）
; 発生源はSOURCE処理の途中で呼ばれうるため、ここでは即時にEVENT_ESCAPEせず予約だけ立て、
; EVENTCOMENDループの安全地点で@行為終了予約消化が消化する(妊娠リスク保留625と同パターン)
; ARG=母。行為中でなければ何もしない(病院分娩・就寝中の陣痛などはno-op)
;----------------------------------------------------------------
@行為中判定(ARG)
#FUNCTION
SIF TCVAR:ARG:イベント
	RETURNF 1
SIF H状態中(ARG)
	RETURNF 1
RETURNF 0

@行為終了予約(ARG)
SIF !行為中判定(ARG)
	RETURN
TCVAR:ARG:行為終了予約 = 1
RETURN

;----------------------------------------------------------------
;予約された行為強制終了の消化（EVENTCOMENDループの安全地点から呼ばれる）
;----------------------------------------------------------------
@行為終了予約消化
#DIM 相手
VARSET LOCAL
FOR LOCAL,0,CHARANUM
	SIF !TCVAR:LOCAL:行為終了予約
		CONTINUE
	;再入防止のため先にクリアしてから実行
	TCVAR:LOCAL:行為終了予約 = 0
	;既にWEAKNESS_CHECKや逃走等で行為が終わっていれば何もしない
	SIF !行為中判定(LOCAL)
		CONTINUE
	相手 = TCVAR:LOCAL:行為対象
	;挿入器具はEVENT_ESCAPE系がクリアしないため先に抜いておく(出血・娩出で押し出される扱い、描写なし)
	SIF TEQUIP:LOCAL:膣 == 1
		TEQUIP:LOCAL:膣 = 0
	SIF TEQUIP:LOCAL:アナル == 60 || TEQUIP:LOCAL:アナル == 61 || TEQUIP:LOCAL:アナル == 62
		TEQUIP:LOCAL:アナル = 0
	TCVAR:LOCAL:被挿入 = 0
	IF LOCAL == MASTER || 相手 == MASTER || (TCVAR:MASTER:行為対象 && TCVAR:MASTER:行為対象 == LOCAL)
		;MASTERが当事者：地の文を出して全終了
		;(流産で衰弱=1が立っている場合は搬送描写済みなので二重演出を避け無言で畳む)
		IF !TCVAR:MASTER:衰弱
			IF LOCAL == MASTER
				PRINTL
				PRINTW とても行為を続けられる状態ではなくなった……。
			ELSE
				PRINTL
				PRINTFORMW %CALLNAME:LOCAL%の只事ではない様子に、行為を続けるどころではなくなった。
			ENDIF
		ENDIF
		CALL EVENT_ESCAPE_ALL
	ELSEIF 相手
		;NPC同士の行為：両者を無言で解除
		CALL EVENT_ESCAPE_NPC(LOCAL, 相手)
	ELSE
		;相手なし(モブ痴漢中など)：EVENT_ESCAPEのNPC分岐は挿入系をクリアしないため
		;EVENTCOMENDの降車時処理と同型の手動リセットを行う
		CALL EVENT_ESCAPE(LOCAL)
		TCVAR:LOCAL:イベント = 0
		TCVAR:LOCAL:挿入 = 0
		TCVAR:LOCAL:被挿入 = 0
		TCVAR:LOCAL:キス中 = 0
		TCVAR:LOCAL:現在体位 = 0
		SELECTCOM:LOCAL = 0
		CFLAG:LOCAL:痴漢発見 = 0
		CALL 痴漢消去(LOCAL)
	ENDIF
NEXT
RETURN

;----------------------------------------------------------------
;妊娠中リスクの統合チェック（@妊娠中リスク保留実行・WEAKNESS_CHECKから呼ぶ）
; ARG=母、ARG:1=負荷強度(%)。妊娠の進行段階でリスクを振り分ける
;  初期(〜35%)＝切迫流産／中期(35〜60%)＝安全／後期(60%〜)＝早産・臨月誘発
;----------------------------------------------------------------
@妊娠中リスクチェック(ARG,ARG:1)
;女性・妊娠中・未陣痛のみ
SIF !GETBIT(TALENT:ARG:性別,0)
	RETURN
SIF !TALENT:ARG:妊娠 || CFLAG:ARG:陣痛 > 0
	RETURN
VARSET LOCAL
;進行率(%)＝妊娠日数 / 出産予定日数
LOCAL = CFLAG:ARG:妊娠日数 * 100 / 出産予定日数(ARG)
IF LOCAL < 35
	;妊娠初期：切迫流産リスク帯
	CALL 切迫流産チェック(ARG, ARG:1)
ELSEIF LOCAL >= 60
	;妊娠後期〜臨月：早産・陣痛誘発リスク帯
	CALL 陣痛誘発チェック(ARG, ARG:1)
ENDIF
;35〜60%（安定期）は何も起こさない
RETURN

;----------------------------------------------------------------
;切迫流産チェック（妊娠初期の負荷で切迫流産度を蓄積・段階的に警告）
; ARG=母、ARG:1=負荷強度(%)。限界(100)到達で初めて流産する
;----------------------------------------------------------------
@切迫流産チェック(ARG,ARG:1)
;流産機能OFFなら何もしない
SIF FLAG:流産率 == 0
	RETURN
;女性・妊娠中・未陣痛のみ
SIF !GETBIT(TALENT:ARG:性別,0)
	RETURN
SIF !TALENT:ARG:妊娠 || CFLAG:ARG:陣痛 > 0
	RETURN
VARSET LOCAL
;LOCAL:1=進行率(%)、LOCAL:2=旧・切迫流産度、LOCAL=上昇量
LOCAL:1 = CFLAG:ARG:妊娠日数 * 100 / 出産予定日数(ARG)
LOCAL:2 = CFLAG:ARG:切迫流産度
;着床直後ほど脆い（進行率0で最大・35%で0）。基礎上昇＝強度×(35-進行率)/70
LOCAL = ARG:1 * (35 - LOCAL:1) / 70
SIF LOCAL < 0
	LOCAL = 0
;多胎は流産しやすい
SIF CFLAG:ARG:胎児数 >= 2
	LOCAL += 4
;高ストレスで上振れ
SIF BASE:ARG:ストレス > MAXBASE:ARG:ストレス * 7 / 10
	LOCAL += 4
;設定倍率を適用
LOCAL = LOCAL * FLAG:流産率 / 100
;新しい切迫流産度
CFLAG:ARG:切迫流産度 = LOCAL:2 + LOCAL
;負荷があった日を記録（翌日の日次減衰を止める）
SIF LOCAL > 0
	CFLAG:ARG:最終母体負荷日 = DAY
;閾値(30/60/90)を跨いだ段階だけ警告（本人＝MASTERのみ描写）
IF ARG == MASTER
	IF LOCAL:2 < 30 && CFLAG:ARG:切迫流産度 >= 30
		STR:0 = 下腹部に鈍い違和感……ショーツにごく少量の出血がにじんでいた。
		CALL 陣痛ログ(ARG)
	ELSEIF LOCAL:2 < 60 && CFLAG:ARG:切迫流産度 >= 60
		STR:0 = 差し込むような下腹部の痛みと出血が続いている。無理は禁物だ……少し休んだ方がいい。
		CALL 陣痛ログ(ARG)
	ELSEIF LOCAL:2 < 90 && CFLAG:ARG:切迫流産度 >= 90
		STR:0 = 強い腹痛とともに出血が増えてきた……切迫流産の兆候だ。すぐに安静にするか、病院へ行かないと危ない……！
		CALL 陣痛ログ(ARG)
	ENDIF
ENDIF
;流産判定：限界(100)到達でのみ流産。加えて「よほど」の稀な直接流産
LOCAL:3 = 0
SIF CFLAG:ARG:切迫流産度 >= 100
	LOCAL:3 = 1
;例外：多胎かつ高ストレスのときだけ、ごく稀(2%)に直接流産
SIF CFLAG:ARG:胎児数 >= 2 && BASE:ARG:ストレス > MAXBASE:ARG:ストレス * 8 / 10 && RAND(100) < 2
	LOCAL:3 = 1
SIF !LOCAL:3
	RETURN
CALL 流産発生(ARG)
RETURN

;----------------------------------------------------------------
;流産の発生処理（状態リセットは既存の@妊娠中断へ委譲）
; ARG=母
;----------------------------------------------------------------
@流産発生(ARG)
;地の文・口上・母体消耗（MASTERのみ）
IF ARG == MASTER
	STR:0 = 激しい痛みとともに、股の間から大量の出血が――お腹の子を、留めておくことができなかった。
	CALL 陣痛ログ(ARG)
	CALL 妊娠口上(13, ARG, CFLAG:ARG:父親)
	;母体の消耗とストレス
	BASE:ARG:体力 = MAX(0, BASE:ARG:体力 - MAXBASE:ARG:体力 / 3)
	BASE:ARG:気力 = MAX(0, BASE:ARG:気力 - MAXBASE:ARG:気力 / 3)
	BASE:ARG:ストレス = MIN(MAXBASE:ARG:ストレス, BASE:ARG:ストレス + MAXBASE:ARG:ストレス / 2)
	;--- 意識を失い、病院へ搬送される（倒れ処理は@WEAKNESS_CHECKを踏襲）---
	PRINTL 激しい出血と痛みに耐えきれず、あなたはその場に崩れ落ちた。
	PRINTW 薄れゆく意識の中、誰かが駆け寄ってくる声が遠くに聞こえた――
	;その日を強制終了（EVENTCOMENDがAFTERTRAINへ抜ける）
	;※H・痴漢イベント中の流産はここで即EVENT_ESCAPEせず、関数末尾の@行為終了予約で予約し
	;　EVENTCOMENDの安全地点で消化する。即時に呼ぶとSOURCE.ERBの中出し処理途中で
	;　行為対象が消え、後続の性病感染チェックが壊れるため。
	TCVAR:MASTER:衰弱 = 1
	;翌朝、病院（地区2・場所13）で目覚める。EVENTTRAINの開始位置リセットを上書きする
	FLAG:就寝地区 = 2
	FLAG:就寝位置 = 13
	FLAG:流産後入院 = 1
	;移動状態の残留をクリア
	CFLAG:MASTER:乗車 = 0
	TCVAR:MASTER:目的地区 = 0
	TCVAR:MASTER:目的位置 = 0
	CFLAG:MASTER:到着地区 = 0
	CFLAG:MASTER:到着位置 = 0
	CFLAG:MASTER:到着時間 = 0
ENDIF
;流産回数を加算
CFLAG:ARG:流産回数 += 1
;大量出血とともに膣内に溜まっていた精液も洗い流される
CALL 膣内精液_全排出(ARG)
;状態リセット（体型回復・産後回復期の設定・切迫流産度クリアまで既存関数に委譲）
CALL 妊娠中断(ARG)
;行為(H/調教/痴漢)中の流産なら行為の強制終了を予約(EVENTCOMENDの安全地点で消化)
CALL 行為終了予約(ARG)
RETURN

;----------------------------------------------------------------
;陣痛誘発チェック（妊娠後期の激しい運動・膣内射精などで早産/陣痛を誘発）
; ARG=母、ARG:1=誘発強度(%)。臨月は正規誘発、60%〜臨月前は早産(低確率)
;----------------------------------------------------------------
@陣痛誘発チェック(ARG,ARG:1)
;女性・妊娠中・未陣痛のみ
SIF !GETBIT(TALENT:ARG:性別,0)
	RETURN
SIF !TALENT:ARG:妊娠 || CFLAG:ARG:陣痛 > 0
	RETURN
VARSET LOCAL
;LOCAL:1=出産予定日数
LOCAL:1 = 出産予定日数(ARG)
IF CFLAG:ARG:妊娠日数 >= LOCAL:1 - 5
	;=== 臨月（予定日の5日前以降）：正規の陣痛誘発 ===
	;予定日が近いほど誘発されやすい
	LOCAL = ARG:1 + (CFLAG:ARG:妊娠日数 - (LOCAL:1 - 5)) * 3
	;多胎はさらに誘発されやすい
	SIF CFLAG:ARG:胎児数 >= 2
		LOCAL += 10
	IF RAND(100) < LOCAL
		STR:0 = 下腹部に、これまでとは違う強い張りと差し込むような痛みが走った……！
		CALL 陣痛ログ(ARG)
		CALL 陣痛開始(ARG)
	ENDIF
ELSE
	;=== 早産帯（進行率60%〜臨月前）：低確率の早産 ===
	SIF FLAG:早産率 == 0
		RETURN
	;進行率(%)
	LOCAL:2 = CFLAG:ARG:妊娠日数 * 100 / LOCAL:1
	SIF LOCAL:2 < 60
		RETURN
	;臨月に近いほど誘発されやすい（60%で0→臨月直前で強度相当）
	LOCAL = ARG:1 * (LOCAL:2 - 60) / 40
	;多胎はさらに誘発されやすい
	SIF CFLAG:ARG:胎児数 >= 2
		LOCAL += 5
	;設定倍率を適用
	LOCAL = LOCAL * FLAG:早産率 / 100
	IF RAND(100) < LOCAL
		IF ARG == MASTER
			STR:0 = お腹が石のように強く張り、周期的な痛みが走り始めた……予定日にはまだ早いのに。
			CALL 陣痛ログ(ARG)
		ENDIF
		CALL 陣痛開始(ARG)
	ENDIF
ENDIF
RETURN

;----------------------------------------------------------------
;陣痛開始（予定日に達したとき、または誘発されたとき）
; 破水が先(前期破水)か、陣痛が先で途中で破水(適時破水)かをランダムに決める
;----------------------------------------------------------------
@陣痛開始(ARG)
CFLAG:ARG:陣痛 = 1
CFLAG:ARG:破水済 = 0
SIF ARG == MASTER
	PRINTL
SIF ARG == MASTER
	PRINTFORML %"=" * 107%
IF RAND(100) < FLAG:早期破水率
	;前期破水：破水が先に起きてから陣痛
	CFLAG:ARG:破水済 = 1
	IF ARG == MASTER
		STR:0 = まだ痛みも来ていないのに、股の間から生温かい液体がどっと溢れ出した……破水だ。
		CALL 陣痛ログ(ARG)
		CALL 妊娠口上(8, ARG, CFLAG:ARG:父親)
		STR:0 = それを追うように、下腹部に規則的な陣痛が始まった。
		CALL 陣痛ログ(ARG)
	ENDIF
ELSE
	;陣痛先行：まだ破水はしていない（後で適時破水する）
	IF ARG == MASTER
		STR:0 = 下腹部に規則的な痛み――陣痛が始まった。
		CALL 陣痛ログ(ARG)
		CALL 妊娠口上(4, ARG, CFLAG:ARG:父親)
	ENDIF
ENDIF
;行為(H/調教/痴漢)中に陣痛が始まった場合は行為の強制終了を予約(EVENTCOMENDの安全地点で消化)
CALL 行為終了予約(ARG)
RETURN

;----------------------------------------------------------------
;分娩到達値（陣痛開始〜分娩の総所要「分」）。基礎720分 × 陣痛時間倍率
; ARG=対象。旧セーブ(倍率0)は標準100扱い。フェーズしきい値はこの比率で算出する
;----------------------------------------------------------------
@陣痛_満了(ARG)
#FUNCTION
LOCAL = FLAG:陣痛時間倍率
SIF LOCAL <= 0
	LOCAL = 100
RETURNF MAX(1, 720 * LOCAL / 100)

;----------------------------------------------------------------
;陣痛の進行（TIME_COUNT から時間経過分だけ呼ぶ）
; ARG=対象、ARG:1=経過分。陣痛カウンタ(分)を積算し閾値でフェーズが進む
;  フェーズは満了値の比率：本格化(1/6)→活動期(1/2)→移行期(3/4)→娩出期(11/12)→娩出(満了)
;  1回あたりの進行は30分で頭打ち（長時間行動でフェーズを飛ばさない）。破水後は加速。
;  地の文・口上はMASTERのみ（NPCは無音で進行）
;  フェーズ境界とは別に「陣痛の波」の反応セリフ（妊娠口上14〜17）が周期的に出る。
;  波の間隔はフェーズが進むほど短い（満了/8→/12→/24→/48）＝陣痛間隔の短縮を再現。
;  境界メッセージ・破水と同じ呼び出しでは波を出さない（LOCAL:3 で抑制）
;----------------------------------------------------------------
@陣痛_進行(ARG,ARG:1)
SIF CFLAG:ARG:陣痛 <= 0
	RETURN
;多胎の児と児のあいだ（次の児を待つ小休止）は専用の進行に分ける
IF CFLAG:ARG:分娩残 > 0
	CALL 分娩_次児待機_進行(ARG, ARG:1)
	RETURN
ENDIF
VARSET LOCAL
;LOCAL=加算前の陣痛値、LOCAL:1=実効経過分（上限30・破水後は加速）、LOCAL:2=分娩到達値(満了)
LOCAL = CFLAG:ARG:陣痛
LOCAL:2 = 陣痛_満了(ARG)
;1回あたりの進行に上限を設ける（入浴・バイト等の長時間行動で一気に飛ばさない）
LOCAL:1 = MIN(ARG:1, 30)
;破水後は陣痛が強まり進行が速くなる（約1.3倍）
SIF CFLAG:ARG:破水済
	LOCAL:1 += LOCAL:1 / 3
CFLAG:ARG:陣痛 += LOCAL:1
;プレイヤーは陣痛で消耗し、フェーズごとに描写・口上
IF ARG == MASTER
	;移行期(満了×3/4)以降は消耗が激しくなる
	IF CFLAG:ARG:陣痛 >= LOCAL:2 * 3 / 4
		BASE:ARG:体力 = MAX(0, BASE:ARG:体力 - LOCAL:1 * 3)
		BASE:ARG:気力 = MAX(0, BASE:ARG:気力 - LOCAL:1 * 3)
	ELSE
		BASE:ARG:体力 = MAX(0, BASE:ARG:体力 - LOCAL:1 * 2)
		BASE:ARG:気力 = MAX(0, BASE:ARG:気力 - LOCAL:1 * 2)
	ENDIF
	;潜伏期→本格化：規則的な陣痛が確立する
	IF LOCAL < LOCAL:2 / 6 && CFLAG:ARG:陣痛 >= LOCAL:2 / 6
		STR:0 = 陣痛の波が、一定の間隔をおいて規則的に訪れるようになった。
		CALL 陣痛ログ(ARG)
		LOCAL:3 = 1
	ENDIF
	;活動期：間隔が短くなり痛みが激化する
	IF LOCAL < LOCAL:2 / 2 && CFLAG:ARG:陣痛 >= LOCAL:2 / 2
		STR:0 = 陣痛の間隔が短くなり、痛みが激しくなってきた……。
		CALL 陣痛ログ(ARG)
		CALL 妊娠口上(6, ARG, CFLAG:ARG:父親)
		LOCAL:3 = 1
	ENDIF
	;移行期：陣痛のピーク。波が途切れず、いきみ衝動が芽生える
	IF LOCAL < LOCAL:2 * 3 / 4 && CFLAG:ARG:陣痛 >= LOCAL:2 * 3 / 4
		STR:0 = 陣痛の波がほとんど途切れなくなり、腰が砕けそうな圧迫感が押し寄せる。奥の方から、いきみたくなるような衝動がこみ上げてきた……！
		CALL 陣痛ログ(ARG)
		CALL 妊娠口上(10, ARG, CFLAG:ARG:父親)
		LOCAL:3 = 1
	ENDIF
	;娩出期：児頭が下降し、抗えないいきみ感に襲われる
	IF LOCAL < LOCAL:2 * 11 / 12 && CFLAG:ARG:陣痛 >= LOCAL:2 * 11 / 12
		STR:0 = 赤ちゃんの頭が産道をぐいぐいと押し下げてくる。もう、いきむのを我慢できない……！
		CALL 陣痛ログ(ARG)
		CALL 妊娠口上(11, ARG, CFLAG:ARG:父親)
		LOCAL:3 = 1
	ENDIF
ENDIF
;陣痛先行だった場合、進行後半（満了×2/3）で破水（適時破水）
IF !CFLAG:ARG:破水済 && CFLAG:ARG:陣痛 >= LOCAL:2 * 2 / 3
	CFLAG:ARG:破水済 = 1
	IF ARG == MASTER
		STR:0 = 一段と強い痛みとともに、股の間から大量の生温かい液体が溢れ出した……破水だ。
		CALL 陣痛ログ(ARG)
		CALL 妊娠口上(8, ARG, CFLAG:ARG:父親)
		LOCAL:3 = 1
	ENDIF
ENDIF
;陣痛の波：本格化以降、波の間隔（LOCAL:4）の倍数をまたぐたびに反応セリフ（LOCAL:5=状況ID）
;（境界・破水のメッセージが出た呼び出しでは出さない。分娩到達時も出産描写に譲る）
IF ARG == MASTER && LOCAL:3 == 0 && CFLAG:ARG:陣痛 < LOCAL:2
	IF CFLAG:ARG:陣痛 >= LOCAL:2 * 11 / 12
		LOCAL:4 = MAX(1, LOCAL:2 / 48)
		LOCAL:5 = 17
	ELSEIF CFLAG:ARG:陣痛 >= LOCAL:2 * 3 / 4
		LOCAL:4 = MAX(1, LOCAL:2 / 24)
		LOCAL:5 = 16
	ELSEIF CFLAG:ARG:陣痛 >= LOCAL:2 / 2
		LOCAL:4 = MAX(1, LOCAL:2 / 12)
		LOCAL:5 = 15
	ELSEIF CFLAG:ARG:陣痛 >= LOCAL:2 / 6
		LOCAL:4 = MAX(1, LOCAL:2 / 8)
		LOCAL:5 = 14
	ENDIF
	;潜伏期（LOCAL:4=0）はゼロ除算を避けるため間隔判定に入らない
	IF LOCAL:4 > 0
		SIF LOCAL / LOCAL:4 != CFLAG:ARG:陣痛 / LOCAL:4
			CALL 妊娠口上(LOCAL:5, ARG, CFLAG:ARG:父親)
	ENDIF
ENDIF
;分娩到達
SIF CFLAG:ARG:陣痛 >= LOCAL:2
	CALL 出産(ARG)
RETURN

;----------------------------------------------------------------
;出産（分娩）
; 多胎は1児ずつのイベントに分割し、児と児のあいだに小休止（@分娩_次児待機）を挟む。
; 小休止のあいだプレイヤーは移動などの行動が取れ、時間経過（TIME_COUNT→@陣痛_進行→
; @分娩_次児待機_進行）が猶予を使い切ると改めてここが呼ばれて次の児が娩出される。
; 進行状態は CFLAG:分娩残（残りの児数）と CFLAG:分娩済（娩出済みの児数）で保持する。
; NPCは報告1行で済み分割する意味がないため、従来どおり一括で娩出する（@出産_NPC）。
;----------------------------------------------------------------
;ARG=母、ARG:1=1で病院での介助分娩（消耗軽減）
@出産(ARG,ARG:1)
VARSET LOCAL
IF ARG != MASTER
	CALL 出産_NPC(ARG)
	RETURN
ENDIF
PRINTL
PRINTFORML %"=" * 107%
;分娩開始（1児目）の初期化
IF CFLAG:ARG:分娩残 <= 0
	;胎児数（未設定は単胎扱い）
	CFLAG:ARG:分娩残 = MAX(1, CFLAG:ARG:胎児数)
	CFLAG:ARG:分娩済 = 0
	;産後の回復期を確定（胎児数リセット前に妊娠期間から算出。この間は妊娠しない）
	CFLAG:ARG:産後回復 = 産後回復日数算出(ARG)
ENDIF
;いきみ（娩出直前）の口上。多胎は児ごとに娩出があるため、児ごとに出す
CALL 妊娠口上(7, ARG, CFLAG:ARG:父親)
;この1児を娩出（介助の有無は児ごとに判定＝小休止の間に病院へ移れば以後は介助になる）
LOCAL = 分娩介助中(ARG, ARG:1)
CALL 出産_1児娩出(ARG, LOCAL)
CFLAG:ARG:分娩済 += 1
CFLAG:ARG:分娩残 -= 1
;まだ残っていれば次の児までの小休止へ。ここで一度イベントを閉じ、操作をプレイヤーに返す
IF CFLAG:ARG:分娩残 > 0
	CALL 分娩_次児待機(ARG)
	RETURN
ENDIF
;全児娩出。後産・締めと母体の状態更新
CALL 出産_完了(ARG)
RETURN

;----------------------------------------------------------------
;いま介助分娩か（＝病院にいるか）
; ARG=母、ARG:1=呼び出し元が明示した介助フラグ。
; 2児目以降は時間経過から ARG:1=0 で呼ばれるため、現在地からも判定する
;----------------------------------------------------------------
@分娩介助中(ARG,ARG:1)
#FUNCTION
SIF ARG:1
	RETURNF 1
SIF ARG != MASTER
	RETURNF 0
;病院：ゾーン2は場所13、それ以外は駅前商店街の病院（ゾーン0・場所12）＝@病院_場所移動と同じ
SIF CFLAG:ARG:現在地区 == 2 && CFLAG:ARG:現在位置 == 13
	RETURNF 1
SIF CFLAG:ARG:現在地区 == 0 && CFLAG:ARG:現在位置 == 12
	RETURNF 1
RETURNF 0

;----------------------------------------------------------------
;分娩中か（多胎で次の児を待っている最中を含む）。表示側の判定用
;----------------------------------------------------------------
@分娩中(ARG)
#FUNCTION
RETURNF CFLAG:ARG:分娩残 > 0

;----------------------------------------------------------------
;1児の娩出（描写と消耗）
; ARG=母、ARG:1=1で介助分娩。何人目かは CFLAG:分娩済 から求める
;----------------------------------------------------------------
@出産_1児娩出(ARG,ARG:1)
VARSET LOCAL
;LOCAL=これから娩出する児が何人目か
LOCAL = CFLAG:ARG:分娩済 + 1
IF LOCAL == 1
	;―― 一人目 ――
	IF ARG:1
		;病院での介助分娩
		STR:0 = 医師と助産師の誘導に合わせていきむと、やがて元気な産声が分娩室に響いた。
		CALL 陣痛ログ(ARG)
		;単胎ならここで分娩は終わり。多胎なら締めは全児娩出後に回す
		IF CFLAG:ARG:分娩残 <= 1
			STR:0 = 介助のおかげもあり、あなたは比較的落ち着いて出産を終えた。
			CALL 陣痛ログ(ARG)
		ENDIF
	ELSE
		;その場での分娩
		STR:0 = いきみたくなるような強烈な痛みが押し寄せる……もう、限界……！
		CALL 陣痛ログ(ARG)
		STR:0 = 「――っ、あ、あああぁぁっ！！」
		CALL 陣痛ログ(ARG)
		STR:0 = 一際大きないきみとともに、あなたは新しい命をこの世に産み落とした。
		CALL 陣痛ログ(ARG)
	ENDIF
	CALL 出産_消耗(ARG, ARG:1, 0)
ELSE
	;―― 二人目以降 ――
	;産道は開いたまま。二人目以降は下降が速い一方、休みきれない体に負担が重なる
	IF LOCAL >= 3
		STR:0 = 息を継ぐ間もない。開ききった産道を次の子が滑り降りてきて、休みきれていない体が悲鳴を上げる。
	ELSE
		STR:0 = 一人目が通ったばかりの産道はまだ開いたままで、次の子はためらいなく下りてくる。
	ENDIF
	CALL 陣痛ログ(ARG)
	;いきみ〜娩出。介助の有無で描写を変える
	IF ARG:1
		STR:0 = 「はい、息を吐いて――そこでもう一度」。医師の声に導かれ、あなたは残った力を振り絞った。
	ELSE
		STR:0 = 誰の手も借りられないまま、あなたは震える膝を立て直し、自分の呼吸だけを頼りにいきんだ。
	ENDIF
	CALL 陣痛ログ(ARG)
	;産声
	STR:0 = ほどなくして、{LOCAL}人目の産声が上がった。
	CALL 陣痛ログ(ARG)
	;この一児分の消耗
	CALL 出産_消耗(ARG, ARG:1, 1)
ENDIF
RETURN

;----------------------------------------------------------------
;次の児までの小休止に入る（多胎）
; 陣痛カウンタを分娩到達値の手前まで巻き戻し、次の児が下りてくるまでの猶予を作る。
; 猶予のあいだプレイヤーは行動でき、1行動あたりの進行は30分で頭打ち（@分娩_次児待機_進行）。
;----------------------------------------------------------------
@分娩_次児待機(ARG)
VARSET LOCAL
;LOCAL:2=分娩到達値、LOCAL=次の児までの猶予(分)。到達値の5〜10%（標準720分なら36〜71分）
LOCAL:2 = 陣痛_満了(ARG)
LOCAL:1 = MAX(5, LOCAL:2 * 5 / 100)
LOCAL = LOCAL:1 + RAND(LOCAL:1)
CFLAG:ARG:陣痛 = MAX(1, LOCAL:2 - LOCAL)
;次の児の卵膜はまだ破れていない（猶予の後半で破水する）
CFLAG:ARG:破水済 = 0
;LOCAL:3=次に産まれるのが何人目か
LOCAL:3 = CFLAG:ARG:分娩済 + 1
;緩みかけた腹に再び陣痛が戻る。健診で多胎を知っていたかで受け止め方が変わる
IF CFLAG:ARG:健診済
	STR:0 = 聞いていた通りだった。医師が頷き、次の子への準備を始める。緩みかけたお腹が、また少しずつ硬く張りつめてきた。
	CALL 陣痛ログ(ARG)
ELSEIF LOCAL:3 == 2
	STR:0 = ――ところが、産み終えて安堵したのも束の間、引いたはずの陣痛が再びこみ上げてくる。……まだ、終わっていなかったのか。
	CALL 陣痛ログ(ARG)
	;多胎に気づく口上（キャラ別があれば優先、無ければ共通）。驚くのは最初の一度だけ
	CALL 妊娠口上(9, ARG, CFLAG:ARG:父親)
ELSE
	STR:0 = 終わったはずのお腹が、三度（みたび）硬くなる。――まだ、終わっていなかった。
	CALL 陣痛ログ(ARG)
ENDIF
;猶予があることを伝える（この間はプレイヤーが行動できる）
IF CFLAG:ARG:分娩残 >= 2
	STR:0 = 次の子が下りてくるまでには、まだ少し間がありそうだ。お腹にはあと{CFLAG:ARG:分娩残}人が残っている。
ELSE
	STR:0 = 次の子が下りてくるまでには、まだ少し間がありそうだ。
ENDIF
CALL 陣痛ログ(ARG)
RETURN

;----------------------------------------------------------------
;小休止の進行（@陣痛_進行から分岐して呼ばれる）
; ARG=対象、ARG:1=経過分。猶予を使い切ると次の児の娩出＝@出産へ入る
;----------------------------------------------------------------
@分娩_次児待機_進行(ARG,ARG:1)
VARSET LOCAL
;LOCAL=加算前の陣痛値、LOCAL:2=分娩到達値、LOCAL:1=実効経過分（長時間行動で猶予を飛ばさないよう30分で頭打ち）
;LOCAL:3=このターンに地の文を出した、LOCAL:4=波の間隔
LOCAL:2 = 陣痛_満了(ARG)
LOCAL:1 = MIN(ARG:1, 30)
LOCAL = CFLAG:ARG:陣痛
CFLAG:ARG:陣痛 = MIN(LOCAL:2, CFLAG:ARG:陣痛 + LOCAL:1)
;小休止のあいだも体は削られ続ける（娩出そのものよりは軽い）
IF ARG == MASTER
	BASE:ARG:体力 = MAX(0, BASE:ARG:体力 - LOCAL:1 * 2)
	BASE:ARG:気力 = MAX(0, BASE:ARG:気力 - LOCAL:1 * 2)
ENDIF
;猶予の終盤で次の児の破水。以後は「そろそろ生まれる」と分かる
IF !CFLAG:ARG:破水済 && LOCAL:2 - CFLAG:ARG:陣痛 <= MAX(5, LOCAL:2 / 48)
	CFLAG:ARG:破水済 = 1
	IF ARG == MASTER
		STR:0 = 再び股の間から生温かい液体が流れ出した。次の子を包む膜が破れたのだ。陣痛の波が一気に強まる。
		CALL 陣痛ログ(ARG)
		STR:0 = ……そろそろ、次の子が生まれる。
		CALL 陣痛ログ(ARG)
		LOCAL:3 = 1
	ENDIF
ENDIF
;次の児を待つあいだも陣痛の波は続く（間隔は娩出期と同じ。反応セリフは状況17を流用）
;破水の地の文を出した回は出さない。猶予を使い切る回は娩出描写に譲る
IF ARG == MASTER && LOCAL:3 == 0 && CFLAG:ARG:陣痛 < LOCAL:2
	LOCAL:4 = MAX(1, LOCAL:2 / 48)
	SIF LOCAL / LOCAL:4 != CFLAG:ARG:陣痛 / LOCAL:4
		CALL 妊娠口上(17, ARG, CFLAG:ARG:父親)
ENDIF
;猶予を使い切ったら次の児を娩出（介助の有無は@出産側で現在地から判定する）
SIF CFLAG:ARG:陣痛 >= LOCAL:2
	CALL 出産(ARG, 0)
RETURN

;----------------------------------------------------------------
;分娩の終了（全児娩出後の後産・締めと母体の状態更新）
; ARG=母。産んだ児数は CFLAG:分娩済 から求める
;----------------------------------------------------------------
@出産_完了(ARG)
VARSET LOCAL
;LOCAL=今回の分娩で産んだ児数
LOCAL = MAX(1, CFLAG:ARG:分娩済)
IF ARG == MASTER
	;多胎の締め（単胎の締めは1児目の描写に含まれる）
	IF LOCAL >= 2
		STR:0 = やがて後産が下り、長かった分娩がようやく終わりを迎えた。
		CALL 陣痛ログ(ARG)
		IF CFLAG:ARG:健診済
			STR:0 = あなたは{LOCAL}人の赤ちゃんを、無事に産み終えた。
		ELSE
			STR:0 = 結局、あなたは{LOCAL}人もの赤ちゃんを産んでいたのだ。
		ENDIF
		CALL 陣痛ログ(ARG)
	ENDIF
	;出産直後の口上
	CALL 妊娠口上(5, ARG, CFLAG:ARG:父親)
ENDIF
;状態更新
TALENT:ARG:妊娠 = 0
CFLAG:ARG:妊娠日数 = 0
CFLAG:ARG:陣痛 = 0
CFLAG:ARG:破水済 = 0
CFLAG:ARG:健診済 = 0
CFLAG:ARG:父親 = 0
CFLAG:ARG:出産回数 += 1
CFLAG:ARG:子供数 += LOCAL
CFLAG:ARG:胎児数 = 0
;分娩の進行状態をクリア（次の分娩へ持ち越さない）
CFLAG:ARG:分娩残 = 0
CFLAG:ARG:分娩済 = 0
CFLAG:ARG:分娩費用済 = 0
;お腹の段階・自覚をリセット
CFLAG:ARG:腹段階 = 0
CFLAG:ARG:妊娠自覚 = 0
;切迫流産度もクリア（次の妊娠へ持ち越さない）
CFLAG:ARG:切迫流産度 = 0
CFLAG:ARG:最終母体負荷日 = 0
;母体の変化：お腹は即時にある程度へこみ、以後は日次処理でゆっくり戻る（バスト・ヒップは徐々に恒久増）
CALL 出産_3サイズ変化(ARG)
;妊娠のバレ状態を全員分クリア（次の妊娠に持ち越さない）
FOR LOCAL:2, 0, CHARANUM
	CFLAG:(LOCAL:2):(3300 + ARG) = 0
NEXT
;出産で子宮内・膣内に溜まっていた精液を排出（産道を通って洗い流される）
CALL 膣内精液_全排出(ARG)
TALENT:ARG:母性 = 1
TALENT:ARG:育児中 = 1
CFLAG:ARG:育児日数 = 30
;母乳が出るようになる
TALENT:ARG:母乳体質 = 1
;行為(H/調教/痴漢)中の出産なら行為の強制終了を予約(陣痛開始時に終了済みのはずだが、
;陣痛中に改めて行為が始まった場合のセーフティネット。EVENTCOMENDの安全地点で消化)
CALL 行為終了予約(ARG)
RETURN

;----------------------------------------------------------------
;NPCの出産（分割せず一括。報告1行と母体の状態更新のみ）
;----------------------------------------------------------------
@出産_NPC(ARG)
VARSET LOCAL
;LOCAL=胎児数（未設定は単胎扱い）
LOCAL = MAX(1, CFLAG:ARG:胎児数)
;産後の回復期を確定（胎児数リセット前に妊娠期間から算出。この間は妊娠しない）
CFLAG:ARG:産後回復 = 産後回復日数算出(ARG)
PRINTL
PRINTFORML %"=" * 107%
IF LOCAL >= 2
	PRINTFORMW %CALLNAME:ARG%は破水と陣痛の末に{LOCAL}人の子を出産し、母親になった。
ELSE
	PRINTFORMW %CALLNAME:ARG%は破水と陣痛の末に出産し、母親になった。
ENDIF
CFLAG:ARG:分娩済 = LOCAL
CALL 出産_完了(ARG)
RETURN

;----------------------------------------------------------------
;分娩1児あたりの消耗
; ARG=母、ARG:1=1で病院の介助分娩、ARG:2=1で二人目以降
;  ・介助あり：消耗が半分で済む
;  ・二人目以降：産道が開いている分だけ体力の目減りは小さいが、
;    分娩が長引くぶん気力の消耗は一人目に近い重さで残る
; ※従来は健診済/未健診で式が非対称（三つ子で気力減が33%と67%）だった。
;   健診の有無は演出の差であって体力差ではないため、ここでは区別しない。
;----------------------------------------------------------------
@出産_消耗(ARG,ARG:1,ARG:2)
VARSET LOCAL
;LOCAL=体力の除数、LOCAL:1=気力の除数（値が大きいほど消耗は小さい）
IF ARG:2
	;二人目以降
	LOCAL   = 6
	LOCAL:1 = 5
ELSE
	;一人目
	LOCAL   = 2
	LOCAL:1 = 2
ENDIF
;病院の介助分娩は消耗が半減
IF ARG:1
	LOCAL   *= 2
	LOCAL:1 *= 2
ENDIF
BASE:ARG:体力 = MAX(0, BASE:ARG:体力 - MAXBASE:ARG:体力 / LOCAL)
BASE:ARG:気力 = MAX(0, BASE:ARG:気力 - MAXBASE:ARG:気力 / LOCAL:1)
RETURN

;----------------------------------------------------------------
;精液量の表現（ステータス表示用の文字列を返す）
;----------------------------------------------------------------
@精液量_名(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE IS >= 800
		RETURNF "大量"
	CASE IS >= 300
		RETURNF "中量"
	CASEELSE
		RETURNF "少量"
ENDSELECT

;----------------------------------------------------------------
;生理周期の初期化（EVENTFIRST から呼ぶ。全女性を非同期化）
;----------------------------------------------------------------
@生理周期_INIT
VARSET LOCAL
FOR LOCAL,0,CHARANUM
	SIF GETBIT(TALENT:LOCAL:性別,0)
		CFLAG:LOCAL:生理周期 = RAND(28)
NEXT
RETURN

;================================================================
; 妊娠システムの設定（設定値は FLAG:60-65 に保存＝セーブに残る）
;================================================================

;----------------------------------------------------------------
;設定の初期化（EVENTFIRST / EVENTLOAD から呼ぶ）
; 既定値未投入のセーブにだけ標準値を入れる（ユーザー変更は保持）
;----------------------------------------------------------------
@妊娠設定_INIT
SIF FLAG:妊娠設定済
	RETURN
CALL 妊娠設定_既定値
RETURN

;----------------------------------------------------------------
;設定を標準値に戻す
;----------------------------------------------------------------
@妊娠設定_既定値
FLAG:妊娠機能 = 1
FLAG:妊娠確率倍率 = 100
FLAG:妊娠期間倍率 = 100
FLAG:多胎率 = 3
FLAG:三つ子率 = 10
FLAG:確実妊娠 = 0
;0＝自動（妊娠期間の1/8・切り上げ）。正の値で固定日数
FLAG:産後回復日数 = 0
;妊娠中リスク（標準値）
FLAG:流産率 = 100
FLAG:早産率 = 100
FLAG:早期破水率 = 40
;陣痛開始〜分娩の長さ倍率（%）。標準100・大きいほど長い
FLAG:陣痛時間倍率 = 100
FLAG:妊娠設定済 = 1
RETURN

;----------------------------------------------------------------
;ON/OFF の表示名
;----------------------------------------------------------------
@設定_ONOFF名(ARG)
#FUNCTIONS
SIF ARG
	RETURNF "有効"
RETURNF "無効"

;----------------------------------------------------------------
;数値設定の入力（対象FLAGを範囲内で更新）
; ARG=FLAG番号、ARG:1=最小、ARG:2=最大
;----------------------------------------------------------------
@設定_数値入力(ARG,ARG:1,ARG:2)
PRINTFORML 　新しい値を入力してください（{ARG:1}〜{ARG:2}）。現在値：{FLAG:(ARG)}
INPUT
FLAG:(ARG) = LIMIT(RESULT, ARG:1, ARG:2)
PRINTFORML 　→ {FLAG:(ARG)} に設定しました。
RETURN

;----------------------------------------------------------------
;妊娠期間の日数入力（単胎基準の日数→倍率FLAG:62に変換して保存）
;----------------------------------------------------------------
@設定_妊娠期間入力
PRINTFORML 　新しい妊娠期間を日数で入力してください（10〜160日）。現在値：{FLAG:妊娠期間倍率 * 40 / 100}日
INPUT
LOCAL = LIMIT(RESULT, 10, 160)
;倍率へ切り上げ変換（表示との往復が一致する）
FLAG:妊娠期間倍率 = (LOCAL * 100 + 39) / 40
PRINTFORML 　→ {FLAG:妊娠期間倍率 * 40 / 100}日 に設定しました。
RETURN

;----------------------------------------------------------------
;妊娠設定画面（SHOP の設定メニュー @SCHEDULE から呼ぶ）
;----------------------------------------------------------------
@妊娠設定画面
$SETTING_LOOP
PRINTL
PRINTFORML %"=" * 60%
PRINTL 　【妊娠システム設定】
DRAWLINE
PRINTFORML [1] 妊娠機能　　　：%設定_ONOFF名(FLAG:妊娠機能)%（OFFにすると妊娠中も中断）
PRINTFORML [2] 妊娠しやすさ　：{FLAG:妊娠確率倍率}％（基礎確率への倍率・標準100・0で妊娠しない）
PRINTFORML [3] 妊娠期間　　　：{FLAG:妊娠期間倍率 * 40 / 100}日（標準40日・単胎基準、双子/三つ子はやや早まる）
PRINTFORML [4] 多胎率（基礎）：{FLAG:多胎率}％（標準3）
PRINTFORML [5] 三つ子率　　　：{FLAG:三つ子率}％（多胎時に三つ子となる割合・標準10）
PRINTFORML [6] 確実に妊娠　　：%設定_ONOFF名(FLAG:確実妊娠)%（ONの間は膣内射精で必ず妊娠）
IF FLAG:産後回復日数 > 0
	PRINTFORML [7] 産後回復　　　：{FLAG:産後回復日数}日（固定・0で自動）
ELSE
	PRINTFORML [7] 産後回復　　　：自動（妊娠期間の1/8・切り上げ／0で自動・正数で固定日数）
ENDIF
DRAWLINE
PRINTFORML [8] 流産率　　　　：{FLAG:流産率}％（妊娠初期の中出し・激しい運動で切迫流産・標準100・0で流産しない）
PRINTFORML [9] 早産率　　　　：{FLAG:早産率}％（臨月前の陣痛誘発・標準100・0で早産しない）
PRINTFORML [10] 早期破水率　 ：{FLAG:早期破水率}％（破水が陣痛に先行する確率・標準40・0で常に陣痛先行・100で常に前期破水）
PRINTFORML [11] 陣痛時間倍率 ：{FLAG:陣痛時間倍率}％（陣痛開始〜分娩の長さ・標準100・大きいほど長い）
DRAWLINE
PRINTL [12] 標準設定に戻す　　[0] 閉じる
$SETTING_INPUT
INPUT
SELECTCASE RESULT
	CASE 0
		RETURN
	CASE 1
		;妊娠機能 ON/OFF トグル
		IF FLAG:妊娠機能
			;OFFにする：妊娠中がいれば確認のうえ中断
			CALL 妊娠機能_OFF処理
		ELSE
			FLAG:妊娠機能 = 1
		ENDIF
	CASE 2
		;61=妊娠確率倍率
		CALL 設定_数値入力(61, 0, 1000)
	CASE 3
		;62=妊娠期間倍率（入力は日数、内部は倍率で保存）
		CALL 設定_妊娠期間入力
	CASE 4
		;63=多胎率
		CALL 設定_数値入力(63, 0, 100)
	CASE 5
		;64=三つ子率
		CALL 設定_数値入力(64, 0, 100)
	CASE 6
		;確実に妊娠 ON/OFF トグル
		FLAG:確実妊娠 = !FLAG:確実妊娠
	CASE 7
		;67=産後回復日数
		CALL 設定_数値入力(67, 0, 365)
	CASE 8
		;68=流産率
		CALL 設定_数値入力(68, 0, 500)
	CASE 9
		;69=早産率
		CALL 設定_数値入力(69, 0, 500)
	CASE 10
		;73=早期破水率
		CALL 設定_数値入力(73, 0, 100)
	CASE 11
		;74=陣痛時間倍率
		CALL 設定_数値入力(74, 25, 400)
	CASE 12
		CALL 妊娠設定_既定値
		PRINTL 　標準設定に戻しました。
	CASEELSE
		CLEARLINE 1
		GOTO SETTING_INPUT
ENDSELECT
GOTO SETTING_LOOP

;----------------------------------------------------------------
;妊娠機能をOFFにする処理（進行中の妊娠を中断するか確認）
;----------------------------------------------------------------
@妊娠機能_OFF処理
VARSET LOCAL
;妊娠中のキャラ数を数える
LOCAL:1 = 0
FOR LOCAL,0,CHARANUM
	SIF TALENT:LOCAL:妊娠
		LOCAL:1 ++
NEXT
;妊娠中がいなければそのままOFF
IF LOCAL:1 <= 0
	FLAG:妊娠機能 = 0
	RETURN
ENDIF
;確認
PRINTFORML 　妊娠中のキャラが{LOCAL:1}人います。OFFにすると、これらの妊娠も中断されます。
PRINTL 　よろしいですか？　[1] はい　[0] いいえ
$OFF_CONFIRM
INPUT
SELECTCASE RESULT
	CASE 1
		;中断を実行
	CASE 0
		PRINTL 　OFFを取りやめました。
		RETURN
	CASEELSE
		CLEARLINE 1
		GOTO OFF_CONFIRM
ENDSELECT
CALL 妊娠_全解除
FLAG:妊娠機能 = 0
PRINTFORML 　妊娠中だった{LOCAL:1}人の妊娠を中断しました。
RETURN

;----------------------------------------------------------------
;全キャラの妊娠を中断（妊娠機能OFF時）
;----------------------------------------------------------------
@妊娠_全解除
VARSET LOCAL
FOR LOCAL,0,CHARANUM
	IF TALENT:LOCAL:妊娠
		CALL 妊娠中断(LOCAL)
	ELSEIF CFLAG:LOCAL:受精卵日数 > 0
		;着床待ちの受精卵も消す
		CFLAG:LOCAL:受精卵日数 = 0
		CFLAG:LOCAL:着床所要日数 = 0
		CFLAG:LOCAL:父親 = 0
		CFLAG:LOCAL:胎児数 = 0
	ENDIF
NEXT
RETURN

;----------------------------------------------------------------
;妊娠の中断（1キャラ）。出産による付与（母性・育児・経産数）は行わない
; ARG=対象
;----------------------------------------------------------------
@妊娠中断(ARG)
VARSET LOCAL
;妊娠中に膨らんだ体型の回復期を開始（妊娠日数・胎児数のクリア前に呼ぶ。恒久変化は与えない）
CALL 妊娠_3サイズ_中断回復(ARG)
TALENT:ARG:妊娠 = 0
CFLAG:ARG:妊娠日数 = 0
CFLAG:ARG:陣痛 = 0
CFLAG:ARG:破水済 = 0
CFLAG:ARG:健診済 = 0
CFLAG:ARG:父親 = 0
CFLAG:ARG:胎児数 = 0
;分娩の進行状態（多胎の途中で中断された場合）もクリアする
CFLAG:ARG:分娩残 = 0
CFLAG:ARG:分娩済 = 0
CFLAG:ARG:分娩費用済 = 0
CFLAG:ARG:腹段階 = 0
CFLAG:ARG:妊娠自覚 = 0
;切迫流産度もクリア（次の妊娠へ持ち越さない）
CFLAG:ARG:切迫流産度 = 0
CFLAG:ARG:最終母体負荷日 = 0
;着床待ちの受精卵も消す（妊娠中は本来共存しないが念のため）
CFLAG:ARG:受精卵日数 = 0
CFLAG:ARG:着床所要日数 = 0
;妊娠のバレ状態を全員分クリア
FOR LOCAL, 0, CHARANUM
	CFLAG:(LOCAL):(3300 + ARG) = 0
NEXT
RETURN

;================================================================
; 妊娠・出産による3サイズ（バスト/ウエスト/ヒップ）の変化
;  ・妊娠中：進行率に応じてウエストが膨らみバストが張る（日々少しずつの一時変化）
;  ・出産  ：お腹は即時にある程度へこみ、以後ゆっくり戻る（育児期間≒30日）。
;            バストは授乳中は張ったままで、授乳終了後にゆっくり落ち着く（恒久+2.0cm）。
;            ヒップは回復期間中に徐々に恒久+1.5cm。
;  ・中断  ：短い回復期（1〜6日、進行に応じる）でゆっくり妊娠前へ完全復元。
; カップ計算(@GET_CUP_SIZE)はトップ(胸囲)−アンダーバスト(身長基準・妊娠不変)で算出する。
;  胴囲(お腹)はカップに影響しないので、お腹の膨張はカップを縮めない（バスト張り分だけカップ微増）。
;  胸囲はカップ計算がMAXBASEを見るためBASE/MAXBASE両方を書く。
; CFLAG:妊娠前胸囲/胴囲/腰囲(38/39/40)＝妊娠中は妊娠前サイズ（遅延キャプチャ・0=未保存）、
;  出産後は恒久変化込みの「回復目標サイズ」に書き換わる。回復完了で0クリア（破棄）。
;================================================================

;----------------------------------------------------------------
;妊娠中の3サイズ更新（腹段階_更新から毎日呼ばれる・冪等）
; ARG=対象。妊娠前サイズ＋進行率(‰)の区分線形補間による増分で毎回上書きするため何度呼んでも安全
;----------------------------------------------------------------
@妊娠_3サイズ_更新(ARG)
;妊娠していない／計測不能（胸囲未設定）キャラは対象外
SIF !TALENT:ARG:妊娠 || MAXBASE:ARG:胸囲 <= 0
	RETURN
VARSET LOCAL
;初回：妊娠前サイズを保存（この時点はまだ未膨張＝真の基準）。全受精経路・既存セーブをここで吸収
IF CFLAG:ARG:妊娠前胸囲 <= 0
	CFLAG:ARG:妊娠前胸囲 = MAXBASE:ARG:胸囲
	CFLAG:ARG:妊娠前胴囲 = MAXBASE:ARG:胴囲
	CFLAG:ARG:妊娠前腰囲 = MAXBASE:ARG:腰囲
ENDIF
;進行率(‰)＝妊娠日数×1000/出産予定日数。850‰(臨月相当)で頭打ち
LOCAL:2 = MIN(CFLAG:ARG:妊娠日数 * 1000 / 出産予定日数(ARG), 850)
SIF LOCAL:2 < 0
	LOCAL:2 = 0
;進行率に応じた一時増分(0.1cm)を区分線形補間で算出（日々少しずつ変化する）
;アンカーは旧腹段階の境界値：100‰=10/30, 300‰=20/100, 600‰=35/180, 850‰=50/250
;LOCAL=バストの張り, LOCAL:1=お腹の膨らみ(ウエスト)
IF LOCAL:2 >= 600
	;進行60〜85%（段階3→4）
	LOCAL = 35 + 15 * (LOCAL:2 - 600) / 250
	LOCAL:1 = 180 + 70 * (LOCAL:2 - 600) / 250
ELSEIF LOCAL:2 >= 300
	;進行30〜60%（段階2→3）
	LOCAL = 20 + 15 * (LOCAL:2 - 300) / 300
	LOCAL:1 = 100 + 80 * (LOCAL:2 - 300) / 300
ELSEIF LOCAL:2 >= 100
	;進行10〜30%（段階1→2）
	LOCAL = 10 + 10 * (LOCAL:2 - 100) / 200
	LOCAL:1 = 30 + 70 * (LOCAL:2 - 100) / 200
ELSE
	;進行〜10%（0→段階1）
	LOCAL = 10 * LOCAL:2 / 100
	LOCAL:1 = 30 * LOCAL:2 / 100
ENDIF
;産後・中断後の回復途中に再妊娠した場合、体型が現在値より縮んで見えないようにする
LOCAL = MAX(LOCAL, BASE:ARG:胸囲 - CFLAG:ARG:妊娠前胸囲)
LOCAL:1 = MAX(LOCAL:1, BASE:ARG:胴囲 - CFLAG:ARG:妊娠前胴囲)
;バスト・ウエストを〈妊娠前＋一時増分〉で上書き（BASE/MAXBASE両方）。ヒップは妊娠中は据え置き
BASE:ARG:胸囲 = CFLAG:ARG:妊娠前胸囲 + LOCAL
MAXBASE:ARG:胸囲 = BASE:ARG:胸囲
BASE:ARG:胴囲 = CFLAG:ARG:妊娠前胴囲 + LOCAL:1
MAXBASE:ARG:胴囲 = BASE:ARG:胴囲
;カップサイズを再計算して反映
CALL GET_CUP_SIZE(ARG)
CFLAG:ARG:36 = RESULT
;体型変化に連動して体重も更新
CALL 体重_更新(ARG)
RETURN

;----------------------------------------------------------------
;妊娠中断時の回復開始（アフターピル・流産用）
; ARG=対象。即時復元はせず、短い回復期でゆっくり妊娠前へ戻す。
; ※妊娠日数・胎児数のクリア前に呼ぶこと（回復期間の算出に使う）
;----------------------------------------------------------------
@妊娠_3サイズ_中断回復(ARG)
;保存が無ければ何もしない
SIF CFLAG:ARG:妊娠前胸囲 <= 0
	RETURN
;ウエスト：胎児分が抜けて即時にある程度へこむ（初期の中断なら実質変化なし）
BASE:ARG:胴囲 = MIN(BASE:ARG:胴囲, CFLAG:ARG:妊娠前胴囲 + 80)
MAXBASE:ARG:胴囲 = BASE:ARG:胴囲
;回復期間：進行に応じて1〜6日（出産後の育児期間≒30日よりずっと短い）。この間は妊娠しない
CFLAG:ARG:産後回復 = MAX(MAX(CFLAG:ARG:産後回復, 1), CFLAG:ARG:妊娠日数 * 6 / 出産予定日数(ARG))
;回復目標(CFLAG:妊娠前*)は妊娠前サイズのまま＝恒久変化なし。以後、日次の回復処理で徐々に戻る
;カップサイズを再計算して反映
CALL GET_CUP_SIZE(ARG)
CFLAG:ARG:36 = RESULT
;体型変化に連動して体重も更新
CALL 体重_更新(ARG)
RETURN

;----------------------------------------------------------------
;出産直後の3サイズ変化と回復目標の設定
; ARG=対象。お腹は即時にある程度へこみ、以後の回復は日次処理(@産後_3サイズ_回復)に任せる。
; CFLAG:妊娠前胸囲/腰囲は恒久変化込みの「回復目標」に書き換える（回復完了時に破棄）
;----------------------------------------------------------------
@出産_3サイズ変化(ARG)
;保存が無い（既存セーブの妊娠中キャラ等）→ 変化はスキップ
SIF CFLAG:ARG:妊娠前胸囲 <= 0
	RETURN
;ウエスト：赤ちゃん・羊水・胎盤分が抜けて即時にある程度へこむ（残り+8.0cmはゆっくり戻る）
BASE:ARG:胴囲 = MIN(BASE:ARG:胴囲, CFLAG:ARG:妊娠前胴囲 + 80)
MAXBASE:ARG:胴囲 = BASE:ARG:胴囲
;バストは授乳の張りで当面維持、ヒップも即時には変えない（日次の回復処理で徐々に目標へ）
;回復目標：バスト恒久増+2.0cm(絶対上限150cm)・ウエストは妊娠前へ・ヒップ恒久増+1.5cm(絶対上限140cm)
CFLAG:ARG:妊娠前胸囲 = MIN(CFLAG:ARG:妊娠前胸囲 + 20, 1500)
CFLAG:ARG:妊娠前腰囲 = MIN(CFLAG:ARG:妊娠前腰囲 + 15, 1400)
;カップサイズを再計算して反映
CALL GET_CUP_SIZE(ARG)
CFLAG:ARG:36 = RESULT
;体型変化に連動して体重も更新
CALL 体重_更新(ARG)
;地の文（プレイヤーのみ）
SIF ARG == MASTER
	PRINTFORMW 出産でお腹はだいぶ引っ込んだが、まだ元通りではない。胸は母乳で張っている。
RETURN

;----------------------------------------------------------------
;産後・中断後の3サイズ日次回復（妊娠_日次処理から毎日呼ばれる）
; ARG=対象。BASEを回復目標(CFLAG:妊娠前胸囲/胴囲/腰囲)へ日々少しずつ収束させる。
;  ウエスト・ヒップ：残り日数（出産後=育児日数≒30日、中断後=産後回復1〜6日）で線形収束
;  バスト：授乳（育児）中は張りを維持し、終了後に1/4ずつゆっくり収束（差0.5cm以下でスナップ）
; 3サイズすべて目標到達で回復完了＝保存を破棄
;----------------------------------------------------------------
@産後_3サイズ_回復(ARG)
;回復対象は「回復目標が保存されている非妊娠キャラ」のみ
SIF TALENT:ARG:妊娠 || CFLAG:ARG:妊娠前胸囲 <= 0
	RETURN
VARSET LOCAL
;LOCAL:2＝ウエスト/ヒップの収束ペース（残り日数+1。整数除算は0方向切り捨てで増減とも動作）
LOCAL:2 = MAX(CFLAG:ARG:育児日数, CFLAG:ARG:産後回復) + 1
;ウエスト：目標へ日々漸減
LOCAL = CFLAG:ARG:妊娠前胴囲 - BASE:ARG:胴囲
BASE:ARG:胴囲 += LOCAL / LOCAL:2
MAXBASE:ARG:胴囲 = BASE:ARG:胴囲
;ヒップ：目標へ日々漸増（出産後の恒久増分）
LOCAL = CFLAG:ARG:妊娠前腰囲 - BASE:ARG:腰囲
BASE:ARG:腰囲 += LOCAL / LOCAL:2
MAXBASE:ARG:腰囲 = BASE:ARG:腰囲
;バスト：授乳（育児）中は張りを維持。終了後は目標へゆっくり収束
IF CFLAG:ARG:育児日数 <= 0
	LOCAL = CFLAG:ARG:妊娠前胸囲 - BASE:ARG:胸囲
	IF ABS(LOCAL) <= 5
		;差が0.5cm以下になったら目標へスナップ
		BASE:ARG:胸囲 = CFLAG:ARG:妊娠前胸囲
	ELSE
		BASE:ARG:胸囲 += LOCAL / 4
	ENDIF
	MAXBASE:ARG:胸囲 = BASE:ARG:胸囲
ENDIF
;カップサイズを再計算して反映
CALL GET_CUP_SIZE(ARG)
CFLAG:ARG:36 = RESULT
;体型変化に連動して体重も更新
CALL 体重_更新(ARG)
;3サイズすべて目標到達＝回復完了。保存を破棄し、完了を描写
IF BASE:ARG:胸囲 == CFLAG:ARG:妊娠前胸囲 && BASE:ARG:胴囲 == CFLAG:ARG:妊娠前胴囲 && BASE:ARG:腰囲 == CFLAG:ARG:妊娠前腰囲
	CFLAG:ARG:妊娠前胸囲 = 0
	CFLAG:ARG:妊娠前胴囲 = 0
	CFLAG:ARG:妊娠前腰囲 = 0
	IF ARG == MASTER
		;出産後（母乳体質あり）と中断後で文言を変える
		IF TALENT:ARG:母乳体質
			PRINTFORMW 出産を経て、体つきが少し変わった。胸は張って大きくなり、腰まわりにも女らしい丸みが増した。
		ELSE
			PRINTFORMW 体型がすっかり元に戻った。
		ENDIF
	ENDIF
ENDIF
RETURN
