;================================================================
; 酒場の共通処理（居酒屋.ERB / バー.ERB から共有。2026-07-21追加）
;  ・酒のデータ（名前／値段／強さ）と注文処理を一元管理する
;  ・バイト勤務（職業19 居酒屋 / 20 バー）の「勤務中のできごと」抽選もここに置く
;  ・酔い度そのものの計算は 酔い.ERB（@飲酒 / @酔い段階）に委譲する
;
;  酒番号: 1 ビール / 2 サワー / 3 日本酒 / 4 焼酎
;          5 ウイスキー / 6 カクテル / 7 ワイン
;          8 ソフトドリンク（酒ではない＝年齢ゲートを通さない）
;  居酒屋は1〜4＋8、バーは5〜7＋8を扱う。
;================================================================

;-------------------------------------------------
; 酒の名前
;-------------------------------------------------
@酒_名(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		RETURNF "生ビール"
	CASE 2
		RETURNF "サワー"
	CASE 3
		RETURNF "日本酒"
	CASE 4
		RETURNF "焼酎"
	CASE 5
		RETURNF "ウイスキー"
	CASE 6
		RETURNF "カクテル"
	CASE 7
		RETURNF "ワイン"
	CASEELSE
		RETURNF "ソフトドリンク"
ENDSELECT

;-------------------------------------------------
; 酒の値段（円）
;-------------------------------------------------
@酒_値段(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 1
		RETURNF 500
	CASE 2
		RETURNF 450
	CASE 3
		RETURNF 700
	CASE 4
		RETURNF 600
	CASE 5
		RETURNF 900
	CASE 6
		RETURNF 1200
	CASE 7
		RETURNF 1000
	CASEELSE
		RETURNF 300
ENDSELECT

;-------------------------------------------------
; 酒の強さ（@飲酒に渡す値。0=酒ではない）
;-------------------------------------------------
@酒_強さ(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 1
		RETURNF 100
	CASE 2
		RETURNF 80
	CASE 3
		RETURNF 180
	CASE 4
		RETURNF 220
	CASE 5
		RETURNF 250
	CASE 6
		RETURNF 150
	CASE 7
		RETURNF 140
	CASEELSE
		RETURNF 0
ENDSELECT

;-------------------------------------------------
; 一杯の描写（ARG=飲んだ本人 / ARG:1=酒番号）
;  酔いの段階に応じて地の文を変える
;-------------------------------------------------
@酒_一杯描写(ARG, ARG:1)
IF !酒_強さ(ARG:1)
	PRINTFORMW 冷たい%酒_名(ARG:1)%が渇いた喉を流れていく。頭は醒めたままだ。
	RETURN
ENDIF
SELECTCASE 酔い段階(ARG)
	CASE 0
		PRINTFORMW 一口目の%酒_名(ARG:1)%が、体の芯をゆっくりと温めていく。
	CASE 1
		PRINTFORMW %酒_名(ARG:1)%を重ねるうち、頬が火照り、口が軽くなってきた。
	CASE 2
		PRINTFORMW 視界がやわらかく滲む。%酒_名(ARG:1)%のグラスを持つ手が、少しあやしい。
	CASE 3
		PRINTFORMW 天井が回っている。それでもグラスを置く気にはなれなかった。
	CASEELSE
		PRINTFORMW ……もう味も分からない。ただ、注がれるままに飲み下していた。
ENDSELECT
RETURN

;-------------------------------------------------
; 一杯注文する（ARG=対象 / ARG:1=酒番号 / ARG:2=店主の登録番号。-1可）
;  RETURN 1=飲んだ / 0=飲めなかった（金欠）
;  料金は先払い。※ARG:2は年齢ゲート撤去に伴い現在未使用（シグネチャは呼び出し側互換のため維持）
;-------------------------------------------------
@酒場_注文(ARG, ARG:1, ARG:2)
#DIM 本人
#DIM 品目
本人 = ARG
品目 = ARG:1
IF MONEY:本人 < 酒_値段(品目)
	PRINTFORMW 財布の中身を確かめて、あなたは黙って首を振った。（所持金%金額(MONEY:本人)%円）
	RETURN 0
ENDIF
MONEY:本人 -= 酒_値段(品目)
CALL 飲酒(本人, 酒_強さ(品目))
CALL 酒_一杯描写(本人, 品目)
CFLAG:本人:待機時間 += 20
RETURN 1

;-------------------------------------------------
; 酒のメニューを一覧表示する（ARG=先頭の酒番号 / ARG:1=末尾の酒番号）
;  選択肢の番号は「酒番号 - 先頭」で採番するため、呼び出し側と揃えること
;-------------------------------------------------
@酒場_メニュー表示(ARG, ARG:1)
FOR LOCAL, ARG, ARG:1 + 1
	PRINTFORML [{LOCAL - ARG}] - %酒_名(LOCAL)%（%金額(酒_値段(LOCAL))%円）
NEXT
RETURN

;================================================================
; 同席者との飲み方（2026-07-22追加）
;  乾杯する／奢る／介抱する。居酒屋・バー双方から使える共通処理。
;  ・登場人物は全員20歳以上なので、年齢による差し替えは行わない
;  ・加算するのは好意(TA:3)のみ
;================================================================

;-------------------------------------------------
; 相手に出す品を決める（ARG=相手 / ARG:1=本来の酒番号）
;  下戸には 8（ソフトドリンク）を返す
;-------------------------------------------------
@酒場_相手の品(ARG, ARG:1)
#FUNCTION
SIF TALENT:ARG:下戸
	RETURNF 8
RETURNF ARG:1

;-------------------------------------------------
; 乾杯する（ARG=相手 / ARG:1=酒番号 / ARG:2=店主の登録番号。-1可）
;  二人分を自分が払って杯を合わせる。RETURN 1=乾杯できた / 0=できなかった
;  ※ARG:2は年齢ゲート撤去に伴い現在未使用（シグネチャは呼び出し側互換のため維持）
;-------------------------------------------------
@酒場_乾杯(ARG, ARG:1, ARG:2)
#DIM 相手
#DIM 品目
#DIM 相手の品
#DIM 代金
#DIM 増分
相手 = ARG
品目 = ARG:1
相手の品 = 酒場_相手の品(相手, 品目)
代金 = 酒_値段(品目) + 酒_値段(相手の品)
IF MONEY:MASTER < 代金
	PRINTFORMW 二人分には少し足りない。あなたは黙って財布を閉じた。（所持金%金額(MONEY:MASTER)%円／%金額(代金)%円必要）
	RETURN 0
ENDIF
MONEY:MASTER -= 代金
CFLAG:MASTER:待機時間 += 20
CFLAG:相手:待機時間 += 20
CALL 飲酒(MASTER, 酒_強さ(品目))
CALL 飲酒(相手, 酒_強さ(相手の品))
増分 = 5
SIF TALENT:相手:酒豪
	増分 += 3
TA:MASTER:相手:3 += 増分
TA:相手:MASTER:3 += 増分
EXP:MASTER:会話経験 += 1
EXP:相手:会話経験 += 1
SOURCE:MASTER:歓楽 = 300
PRINTL
PRINTFORML %CALLNAME:相手%のグラスに、自分のグラスを軽く当てた。
IF 酒_強さ(相手の品) <= 0
	PRINTFORMW %CALLNAME:相手%は%酒_名(相手の品)%のグラスを掲げ、律儀に付き合ってくれた。
ELSEIF TALENT:相手:酒豪
	PRINTFORMW %CALLNAME:相手%は一息に干してみせ、「その調子だ」と空のグラスを振ってきた。
ELSE
	PRINTFORMW 澄んだ音がひとつ。それだけで、卓の空気がずいぶん和らいだ。
ENDIF
RETURN 1

;-------------------------------------------------
; 奢る（ARG=相手 / ARG:1=酒番号 / ARG:2=店主の登録番号。-1可）
;  相手の分だけ払う。自分は飲まないので年齢ゲートは相手の品目側だけ効く
;-------------------------------------------------
@酒場_奢る(ARG, ARG:1, ARG:2)
#DIM 相手
#DIM 相手の品
#DIM 代金
相手 = ARG
相手の品 = 酒場_相手の品(相手, ARG:1)
代金 = 酒_値段(相手の品)
IF MONEY:MASTER < 代金
	PRINTFORMW 奢ってやれるだけの持ち合わせがなかった。（所持金%金額(MONEY:MASTER)%円／%金額(代金)%円必要）
	RETURN 0
ENDIF
MONEY:MASTER -= 代金
CFLAG:MASTER:待機時間 += 15
CALL 飲酒(相手, 酒_強さ(相手の品))
TA:相手:MASTER:3 += 10
TA:MASTER:相手:3 += 3
EXP:MASTER:会話経験 += 1
PRINTL
PRINTFORML 店員を呼び止め、%CALLNAME:相手%の前に%酒_名(相手の品)%を一杯置いてもらった。
IF TA:相手:MASTER:3 >= 40
	PRINTFORMW %CALLNAME:相手%は目を丸くしてから、「悪いな」と嬉しそうに頭を下げた。
ELSE
	PRINTFORMW %CALLNAME:相手%は一瞬きょとんとして、それから小さく会釈を返してきた。
ENDIF
RETURN 1

;-------------------------------------------------
; 介抱する（ARG=相手）
;  泥酔（段階3）以上の同席者の世話を焼く。1日1回（TCVAR:639）。
;  酒耐性が高いほど手際がよく、酔いをよく醒ませる
;-------------------------------------------------
@酒場_介抱(ARG)
#DIM 相手
#DIM 効果
#DIM 増分
相手 = ARG
IF TCVAR:MASTER:当日介抱済
	PRINTFORMW 今夜はもう、人の面倒まで見る余裕がなかった。
	RETURN 0
ENDIF
IF 酔い段階(相手) < 3
	PRINTFORMW %CALLNAME:相手%はまだしっかりしている。世話を焼くまでもなさそうだ。
	RETURN 0
ENDIF
TCVAR:MASTER:当日介抱済 = 1
CFLAG:MASTER:待機時間 += 30
CFLAG:相手:待機時間 += 30
;酒耐性が高いほど「何をすべきか」を知っている
効果 = 150 + MIN(ABL:MASTER:酒耐性, 5) * 70
BASE:相手:酔い = MAX(BASE:相手:酔い - 効果, 0)
増分 = 8 + MIN(ABL:MASTER:酒耐性, 5) * 2
TA:相手:MASTER:3 += 増分
TA:MASTER:相手:3 += 3
EXP:MASTER:飲酒経験 += 1
PRINTL
IF ABL:MASTER:酒耐性 >= 3
	PRINTFORML 水とおしぼりを頼み、%CALLNAME:相手%を楽な姿勢に座らせて襟元を緩めてやる。
	PRINTFORMW 手慣れていた。介抱される側より、する側でいることの方が多いのだろう。
ELSE
	PRINTFORML とりあえず水を運び、%CALLNAME:相手%の背中をさすってやる。
	PRINTFORMW 何が正解かは分からなかったが、放っておく気にはなれなかった。
ENDIF
IF 酔い段階(相手) >= 3
	PRINTFORMW %CALLNAME:相手%は据わった目のまま、それでも小さく「ありがとう」と呟いた。
ELSE
	PRINTFORMW 水を飲み干した%CALLNAME:相手%の目に、少しだけ焦点が戻ってきた。
ENDIF
RETURN 1

;================================================================
; バイト勤務（職業19 居酒屋 / 20 バー）
;  XCOM1005から呼ばれ、勤務中のできごとを抽選してSOURCEと飲酒を仕込む。
;  （SOURCE→PALAM・経験の変換は描写(COM_MESSAGE)より先に走るため、抽選＝XCOM段階で仕込む）
;  M:107 … 0=平穏 / 1=常連に飲まされる / 2=絡まれる / 3=体を触られる / 4=口説かれる
;================================================================
@酒場勤務抽選(ARG)
#DIM 本人
#DIM 抽選
;CALL 飲酒 を挟むためARGは先に退避する
本人 = ARG
M:107 = 0
抽選 = RAND(100)
IF CFLAG:本人:職業 == 19
	;居酒屋＝酔客の密度が高い。絡み・セクハラが多い
	SELECTCASE 抽選
		CASE IS < 25
			M:107 = 1
		CASE IS < 45
			M:107 = 2
		CASE IS < 60
			M:107 = 3
		CASE IS < 70
			M:107 = 4
	ENDSELECT
ELSE
	;バー＝客層が落ち着いている。口説かれることの方が多い
	SELECTCASE 抽選
		CASE IS < 20
			M:107 = 1
		CASE IS < 30
			M:107 = 2
		CASE IS < 40
			M:107 = 3
		CASE IS < 65
			M:107 = 4
	ENDSELECT
ENDIF
;常連に飲まされる（勤務中の飲酒。断れる性格なら軽く済む）
IF M:107 == 1
	IF ABL:本人:話術技能 >= 3
		CALL 飲酒(本人, 80)
	ELSE
		CALL 飲酒(本人, 160)
	ENDIF
ENDIF
;体を触られる（酔った勢いのセクハラ。露出・快感のソースを仕込む）
IF M:107 == 3
	SOURCE:本人:快Ｂ = 60
	SOURCE:本人:露出 = 100
	EXP:本人:異常経験 += 1
ENDIF
;口説かれる（悪い気はしない＝歓楽）
SIF M:107 == 4
	SOURCE:本人:歓楽 = 300
RETURN

;-------------------------------------------------
; 勤務中のできごとの描写（COM_MESSAGE1005の@bite19から呼ぶ）
;  抽選（M:107）とSOURCEは@酒場勤務抽選で仕込み済み。ここでは描写だけ行う
;-------------------------------------------------
@酒場勤務描写(ARG)
#DIM 店主
店主 = -1
SIF JOB_MASTER_CHARA(CFLAG:ARG:職業) >= 0
	店主 = GETCHARA(JOB_MASTER_CHARA(CFLAG:ARG:職業))
IF CFLAG:ARG:職業 == 19
	PRINTFORML ＜居酒屋のホール＞
	PRINTL 生ビールのジョッキが次々と空になり、注文の声があちこちから飛んでくる。
	IF ABL:ARG:接客技能 >= 4
		PRINTFORML %CALLNAME:ARG%は四人分の注文を一度に捌き、盆を高く掲げて卓の間を抜けていく。
	ELSEIF ABL:ARG:接客技能 >= 2
		PRINTFORML 大声で復唱しながら、%CALLNAME:ARG%はどうにか卓を回していく。
	ELSE
		PRINTFORML 注文を取り違えそうになりながら、%CALLNAME:ARG%は必死に厨房と卓を往復した。
	ENDIF
ELSE
	PRINTFORML ＜バーのカウンター＞
	PRINTL 低く流れるジャズと、氷を削る音。客の話し声はどれも囁くように小さい。
	IF ABL:ARG:接客技能 >= 4
		PRINTFORML %CALLNAME:ARG%は客の顔色だけで次の一杯を用意し、静かにコースターへ置いた。
	ELSEIF ABL:ARG:接客技能 >= 2
		PRINTFORML グラスを磨きながら、%CALLNAME:ARG%は客の話に相槌を返していく。
	ELSE
		PRINTFORML 慣れない手つきでシェイカーを振る%CALLNAME:ARG%を、客は面白そうに眺めていた。
	ENDIF
ENDIF
SELECTCASE M:107
	CASE 1
		SIF 店主 >= 0
			PRINTFORML %CALLNAME:店主%が苦笑しながら、断りきれなかったあなたのグラスを見ている。
		PRINTL 「まあ一杯くらい付き合えって」──常連に押しきられ、あなたは仕事中に杯を空けた。
		PRINTFORMW 喉の奥が熱い。仕事はまだ終わっていないというのに。
	CASE 2
		PRINTL 出来上がった客に袖を掴まれ、同じ話を三度も聞かされる羽目になった。
		IF 店主 >= 0
			PRINTFORMW %CALLNAME:店主%が割って入ってくれるまで、あなたは曖昧に笑い続けた。
		ELSE
			PRINTFORMW 誰も助けてはくれず、あなたは曖昧に笑い続けるしかなかった。
		ENDIF
	CASE 3
		PRINTL 卓に酒を置こうと屈んだ瞬間、赤ら顔の客の手が伸びてきた。
		PRINTFORMW 「おっと、悪い悪い」──悪びれもしない声。振り払う暇もなく、手はもう離れていた。
	CASE 4
		PRINTL 名刺を差し出され、「今度、店の外で会えないか」と真顔で誘われた。
		PRINTFORMW 社交辞令で受け流したものの、悪い気はしなかった。
ENDSELECT
RETURN
